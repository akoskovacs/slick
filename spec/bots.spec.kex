using App.Live.Tab, only: [Tab]
using App.Models.User, only: [User]
using Spec.Support, only: [World, stepped, shown, fresh, populated]

# The bots dialog. Each example starts from a world of its own
# (Spec.Support).

# Makes a bot from a tab of `user`'s, and the bot its token speaks for.
foul createBot(world: World, user: User, tab: Tab, name: String, owner: String) -> (Tab, User) do
  let (made, _) = stepped(world, user, tab, [("event", "bot-create"), ("name", name), ("owner", owner)])
  let bot : User = App.Services.Bots.bearer(Just("Bearer ${made.secret}")).or(user)
  (made, bot)
end

describe("App.Live.Bots, making one") do
  it("makes a person's own bot, a member known by a token stored only as a digest") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, bot) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      Assert.truthy(made.secret.contains?("slick_bot_"))
      let dialog = shown(world, world.bob, made)
      Assert.truthy(dialog.contains?(made.secret))
      Assert.truthy(dialog.contains?("deploy-bot"))
      Assert.falsy(shown(world, world.ada, Tab {}).contains?(made.secret))
      Assert.truthy(shown(world, world.ada, Tab {}).contains?("class=\"flag\">BOT"))
      Assert.truthy(bot.bot?)
      Assert.equal(bot.ownerId, world.bob.id)
      Assert.equal(bot.ownerOrganizationId, "")
    end
  end

  it("knows a bot by its whole token, and never lets it sign in like a person") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, bot) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      Assert.equal(App.Services.Bots.bearer(Just("Bearer slick_bot_wrong")), None)
      Assert.equal(App.Services.Bots.bearer(None), None)
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ")), None)
      Assert.truthy(App.Services.Authentication.signIn(bot.email, "").error?)
      Assert.truthy(App.Services.Authentication.signIn(bot.email, made.secret).error?)
    end
  end

  it("refuses a bot without a proper name") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, changed) = stepped(world, world.bob, Tab {}, [("event", "bot-create"), ("name", "x"), ("owner", "me")])
      Assert.falsy(changed)
      Assert.equal(made.dialog, "bots")
      Assert.truthy(!made.dialogProblem.empty?)
      Assert.equal(made.secret, "")
    end
  end

  it("lists a person's own bots under Bots, and everyone else's among the people") do
    with Harmat.Connection = fresh() do
      let world = populated()
      createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      let bobs = shown(world, world.bob, Tab {}).split("<h2>Bots</h2>")
      Assert.falsy(bobs.first.or("").contains?(">deploy-bot"))
      Assert.truthy(bobs.drop(1).first.or("").contains?(">deploy-bot"))
      let adas = shown(world, world.ada, Tab {}).split("<h2>Bots</h2>")
      Assert.truthy(adas.first.or("").contains?(">deploy-bot"))
      Assert.falsy(adas.drop(1).first.or("").contains?(">deploy-bot"))
    end
  end

  it("lets a bot write where its organization lets a member, and nowhere else") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, bot) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      let (_, sent) = stepped(world, bot, Tab {}, [("event", "message-send"), ("body", "deployed :rocket:")])
      Assert.truthy(sent)
      Assert.truthy(shown(world, world.ada, Tab {}).contains?("deployed 🚀"))
      Assert.equal(App.Live.Addresses.tabFor(bot, "/other/channels/general"), Tab {})
      let (chat, _) = stepped(world, world.ada, Tab {}, [("event", "direct-open"), ("user", world.bob.id)])
      Assert.equal(App.Live.Places.visible(bot, chat), None)
    end
  end
end

describe("App.Live.Bots, an organization's") do
  it("makes one only for an administrator, and lists it only to them") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (eveTries, _) = stepped(world, world.eve, Tab {}, [("event", "bot-create"), ("name", "acme-bot"), ("owner", "organization")])
      Assert.truthy(eveTries.dialogProblem.contains?("Only an administrator"))
      let (_, bot) = createBot(world, world.ada, Tab {}, "acme-bot", "organization")
      Assert.equal(bot.ownerId, "")
      Assert.equal(bot.ownerOrganizationId, world.acme.organization)
      let evesDialog = shown(world, world.eve, Tab { dialog: "bots" })
      Assert.falsy(evesDialog.split("<h2>Bots</h2>").drop(1).first.or("").contains?(">acme-bot"))
      let adasDialog = shown(world, world.ada, Tab { dialog: "bots" })
      Assert.truthy(adasDialog.contains?("acme-bot"))
      Assert.truthy(adasDialog.contains?("belongs to Acme Corp"))
      Assert.falsy(shown(world, world.mal, Tab {}).contains?("acme-bot"))
    end
  end

  it("marks a person's own bots as theirs in the dialog") do
    with Harmat.Connection = fresh() do
      let world = populated()
      createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      Assert.truthy(shown(world, world.bob, Tab { dialog: "bots" }).contains?("<span class=\"hint\">yours</span>"))
    end
  end
end

describe("App.Live.Bots, a new token") do
  it("gives a person's bot one only for its owner, and the old one stops working") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, bot) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      let (adaTries, _) = stepped(world, world.ada, Tab {}, [("event", "bot-rotate"), ("id", bot.id)])
      Assert.equal(adaTries.secret, "")
      Assert.truthy(App.Services.Bots.bearer(Just("Bearer ${made.secret}")).set?)
      let (rotated, changed) = stepped(world, world.bob, Tab {}, [("event", "bot-rotate"), ("id", bot.id)])
      Assert.falsy(changed)
      Assert.truthy(rotated.secret != made.secret)
      Assert.equal(rotated.secretFor, "deploy-bot")
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ${made.secret}")), None)
      Assert.truthy(App.Services.Bots.bearer(Just("Bearer ${rotated.secret}")).set?)
    end
  end

  it("gives an organization's bot one only from an administrator, there") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, bot) = createBot(world, world.ada, Tab {}, "acme-bot", "organization")
      let (eveTries, _) = stepped(world, world.eve, Tab {}, [("event", "bot-rotate"), ("id", bot.id)])
      Assert.equal(eveTries.secret, "")
      let (malTries, _) = stepped(world, world.mal, Tab {}, [("event", "bot-rotate"), ("id", bot.id)])
      Assert.equal(malTries.secret, "")
      # Ada is in Other too, but from there she cannot touch Acme's bot.
      let (elsewhere, _) = stepped(world, world.ada, world.other, [("event", "bot-rotate"), ("id", bot.id)])
      Assert.equal(elsewhere.secret, "")
      let (rotated, _) = stepped(world, world.ada, Tab {}, [("event", "bot-rotate"), ("id", bot.id)])
      Assert.truthy(rotated.secret.contains?("slick_bot_"))
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ${made.secret}")), None)
      Assert.truthy(App.Services.Bots.bearer(Just("Bearer ${rotated.secret}")).set?)
    end
  end
end

describe("App.Live.Bots, adding one to an organization") do
  it("adds a person's own bot to another organization they are in") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, bot) = createBot(world, world.ada, Tab {}, "ada-bot", "me")
      Assert.falsy(shown(world, world.mal, Tab {}).contains?(">ada-bot"))
      let (added, changed) = stepped(world, world.ada, world.other, [("event", "bot-add"), ("id", bot.id)])
      Assert.truthy(changed)
      Assert.equal(added.dialog, "bots")
      Assert.truthy(shown(world, world.mal, Tab {}).contains?(">ada-bot"))
    end
  end

  it("adds nobody else's bot, not even the organization's") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, own) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      let (malTries, malAdded) = stepped(world, world.mal, Tab {}, [("event", "bot-add"), ("id", own.id)])
      Assert.falsy(malAdded)
      Assert.truthy(malTries.dialogProblem.contains?("not one of your bots"))
      let (_, shared) = createBot(world, world.ada, Tab {}, "acme-bot", "organization")
      let (_, adaAdded) = stepped(world, world.ada, world.other, [("event", "bot-add"), ("id", shared.id)])
      Assert.falsy(adaAdded)
    end
  end
end

describe("App.Live.Bots, removing one") do
  it("removes an organization's bot only for an administrator, with its access") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, bot) = createBot(world, world.ada, Tab {}, "acme-bot", "organization")
      let (_, malRemoved) = stepped(world, world.mal, Tab {}, [("event", "bot-remove"), ("id", bot.id)])
      Assert.falsy(malRemoved)
      let (_, eveRemoved) = stepped(world, world.eve, Tab {}, [("event", "bot-remove"), ("id", bot.id)])
      Assert.falsy(eveRemoved)
      Assert.truthy(App.Services.Bots.bearer(Just("Bearer ${made.secret}")).set?)
      let (removed, changed) = stepped(world, world.ada, Tab {}, [("event", "bot-remove"), ("id", bot.id)])
      Assert.truthy(changed)
      Assert.truthy(removed.notice.contains?("acme-bot"))
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ${made.secret}")), None)
      Assert.falsy(shown(world, world.ada, Tab { dialog: "bots" }).contains?(">acme-bot"))
    end
  end

  it("removes a person's own bot only for its owner") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, bot) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      let (_, adaRemoved) = stepped(world, world.ada, Tab {}, [("event", "bot-remove"), ("id", bot.id)])
      Assert.falsy(adaRemoved)
      let (_, bobRemoved) = stepped(world, world.bob, Tab {}, [("event", "bot-remove"), ("id", bot.id)])
      Assert.truthy(bobRemoved)
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ${made.secret}")), None)
      Assert.falsy(shown(world, world.bob, Tab { dialog: "bots" }).contains?(">deploy-bot"))
      Assert.falsy(App.Services.Authentication.current(Just(made.secret)).set?)
    end
  end
end

describe("App.Live.Bots, operators") do
  it("lets a bot's owner choose its operators among the people there") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, bot) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      let (saved, changed) = stepped(world, world.bob, Tab {}, [("event", "bot-operators-set"), ("bot", bot.id), ("operator", world.eve.id)])
      Assert.truthy(changed)
      Assert.truthy(saved.notice.contains?("saved"))
      Assert.equal(DB.Repositories.BotOperators.forBot(bot.id).or([]), [world.eve.id])
    end
  end

  it("refuses operators from anybody else, or from outside the organization") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, bot) = createBot(world, world.bob, Tab {}, "deploy-bot", "me")
      let (eveTries, eveChanged) = stepped(world, world.eve, Tab {}, [("event", "bot-operators-set"), ("bot", bot.id), ("operator", world.eve.id)])
      Assert.falsy(eveChanged)
      Assert.truthy(eveTries.dialogProblem.contains?("Only the bot owner"))
      let (outsider, outsiderChanged) = stepped(world, world.bob, Tab {}, [("event", "bot-operators-set"), ("bot", bot.id), ("operator", world.mal.id)])
      Assert.falsy(outsiderChanged)
      Assert.truthy(outsider.dialogProblem.contains?("Choose people"))
      Assert.equal(DB.Repositories.BotOperators.forBot(bot.id).or([]), [])
    end
  end
end

describe("App.Live.Bots, what bots read") do
  it("lets an administrator choose how much of a channel bots read") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (access, changed) = stepped(world, world.ada, Tab {}, [("event", "bot-access-set"), ("access", "mentions")])
      Assert.truthy(changed)
      Assert.truthy(access.notice.contains?("mentions"))
    end
  end

  it("refuses a member, and anything but none, mentions or all") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (eveTries, eveChanged) = stepped(world, world.eve, Tab {}, [("event", "bot-access-set"), ("access", "no_bots")])
      Assert.falsy(eveChanged)
      Assert.truthy(eveTries.failure.contains?("Only an administrator"))
      let (odd, oddChanged) = stepped(world, world.ada, Tab {}, [("event", "bot-access-set"), ("access", "everything")])
      Assert.falsy(oddChanged)
      Assert.equal(odd, Tab {})
    end
  end
end
