# Uploaded files: what they are and where they belong.
#
#   DB.Repositories.Attachments.inConversation(conversation.id)
module DB.Repositories.Attachments

using Harmat.Database, as: Database
using App.Models.Attachment, only: [Attachment]

# Notes a file somebody has just uploaded: theirs alone, until it is sent.
foul create(userId: String, blob: Metro.Storage.Blob) -> Attachment or! String do
  let file = Attachment {
    id: blob.key,
    userId: userId,
    filename: blob.filename,
    contentType: blob.contentType,
    byteSize: blob.byteSize,
    checksum: blob.checksum,
    uploadedAt: Metro.Clock.milliseconds()
  }
  let row = {
    id: file.id,
    user_id: userId,
    filename: file.filename,
    content_type: file.contentType,
    byte_size: file.byteSize,
    checksum: file.checksum,
    uploaded_at: file.uploadedAt
  }
  return Database.insert(DB.Schema.Files)
    .values(row)
    .run
    .map { |_| file }
end

# One file, or `None`.
foul find(id: String) -> Attachment? or! String do
  return Database.select().from(DB.Schema.Files)
    .where(DB.Schema.Files.id == id)
    .first(as: Attachment)
end

# Several files, by id, as many of them as there are.
foul findAll(ids: [String]) -> [Attachment] or! String do
  return Database.select().from(DB.Schema.Files)
    .where(DB.Schema.Files.id.in(ids))
    .orderBy([:uploaded_at, :id])
    .all(as: Attachment)
end

# Every file sent into a conversation, newest first.
foul inConversation(conversationId: String) -> [Attachment] or! String do
  return Database.select().from(DB.Schema.Files)
    .where(DB.Schema.Files.conversationId == conversationId)
    .orderBy(descending: [:uploaded_at, :id])
    .all(as: Attachment)
end

# Sends a person's files with a message: only theirs, and only those not
# sent before. How many went.
foul markSent(
  userId: String,
  ids: [String],
  conversationId: String,
  messageId: String
) -> Integer or! String do
  return Database.update(DB.Schema.Files)
    .where(DB.Schema.Files.userId == userId)
    .set({conversation_id: conversationId, message_id: messageId}, columns: [:conversation_id, :message_id])
    .where(DB.Schema.Files.id.in(ids))
    .where(DB.Schema.Files.messageId == "")
    .run
end
