describe("App.Live.Statuses") do
  it("shows somebody typing to the others there, until the message is sent") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, heard) = stepped(world, world.ada, Tab {}, [("event", "typing")])
      Assert.truthy(heard)
      Assert.truthy(shown(world, world.bob, Tab {}).contains?("<strong>Ada</strong> is typing…"))
      Assert.falsy(shown(world, world.ada, Tab {}).contains?("is typing…"))
      said(world, world.ada, "typed and sent")
      Assert.falsy(shown(world, world.bob, Tab {}).contains?("is typing…"))
    end
  end

  it("shows what somebody says they are doing, until they take it back or it lapses") do
    with Harmat.Connection = fresh() do
      let world = populated()
      Assert.truthy(App.Live.Statuses.say(world.statuses, world.eve, Tab {}, "Deploying <now>", 30000))
      Assert.truthy(shown(world, world.bob, Tab {}).contains?("<strong>Eve</strong> Deploying &lt;now&gt;…"))
      App.Live.Statuses.say(world.statuses, world.eve, Tab {}, "", 0)
      Assert.falsy(shown(world, world.bob, Tab {}).contains?("Deploying"))
      world.statuses.noted("general", "nobody", "old news", 1)
      Assert.equal(Metro.Live.Presence.standing(world.statuses, "general", 2), [])
    end
  end

  it("shows somebody online until the last of their tabs closes") do
    with Harmat.Connection = fresh() do
      let world = populated()
      # The sidebar line for somebody: its <button> tag, up to their id.
      let lineFor = do |markup, id|
        markup
          .split("data-user=\"${id}\"")
          .first
          .or("")
          .split("<button")
          .last
          .or("")
      end
      let online? = do |user|
        lineFor(shown(world, world.bob, Tab {}), user.id).contains?("entry online")
      end
      Assert.falsy(online?(world.ada))
      Metro.Live.Presence.arrived(world.statuses, world.ada.id, "one")
      Metro.Live.Presence.arrived(world.statuses, world.ada.id, "two")
      Assert.truthy(online?(world.ada))
      Metro.Live.Presence.departed(world.statuses, world.ada.id, "one")
      Assert.truthy(online?(world.ada))
      Metro.Live.Presence.departed(world.statuses, world.ada.id, "two")
      Assert.falsy(online?(world.ada))
    end
  end
end

describe("App.Live.Addresses, the tab an address stands for") do
  it("takes an organization, then a channel by name, a private chat by person, or a thread") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (random, _) = stepped(world, world.ada, Tab {}, [("event", "channel-create"), ("title", "random")])
      let id = said(world, world.ada, "a thread")
      let (chat, _) = stepped(world, world.ada, Tab {}, [("event", "direct-open"), ("user", world.bob.id)])
      Assert.equal(App.Live.Addresses.tabFor(world.eve, "/acmecorp/channels/random").conversation, random.conversation)
      Assert.equal(App.Live.Addresses.tabFor(world.eve, "/acmecorp/channels/general?thread=${id}").thread, id)
      Assert.equal(App.Live.Addresses.tabFor(world.ada, "/acmecorp/dm/${world.bob.id}").conversation, chat.conversation)
      Assert.truthy(shown(world, world.ada, chat).contains?("data-live-path=\"/acmecorp/dm/${world.bob.id}\""))
      Assert.truthy(shown(world, world.ada, random).contains?("# random · Acme Corp\">"))
    end
  end

  it("takes nobody anywhere that is not there, or not theirs") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (chat, _) = stepped(world, world.ada, Tab {}, [("event", "direct-open"), ("user", world.bob.id)])
      Assert.equal(App.Live.Addresses.tabFor(world.eve, "/acmecorp/channels/nowhere").conversation, "")
      Assert.equal(App.Live.Addresses.tabFor(world.eve, "/acmecorp/dm/nobody").conversation, "")
      Assert.equal(App.Live.Addresses.tabFor(world.eve, "/nowhere/channels/general").organization, "")
      # Eve going to her own chat with Bob gets hers, not Ada's.
      Assert.truthy(App.Live.Addresses.tabFor(world.eve, "/acmecorp/dm/${world.bob.id}").conversation != chat.conversation)
    end
  end
end

describe("Organizations, kept apart") do
  it("shows somebody nothing of an organization they are not in, however they ask") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (random, _) = stepped(world, world.ada, Tab {}, [("event", "channel-create"), ("title", "random")])
      let id = said(world, world.ada, "hello")
      let theirs = shown(world, world.mal, Tab {})
      Assert.truthy(theirs.contains?("<strong>Other</strong>"))
      Assert.falsy(theirs.contains?("Acme"))
      Assert.falsy(theirs.contains?("# random"))
      Assert.falsy(theirs.contains?("hello"))
      Assert.equal(App.Live.Addresses.tabFor(world.mal, "/acmecorp/channels/random"), Tab {})
      let (switched, _) = stepped(world, world.mal, Tab {}, [("event", "organization-switch"), ("id", world.acme.organization)])
      Assert.equal(switched.organization, "")
      let forged = Tab { organization: world.acme.organization, conversation: random.conversation }
      Assert.equal(world.mal.visible(forged.organization, forged.conversation), None)
      let (_, sent) = stepped(world, world.mal, forged, [("event", "message-send"), ("body", "mallory was here")])
      Assert.falsy(sent)
      let (_, reacted) = stepped(world, world.mal, forged, [("event", "message-react"), ("message", id), ("emoji", "🎉")])
      Assert.falsy(reacted)
      Assert.falsy(shown(world, world.ada, random).contains?("mallory was here"))
    end
  end
end

describe("App.Live.Unread") do
  it("counts what came since somebody last looked, beside the place and in the title") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (random, _) = stepped(world, world.ada, Tab {}, [("event", "channel-create"), ("title", "random")])
      shown(world, world.eve, Tab {})
      Assert.falsy(shown(world, world.eve, random).contains?("# general\n      <span class=\"count\""))
      said(world, world.bob, "one for later")
      said(world, world.bob, "and another")
      let away = shown(world, world.eve, random)
      Assert.truthy(away.contains?("# general\n      <span class=\"count\" aria-label=\"2 unread\">2</span>"))
      Assert.truthy(away.contains?("data-live-title=\"(2) # random"))
      Assert.truthy(away.contains?("class=\"entry unread\""))
      # Looking reads it.
      shown(world, world.eve, Tab {})
      Assert.falsy(shown(world, world.eve, random).contains?("# general\n      <span class=\"count\""))
    end
  end

  it("does not count replies in a thread somebody does not follow") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (random, _) = stepped(world, world.ada, Tab {}, [("event", "channel-create"), ("title", "random")])
      let id = said(world, world.bob, "a thread")
      let (thread, _) = stepped(world, world.bob, Tab {}, [("event", "thread-open"), ("message", id)])
      shown(world, world.eve, Tab {})
      stepped(world, world.bob, thread, [("event", "message-reply"), ("body", "a quiet reply")])
      Assert.falsy(shown(world, world.eve, random).contains?("# general\n      <span class=\"count\""))
    end
  end

  it("counts what arrives in a tab nobody is looking at, until they look again") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let away = Tab { attentive?: false }
      shown(world, world.eve, Tab {})
      said(world, world.bob, "while eve is away")
      Assert.truthy(shown(world, world.eve, away).contains?("data-live-title=\"(1) # general"))
      let (back, _) = stepped(world, world.eve, away, [("event", "attention"), ("on", "true")])
      shown(world, world.eve, back)
      Assert.falsy(shown(world, world.eve, away).contains?("data-live-title=\"(1)"))
    end
  end

  it("counts other people's replies in a thread somebody replied in, until they read it") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (random, _) = stepped(world, world.ada, Tab {}, [("event", "channel-create"), ("title", "random")])
      let id = said(world, world.bob, "a thread")
      let (thread, _) = stepped(world, world.bob, Tab {}, [("event", "thread-open"), ("message", id)])
      stepped(world, world.eve, thread, [("event", "message-reply"), ("body", "count me in")])
      shown(world, world.eve, Tab {})
      stepped(world, world.bob, thread, [("event", "message-reply"), ("body", "eve, look")])
      Assert.truthy(shown(world, world.eve, random).contains?("# general\n      <span class=\"count\" aria-label=\"1 unread\">1</span>"))
      # Reading the channel is not reading the thread.
      Assert.truthy(shown(world, world.eve, Tab {}).contains?("data-live-title=\"(1) # general"))
      shown(world, world.eve, thread)
      Assert.falsy(shown(world, world.eve, random).contains?("# general\n      <span class=\"count\""))
    end
  end

  it("counts a private chat by the person it is with") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (random, _) = stepped(world, world.ada, Tab {}, [("event", "channel-create"), ("title", "random")])
      let (chat, _) = stepped(world, world.bob, Tab {}, [("event", "direct-open"), ("user", world.eve.id)])
      stepped(world, world.bob, chat, [("event", "message-send"), ("body", "psst, eve")])
      Assert.truthy(shown(world, world.eve, random).contains?("data-user=\"${world.bob.id}\">Bob\n      <span class=\"count\""))
    end
  end
end

describe("DB.Store, transactions") do
  it("undoes what a transaction did when it answers an Error, and keeps it on Ok") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let draft = do |body| App.Models.Draft.Draft { conversationId: "c-nowhere", body: body } end
      let undone = Harmat.Database.transaction do
        DB.Repositories.Drafts.save(world.ada.id, draft("undone")).try
        Error("changed my mind")
      end
      Assert.equal(undone, Error("changed my mind"))
      Assert.falsy(DB.Repositories.Drafts.pending(world.ada.id).or([]).any? { |each| each.body == "undone" })
      let done = Harmat.Database.transaction do
        DB.Repositories.Drafts.save(world.ada.id, draft("done")).try
        DB.Repositories.Drafts.save(world.ada.id, draft(""))
      end
      Assert.truthy(done.ok?)
      Assert.falsy(DB.Repositories.Drafts.pending(world.ada.id).or([]).any? { |each| each.conversationId == "c-nowhere" })
    end
  end
end

describe("App.Controllers.Files") do
  it("keeps a file waiting for its uploader, then serves it to whoever may read it") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let files = "storage_spec_${Metro.Clock.milliseconds()}"
      with Metro.Storage = Metro.Storage.Disk { root: files } do
        let upload = Metro.Wire.made(
          "POST",
          "/uploads",
          [("Content-Type", "text/plain"), ("X-Filename", "notes.txt")],
          "first line\nsecond <line>"
        )
        let uploaded = App.Controllers.Files.uploaded(Metro.WebRequest.WebRequest {
          incoming: upload,
          assigns: {user: world.ada}
        })
        Assert.equal(uploaded.code, 200)
        let fileId = uploaded.payload
          .to(String)
          .or("")
          .split("\"file\":\"")
          .second
          .or("")
          .split("\"")
          .first
          .or("")
        Assert.truthy(fileId.startsWith?("f"))
        # Nobody shares a file that is not theirs.
        let (bobTakes, _) = stepped(world, world.bob, Tab {}, [("event", "file-attach"), ("file", fileId)])
        Assert.equal(bobTakes.pending, [])
        let (shares, _) = stepped(world, world.ada, Tab {}, [("event", "file-attach"), ("file", fileId)])
        Assert.equal(shares.pending, [fileId])
        Assert.truthy(shown(world, world.ada, shares).contains?("<strong>notes.txt</strong>"))
        # Before it is sent, only its uploader can fetch it.
        let asking = do |who|
          App.Controllers.Files.fetched(Metro.WebRequest.WebRequest {
            incoming: Metro.Wire.made("GET", "/files/${fileId}", [], ""),
            captures: {"id": fileId},
            assigns: {user: who}
          })
        end
        Assert.equal(asking(world.bob).code, 404)
        Assert.equal(asking(world.ada).code, 200)
        # A file goes without words.
        let (after, sent) = stepped(world, world.ada, shares, [("event", "message-send"), ("body", "")])
        Assert.truthy(sent)
        Assert.equal(after.pending, [])
        Assert.truthy(shown(world, world.bob, Tab {}).contains?("href=\"/files/${fileId}\""))
        Assert.equal(asking(world.bob).code, 200)
        Assert.equal(asking(world.mal).code, 404)
        Assert.equal(asking(world.bob).outgoing.get("X-Content-Type-Options"), Just("nosniff"))
        # The files view lists it, with the start of what it says.
        let view = shown(world, world.bob, Tab { view: App.Live.Tab.FilesView })
        Assert.truthy(view.contains?("<pre>first line\nsecond &lt;line&gt;</pre>"))
        Assert.truthy(view.contains?("Files <span class=\"tally\">1</span>"))
        # A file once sent cannot be sent again.
        let (again, _) = stepped(world, world.ada, Tab {}, [("event", "file-attach"), ("file", fileId)])
        Assert.equal(again.pending, [])
      end
      FS.Directory.deleteAll(files)
    end
  end

  it("says sizes to a tenth, in decimal units") do
    let sizedAs = do |count|
      App.Models.Attachment.Attachment { id: "f", userId: "u", filename: "x", contentType: "", byteSize: count }.sized
    end
    Assert.equal([28, 4312, 1536000, 2500000000].map { |count| sizedAs(count) }, ["28 B", "4.3 KB", "1.5 MB", "2.5 GB"])
  end
end

describe("The events bus, telling bots what happens") do
  it("tells each bot only what it may read, and where, never what") do
    let acme = "o1"
    let other = "o2"
    # A message in a public channel of Acme that lets bots read everything:
    # every bot of Acme's, and none of another organization's.
    let publicMessage = App.Live.Events.Event {
      kind: App.Live.Events.Message, organizationId: acme, organization: "acme",
      conversationId: "c1", channel: "general", message: "m1", at: 100, public?: true, botAccess: Conversation.AllBots
    }
    # A message in a private channel of Acme: only its participants.
    let privateMessage = App.Live.Events.Event {
      ...publicMessage, conversationId: "c2", channel: "", group: "c2", public?: false, people: ["u1", "b1"]
    }
    # An answer to a form: the one bot whose form it was.
    let answered = App.Live.Events.Event {
      ...publicMessage, kind: App.Live.Events.Answer, message: "m9", bot: "b1"
    }
    # A command: the one bot it was used for.
    let commanded = App.Live.Events.Event {
      ...publicMessage, kind: App.Live.Events.Command, message: "", bot: "b2"
    }
    # A channel that only tells bots what names them, and a mention in it.
    let mentioned = App.Live.Events.Event {
      ...publicMessage, botAccess: Conversation.Mentions, body: "hey @muse, look at this"
    }
    # A reply in a thread a bot already replied in: told to that bot, though
    # it is not named.
    let replied = App.Live.Events.Event {
      ...publicMessage, botAccess: Conversation.Mentions, body: "and 3 + 3?", thread: "m1", replied: ["b1"]
    }
    # A channel bots may read nothing of.
    let forbidden = App.Live.Events.Event {
      ...publicMessage, botAccess: Conversation.NoBots, body: "hey @muse"
    }

    Assert.truthy(App.Live.Events.heard?(publicMessage, "b1", "muse", [acme]))
    Assert.truthy(App.Live.Events.heard?(publicMessage, "b2", "deploy", [acme]))
    Assert.falsy(App.Live.Events.heard?(publicMessage, "b1", "muse", [other]))
    Assert.falsy(App.Live.Events.heard?(privateMessage, "b2", "deploy", [acme]))
    Assert.truthy(App.Live.Events.heard?(privateMessage, "b1", "muse", [acme]))
    Assert.truthy(App.Live.Events.heard?(answered, "b1", "muse", [acme]))
    Assert.falsy(App.Live.Events.heard?(answered, "b2", "deploy", [acme]))
    Assert.truthy(App.Live.Events.heard?(commanded, "b2", "deploy", [acme]))
    Assert.falsy(App.Live.Events.heard?(commanded, "b1", "muse", [acme]))
    # "mentions": only the bot named, or a thread it is in.
    Assert.truthy(App.Live.Events.heard?(mentioned, "b1", "muse", [acme]))
    Assert.falsy(App.Live.Events.heard?(mentioned, "b2", "deploy", [acme]))
    Assert.truthy(App.Live.Events.heard?(replied, "b1", "muse", [acme]))
    Assert.falsy(App.Live.Events.heard?(replied, "b2", "deploy", [acme]))
    # "none": no bot, however it is named.
    Assert.falsy(App.Live.Events.heard?(forbidden, "b1", "muse", [acme]))
    Assert.falsy(App.Live.Events.heard?(forbidden, "b2", "deploy", [acme]))

    # Where each of them is told to look, as its own API takes it: a channel
    # by its title, a group chat by its id, a private chat by who it is with.
    let between = App.Live.Events.Event {
      ...publicMessage, channel: "", first: "u1", second: "b1"
    }
    Assert.equal(App.Live.Events.accessFor(publicMessage), "all")
    Assert.equal(App.Live.Events.accessFor(mentioned), "mentions")
    Assert.equal(App.Live.Events.accessFor(forbidden), "none")
    Assert.equal(App.Live.Events.accessFor(between), "all")
    Assert.equal(App.Live.Events.placed(publicMessage, "b1"), "channels/general")
    Assert.equal(App.Live.Events.placed(privateMessage, "b1"), "groups/c2")
    Assert.equal(App.Live.Events.placed(between, "b1"), "dm/u1")
    Assert.equal(App.Live.Events.placed(between, "u1"), "dm/b1")
  end
end

describe("User, deciding from grants") do
  it("gives roles from grants, with teams carrying their roles to members") do
    with Harmat.Connection = fresh() do
      let ada = User { id: "u1", email: "ada@x", name: "Ada" }
      let bob = User { id: "u2", email: "bob@x", name: "Bob" }
      let carl = User { id: "u3", email: "carl@x", name: "Carl" }
      let bot = User { id: "b1", email: "b1@x", name: "muse", kind: User.Bot }

      let general = Conversation { id: "c1", kind: Channel, slug: "o1#general", title: "general", organizationId: "o1", access: Conversation.Public }
      let secret = Conversation { id: "c2", kind: Channel, slug: "o1#secret", title: "secret", organizationId: "o1", access: Conversation.Private }
      let dm = Conversation { id: "d1", kind: PrivateChat, slug: "o1@u1:u2", firstUser: "u1", secondUser: "u2", organizationId: "o1" }

      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "u1", resourceType: Grant.OrganizationResource, resourceId: "o1", role: Grant.Member }).try
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "u2", resourceType: Grant.OrganizationResource, resourceId: "o1", role: Grant.Admin }).try
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "u3", resourceType: Grant.OrganizationResource, resourceId: "o1", role: Grant.ReadOnly }).try
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "b1", resourceType: Grant.OrganizationResource, resourceId: "o1", role: Grant.Member }).try

      # A public channel: members, admins and read-only users read it; only
      # members and admins write.
      Assert.truthy(ada.canRead?(general))
      Assert.truthy(carl.canRead?(general))
      Assert.truthy(ada.canWrite?(general))
      Assert.falsy(carl.canWrite?(general))
      Assert.truthy(bob.canWrite?(general))

      # A private channel: nobody until granted — not even an org admin, who
      # may manage it but does not read it.
      Assert.falsy(ada.canRead?(secret))
      Assert.falsy(bob.canRead?(secret))
      Assert.truthy(bob.canAdminister?(secret))

      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "u1", resourceType: Grant.ConversationResource, resourceId: "c2", role: Grant.Member }).try
      Assert.truthy(ada.canRead?(secret))
      Assert.truthy(ada.canWrite?(secret))
      Assert.falsy(ada.canAdminister?(secret))

      # A team that owns the channel hands its members the channel.
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "u1", resourceType: Grant.TeamResource, resourceId: "t1", role: Grant.Member }).try
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.TeamSubject, subjectId: "t1", resourceType: Grant.ConversationResource, resourceId: "c2", role: Grant.Admin }).try
      Assert.truthy(ada.canAdminister?(secret))
      Assert.falsy(carl.canRead?(secret))

      # A private chat: the two of them, and nobody else.
      Assert.truthy(ada.canRead?(dm))
      Assert.truthy(bob.canWrite?(dm))
      Assert.falsy(carl.canRead?(dm))

      # Making channels and teams, and managing the organization.
      Assert.truthy(ada.canCreate?("o1"))
      Assert.falsy(carl.canCreate?("o1"))
      Assert.truthy(bob.canManage?("o1"))
      Assert.falsy(ada.canManage?("o1"))

      # Bots are users: a bot that is a member reads what a member reads.
      Assert.truthy(bot.canRead?(general))
      Assert.truthy(bot.canWrite?(general))

      # A server administrator can hold that role through a team, while a
      # lesser server grant must not add its holder to the admin roster.
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.TeamSubject, subjectId: "t1", resourceType: Grant.ServerResource, resourceId: "", role: Grant.Admin }).try
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "u2", resourceType: Grant.ServerResource, resourceId: "", role: Grant.Admin }).try
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "u3", resourceType: Grant.ServerResource, resourceId: "", role: Grant.Member }).try
      let serverAdmins = DB.Repositories.Grants.serverAdmins().try
      Assert.truthy(ada.serverAdmin?)
      Assert.truthy(serverAdmins.contains?("u1"))
      Assert.truthy(serverAdmins.contains?("u2"))
      Assert.falsy(serverAdmins.contains?("u3"))
      Assert.equal(serverAdmins.count, 2)
    end
  end

  it("seeds an explicit server administrator, including on an existing development database") do
    with Harmat.Connection = fresh() do
      DB.Seeds.planted(Development).try
      let isAdmin = DB.Repositories.Users.credentials("admin@example.com").try
        .map { |pair| match pair do (admin, _) => admin.serverAdmin? end }
        .or(false)
      Assert.truthy(isAdmin)

      # Seeding again is safe and retains the server-wide grant.
      DB.Seeds.planted(Development).try
      let isStillAdmin = DB.Repositories.Users.credentials("admin@example.com").try
        .map { |pair| match pair do (admin, _) => admin.serverAdmin? end }
        .or(false)
      Assert.truthy(isStillAdmin)
    end
  end

  it("lets a server administrator manage users in every organization") do
    with Harmat.Connection = fresh() do
      DB.Seeds.planted(Development).try
      let adminToken = App.Services.Authentication.signIn("admin@example.com", DB.Seeds.PASSWORD).try
      let admin : User = App.Services.Authentication.current(Just(adminToken)).try
      let adaToken = App.Services.Authentication.signIn("ada@example.com", DB.Seeds.PASSWORD).try
      let ada : User = App.Services.Authentication.current(Just(adaToken)).try
      let bobToken = App.Services.Authentication.signIn("bob@example.com", DB.Seeds.PASSWORD).try
      let bob : User = App.Services.Authentication.current(Just(bobToken)).try
      let other = ada.createOrganization("Other", "other").try
      let statuses = Process.spawn(Metro.Live.Presence.Presence {})

      Assert.truthy(admin.memberOf?(other.id))
      Assert.truthy(admin.canManage?(other.id))
      Assert.equal(admin.role(Grant.OrganizationResource, other.id), Just(Grant.Admin))
      Assert.equal(admin.home(other.id).map { |organization| organization.id }, Just(other.id))
      Assert.truthy(admin.organizations.any? { |organization| organization.id == other.id })
      Assert.truthy(App.Live.Chat.markup(statuses, admin, Tab { organization: other.id }).contains?("Manage people"))

      let (manager, _) = step(statuses, admin, Tab { organization: other.id }, [
        ("event", "dialog-open"), ("dialog", "people")
      ])
      Assert.equal(manager.dialog, App.Live.Tab.PeopleDialog)
      Assert.truthy(App.Live.Chat.markup(statuses, admin, manager).contains?("Manage people in Other"))

      let (_, invited) = step(statuses, admin, manager, [
        ("event", "invite-send"), ("email", "bob@example.com")
      ])
      Assert.truthy(invited)
      Assert.truthy(DB.Repositories.Memberships.member?(other.id, bob.id))

      let (_, changedRole) = step(statuses, admin, Tab { organization: other.id }, [
        ("event", "role-set"), ("user", bob.id), ("role", "read_only")
      ])
      Assert.truthy(changedRole)
      Assert.equal(other.roleOf(bob.id), Just(Grant.ReadOnly))

      let (_, removed) = step(statuses, admin, Tab { organization: other.id }, [
        ("event", "member-remove"), ("user", bob.id)
      ])
      Assert.truthy(removed)
      Assert.falsy(DB.Repositories.Memberships.member?(other.id, bob.id))

      # Server-wide rights remain in force even when the last explicit
      # organization administrator is demoted or removed.
      let (_, demotedLastOrgAdmin) = step(statuses, admin, Tab { organization: other.id }, [
        ("event", "role-set"), ("user", ada.id), ("role", "member")
      ])
      Assert.truthy(demotedLastOrgAdmin)
      Assert.equal(other.roleOf(ada.id), Just(Grant.Member))
      Assert.truthy(admin.canManage?(other.id))

      let (_, removedLastOrgAdmin) = step(statuses, admin, Tab { organization: other.id }, [
        ("event", "member-remove"), ("user", ada.id)
      ])
      Assert.truthy(removedLastOrgAdmin)
      Assert.falsy(DB.Repositories.Memberships.member?(other.id, ada.id))
      Assert.truthy(admin.canManage?(other.id))
    end
  end
end

describe("Organization, roles an administrator gives") do
  it("promotes, demotes and removes members, but not the last administrator") do
    with Harmat.Connection = fresh() do
      let statuses = Process.spawn(Metro.Live.Presence.Presence {})
      let member = do |name, email|
        let token = App.Services.Authentication.register(name, email, "a long enough phrase").try
        let user : User = App.Services.Authentication.current(Just(token)).try
        user
      end
      let ada = member("Ada", "ada@example.com")
      let bob = member("Bob", "bob@example.com")
      let eve = member("Eve", "eve@example.com")
      let (acme, _) = step(statuses, ada, Tab {}, [("event", "organization-create"), ("name", "Acme")])
      step(statuses, ada, Tab {}, [("event", "invite-send"), ("email", "bob@example.com")])
      step(statuses, ada, Tab {}, [("event", "invite-send"), ("email", "eve@example.com")])

      Assert.truthy(ada.canManage?(acme.organization))
      Assert.falsy(bob.canManage?(acme.organization))

      # A member cannot change roles; an administrator can.
      let (_, bobTries) = step(statuses, bob, Tab {}, [("event", "role-set"), ("user", eve.id), ("role", "admin")])
      Assert.falsy(bobTries)
      Assert.falsy(eve.canManage?(acme.organization))

      let (_, promoted) = step(statuses, ada, Tab {}, [("event", "role-set"), ("user", eve.id), ("role", "admin")])
      Assert.truthy(promoted)
      Assert.truthy(eve.canManage?(acme.organization))

      # Read-only: still in the organization, but cannot write.
      let (_, muted) = step(statuses, ada, Tab {}, [("event", "role-set"), ("user", bob.id), ("role", "read_only")])
      Assert.truthy(muted)
      Assert.truthy(bob.canRead?(Conversation { id: "c1", kind: Channel, slug: "o#g", title: "g", organizationId: acme.organization, access: Conversation.Public }))
      Assert.falsy(bob.canWrite?(Conversation { id: "c1", kind: Channel, slug: "o#g", title: "g", organizationId: acme.organization, access: Conversation.Public }))

      # The last administrator cannot be demoted or removed.
      let (_, demoted) = step(statuses, ada, Tab {}, [("event", "role-set"), ("user", eve.id), ("role", "member")])
      Assert.truthy(demoted)
      let admins = DB.Repositories.Organizations.find(acme.organization).try
        .map { |organization| organization.admins.count }
        .or(0)
      Assert.equal(admins, 1)

      let (_, selfDemote) = step(statuses, ada, Tab {}, [("event", "role-set"), ("user", ada.id), ("role", "member")])
      Assert.falsy(selfDemote)
      Assert.truthy(ada.canManage?(acme.organization))

      let (_, removedLast) = step(statuses, ada, Tab {}, [("event", "member-remove"), ("user", ada.id)])
      Assert.falsy(removedLast)
      Assert.truthy(ada.canManage?(acme.organization))
    end
  end
end

describe("User, what a channel lets its bots read") do
  it("gates a bot by the setting, and by whether it is named or in the thread") do
    with Harmat.Connection = fresh() do
      let bot = User { id: "b1", email: "b1@x", name: "muse", kind: User.Bot }
      let channel = Conversation { id: "c1", kind: Channel, slug: "o#g", title: "g", organizationId: "o1", access: Conversation.Public, botAccess: Conversation.Mentions }
      DB.Repositories.Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: "b1", resourceType: Grant.OrganizationResource, resourceId: "o1", role: Grant.Member }).try

      let asked = DB.Repositories.Messages.create("c1", "u1", "a question", "").try
      let named = DB.Repositories.Messages.create("c1", "u1", "hey @muse, help", "").try
      DB.Repositories.Messages.create("c1", "b1", "I am on it", asked.id).try

      # "mentions": the newest messages are not listed, a thread it is named
      # in is read, and a thread it has replied in is read.
      Assert.falsy(bot.botMayRead?(channel, ""))
      Assert.truthy(bot.botMayRead?(channel, named.id))
      Assert.truthy(bot.botMayRead?(channel, asked.id))

      # "all": everything.
      DB.Repositories.Conversations.setBotAccess("c1", Conversation.AllBots).try
      Assert.truthy(bot.botMayRead?(Conversation { ...channel, botAccess: Conversation.AllBots }, ""))

      # "none": nothing.
      let none = Conversation { ...channel, botAccess: Conversation.NoBots }
      Assert.falsy(bot.botMayRead?(none, named.id))
    end
  end
end
