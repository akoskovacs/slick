---
params: [bubble: Bubble, chips: String, offers: String, attached: String]
---
<article class="message<% if bubble.own? %> own<% end %><% if bubble.continued? %> continued<% end %>" id="<%= bubble.anchor %>">
<% if bubble.continued? %>
  <time class="gutter"><%= bubble.stamp %></time>
<% else %>
  <button type="button" class="avatar tint-<%= bubble.tint %>" data-event="profile" data-user="<%= bubble.writer %>" tabindex="-1" aria-hidden="true"><%= bubble.initial %></button>
<% end %>
  <div class="said">
  <% if !bubble.continued? %>
    <p class="byline"><button type="button" class="author" data-event="profile" data-user="<%= bubble.writer %>"><strong><%= bubble.author %></strong></button>
    <% if !bubble.emblem.empty? %>
      <span class="emblem" title="<%= bubble.emblemNote %>"><%= bubble.emblem %></span>
    <% end %>
    <% if !bubble.badged.empty? %>
      <span class="flag"><%= bubble.badged %></span>
    <% end %>
    <time><%= bubble.stamp %></time></p>
  <% end %>
  <div class="body"><%== bubble.content %></div>
  <% if !attached.empty? %>
    <div class="attachments"><%== attached %></div>
  <% end %>
  <div class="reactions"><%== chips %></div>
  <% if !bubble.answers.empty? %>
    <button type="button" class="answers" data-event="thread" data-message="<%= bubble.key %>"><%= bubble.answers %></button>
  <% end %>
  </div>
  <div class="offers"><%== offers %>
    <% if bubble.threadable? %>
      <button type="button" class="chip" data-event="thread" data-message="<%= bubble.key %>" title="Reply in thread">💬</button>
    <% end %>
  </div>
</article>
