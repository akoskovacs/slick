---
params: [heading: String, lead: String, verb: String, spot: String, teams: String, problem: String, label: String, closed?: Bool]
---
<div class="backdrop">
  <section class="editor" id="editor" role="dialog" aria-modal="true" aria-label="<%= heading %>">
    <h2><%= heading %></h2>
    <p class="hint"><%= lead %></p>
    <form class="asking details-form" data-live="<%= verb %>" data-live-quiet>
      <label class="detail">
        <span>Name</span>
        <input name="title" placeholder="new-channel" maxlength="30" autocomplete="off">
      </label>
      <fieldset class="access">
        <legend>Who can read it</legend>
        <label class="choice">
          <input type="radio" name="access" value="public"<% if !closed? %> checked<% end %>>
          Everyone in <%= spot %>
        </label>
        <label class="choice">
          <input type="radio" name="access" value="private"<% if closed? %> checked<% end %>>
          🔒 Only the people in it
        </label>
      </fieldset>
      <% if !teams.empty? %>
        <label class="detail">
          <span>Team</span>
          <select name="team">
            <option value="">No team</option>
            <%== teams %>
          </select>
          <span class="hint">A team's members can always read its private channels.</span>
        </label>
      <% end %>
      <% if !problem.empty? %>
        <p class="problem" role="alert"><%= problem %></p>
      <% end %>
      <div class="actions">
        <button type="submit" class="primary"><%= label %></button>
        <button type="button" class="quiet" data-event="cancel">Cancel</button>
      </div>
    </form>
  </section>
</div>
