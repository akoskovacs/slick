# The `team_members` table: who is in which team. See
# db/migrate/N0020_create_teams.kex.
module DB.Schema.TeamMembers

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :team_members, doc: "Who is in which team" do |t|
  t.text(:id, primaryKey: true)
  t.belongsTo(:team, :teams)
  t.belongsTo(:user, :users)
  t.text(:joined_at)
end

let table = DB.Schema.TeamMembers.definition.table

let id = DB.Schema.TeamMembers.definition.textColumn(:id)
let teamId = DB.Schema.TeamMembers.definition.textColumn(:team_id)
let userId = DB.Schema.TeamMembers.definition.textColumn(:user_id)
