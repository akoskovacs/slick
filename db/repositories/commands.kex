# The slash commands bots answer to.
#
#   DB.Repositories.Commands.declared(bot.id, commands)
module DB.Repositories.Commands

using Harmat.Database, as: Database
using App.Models.Command, only: [Command]

# Replaces a bot's commands with these, all at once.
foul declared(botId: String, commands: [Command]) -> Result<Integer, String> do
  let replaced : Result<Integer, String> = Database.transaction do
    Database.delete(DB.Schema.Commands)
      .by({bot_id: botId})
      .run
      .try
    let rows = commands.map { |command|
      {
        id: "${botId}:${command.name}",
        bot_id: botId,
        name: command.name,
        description: command.description
      }
    }
    Database.insertAll(DB.Schema.Commands, rows)
  end
  return replaced
end

# The commands of some bots, by name.
foul of(botIds: [String]) -> Result<[Command], String> do
  return Database.select().from(DB.Schema.Commands)
    .where(DB.Schema.Commands.botId.in(botIds))
    .orderBy([:name, :bot_id])
    .into(Command { botId: "", name: "" })
end
