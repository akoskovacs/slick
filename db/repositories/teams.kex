# Teams, and who is in them.
#
#   DB.Repositories.Teams.ofOrganization(organization.id)
#
# A team a sync has (`managed?`) keeps its name and members as the sync
# says: the conditions here leave it alone, whoever asks.
module DB.Repositories.Teams

using Harmat.Database, as: Database
using App.Models.Team, only: [Team]

# Creates a team, with its first members. Fails when the organization has a
# team of that handle: the unique index decides.
foul formed(team: Team, by: String) -> Result<Team, String> do
  let made = Team { ...team, id: Metro.Id.generate(prefix: "t") }
  let stored : Result<Team, String> = Database.transaction do
    Database.insert(DB.Schema.Teams)
      .valuesOf(made, extra: {created_by: by, created_at: "${DateTime.utcNow()}"})
      .run
      .try
    joinedAll(made.id, made.members).try
    Ok(made)
  end
  return stored
end

# Every team of an organization, by handle, each with its members.
foul ofOrganization(organizationId: String) -> Result<[Team], String> do
  let teams : [Team] = Database.select().from(DB.Schema.Teams)
    .by({organization_id: organizationId})
    .orderBy([:handle])
    .into(BLANK)
    .try
  return membered(teams)
end

# One team, with its members, or `None`.
foul single(id: String) -> Result<Team?, String> do
  let found : Team? = Database.find(DB.Schema.Teams, id, into: BLANK).try
  let teams : [Team] = membered(found.map { |team| [team] }.or([])).try
  return Ok(teams.first)
end

# The teams a person is in, by id.
foul joinedBy(userId: String) -> Result<[String], String> do
  return Database.select().from(DB.Schema.TeamMembers)
    .by({user_id: userId})
    .pluck(:team_id)
end

# Renames a team and says again what it is for; whether there was such a
# team that is not a sync's.
foul revised(id: String, name: String, description: String) -> Result<Bool, String> do
  return Database.within(DB.Schema.Teams.managed != "yes")
    .update(DB.Schema.Teams)
    .set({name: name, description: description})
    .by({id: id})
    .run
    .map { |changed| changed > 0 }
end

# Puts people in a team, leaving out whoever is in it already.
foul joinedAll(teamId: String, userIds: [String]) -> Result<Integer, String> do
  let present : [String] = members(teamId).try
  let newcomers = userIds.uniq.reject { |userId| present.contains?(userId) }
  let rows = newcomers.map { |userId|
    {
      id: "${teamId}:${userId}",
      team_id: teamId,
      user_id: userId,
      joined_at: "${DateTime.utcNow()}"
    }
  }
  return Database.insertAll(DB.Schema.TeamMembers, rows)
end

# Takes a person out of a team.
foul left(teamId: String, userId: String) -> Result<Integer, String> do
  return Database.delete(DB.Schema.TeamMembers)
    .by({id: "${teamId}:${userId}"})
    .run
end

# Hands a team to a sync, as the group of this id — or, with "", takes it
# back: from then on it is changed here again.
foul managing(id: String, externalId: String) -> Result<Integer, String> do
  return Database.update(DB.Schema.Teams)
    .set({external_id: externalId, managed: externalId.empty? then "" else "yes"})
    .by({id: id})
    .run
end

# The ids of the people in a team.
foul members(teamId: String) -> Result<[String], String> do
  return Database.select().from(DB.Schema.TeamMembers)
    .by({team_id: teamId})
    .orderBy([:joined_at, :id])
    .pluck(:user_id)
end

# The ids of the people in any of some teams, by team.
foul rosters(teamIds: [String]) -> Result<{String: [String]}, String> do
  let byTeam : {String: [{String: String}]} = Database.belongingTo(
    DB.Schema.TeamMembers,
    DB.Schema.Teams,
    teamIds,
    orderBy: [:joined_at, :id]
  ).try
  return Ok(byTeam.mapValues { |rows| rows.map { |row| row.get("user_id").or("") } })
end

private do
  # Teams with their members filled in.
  foul membered(teams: [Team]) -> Result<[Team], String> do
    let byTeam : {String: [String]} = rosters(teams.map { |team| team.id }).try
    return Ok(teams.map { |team| Team { ...team, members: byTeam.get(team.id).or([]) } })
  end

  # What each row is read into.
  let BLANK = Team { id: "" }
end
