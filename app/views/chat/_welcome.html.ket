---
params: [who: String, email: String, problem: String, bar: String]
---
<%== bar %>
<div class="welcome" data-live-path="/" data-live-title="Slick">
  <section class="editor">
    <h1>Welcome, <%= who %></h1>
    <p>You are not in an organization yet. Create one, or ask somebody in one to add <strong><%= email %></strong>: this page will change when they do.</p>
    <form class="asking" data-live="charter" data-live-quiet>
      <input id="organization-box" name="name" placeholder="Acme" maxlength="40" autocomplete="off" autofocus>
<% if !problem.empty? %>
      <p class="problem" role="alert"><%= problem %></p>
<% end %>
      <div class="actions"><button type="submit" class="primary">Create organization</button></div>
    </form>
  </section>
</div>
