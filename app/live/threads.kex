# Threads: the replies to a message, opened beside the conversation.
module App.Live.Threads

using Metro.Live.Socket, only: [unchanged]
using App.Live.Outcome, only: [Outcome]
using App.Live.Event, only: [Event]
using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Message, only: [Message, MessageId]
using App.Models.Ids, only: [UserId]
using App.Models.Team, only: [TeamId]
using App.Models.User, only: [User]
using DB.Repositories.Messages, as: Messages

# The message that starts the thread this message is in — itself, when it
# is not a reply — if it belongs to this conversation.
root : Conversation -> MessageId -> Message?
foul root(conversation, id) do
  return None if id.empty?

  match Messages.find(id) do
    Ok(Just(message)) => do
      return None if message.conversationId != conversation.id
      return Just(message) if message.parentId.empty?
      return root(conversation, message.parentId)
    end
    _ => return None
  end
end

# An open thread: the message that started it, then its replies. Empty
# when no thread is open, or the one asked for is not in this conversation.
messages : Conversation -> MessageId -> [Message]
foul messages(conversation, id) do
  match root(conversation, id) do
    None => return []
    Just(first) => do
      let replies : [Message] = Messages.replies(first.id).or([])
      return [first] + replies
    end
  end
end

# The id of the message a thread starts with; "" for no thread.
firstId : [Message] -> MessageId
let firstId(thread) = thread.first.map { |first| first.id }.or("")

# Opens the thread a message is in beside the conversation, in place of a
# profile or a team.
open : User -> Tab -> MessageId -> Outcome
foul open(user, tab, id) do
  match user.visible(tab.organization, tab.conversation) do
    None => return unchanged(tab)
    Just(conversation) => match root(conversation, id) do
      Just(first) => return unchanged(Tab { ...tab.closed, thread: first.id, profile: "".as(UserId), team: "".as(TeamId) })
      None => return unchanged(tab)
    end
  end
end

# What this part answers, of the events config/live.kex routes to it, by
# their whole names; any other does nothing.
on : String -> Event -> Outcome
foul on("thread-open", event) = open(event.user, event.tab, event.given("message").as(MessageId))
foul on("thread-close", event) = unchanged(Tab { organization: event.tab.organization, conversation: event.tab.conversation })
foul on(_, event) = unchanged(event.tab)
