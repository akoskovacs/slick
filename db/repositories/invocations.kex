# Slash commands somebody used.
#
#   DB.Repositories.Invocations.inConversation(conversation.id)
module DB.Repositories.Invocations

using Harmat.Database, as: Database
using App.Models.Invocation, only: [Invocation]
using App.Models.Conversation, only: [ConversationId]
using App.Models.Organization, only: [OrganizationId]
using App.Models.Ids, only: [UserId]

# Keeps one, as it is.
foul save(invocation: Invocation) -> Integer or! String do
  return Database.insert(DB.Schema.Invocations.definition)
    .record(invocation)
    .run
end

# Every one used in a conversation, its threads included, oldest first.
foul inConversation(conversationId: ConversationId) -> [Invocation] or! String do
  return Database.select().from(DB.Schema.Invocations.definition)
    .where(DB.Schema.Invocations.conversationId == conversationId.as(String))
    .orderBy([:invoked_at, :id])
    .all(as: Invocation)
end

# Those meant for a bot in an organization after `after`, oldest first:
# what the bot is told.
foul forBot(organizationId: OrganizationId, botId: UserId, after: Integer) -> [Invocation] or! String do
  return Database.select().from(DB.Schema.Invocations.definition)
    .where(DB.Schema.Invocations.organizationId == organizationId.as(String))
    .where(DB.Schema.Invocations.botId == botId.as(String))
    .where(DB.Schema.Invocations.invokedAt > after)
    .orderBy([:invoked_at, :id])
    .all(as: Invocation)
end
