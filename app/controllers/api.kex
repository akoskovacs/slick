# The API bots use. Every request carries `Authorization: Bearer <token>`;
# the `bearer` plug (App.Controllers.Application) has found the bot before
# any of these run.
#
#   GET  /api/me
#   GET  /api/:organization/channels
#   GET  /api/:organization/channels/:name/messages?limit=50&after=<sentAt>
#   POST /api/:organization/channels/:name/messages    {"body": "…", "thread": "<message id>"}
#                                                      or {"blocks": […]} in place of "body"
#   POST /api/:organization/channels/:name/reactions   {"message": "<id>", "emoji": "🎉"}
#   POST /api/:organization/channels/:name/status      {"text": "Deploying", "seconds": 30}
#   GET  /api/:organization/dm/:person/messages
#   POST /api/:organization/dm/:person/messages
#
# A message is rich text (app/helpers/rich_text.kex). It can be sent as the
# text a person would type — "*done* in `4s`" — or as blocks:
#
#   {"blocks": [
#     {"type": "heading", "text": "Deploy finished"},
#     {"type": "section", "text": "*api* is on `v1.4`"},
#     {"type": "list", "items": ["migrated", "restarted"]},
#     {"type": "quote", "text": "…"}, {"type": "code", "text": "…"}, {"type": "divider"}
#   ]}
#
# and every message read back carries both: "body" and "blocks".
#
# A status is what the bot is in the middle of — "Thinking", "Deploying" —
# shown under the conversation the way "is typing" is for a person. It
# stands for `seconds` (30 unless said, 300 at most), or until the bot says
# something there, or until it sends an empty "text".
#
# A bot is a member like any other, and what it does goes through the same
# two functions a browser tab's events do (`App.Live.Chat.arrived` and
# `handled`), so it can read and write exactly what a person in its place
# could, and tabs that are open see what it writes at once.
module App.Controllers.Api

using Metro.WebRequest, only: [WebRequest]
using App.Controllers.Application, only: [hubFor, statusesFor, userFor]
using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Message, only: [Message]
using App.Models.Organization, only: [Organization]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Messages, as: Messages
using DB.Repositories.Users, as: Users

# The most messages one request is given.
let MOST = 200

# The longest a status stands without being said again, the longest it may
# be asked to, and the longest it may be.
let STATUS_SECONDS = 30
let STATUS_MOST = 300
let STATUS_LONGEST = 80

whoami : WebRequest -> WebRequest
foul whoami(request) do
  let bot = userFor(request)
  let mine : [Organization] = App.Live.Chat.organizations(bot)
  let listed : [Any] = mine.map { |each| {"slug": each.slug, "name": each.name} }
  let answer : {String: Any} = {"id": bot.id, "name": bot.name, "bot": true, "organizations": listed}
  return request.json(answer)
end

channelList : WebRequest -> WebRequest
foul channelList(request) do
  let slug = request.param("organization").or("")
  let tab = App.Live.Chat.arrived(userFor(request), App.Paths.channelPath.filled({"organization": slug, "name": "general"}))
  return failed(request, 404, "There is no such organization, or this bot is not in it.") if tab.organization.empty?

  let found : [Conversation] = Conversations.channels(tab.organization).or([])
  let listed : [Any] = found.map { |channel| {"id": channel.id, "name": channel.title, "topic": channel.topic} }
  return request.json(listed)
end

# The newest messages of a conversation — a channel, or the private chat
# with a person — oldest first.
history : WebRequest -> WebRequest
foul history(request) do
  match placed(request, "") do
    Error(reply) => return reply
    Ok((tab, conversation)) => do
      let asked = request.query("limit").or("50").to(Integer).or(50)
      let limit = asked < 1 || asked > MOST then MOST else asked
      let since = request.query("after").or("0").to(Integer).or(0)
      let people : [User] = Users.everyone.or([])
      let found : [Message] = Messages.latest(conversation.id, limit).or([])
      let listed : [Any] = found.filter { |message| message.sentAt > since }.map { |message| described(message, people) }
      return request.json(listed)
    end
  end
end

# Says something, in the conversation or — with `thread` — in a thread.
posted : WebRequest -> WebRequest
foul posted(request) do
  let thread = request.field("thread").or("").trim
  let typed = request.field("body").or("").trim
  let body = typed.empty? then App.Helpers.RichText.composed(request.list("blocks")) else typed
  match placed(request, thread) do
    Error(reply) => return reply
    Ok((tab, conversation)) => do
      let event = thread.empty? then "send" else "reply"
      let (_, changed) = App.Live.Chat.handled(statusesFor(request), userFor(request), tab, [("event", Just(event)), ("body", Just(body))])
      return failed(request, 422, "Not sent: a message needs a body of at most ${App.Models.Message.LONGEST} characters, and a thread has to be a message of this conversation.") if !changed

      hubFor(request).changed("api", "everyone")
      let people : [User] = Users.everyone.or([])
      let inChannel : [Message] = Messages.latest(conversation.id, 1).or([])
      let inThread : [Message] = Messages.answering(tab.thread).or([])
      let newest = thread.empty? then inChannel else inThread.reverse.take(1)
      let answer : {String: Any} = newest.first.map { |message| described(message, people) }.or({})
      return request.json(201, answer)
    end
  end
end

# Puts an emoji on a message, or takes the bot's own one off again.
reacting : WebRequest -> WebRequest
foul reacting(request) do
  match placed(request, "") do
    Error(reply) => return reply
    Ok((tab, conversation)) => do
      let fields = [("event", Just("react")), ("message", request.field("message")), ("emoji", request.field("emoji"))]
      let (_, changed) = App.Live.Chat.handled(statusesFor(request), userFor(request), tab, fields)
      return failed(request, 422, "Not done: the message has to be one of this conversation, and the emoji one of the reactions Slick offers.") if !changed

      hubFor(request).changed("api", "everyone")
      return request.json({"ok": true})
    end
  end
end

# Says what the bot is doing in a conversation, or takes it back.
statusSet : WebRequest -> WebRequest
foul statusSet(request) do
  match placed(request, "") do
    Error(reply) => return reply
    Ok((tab, conversation)) => do
      let text = request.field("text").or("").trim.replace("\n", " ").take(STATUS_LONGEST)
      let asked = request.field("seconds").or("").to(Integer).or(STATUS_SECONDS)
      let seconds = asked < 1 || asked > STATUS_MOST then STATUS_SECONDS else asked
      App.Live.Chat.noting(statusesFor(request), userFor(request), tab, text, text.empty? then 0 else seconds * 1000)
      hubFor(request).changed("api", "everyone")
      let answer : {String: Any} = {"ok": true, "text": text, "seconds": text.empty? then 0 else seconds}
      return request.json(answer)
    end
  end
end

private do
  failed : WebRequest -> Integer -> String -> WebRequest
  let failed(request, status, reason) = request.json(status, {"error": reason})

  # The conversation the address names, and a tab showing it — if the bot
  # may read it. A route with `:person` is the private chat with them; one
  # with `:name` is a channel.
  placed : WebRequest -> String -> Result<(Tab, Conversation), WebRequest>
  foul placed(request, thread) do
    let bot = userFor(request)
    let slug = request.param("organization").or("")
    let channel = App.Paths.channelPath.filled({"organization": slug, "name": request.param("name").or("")})
    let direct = App.Paths.directPath.filled({"organization": slug, "person": request.param("person").or("")})
    let tab = App.Live.Chat.arrived(bot, App.Paths.threaded(request.param("person").set? then direct else channel, thread))
    return Error(failed(request, 404, "There is no such conversation, or this bot is not in it.")) if tab.conversation.empty?

    match App.Live.Chat.visible(bot, tab) do
      Just(conversation) => return Ok((tab, conversation))
      None => return Error(failed(request, 404, "There is no such conversation, or this bot is not in it."))
    end
  end

  described : Message -> [User] -> {String: Any}
  let described(message, people) do
    let author = people.find { |person| person.id == message.userId }
    {
      "id": message.id, "user": message.userId, "author": author.map { |person| person.shown }.or("Someone"),
      "bot": author.map { |person| person.bot? }.or(false), "body": message.body, "blocks": App.Helpers.RichText.described(message.body), "sentAt": message.sentAt,
      "sentOn": message.sentOn, "thread": message.parentId, "replies": message.replyCount
    }
  end
end
