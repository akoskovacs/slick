# Who is in which organization.
#
#   DB.Repositories.Memberships.affiliated?(organization.id, user.id)
module DB.Repositories.Memberships

using Harmat.Database, as: Database

# Puts a person in an organization. Fails when they are already in it: the
# row's id is the pair.
foul enlisted(organizationId: String, userId: String) -> Result<Integer, String> do
  let row = {
    id: "${organizationId}:${userId}",
    organization_id: organizationId,
    user_id: userId,
    joined_at: "${DateTime.utcNow()}"
  }
  return Database.insert(DB.Schema.Memberships)
    .values(row)
    .run
end

# Whether a person is in an organization.
foul affiliated?(organizationId: String, userId: String) -> Bool do
  let membership = Database.select([:id]).from(DB.Schema.Memberships)
    .where(DB.Schema.Memberships.id.eq("${organizationId}:${userId}"))
    .first
  match membership do
    Ok(Just(_)) => return true
    _ => return false
  end
end

# When a person joined an organization, in milliseconds since 1970; 0 if
# they are not in it.
foul joined(organizationId: String, userId: String) -> Integer do
  let found = Database.select([:joined_at]).from(DB.Schema.Memberships)
    .where(DB.Schema.Memberships.id.eq("${organizationId}:${userId}"))
    .first
  match found do
    Ok(Just(row)) => return DateTime.parse(row.get("joined_at").or(""))
      .map { |moment| moment.epochSeconds * 1000 }
      .or(0)
    _ => return 0
  end
end

# The ids of the organizations a person is in, oldest membership first.
foul affiliations(userId: String) -> Result<[String], String> do
  return Database.select([:organization_id]).from(DB.Schema.Memberships)
    .where(DB.Schema.Memberships.userId.eq(userId))
    .orderBy([:joined_at, :id])
    .all
    .map { |rows| rows.map { |row| row.get("organization_id").or("") } }
end

# The ids of the people in an organization.
foul roster(organizationId: String) -> Result<[String], String> do
  return Database.select([:user_id]).from(DB.Schema.Memberships)
    .where(DB.Schema.Memberships.organizationId.eq(organizationId))
    .all
    .map { |rows| rows.map { |row| row.get("user_id").or("") } }
end
