# The `answers` table: answers to the forms in messages. See
# db/migrate/N0012_create_answers.kex.
module DB.Schema.Answers

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :answers, doc: "Answers to the forms in messages: one per person and form" do |t|
  t.text(:id, primaryKey: true)
  t.belongsTo(:message, :messages)
  t.belongsTo(:conversation, :conversations)
  t.belongsTo(:organization, :organizations)
  t.belongsTo(:asker, :users, doc: "The bot or person whose message asked")
  t.belongsTo(:user, :users)
  t.int(:form)
  t.text(:answer)
  t.bigint(:answered_at)
end

let table = DB.Schema.Answers.definition.table

let id = DB.Schema.Answers.definition.textColumn(:id)
let messageId = DB.Schema.Answers.definition.textColumn(:message_id)
let conversationId = DB.Schema.Answers.definition.textColumn(:conversation_id)
let organizationId = DB.Schema.Answers.definition.textColumn(:organization_id)
let askerId = DB.Schema.Answers.definition.textColumn(:asker_id)
let userId = DB.Schema.Answers.definition.textColumn(:user_id)
