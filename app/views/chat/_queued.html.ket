---
params: [file: Enclosure]
---
<span class="queued">
  <% if file.picture? %>
    <img src="<%= file.link %>" alt="">
  <% else %>
    <span aria-hidden="true">📄</span>
  <% end %>
  <span class="about"><strong><%= file.caption %></strong><span><%= file.weight %></span></span>
  <button type="button" class="quiet" title="Remove <%= file.caption %>"
    data-event="file-detach" data-file="<%= file.key %>">✕</button>
</span>
