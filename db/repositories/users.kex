# The people who can sign in.
#
#   DB.Repositories.Users.credentials(email)
module DB.Repositories.Users

using Harmat.Database, as: Database
using App.Models.User, only: [User, Bot]

# Stores a new user. Fails when the email is taken: the table's unique
# index decides, so two registrations racing for one address cannot both win.
foul enroll(user: User, passwordHash: String) -> Result<User, String> do
  let row = {
    id: user.id,
    email: user.email,
    name: user.name,
    password_hash: passwordHash,
    created_at: "${DateTime.utcNow()}"
  }
  return Database.insert(DB.Schema.Users)
    .values(row)
    .run
    .map { |_| user }
end

# The user registered under an email, with their stored password line.
foul credentials(email: String) -> Result<(User, String)?, String> do
  return Database.findBy(DB.Schema.Users, {email: email})
    .map { |row| row.map { |found| (decoded(found), found.get("password_hash").or("")) } }
end

# Stores a bot. It has no password: `tokenDigest` is how it is known.
foul automated(bot: User, tokenDigest: String) -> Result<User, String> do
  let row = {
    id: bot.id,
    email: bot.email,
    name: bot.name,
    password_hash: "",
    created_at: "${DateTime.utcNow()}",
    kind: Bot,
    owner_id: bot.ownerId,
    owner_organization_id: bot.ownerOrganizationId,
    api_token_digest: tokenDigest
  }
  return Database.insert(DB.Schema.Users)
    .values(row)
    .run
    .map { |_| bot }
end

# A person's bots, by name.
foul operated(owner: String) -> Result<[User], String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .by({owner_id: owner})
    .orderBy([:name, :id])
    .into(BLANK)
end

# An organization's bots, by name.
foul maintained(organizationId: String) -> Result<[User], String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .by({owner_organization_id: organizationId})
    .orderBy([:name, :id])
    .into(BLANK)
end

# Replaces the token of an organization's bot; whether it was that
# organization's to change.
foul rekeyedFor(botId: String, organizationId: String, tokenDigest: String) -> Result<Bool, String> do
  return Database.within(DB.Schema.Users.ownerOrganizationId == organizationId)
    .update(DB.Schema.Users)
    .set({api_token_digest: tokenDigest})
    .by({id: botId})
    .run
    .map { |changed| changed > 0 }
end

# The bot an API token's digest belongs to, or `None`.
foul bearing(tokenDigest: String) -> Result<User?, String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .by({api_token_digest: tokenDigest, kind: Bot})
    .firstInto(BLANK)
end

# Replaces a bot's token; whether it was this owner's bot to change.
foul rekeyed(botId: String, owner: String, tokenDigest: String) -> Result<Bool, String> do
  return Database.within(DB.Schema.Users.ownerId == owner)
    .update(DB.Schema.Users)
    .set({api_token_digest: tokenDigest})
    .by({id: botId})
    .run
    .map { |changed| changed > 0 }
end

# Sets what somebody says about themselves; "" and "" takes it back.
foul restyled(id: String, emoji: String, saying: String) -> Result<Integer, String> do
  return Database.update(DB.Schema.Users)
    .set({status_emoji: emoji, status_text: saying})
    .by({id: id})
    .run
end

# Sets the details a profile shows, each as it is on `user`. Whatever a sync
# has taken over is for the caller to have kept: `App.Live.Chat` does.
foul described(user: User) -> Result<Integer, String> do
  let row = {
    name: user.name,
    title: user.title,
    department: user.department,
    phone: user.phone,
    time_zone: user.timeZone,
    bio: user.bio,
    nickname: user.nickname,
    show_nickname: user.showNickname? then "yes" else ""
  }
  return Database.update(DB.Schema.Users)
    .set(row)
    .by({id: user.id})
    .run
end

# Hands details over to a sync, by column, or back with `[]`: what it has
# taken over cannot be changed from a profile.
foul managing(id: String, columns: [String]) -> Result<Integer, String> do
  return Database.update(DB.Schema.Users)
    .set({managed: columns.join(",")})
    .by({id: id})
    .run
end

foul member(id: String) -> Result<User?, String> do
  return Database.select().from(DB.Schema.Users)
    .by({id: id})
    .firstInto(BLANK)
end

# Everyone, by name: who can be written to, and whose name goes on a message.
foul everyone -> Result<[User], String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .orderBy([:name, :email])
    .into(BLANK)
end

private do
  # What is read of a user when nobody is signing in: everything but the
  # password line and the token digest.
  let SHOWN = [
    :id,
    :email,
    :name,
    :kind,
    :owner_id,
    :owner_organization_id,
    :status_emoji,
    :status_text,
    :title,
    :department,
    :phone,
    :time_zone,
    :bio,
    :nickname,
    :show_nickname,
    :managed
  ]

  # What each row is read into.
  let BLANK = User { id: "", email: "" }

  decoded : {String: String} -> User
  let decoded(row) = Harmat.Database.decoded(row, BLANK, {})
end
