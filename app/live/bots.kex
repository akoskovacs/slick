# What the bots dialog does: making, re-keying, adding and removing bots,
# choosing who operates one, and how much of a conversation bots may read.
# A bot's new token is kept in the tab, to be shown until the dialog is
# closed, and nowhere else.
module App.Live.Bots

using App.Models.Conversation, only: [Conversation]
using App.Models.Conversation, as: Conversation
using Metro.Validation, only: [rules, validates, present, sized]
using Metro.Live.Socket, only: [unchanged, changed]
using App.Live.Outcome, only: [Outcome, refused, failed]
using App.Live.Event, only: [Event, given, typed, picked]
using App.Live.Tab, only: [Tab, closed]
using App.Models.Organization, only: [Organization, OrganizationId]
using App.Models.User, only: [User]
using App.Models.Ids, only: [UserId]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Memberships, as: Memberships
using DB.Repositories.Users, as: Users

let DIALOG = App.Live.Tab.BotsDialog

let botRules = rules do
  validates("name", "A bot's name", [present, sized(2, 40)])
end

# Makes a bot in the tab's organization: this person's own when `owner` is
# "me", and otherwise the organization's.
create : User -> Tab -> String -> String -> Outcome
foul create(user, tab, name, owner) do
  let problems = Metro.Validation.checked(botRules, {"name": name}).messages
  return refused(tab, DIALOG, problems.first.or("")) if !problems.empty?

  match user.home(tab.organization) do
    None => return unchanged(tab)
    Just(organization) => do
      if owner != "me" && !user.canManage?(organization.id)
        return refused(tab, DIALOG, "Only an administrator of ${organization.name} can make a bot for it.")
      end
      let ownerOrganization = owner == "me" then "" else organization.id
      match user.buildBot(ownerOrganization, name) do
        Error(reason) => return refused(tab, DIALOG, reason)
        Ok((bot, token)) => do
          Memberships.add(organization.id, bot.id)
          return changed(revealed(tab, bot.name, token))
        end
      end
    end
  end
end

# Gives a bot a new token; the old one stops working.
rotateToken : User -> Tab -> UserId -> Outcome
foul rotateToken(user, tab, id) do
  match user.home(tab.organization) do
    None => return unchanged(tab)
    Just(organization) => do
      return refused(tab, DIALOG, notManager(organization)) if !user.mayManageBot?(organization, id)

      match user.renewBotToken(organization.id, id) do
        Ok(token) => return unchanged(revealed(tab, user.managedBotName(organization, id), token))
        Error(reason) => return refused(tab, DIALOG, reason)
      end
    end
  end
end

# Puts one of this person's bots into the tab's organization.
add : User -> Tab -> UserId -> Outcome
foul add(user, tab, id) do
  return refused(tab, DIALOG, "That is not one of your bots.") if !user.ownsBot?(id)

  match user.home(tab.organization) do
    None => return unchanged(tab)
    Just(organization) => do
      Memberships.add(organization.id, id)
      return changed(opened(tab))
    end
  end
end

# Deletes a bot — this person's own, or the tab's organization's — and
# takes its access with it.
remove : User -> Tab -> UserId -> Outcome
foul remove(user, tab, id) do
  match user.home(tab.organization) do
    None => return unchanged(tab)
    Just(organization) => do
      return refused(tab, DIALOG, notManager(organization)) if !user.mayManageBot?(organization, id)

      let name = user.managedBotName(organization, id)
      match user.removeBot(organization.id, id) do
        Ok(true) => return changed(Tab { ...opened(tab), notice: "${name} was removed." })
        Ok(false) => return refused(tab, DIALOG, "That is not one of your bots, or of this organization's.")
        Error(reason) => return refused(tab, DIALOG, reason)
      end
    end
  end
end

# Chooses the people, of the tab's organization, who operate a bot.
setOperators : User -> Tab -> UserId -> [UserId] -> Outcome
foul setOperators(user, tab, botId, operators) do
  match user.home(tab.organization) do
    None => return unchanged(tab)
    Just(organization) => do
      if !user.manageableBots(organization).any? { |bot| bot.id == botId }
        return refused(tab, DIALOG, "Only the bot owner or a workspace administrator can change its operators.")
      end
      let roster : [UserId] = Memberships.roster(organization.id).or([])
      let people = Users.everyone
        .or([])
        .filter { |person| roster.contains?(person.id) && !person.bot? }
      if operators.any? { |id| !people.any? { |person| person.id == id } }
        return refused(tab, DIALOG, "Choose people in this workspace.")
      end

      match DB.Repositories.BotOperators.replace(botId, operators) do
        Ok(_) => return changed(Tab { ...opened(tab), notice: "Bot operators saved." })
        Error(reason) => return refused(tab, DIALOG, reason)
      end
    end
  end
end

# How much of a channel or group chat its bots may read. Only an
# administrator changes it.
setAccess : User -> Tab -> String -> Outcome
foul setAccess(user, tab, access) do
  let selected = Conversation.botAccessFrom(access)
  return unchanged(tab) if !selected.set?

  match user.visible(tab.organization, tab.conversation) do
    None => return unchanged(tab)
    Just(conversation) => do
      return unchanged(tab) if !conversation.channel? && !conversation.group?
      if !user.canAdminister?(conversation)
        return failed(tab, "Only an administrator can change what bots read here.")
      end

      match Conversations.setBotAccess(conversation.id, selected.or(Conversation.Mentions)) do
        Ok(true) => return changed(Tab { ...closed(tab), notice: "Bots here read ${access}." })
        Ok(false) => return failed(tab, "That conversation is not there.")
        Error(reason) => return failed(tab, reason)
      end
    end
  end
end

# What this part answers, of the events config/live.kex routes to it, by
# their whole names; any other does nothing.
on : String -> Event -> Outcome
foul on("bot-create", event) = create(event.user, event.tab, typed(event, "name"), given(event, "owner"))
foul on("bot-rotate", event) = rotateToken(event.user, event.tab, given(event, "id"))
foul on("bot-add", event) = add(event.user, event.tab, given(event, "id"))
foul on("bot-remove", event) = remove(event.user, event.tab, given(event, "id"))
foul on("bot-operators-set", event) = setOperators(event.user, event.tab, given(event, "bot"), picked(event, "operator"))
foul on("bot-access-set", event) = setAccess(event.user, event.tab, given(event, "access"))
foul on(_, event) = unchanged(event.tab)

private do
  notManager : Organization -> String
  let notManager(organization) = "Only an administrator of ${organization.name} can manage its bots."

  # The tab with the bots dialog open, and nothing else over it.
  opened : Tab -> Tab
  let opened(tab) = Tab { ...closed(tab), dialog: DIALOG }

  # The dialog, showing a bot's new token until it is closed.
  revealed : Tab -> String -> String -> Tab
  let revealed(tab, name, token) = Tab {
    ...opened(tab),
    secret: token,
    secretFor: name
  }
end
