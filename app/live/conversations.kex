# Conversations from a tab: opening one, private chats, channels and group
# chats, making a group chat a channel, letting people into a private
# channel, and what a conversation is about.
module App.Live.Conversations

using App.Models.Conversation, only: [Conversation, ConversationId]
using App.Models.Conversation, as: Conversation
using Metro.Validation, only: [rules, validates, present, sized, passing]
using Metro.Live.Socket, only: [unchanged, changed]
using App.Live.Outcome, only: [Outcome, refused, failed]
using App.Live.Places, only: [home, visible, member?]
using App.Live.Event, only: [Event, given, typed, picked]
using App.Live.Tab, only: [Tab, closed]
using App.Models.Team, only: [Team, TeamId]
using App.Models.Organization, only: [OrganizationId]
using App.Models.User, only: [User, UserId]
using DB.Repositories.Teams, as: Teams

let channelRules = rules do
  validates("title", "A channel name", [
    present,
    sized(2, 30),
    passing("may only have lower-case letters, digits and dashes.") do |text|
      text.chars.all? { |char| char.lower? || char.digit? || "${char}" == "-" }
    end
  ])
end

let topicRules = rules do
  validates("topic", "A topic", [sized(0, 250)])
end

# Shows a conversation of the tab's organization this person may read.
open : User -> Tab -> ConversationId -> Outcome
foul open(user, tab, id) do
  return unchanged(tab) if id.empty?

  match visible(user, Tab { organization: tab.organization, conversation: id }) do
    Just(conversation) => return unchanged(at(conversation.organizationId, conversation.id))
    None => return unchanged(tab)
  end
end

# Opens the private chat with another person of the organization, starting
# it if need be — or with themselves: a place of their own, where nobody
# else looks, to keep notes in and try Slick out.
openDirect : User -> Tab -> UserId -> Outcome
foul openDirect(user, tab, other) do
  match home(user, tab) do
    None => return unchanged(tab)
    Just(organization) => do
      return unchanged(tab) if !member?(organization.id, other)

      match DB.Repositories.Conversations.findOrCreateDirect(organization.id, user.id, other) do
        Ok(conversation) => return unchanged(at(organization.id, conversation.id))
        Error(reason) => return failed(tab, reason)
      end
    end
  end
end

# A channel: public, or private — to whoever made it, and to the team that
# owns it, if one does. Only a team somebody is in can be given a channel
# by them.
createChannel : User -> Tab -> String -> String -> TeamId -> Outcome
foul createChannel(user, tab, title, access, teamId) do
  let problems = Metro.Validation.checked(channelRules, {"title": title}).messages
  return refused(tab, App.Live.Tab.ChannelDialog, problems.first.or("")) if !problems.empty?

  match home(user, tab) do
    None => return unchanged(tab)
    Just(organization) => do
      if !App.Services.Authority.canCreate(user, organization.id)
        return refused(tab, App.Live.Tab.ChannelDialog, "You may not make a channel in ${organization.name}.")
      end
      let owner : Team? = match Teams.find(teamId) do
        Ok(found) => found
        Error(_) => None
      end
      let owns = owner
        .map { |team| team.organizationId == organization.id && team.includes?(user.id) }
        .or(teamId.empty?)
      return refused(tab, App.Live.Tab.ChannelDialog, "A channel can only be made for a team you are in.") if !owns

      let kept = match Conversation.accessFrom(access) do
        Just(access) => access
        None => return refused(tab, App.Live.Tab.ChannelDialog, "Pick who may read the channel.")
      end
      match DB.Repositories.Conversations.create(organization.id, title, user.id, access: kept, teamId: teamId) do
        Ok(channel) => return changed(at(organization.id, channel.id))
        Error(_) => return refused(tab, App.Live.Tab.ChannelDialog, "There is already a channel called ${title}.")
      end
    end
  end
end

# Starts a group chat with the people picked, or opens the one they already
# have; with one person picked, the private chat with them.
createGroup : User -> Tab -> [UserId] -> Outcome
foul createGroup(user, tab, picked) do
  match home(user, tab) do
    None => return unchanged(tab)
    Just(organization) => do
      let others = picked.uniq.filter { |id| id != user.id && member?(organization.id, id) }
      return refused(tab, App.Live.Tab.GroupDialog, "Pick at least one person.") if others.empty?
      return openDirect(user, closed(tab), others.first.or("")) if others.count == 1

      match DB.Repositories.Conversations.findOrCreateGroup(organization.id, others, user.id) do
        Ok(chat) => return changed(at(organization.id, chat.id))
        Error(reason) => return refused(tab, App.Live.Tab.GroupDialog, reason)
      end
    end
  end
end

# Makes the group chat the tab shows a channel, public or private. Whoever
# was in it stays in it.
makeChannel : User -> Tab -> String -> String -> Outcome
foul makeChannel(user, tab, title, access) do
  let problems = Metro.Validation.checked(channelRules, {"title": title}).messages
  return refused(tab, App.Live.Tab.PromoteDialog, problems.first.or("")) if !problems.empty?

  match visible(user, tab) do
    None => return unchanged(tab)
    Just(conversation) => do
      return unchanged(closed(tab)) if !conversation.group?
      if !App.Services.Authority.canAdminister(user, conversation)
        return refused(tab, App.Live.Tab.PromoteDialog, "Only an administrator can make this a channel.")
      end

      let kept = match Conversation.accessFrom(access) do
        Just(access) => access
        None => return refused(tab, App.Live.Tab.PromoteDialog, "Pick who may read the channel.")
      end
      match DB.Repositories.Conversations.promote(conversation.id, title, kept) do
        Ok(channel) => return changed(at(channel.organizationId, channel.id))
        Error(_) => return refused(tab, App.Live.Tab.PromoteDialog, "There is already a channel called ${title}.")
      end
    end
  end
end

# Lets people of the organization into the private channel the tab shows.
addPeople : User -> Tab -> [UserId] -> Outcome
foul addPeople(user, tab, picked) do
  match visible(user, tab) do
    None => return unchanged(tab)
    Just(conversation) => do
      return unchanged(closed(tab)) if !conversation.channel? || conversation.public?
      if !App.Services.Authority.canAdminister(user, conversation)
        return refused(tab, App.Live.Tab.AdmitDialog, "Only an administrator of this channel can add people.")
      end

      let newcomers = picked.uniq.filter do |id|
        !conversation.admits?(id) && member?(conversation.organizationId, id)
      end
      return refused(tab, App.Live.Tab.AdmitDialog, "Pick at least one person who is not in it yet.") if newcomers.empty?

      match DB.Repositories.Conversations.admit(conversation.id, newcomers) do
        Ok(count) => do
          let notice = count == 1 then "Added one person." else "Added ${count} people."
          return changed(Tab { ...closed(tab), notice: notice })
        end
        Error(reason) => return refused(tab, App.Live.Tab.AdmitDialog, reason)
      end
    end
  end
end

# Says what the conversation the tab shows is about.
setTopic : User -> Tab -> String -> Outcome
foul setTopic(user, tab, topic) do
  let problems = Metro.Validation.checked(topicRules, {"topic": topic}).messages
  if !problems.empty?
    return unchanged(Tab { ...closed(tab), retitling?: true, failure: problems.first.or("") })
  end

  match visible(user, tab) do
    None => return unchanged(tab)
    Just(conversation) => match DB.Repositories.Conversations.setTopic(conversation.id, topic) do
      Ok(said) => return (closed(tab), said)
      Error(reason) => return failed(tab, reason)
    end
  end
end

# Changes a channel's settings at once: who may read it, the team that owns
# it, and how much its bots may read. Only an administrator, and only a
# channel.
configure : User -> Tab -> String -> TeamId -> String -> Outcome
foul configure(user, tab, access, teamId, botAccess) do
  let chosenAccess = Conversation.accessFrom(access)
  let chosenBotAccess = Conversation.botAccessFrom(botAccess)
  return unchanged(inSettings(tab, "Pick who may read it.")) if !chosenAccess.set?
  return unchanged(inSettings(tab, "Pick what bots may read.")) if !chosenBotAccess.set?

  match visible(user, tab) do
    None => return unchanged(tab)
    Just(conversation) => do
      return unchanged(tab) if !conversation.channel?
      if !App.Services.Authority.canAdminister(user, conversation)
        return unchanged(inSettings(tab, "Only an administrator can change a channel's settings."))
      end
      if !teamId.empty? && teamId != conversation.teamId
        let owner : Team? = match Teams.find(teamId) do
          Ok(found) => found
          Error(_) => None
        end
        let owns = owner
          .map { |team| team.organizationId == conversation.organizationId && team.includes?(user.id) }
          .or(false)
        return unchanged(inSettings(tab, "A channel can only belong to a team you are in.")) if !owns
      end

      match DB.Repositories.Conversations.configure(conversation.id, chosenAccess.or(Conversation.Public), teamId, chosenBotAccess.or(Conversation.Mentions)) do
        Ok(true) => return changed(Tab { ...closed(tab), view: App.Live.Tab.ConversationView, notice: "Channel settings saved." })
        Ok(false) => return unchanged(inSettings(tab, "That conversation is not there."))
        Error(reason) => return unchanged(inSettings(tab, reason))
      end
    end
  end
end

# What this part answers, of the events config/live.kex routes to it, by
# their whole names; any other does nothing.
on : String -> Event -> Outcome
foul on("conversation-open", event) = open(event.user, event.tab, given(event, "id"))
foul on("direct-open", event) = openDirect(event.user, event.tab, given(event, "user"))
foul on("channel-create", event) = createChannel(event.user, event.tab, typed(event, "title").lowerCase, given(event, "access"), given(event, "team"))
foul on("channel-add", event) = addPeople(event.user, event.tab, picked(event, "person"))
foul on("channel-configure", event) = configure(event.user, event.tab, given(event, "access"), given(event, "team"), given(event, "bot-access"))
foul on("group-create", event) = createGroup(event.user, event.tab, picked(event, "person"))
foul on("group-promote", event) = makeChannel(event.user, event.tab, typed(event, "title").lowerCase, given(event, "access"))
foul on("topic-edit", event) = unchanged(Tab { ...closed(event.tab), retitling?: true })
foul on("topic-set", event) = setTopic(event.user, event.tab, typed(event, "topic"))
foul on(_, event) = unchanged(event.tab)

private do
  # A tab showing a conversation, and nothing else.
  at : OrganizationId -> ConversationId -> Tab
  let at(organization, conversation) = Tab {
    organization: organization,
    conversation: conversation
  }

  # The channel's settings, still open, saying what was wrong.
  inSettings : Tab -> String -> Tab
  let inSettings(tab, failure) = Tab {
    ...closed(tab),
    view: App.Live.Tab.SettingsView,
    failure: failure
  }
end
