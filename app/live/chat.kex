# The whole of Slick as one live view: what each browser event does to a
# tab's state and to what is stored, and the markup that results.
# `Metro.Live.Socket` runs these two functions against a WebSocket
# (config/routes.kex).
#
# Every event is checked here against who sent it. A tab names an
# organization and a conversation by id, and an id is not a permission:
# `home` only ever answers with an organization its person is in, and
# `visible` only with a conversation of that organization they may read.
# Both are asked before anything is read or written, so the id of another
# organization's channel, or of somebody else's private chat, gets a tab
# nothing.
module App.Live.Chat

using Metro.Live.Presence, only: [Presence, Note]
using Metro.Live.Socket, only: [field, repeated]
using Metro.Validation, only: [rules, validates, present, sized, passing]
using App.Live.Tab, only: [Tab]
using App.Live.Unread, only: [Unread]
using App.Models.Attachment, only: [Attachment]
using App.Models.Command, only: [Command]
using App.Models.Invocation, only: [Invocation]
using App.Models.Conversation, only: [Conversation]
using App.Models.Draft, only: [Draft]
using App.Models.Grant, only: [Grant]
using App.Models.Message, only: [Message]
using App.Models.Reading, only: [Reading]
using App.Models.Organization, only: [Organization]
using App.Models.Team, only: [Team]
using App.Models.User, only: [User]
using DB.Repositories.Attachments, as: Attachments
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Drafts, as: Drafts
using DB.Repositories.Memberships, as: Memberships
using DB.Repositories.Messages, as: Messages
using DB.Repositories.Organizations, as: Organizations
using DB.Repositories.Readings, as: Readings
using DB.Repositories.Reactions, as: Reactions
using DB.Repositories.Answers, as: Answers
using DB.Repositories.Grants, as: Grants
using DB.Repositories.Teams, as: Teams
using DB.Repositories.Users, as: Users

# How many messages of a conversation a tab is shown.
let WINDOW = 200

# What the first channel of an organization is about, until somebody says.
let GENERAL_TOPIC = "Company-wide announcements and chatter"

let channelRules = rules do
  validates("title", "A channel name", [
    present,
    sized(2, 30),
    passing("may only have lower-case letters, digits and dashes.") do |text|
      text.chars.all? { |char| char.lower? || char.digit? || "${char}" == "-" }
    end
  ])
end

let messageRules = rules do
  validates("body", "A message", [present, sized(1, App.Models.Message.LONGEST)])
end

let topicRules = rules do
  validates("topic", "A topic", [sized(0, 250)])
end

let organizationRules = rules do
  validates("name", "A name", [present, sized(2, 40)])
end

let teamRules = rules do
  validates("name", "A team's name", [present, sized(2, 40)])
  validates("description", "What a team is for", [sized(0, App.Models.Team.LONGEST_DESCRIPTION)])
end

# The live region for one person's tab, as things are stored right now.
#
# `statuses` is the board of what people are in the middle of — typing, or
# whatever a bot says it is doing: `Metro.Live.Presence`.
markup : Server<Presence> -> User -> Tab -> String
foul markup(statuses, user, tab) do
  match home(user, tab) do
    None => return App.Views.Chat.welcome(tab, user)
    Just(organization) => do
      let mine : [Organization] = organizations(user)
      let roster : [String] = Memberships.roster(organization.id).or([])
      let everyone : [User] = Users.everyone.or([])
      let people = everyone.filter { |person| roster.contains?(person.id) }
      let channels : [Conversation] = readable(user, Conversations.channels(organization.id).or([]))
      let groups : [Conversation] = Conversations.groupsOf(organization.id, user.id).or([])
      let teams : [Team] = Teams.ofOrganization(organization.id).or([])
      let now = Metro.Clock.milliseconds()
      let online : [String] = Metro.Live.Presence.standing(statuses, ONLINE, now)
        .map { |note| note.member.split(" ").first.or("") }
      let bots : [User] = tab.dialog == "bots" then manageable(user, organization) else []
      let operators : {String: [String]} = bots.reduce({}) { |found, bot|
        found.put(bot.id, DB.Repositories.BotOperators.listed(bot.id).or([]))
      }
      let roles = Grants.over("organization", organization.id).or([])
        .filter { |grant| grant.subjectType == "user" }
        .reduce({}) { |found, grant| found.put(grant.subjectId, grant.role) }
      let administrator = App.Services.Authority.canManage(user, organization.id)
      let drafts : [Draft] = Drafts.pending(user.id).or([])
      let marks : [Reading] = Readings.marks(user.id).or([])
      match visible(user, tab) do
        None => do
          let unread = tallied(user, organization, mine, marks, "", "")
          return App.Views.Chat.index(
            tab,
            user,
            mine,
            organization,
            channels,
            groups,
            teams,
            people,
            online,
            bots,
            operators,
            drafts,
            unread,
            App.Views.Chat.Cabinet {},
            [],
            [],
            None,
            [],
            [],
            [],
            [],
            [],
            roles,
            administrator
          )
        end
        Just(conversation) => do
          let messages : [Message] = Messages.latest(conversation.id, WINDOW).or([])
          let thread = unfolded(conversation, tab.thread)
          # Somebody looking at a conversation reads it as far as its newest
          # message, and the thread open beside it, if they follow it, as
          # far as its newest reply.
          let reading = tab.attentive? then conversation.id else ""
          let readingThread = tab.attentive? then opening(thread) else ""
          if tab.attentive?
            noted(user, marks, Reading {
              conversationId: conversation.id,
              readAt: newest(messages)
            })
            if followed(marks, readingThread)
              noted(user, marks, Reading {
                conversationId: conversation.id,
                threadId: readingThread,
                readAt: newest(thread)
              })
            end
          end
          let unread = tallied(user, organization, mine, marks, reading, readingThread)
          let reactions = Reactions.throughout(conversation.id).or([])
          let cabinet = filedIn(user, tab, conversation)
          let responses = Answers.collected(conversation.id).or([])
          let doing : [Note] = Metro.Live.Presence.standing(statuses, conversation.id, now)
          return App.Views.Chat.index(
            tab,
            user,
            mine,
            organization,
            channels,
            groups,
            teams,
            people,
            online,
            bots,
            operators,
            drafts,
            unread,
            cabinet,
            offering(user, conversation, people),
            DB.Repositories.Invocations.inside(conversation.id).or([]),
            Just(conversation),
            messages,
            reactions,
            responses,
            thread,
            doing.reject { |note| note.member == user.id },
            roles,
            administrator
          )
        end
      end
    end
  end
end

# Applies one event: the tab's next state, and whether something other tabs
# show was changed — in which case they are told to refresh. What changed in
# what a bot could see is noted to the events bus on the way (`events`).
handled : Server<App.Live.Events.Bus> -> Server<Presence> -> User -> Tab -> [(String, String?)] -> (Tab, Bool)
foul handled(events, statuses, user, tab, entries) do
  match field(entries, "event") do
    "open" => opened(user, tab, field(entries, "id"))
    "direct" => whispered(user, tab, field(entries, "user"))
    "found" => (Tab { ...settled(tab), dialog: "channel" }, false)
    "create" => established(user, tab, field(entries, "title").trim.lowerCase, field(entries, "access"), field(entries, "team"))
    "group" => (Tab { ...settled(tab), dialog: "group" }, false)
    "gather" => gathered(user, tab, repeated(entries, "person"))
    "promote" => (Tab { ...settled(tab), dialog: "promote" }, false)
    "promote-set" => promotedTo(user, tab, field(entries, "title").trim.lowerCase, field(entries, "access"))
    "admit" => (Tab { ...settled(tab), dialog: "admit" }, false)
    "admit-set" => admittedTo(user, tab, repeated(entries, "person"))
    "team" => teamed(user, tab, field(entries, "id"))
    "unteam" => (Tab { ...settled(tab), team: "" }, false)
    "team-new" => (Tab { ...settled(tab), dialog: "team" }, false)
    "team-form" => teamFormed(user, tab, entries)
    "team-edit" => (Tab { ...settled(tab), dialog: "team-edit" }, false)
    "team-set" => teamRevised(user, tab, entries)
    "team-join" => teamJoined(user, tab, [user.id])
    "team-add" => teamJoined(user, tab, repeated(entries, "person"))
    "team-leave" => teamLeft(user, tab, user.id)
    "team-remove" => teamLeft(user, tab, field(entries, "user"))
    "send" => sent(events, statuses, user, tab, field(entries, "body").trim)
    "draft" => drafted(user, tab, field(entries, "place"), field(entries, "body"))
    "typing" => typing(statuses, user, tab)
    "retitle" => (Tab { ...settled(tab), retitling?: true }, false)
    "topic" => retitled(user, tab, field(entries, "topic").trim)
    "react" => reacted(user, tab, field(entries, "message"), field(entries, "emoji"))
    "answer" => answered(events, user, tab, entries)
    "cancel" => (settled(tab), false)
    "thread" => threaded(user, tab, field(entries, "message"))
    "unthread" => (Tab { organization: tab.organization, conversation: tab.conversation }, false)
    "profile" => profiled(user, tab, field(entries, "user"))
    "bot-operators" => operatorsSet(user, tab, field(entries, "bot"), repeated(entries, "operator"))
    "bot-access" => botAccessSet(user, tab, field(entries, "access"))
    "settings" => (Tab { ...settled(tab), thread: "", profile: "", team: "", view: "settings" }, false)
    "settings-set" => settingsSet(user, tab, entries)
    "role-set" => roleGiven(user, tab, field(entries, "user"), field(entries, "role"))
    "role-remove" => roleTaken(user, tab, field(entries, "user"))
    "unprofile" => (Tab { ...settled(tab), profile: "" }, false)
    "attention" => (Tab { ...tab, attentive?: field(entries, "on") != "false" }, false)
    "share" => shared(user, tab, field(entries, "file"))
    "share-failed" => (refusedUpload(tab, field(entries, "filename"), field(entries, "reason")), false)
    "unshare" => (Tab { ...tab, pending: tab.pending.reject { |id| id == field(entries, "file") } }, false)
    "files" => (Tab { ...settled(tab), thread: "", view: "files" }, false)
    "messages" => (Tab { ...settled(tab), view: "" }, false)
    "profile-edit" => (Tab { ...settled(tab), dialog: "profile" }, false)
    "profile-set" => described(user, tab, entries)
    "reply" => replied(events, statuses, user, tab, field(entries, "body").trim)
    "visit" => (arrived(user, field(entries, "path")), false)
    "organization" => switched(user, tab, field(entries, "id"))
    "organize" => (Tab { ...settled(tab), dialog: "organization" }, false)
    "charter" => organized(user, tab, field(entries, "name").trim)
    "invite" => (Tab { ...settled(tab), dialog: "invite" }, false)
    "enlist" => invited(user, tab, field(entries, "email").trim.lowerCase)
    "status" => (Tab { ...settled(tab), dialog: "status" }, false)
    "status-set" => restyled(user, tab, field(entries, "emoji").trim, field(entries, "text").trim)
    "status-clear" => restyled(user, tab, "", "")
    "bots" => (Tab { ...settled(tab), dialog: "bots" }, false)
    "bot-create" => botMade(user, tab, field(entries, "name").trim, field(entries, "owner"))
    "bot-rekey" => botRenewed(user, tab, field(entries, "id"))
    "bot-enlist" => botBrought(user, tab, field(entries, "id"))
    "bot-remove" => botRemoved(user, tab, field(entries, "id"))
    _ => (tab, false)
  end
end

# The topic, on the statuses board, of who has a tab open. A member there is
# "<user id> <something of the tab's own>", so that closing one of two tabs
# does not make somebody look gone.
let ONLINE = "online"

# Somebody's tab has opened, or closed.
arriving : Server<Presence> -> User -> String -> Void
foul arriving(statuses, user, seat) do
  statuses.noted(ONLINE, "${user.id} ${seat}", "", Metro.Clock.milliseconds() + 86400000)
end

leaving : Server<Presence> -> User -> String -> Void
foul leaving(statuses, user, seat) do
  statuses.lifted(ONLINE, "${user.id} ${seat}")
end

# How long "is typing" stands after a keystroke is heard of, in milliseconds.
# The browser says so again every three seconds while it goes on.
let TYPING_FOR = 6000

# Says what somebody is doing in the conversation their tab is showing, for
# `milliseconds`; "" takes it back. Whether there was a conversation to say
# it in.
noting : Server<Presence> -> User -> Tab -> String -> Integer -> Bool
foul noting(statuses, user, tab, text, milliseconds) do
  match visible(user, tab) do
    None => return false
    Just(conversation) => do
      if milliseconds <= 0
        statuses.lifted(conversation.id, user.id)
      else
        statuses.noted(conversation.id, user.id, text, Metro.Clock.milliseconds() + milliseconds)
      end
      return true
    end
  end
end

# The tab for an address (App.Paths): a channel, a private chat or a group
# chat of an organization, any with `?thread=<message>`. Anything else, or a
# place this person may not be, is the tab everyone starts with. A private
# chat is started by going to it.
arrived : User -> String -> Tab
foul arrived(user, location) do
  let thread = Metro.Path.query(location, "thread").or("")
  match App.Paths.channelPath.captured(location) do
    Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
      None => return Tab {}
      Just(organization) => match Conversations.channelCalled(organization.id, parts.get("name").or("")) do
        Ok(Just(channel)) => return Tab { organization: organization.id, conversation: channel.id, thread: thread }
        _ => return Tab { organization: organization.id }
      end
    end
    None => match App.Paths.directPath.captured(location) do
      None => return grouped(user, location, thread)
      Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
        None => return Tab {}
        Just(organization) => do
          let (chat, _) = whispered(user, Tab { organization: organization.id }, parts.get("person").or(""))
          return Tab { organization: organization.id, conversation: chat.conversation, thread: thread }
        end
      end
    end
  end
end

# The tab for the address of a group chat: only one this person is in.
grouped : User -> String -> String -> Tab
foul grouped(user, location, thread) do
  match App.Paths.groupPath.captured(location) do
    None => return Tab {}
    Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
      None => return Tab {}
      Just(organization) => do
        let tab = Tab { organization: organization.id, conversation: parts.get("group").or(""), thread: thread }
        match visible(user, tab) do
          Just(conversation) => return conversation.group? then tab else Tab { organization: organization.id }
          None => return Tab { organization: organization.id }
        end
      end
    end
  end
end

# The organization at an address, if this person is in it.
memberOrganization : User -> String -> Organization?
foul memberOrganization(user, slug) do
  match Organizations.addressed(slug) do
    Ok(Just(organization)) => return affiliated?(organization.id, user.id) then Just(organization) else None
    _ => return None
  end
end

# The organization a tab is in: the one it names, if its person is in it,
# and otherwise the first one they are in. `None` is somebody in none.
home : User -> Tab -> Organization?
foul home(user, tab) do
  let mine : [String] = Grants.organizationsOf(user.id).or([])
  let chosen = mine.contains?(tab.organization) then tab.organization else mine.first.or("")
  return None if chosen.empty?

  match Organizations.identified(chosen) do
    Ok(Just(organization)) => return Just(organization)
    _ => return None
  end
end

# The conversation a tab is showing, if its person may read it: it has to be
# in the tab's organization, and theirs to read there.
visible : User -> Tab -> Conversation?
foul visible(user, tab) do
  match home(user, tab) do
    None => return None
    Just(organization) => do
      let found = tab.conversation.empty? then Conversations.channelCalled(organization.id, App.Models.Conversation.GENERAL) else Conversations.lookup(tab.conversation)
      match found do
        Ok(Just(conversation)) => do
          return None if conversation.organizationId != organization.id || !App.Services.Authority.canRead(user, conversation)
          return Just(conversation)
        end
        _ => return None
      end
    end
  end
end

# The organizations a person is in, oldest membership first.
organizations : User -> [Organization]
foul organizations(user) do
  let mine : [String] = Grants.organizationsOf(user.id).or([])
  return mine.flatMap do |id|
    match Organizations.identified(id) do
      Ok(Just(organization)) => [organization]
      _ => []
    end
  end
end

private do
  # How much somebody has not read: in the organization the tab is in, by
  # channel and by private chat, and in each of the others altogether.
  # `marks` are how far they have read (`Readings.marks`); `open` and
  # `openThread` are what the tab shows them right now, if they are looking.
  tallied : User -> Organization -> [Organization] -> [Reading] -> String -> String -> Unread
  foul tallied(user, current, mine, marks, open, openThread) do
    let (channels, people, groups) = unreadIn(user, current, marks, open, openThread)
    let others = mine.reject { |each| each.id == current.id }
    let elsewhere = others.reduce({}) do |found, other|
      let (theirChannels, theirPeople, theirGroups) = unreadIn(user, other, marks, "", "")
      found.put(other.id, summed(theirChannels) + summed(theirPeople) + summed(theirGroups))
    end
    return Unread {
      channels: channels,
      people: people,
      groups: groups,
      organizations: elsewhere,
      total: summed(channels) + summed(people) + summed(groups) + summed(elsewhere)
    }
  end

  # What is new in each channel of an organization this person may read, by
  # id, in each of their private chats there, by the person it is with, and
  # in each of their group chats, by id: messages
  # since they last read there — since they joined, where they never have —
  # and other people's replies in the threads they follow since they last
  # read those.
  foul unreadIn(
    user: User,
    organization: Organization,
    marks: [Reading],
    open: String,
    openThread: String
  ) -> ({String: Integer}, {String: Integer}, {String: Integer}) do
    let since = Memberships.joined(organization.id, user.id)
    let channels : [Conversation] = readable(user, Conversations.channels(organization.id).or([]))
    let chats : [Conversation] = Conversations.directsOf(organization.id, user.id).or([])
    let groups : [Conversation] = Conversations.groupsOf(organization.id, user.id).or([])
    let places = (channels + chats + groups).map { |conversation| conversation.id }
    let follows = marks.filter do |mark|
      !mark.threadId.empty? && mark.threadId != openThread && places.contains?(mark.conversationId)
    end
    let roots = follows.map { |mark| mark.threadId }
    let oldest = follows.map { |mark| mark.readAt }.min.or(0)
    let replies : [Message] = follows.empty? then [] else Messages.replyingTo(roots, oldest).or([])
    let answered = replies.filter do |reply|
      reply.userId != user.id && follows.any? do |mark|
        mark.threadId == reply.parentId && reply.sentAt > mark.readAt
      end
    end
    let counted = do |conversation|
      let replied = answered.count { |reply| reply.conversationId == conversation.id }
      unseen(conversation, marks, since, open) + replied
    end
    let byChannel = channels.reduce({}) do |found, channel|
      found.put(channel.id, counted(channel))
    end
    let byPerson = chats.reduce({}) do |found, chat|
      found.put(chat.counterpart(user.id), counted(chat))
    end
    let byGroup = groups.reduce({}) do |found, group|
      found.put(group.id, counted(group))
    end
    return (byChannel, byPerson, byGroup)
  end

  # The channels of these that this person may read.
  readable : User -> [Conversation] -> [Conversation]
  foul readable(user, channels) = channels.filter { |channel| App.Services.Authority.canRead(user, channel) }

  # Whether a user is in an organization, by their grants.
  foul affiliated?(organizationId: String, userId: String) -> Bool do
    return Grants.organizationsOf(userId).or([]).contains?(organizationId)
  end

  # The messages of a conversation newer than how far this person has read
  # there; none in the one they are reading.
  unseen : Conversation -> [Reading] -> Integer -> String -> Integer
  foul unseen(conversation, marks, since, open) do
    return 0 if conversation.id == open
    let mark = marks.find { |each| each.conversationId == conversation.id && each.threadId.empty? }
    let read = mark.map { |each| each.readAt }.or(since)
    return Messages.newer(conversation.id, read).or(0)
  end

  # The files of a conversation: what was sent into it, what this person
  # has waiting to send there, and — while the files view is open — the
  # start of each small text file.
  filedIn : User -> Tab -> Conversation -> App.Views.Chat.Cabinet
  foul filedIn(user, tab, conversation) do
    let stored : [Attachment] = Attachments.inside(conversation.id).or([])
    let waiting : [Attachment] = tab.pending.empty? then [] else Attachments.among(tab.pending).or([])
    let queued = waiting.filter { |file| file.userId == user.id && !file.sent? }
    let small = stored.filter { |file| file.textual? && file.byteSize <= GLIMPSED }
    let glimpsed = tab.view == "files" then small else []
    let glimpses = glimpsed.reduce({}) do |found, file|
      let content : Result<Binary, String> = Metro.Storage.Service.get(file.id)
      let text = content.map { |bytes| bytes.to(String).or("") }.or("")
      found.put(file.id, text.take(400))
    end
    return App.Views.Chat.Cabinet {
      stored: stored,
      queued: queued,
      glimpses: glimpses
    }
  end

  # The largest text file whose start the files view shows, in bytes.
  let GLIMPSED = 65536

  # The slash commands somebody can use in a conversation: those of every bot
  # of the organization in a public channel, those of the bots taking part
  # in a private channel or a group chat, those of the bot in a private
  # chat with one, and none in a chat with a person.
  offering : User -> Conversation -> [User] -> [Command]
  foul offering(user, conversation, people) do
    let bots = people.filter { |person| person.bot? }
    let other = conversation.counterpart(user.id)
    let listening = if conversation.direct?
      bots.filter { |bot| bot.id == other }
    else
      bots.filter { |bot| conversation.admits?(bot.id) }
    end
    return [] if listening.empty?
    return DB.Repositories.Commands.of(listening.map { |bot| bot.id }).or([])
  end

  # Whether what was sent is a slash command for a bot in reach — and if so,
  # notes it as used, and clears the box it was written in. It is one when
  # it starts with a command a bot here has declared: `/mode` in a bot's
  # private chat; `@opencode /mode auto` in a channel, or `/mode` alone
  # when only one bot here answers to it. Anything else is a message.
  invoked : Server<App.Live.Events.Bus> -> User -> Conversation -> String -> String -> Bool
  foul invoked(events, user, conversation, threadId, body) do
    let people : [User] = Users.everyone.or([])
    let commands = offering(user, conversation, people)
    return false if commands.empty?

    let text = body.trim
    let bots = people.filter { |person| commands.any? { |command| command.botId == person.id } }
    let addressed = bots.find { |bot| text.startsWith?("@${bot.shown} ") }
    let rest = addressed.map { |bot| text.drop(bot.shown.count + 1).trim }.or(text)
    return false if !rest.startsWith?("/")

    let name = rest.drop(1).split(" ").first.or("").lowerCase
    let candidates = commands.filter do |command|
      command.name == name && addressed.map { |bot| command.botId == bot.id }.or(true)
    end
    return false if candidates.count != 1

    let command = candidates.first.or(Command { botId: "", name: "" })
    let moment = Metro.Clock.milliseconds()
    let used = Invocation {
      id: Metro.Id.generate(prefix: "i"),
      organizationId: conversation.organizationId,
      conversationId: conversation.id,
      threadId: threadId,
      botId: command.botId,
      userId: user.id,
      command: command.name,
      arguments: rest.drop(1 + name.count).trim,
      invokedAt: moment
    }
    let kept : Result<Integer, String> = Harmat.Database.transaction do
      DB.Repositories.Invocations.recorded(used).try
      Drafts.kept(user.id, Draft { conversationId: conversation.id, threadId: threadId, body: "" })
    end
    if kept.ok?
      happened(events, conversation, "command", "", used.threadId, used.invokedAt, command.botId, "")
    end
    return kept.ok?
  end

  # Notes what happened to the events bus, for the bots that are watching.
  # Nothing is told but where: what a bot may read of it, it fetches through
  # the API as ever. A bot "" is no bot: the event is for whoever may read
  # the conversation. `body` is the message said, kept on the server only so
  # the bus can tell which bots it names.
  happened : Server<App.Live.Events.Bus> -> Conversation -> String -> String -> String -> Integer -> String -> String -> Void
  foul happened(events, conversation, kind, messageId, threadId, at, bot, body) do
    match Organizations.identified(conversation.organizationId) do
      Ok(Just(organization)) => do
        let replied = if kind == "message" && !threadId.empty?
          Messages.botAuthors(threadId, Users.botIds().or([])).or([])
        else
          []
        end
        events.happened(App.Live.Events.Event {
          kind: kind,
          organizationId: conversation.organizationId,
          organization: organization.slug,
          conversationId: conversation.id,
          channel: conversation.channel? then conversation.title else "",
          group: conversation.group? then conversation.id else "",
          first: conversation.direct? then conversation.firstUser else "",
          second: conversation.direct? then conversation.secondUser else "",
          thread: threadId,
          message: messageId,
          at: at,
          public?: conversation.public?,
          people: conversation.public? then [] else (conversation.direct? then [conversation.firstUser, conversation.secondUser] else conversation.participants),
          bot: bot,
          body: body,
          botAccess: conversation.botAccess,
          replied: replied
        })
      end
      _ => ()
    end
  end

  # The id of the message a thread starts with; "" for no thread.
  opening : [Message] -> String
  let opening(thread) = thread.first.map { |first| first.id }.or("")

  # When the newest of some messages was sent; 0 for none.
  newest : [Message] -> Integer
  let newest(messages) = messages.last.map { |message| message.sentAt }.or(0)

  # A tab told that a file did not upload, and why.
  refusedUpload : Tab -> String -> String -> Tab
  let refusedUpload(tab, filename, reason) = Tab {
    ...tab,
    failure: "${filename} was not uploaded: ${reason}"
  }

  # Whether this person follows the thread a message starts.
  followed : [Reading] -> String -> Bool
  let followed(marks, threadId) = !threadId.empty? && marks.any? do |mark|
    mark.threadId == threadId
  end

  # Notes how far somebody has read, if it is further than before.
  noted : User -> [Reading] -> Reading -> Void
  foul noted(user, marks, reading) do
    let before = marks
      .find { |mark| mark.conversationId == reading.conversationId && mark.threadId == reading.threadId }
      .map { |mark| mark.readAt }
      .or(0)
    Readings.reached(user.id, reading) if reading.readAt > before
  end

  summed : {String: Integer} -> Integer
  let summed(counts) = counts.values.reduce(0) { |sum, count| sum + count }

  # A tab with nothing open over the conversation: no form, no dialog, no
  # message left from the last thing tried.
  settled : Tab -> Tab
  let settled(tab) = Tab {
    organization: tab.organization,
    conversation: tab.conversation,
    thread: tab.thread,
    profile: tab.profile,
    team: tab.team,
    pending: tab.pending,
    view: tab.view,
    attentive?: tab.attentive?
  }

  switched : User -> Tab -> String -> (Tab, Bool)
  foul switched(user, tab, id) do
    return (tab, false) if !affiliated?(id, user.id)
    return (Tab { organization: id }, false)
  end

  # Creates an organization with its first member and its #general.
  organized : User -> Tab -> String -> (Tab, Bool)
  foul organized(user, tab, name) do
    let refused = Tab { ...settled(tab), dialog: "organization" }
    let problems = Metro.Validation.checked(organizationRules, {"name": name}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    let slug = App.Models.Organization.slugged(name)
    return (Tab { ...refused, dialogProblem: "A name needs at least two letters or digits." }, false) if slug.chars.count < 2
    return (Tab { ...refused, dialogProblem: "${name} cannot be used as a name. Try another." }, false) if App.Models.Organization.RESERVED.contains?(slug)

    match chartering(user, name, slug) do
      Error(_) => return (Tab { ...refused, dialogProblem: "There is already an organization called ${name}." }, false)
      Ok(organization) => return (Tab { organization: organization.id }, true)
    end
  end

  # An organization, its first member and its #general, all or nothing.
  chartering : User -> String -> String -> Result<Organization, String>
  foul chartering(user, name, slug) do
    let made : Result<Organization, String> = Harmat.Database.transaction do
      let organization : Organization = Organizations.chartered(name, slug, user.id).try
      Memberships.enlisted(organization.id, user.id).try
      Grants.granted(Grant { subjectType: "user", subjectId: user.id, resourceType: "organization", resourceId: organization.id, role: "admin" }).try
      let general : Conversation = Conversations
        .founded(organization.id, App.Models.Conversation.GENERAL, user.id)
        .try
      Conversations.retitled(general.id, GENERAL_TOPIC).try
      Ok(organization)
    end
    return made
  end

  # Puts somebody who has registered into the tab's organization.
  invited : User -> Tab -> String -> (Tab, Bool)
  foul invited(user, tab, email) do
    let refused = Tab { ...settled(tab), dialog: "invite" }
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !App.Services.Authority.canManage(user, organization.id)
          return (Tab { ...refused, dialogProblem: "Only an administrator of ${organization.name} can invite people." }, false)
        end
        match Users.credentials(email) do
          Ok(Just((person, _))) => match Memberships.enlisted(organization.id, person.id) do
            Ok(_) => return (Tab { ...settled(tab), notice: "${person.shown} is now in ${organization.name}." }, true)
            Error(_) => return (Tab { ...refused, dialogProblem: "${person.shown} is already in ${organization.name}." }, false)
          end
          _ => return (Tab { ...refused, dialogProblem: "Nobody has registered with ${email}. They need an account first." }, false)
        end
      end
    end
  end

  let botRules = rules do
    validates("name", "A bot's name", [present, sized(2, 40)])
  end

  # Makes a bot of this person's, in the tab's organization. Its token is
  # kept in the tab, to be shown until the dialog is closed, and nowhere else.
  # The bots a person may look after from a tab: their own, and — for an
  # administrator — those of the organization the tab is in.
  manageable : User -> Organization -> [User]
  foul manageable(user, organization) do
    let own : [User] = Users.operated(user.id).or([])
    if App.Services.Authority.canManage(user, organization.id)
      return Users.maintained(organization.id).or([]) + own
    end
    return own
  end

  # `owner` is "me" for a bot of this person's own; anything else makes it
  # the organization's.
  botMade : User -> Tab -> String -> String -> (Tab, Bool)
  foul botMade(user, tab, name, owner) do
    let refused = Tab { ...settled(tab), dialog: "bots" }
    let problems = Metro.Validation.checked(botRules, {"name": name}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if owner != "me" && !App.Services.Authority.canManage(user, organization.id)
          return (Tab { ...refused, dialogProblem: "Only an administrator of ${organization.name} can make a bot for it." }, false)
        end
        match App.Services.Bots.built(user, owner == "me" then "" else organization.id, name) do
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
          Ok((bot, token)) => do
            Memberships.enlisted(organization.id, bot.id)
            return (Tab { ...refused, secret: token, secretFor: bot.name }, true)
          end
        end
      end
    end
  end

  botRenewed : User -> Tab -> String -> (Tab, Bool)
  foul botRenewed(user, tab, id) do
    let refused = Tab { ...settled(tab), dialog: "bots" }
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !ownBot(user, id) && !App.Services.Authority.canManage(user, organization.id)
          return (Tab { ...refused, dialogProblem: "Only an administrator of ${organization.name} can manage its bots." }, false)
        end
        let named = manageable(user, organization).find { |bot| bot.id == id }.map { |bot| bot.name }.or("the bot")
        match App.Services.Bots.renewed(user, organization.id, id) do
          Ok(token) => return (Tab { ...refused, secret: token, secretFor: named }, false)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
    end
  end

  # Puts one of this person's bots into the tab's organization.
  botBrought : User -> Tab -> String -> (Tab, Bool)
  foul botBrought(user, tab, id) do
    let refused = Tab { ...settled(tab), dialog: "bots" }
    let owned : [User] = Users.operated(user.id).or([])
    return (Tab { ...refused, dialogProblem: "That is not one of your bots." }, false) if !owned.any? { |bot| bot.id == id }

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        Memberships.enlisted(organization.id, id)
        return (refused, true)
      end
    end
  end

  # Deletes a bot — this person's own, or the tab's organization's — and
  # takes its access with it.
  botRemoved : User -> Tab -> String -> (Tab, Bool)
  foul botRemoved(user, tab, id) do
    let refused = Tab { ...settled(tab), dialog: "bots" }
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !ownBot(user, id) && !App.Services.Authority.canManage(user, organization.id)
          return (Tab { ...refused, dialogProblem: "Only an administrator of ${organization.name} can manage its bots." }, false)
        end
        let named = manageable(user, organization).find { |bot| bot.id == id }.map { |bot| bot.name }.or("the bot")
        match App.Services.Bots.removed(user, organization.id, id) do
          Ok(true) => return (Tab { ...refused, notice: "${named} was removed." }, true)
          Ok(false) => return (Tab { ...refused, dialogProblem: "That is not one of your bots, or of this organization's." }, false)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
    end
  end

  foul operatorsSet(user: User, tab: Tab, botId: String, operators: [String]) -> (Tab, Bool) do
    let refused = Tab { ...tab, dialog: "bots", dialogProblem: "" }
    match currentOrganization(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !manageable(user, organization).any? { |bot| bot.id == botId }
          return (Tab { ...refused, dialogProblem: "Only the bot owner or a workspace administrator can change its operators." }, false)
        end
        let roster : [String] = Memberships.roster(organization.id).or([])
        let people = Users.everyone.or([])
          .filter { |person| roster.contains?(person.id) && !person.bot? }
        if operators.any? { |id| !people.any? { |person| person.id == id } }
          return (Tab { ...refused, dialogProblem: "Choose people in this workspace." }, false)
        end
        match DB.Repositories.BotOperators.replaced(botId, operators) do
          Ok(_) => return (Tab { ...refused, notice: "Bot operators saved." }, true)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
    end
  end

  # Whether a bot is this person's own.
  ownBot : User -> String -> Bool
  foul ownBot(user, id) = Users.operated(user.id).or([]).any? { |bot| bot.id == id }

  # How much of a channel or group chat its bots may read. Only an
  # administrator changes it.
  botAccessSet : User -> Tab -> String -> (Tab, Bool)
  foul botAccessSet(user, tab, access) do
    let refused = Tab { ...settled(tab), retitling?: false }
    return (tab, false) if !["none", "mentions", "all"].contains?(access)

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => do
        return (tab, false) if !conversation.channel? && !conversation.group?
        if !App.Services.Authority.canAdminister(user, conversation)
          return (Tab { ...refused, failure: "Only an administrator can change what bots read here." }, false)
        end

        match Conversations.botAccess(conversation.id, access) do
          Ok(true) => return (Tab { ...refused, notice: "Bots here read ${access}." }, true)
          Ok(false) => return (Tab { ...refused, failure: "That conversation is not there." }, false)
          Error(reason) => return (Tab { ...refused, failure: reason }, false)
        end
      end
    end
  end

  # Changes a channel's settings at once: who may read it, the team that
  # owns it, and how much its bots may read. Only an administrator, and only
  # a channel.
  settingsSet : User -> Tab -> [(String, String?)] -> (Tab, Bool)
  foul settingsSet(user, tab, entries) do
    let refused = Tab { ...settled(tab), view: "settings" }
    let access = field(entries, "access")
    let botAccess = field(entries, "bot-access")
    let teamId = field(entries, "team")
    return (Tab { ...refused, failure: "Pick who may read it." }, false) if !["public", "private"].contains?(access)
    return (Tab { ...refused, failure: "Pick what bots may read." }, false) if !["none", "mentions", "all"].contains?(botAccess)

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => do
        return (tab, false) if !conversation.channel?
        if !App.Services.Authority.canAdminister(user, conversation)
          return (Tab { ...refused, failure: "Only an administrator can change a channel's settings." }, false)
        end
        if !teamId.empty? && teamId != conversation.teamId
          let owner : Team? = match Teams.single(teamId) do
            Ok(found) => found
            Error(_) => None
          end
          let owns = owner.map { |team| team.organizationId == conversation.organizationId && team.includes?(user.id) }.or(false)
          return (Tab { ...refused, failure: "A channel can only belong to a team you are in." }, false) if !owns
        end

        match Conversations.configured(conversation.id, access, teamId, botAccess) do
          Ok(true) => return (Tab { ...settled(tab), view: "", notice: "Channel settings saved." }, true)
          Ok(false) => return (Tab { ...refused, failure: "That conversation is not there." }, false)
          Error(reason) => return (Tab { ...refused, failure: reason }, false)
        end
      end
    end
  end

  # Gives a person a role in the tab's organization. Only an administrator
  # changes roles, only of someone in the organization, and the last
  # administrator cannot be demoted.
  roleGiven : User -> Tab -> String -> String -> (Tab, Bool)
  foul roleGiven(user, tab, personId, role) do
    let refused = Tab { ...settled(tab), profile: personId }
    return (tab, false) if !["admin", "member", "read-only"].contains?(role)
    return (tab, false) if personId == user.id

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !App.Services.Authority.canManage(user, organization.id)
          return (Tab { ...refused, failure: "Only an administrator can change a member's role." }, false)
        end
        let was = App.Services.Authority.role(personId, "organization", organization.id)
        return (Tab { ...refused, failure: "They are not in ${organization.name}." }, false) if !was.set?
        if role != "admin" && was == Just("admin") && App.Services.Authority.admins(organization.id).count <= 1
          return (Tab { ...refused, failure: "The last administrator cannot be demoted." }, false)
        end

        match Grants.granted(Grant { subjectType: "user", subjectId: personId, resourceType: "organization", resourceId: organization.id, role: role }) do
          Ok(_) => return (Tab { ...refused, notice: "Their role is ${role} now." }, true)
          Error(reason) => return (Tab { ...refused, failure: reason }, false)
        end
      end
    end
  end

  # Takes a person out of the tab's organization. Only an administrator
  # does it, and not to the last one.
  roleTaken : User -> Tab -> String -> (Tab, Bool)
  foul roleTaken(user, tab, personId) do
    let refused = Tab { ...settled(tab), profile: "" }
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !App.Services.Authority.canManage(user, organization.id)
          return (Tab { ...refused, failure: "Only an administrator can remove a member." }, false)
        end
        let was = App.Services.Authority.role(personId, "organization", organization.id)
        return (Tab { ...refused, failure: "They are not in ${organization.name}." }, false) if !was.set?
        if was == Just("admin") && App.Services.Authority.admins(organization.id).count <= 1
          return (Tab { ...refused, failure: "The last administrator cannot be removed." }, false)
        end

        match Grants.revoked(Grants.key("user", personId, "organization", organization.id)) do
          Ok(_) => return (Tab { ...refused, notice: "They are no longer in ${organization.name}." }, true)
          Error(reason) => return (Tab { ...refused, failure: reason }, false)
        end
      end
    end
  end

  let statusRules = rules do
    validates("text", "A status", [sized(0, 80)])
  end

  # What somebody says about themselves: an emoji Slick offers, and a few
  # words. Both empty takes it back.
  restyled : User -> Tab -> String -> String -> (Tab, Bool)
  foul restyled(user, tab, emoji, saying) do
    let refused = Tab { ...settled(tab), dialog: "status" }
    let problems = Metro.Validation.checked(statusRules, {"text": saying}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?
    return (Tab { ...refused, dialogProblem: "Pick one of the emoji offered." }, false) if !App.Models.Emoji.status?(emoji)

    match Users.restyled(user.id, emoji, saying) do
      Ok(_) => return (settled(tab), true)
      Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
    end
  end

  # Changes somebody's own details. One a sync has taken over keeps what is
  # stored, whatever was sent for it: the form shows it, but only to read.
  described : User -> Tab -> [(String, String?)] -> (Tab, Bool)
  foul described(user, tab, entries) do
    let refused = Tab { ...settled(tab), dialog: "profile" }
    match Users.member(user.id) do
      Ok(Just(stored)) => do
        let given = App.Models.User.DETAILS.map do |column, _label, _longest|
          let kept = stored.locked?(column)
          (column, kept then stored.detail(column) else field(entries, column).trim)
        end
        let problems = App.Models.User.DETAILS.flatMap do |column, label, longest|
          faults(column, label, longest, chosen(given, column))
        end
        return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

        let changed = User {
          ...stored,
          name: chosen(given, "name"),
          title: chosen(given, "title"),
          department: chosen(given, "department"),
          phone: chosen(given, "phone"),
          timeZone: chosen(given, "time_zone"),
          bio: chosen(given, "bio"),
          nickname: chosen(given, "nickname"),
          nicknameShown?: field(entries, "show_nickname") == "yes"
        }
        match Users.described(changed) do
          Ok(_) => return (settled(tab), true)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
      _ => return (tab, false)
    end
  end

  # What was given for one detail.
  chosen : [(String, String)] -> String -> String
  let chosen(pairs, column) = pairs
    .flatMap { |key, value| key == column then [value] else [] }
    .first
    .or("")

  # What is wrong with what was given for one detail: a display name is
  # needed, and none may be longer than it may.
  faults : String -> String -> Integer -> String -> [String]
  let faults("name", label, longest, "") = ["${label} cannot be empty."]
  let faults(column, label, longest, text) do
    return [] if text.chars.count <= longest
    ["${label} cannot be longer than ${longest} characters."]
  end

  # Somebody is typing: said for a few seconds, to everyone else there.
  typing : Server<Presence> -> User -> Tab -> (Tab, Bool)
  foul typing(statuses, user, tab) = (tab, noting(statuses, user, tab, "", TYPING_FOR))

  # The message that starts the thread this message is in — itself, when it
  # is not a reply — if it belongs to this conversation.
  rooted : Conversation -> String -> Message?
  foul rooted(conversation, id) do
    return None if id.empty?

    match Messages.single(id) do
      Ok(Just(message)) => do
        return None if message.conversationId != conversation.id
        return Just(message) if message.parentId.empty?
        return rooted(conversation, message.parentId)
      end
      _ => return None
    end
  end

  # An open thread: the message that started it, then its replies. Empty
  # when no thread is open, or the one asked for is not in this conversation.
  unfolded : Conversation -> String -> [Message]
  foul unfolded(conversation, id) do
    match rooted(conversation, id) do
      None => return []
      Just(first) => do
        let replies : [Message] = Messages.answering(first.id).or([])
        return [first] + replies
      end
    end
  end

  threaded : User -> Tab -> String -> (Tab, Bool)
  foul threaded(user, tab, id) do
    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match rooted(conversation, id) do
        Just(first) => return (Tab { ...settled(tab), thread: first.id, profile: "", team: "" }, false)
        None => return (tab, false)
      end
    end
  end

  # Opens somebody's profile beside the conversation, in place of a thread:
  # only of somebody in the tab's organization.
  profiled : User -> Tab -> String -> (Tab, Bool)
  foul profiled(user, tab, id) do
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        return (tab, false) if !affiliated?(organization.id, id)
        return (Tab { ...settled(tab), thread: "", profile: id, team: "" }, false)
      end
    end
  end

  # Keeps what is being written in one of the tab's message boxes, as it is
  # written: `place` is "reply" for the open thread's, and anything else for
  # the conversation's. Where it is kept is the tab's to say, not the
  # browser's. Nobody else is shown it, so no other tab is told.
  drafted : User -> Tab -> String -> String -> (Tab, Bool)
  foul drafted(user, tab, place, body) do
    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => do
        let root = rooted(conversation, tab.thread).map { |first| first.id }.or("")
        let thread = place == "reply" then root else ""
        return (tab, false) if place == "reply" && thread.empty?

        let draft = Draft {
          conversationId: conversation.id,
          threadId: thread,
          personId: conversation.direct? then conversation.counterpart(user.id) else "",
          body: body.take(App.Models.Message.LONGEST)
        }
        Drafts.kept(user.id, draft)
        return (tab, false)
      end
    end
  end

  # A reply goes into the thread the tab has open, and nowhere else.
  replied : Server<App.Live.Events.Bus> -> Server<Presence> -> User -> Tab -> String -> (Tab, Bool)
  foul replied(events, statuses, user, tab, body) do
    let problems = Metro.Validation.checked(messageRules, {"body": body}).messages
    return (tab, false) if !problems.empty?

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => do
        return (tab, false) if !App.Services.Authority.canWrite(user, conversation)
        match rooted(conversation, tab.thread) do
          None => return (tab, false)
          Just(first) => do
            # A command for a bot is used, not said.
            if invoked(events, user, conversation, first.id, body)
              statuses.lifted(conversation.id, user.id)
              return (Tab { ...settled(tab), thread: first.id }, true)
            end
            return repliedTo(events, statuses, user, tab, conversation, first, body)
          end
        end
      end
    end
  end

  # A reply said in the thread `first` starts.
  repliedTo : Server<App.Live.Events.Bus> -> Server<Presence> -> User -> Tab -> Conversation -> Message -> String -> (Tab, Bool)
  foul repliedTo(events, statuses, user, tab, conversation, first, body) do
    match Messages.said(conversation.id, user.id, body, first.id) do
      Ok(reply) => do
        happened(events, conversation, "message", reply.id, first.id, reply.sentAt, "", body)
        statuses.lifted(conversation.id, user.id)
        # Who replies in a thread follows it, and has read it so far.
        Readings.reached(user.id, Reading {
          conversationId: conversation.id,
          threadId: first.id,
          readAt: reply.sentAt
        })
        Drafts.kept(user.id, Draft {
          conversationId: conversation.id,
          threadId: first.id,
          body: ""
        })
        return (Tab { ...settled(tab), thread: first.id }, true)
      end
      Error(reason) => return (Tab { ...settled(tab), failure: "Not sent: ${reason}" }, false)
    end
  end

  opened : User -> Tab -> String -> (Tab, Bool)
  foul opened(user, tab, id) do
    return (tab, false) if id.empty?

    match visible(user, Tab { organization: tab.organization, conversation: id }) do
      Just(conversation) => return (Tab { organization: conversation.organizationId, conversation: conversation.id }, false)
      None => return (tab, false)
    end
  end

  # Opens the private chat with another person of the organization, starting
  # it if need be — or with themselves: a place of their own, where nobody
  # else looks, to keep notes in and try Slick out.
  whispered : User -> Tab -> String -> (Tab, Bool)
  foul whispered(user, tab, other) do
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        return (tab, false) if !affiliated?(organization.id, other)

        match Conversations.between(organization.id, user.id, other) do
          Ok(conversation) => return (Tab { organization: organization.id, conversation: conversation.id }, false)
          Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
        end
      end
    end
  end

  # Not called `founded`: a function here with the name and the number of
  # arguments of a repository method makes the call to that method lose an
  # argument when compiled, and fail as `undef` when run (kexhq/kex#451).
  # A channel: public, or private — to whoever made it, and to the team
  # that owns it, if one does. Only a team somebody is in can be given a
  # channel by them.
  established : User -> Tab -> String -> String -> String -> (Tab, Bool)
  foul established(user, tab, title, access, teamId) do
    let refused = Tab { ...settled(tab), dialog: "channel" }
    let problems = Metro.Validation.checked(channelRules, {"title": title}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !App.Services.Authority.canCreate(user, organization.id)
          return (Tab { ...refused, dialogProblem: "You may not make a channel in ${organization.name}." }, false)
        end
        let owner : Team? = match Teams.single(teamId) do
          Ok(found) => found
          Error(_) => None
        end
        let owns = owner.map { |team| team.organizationId == organization.id && team.includes?(user.id) }.or(teamId.empty?)
        return (Tab { ...refused, dialogProblem: "A channel can only be made for a team you are in." }, false) if !owns

        let kept = access == "private" then "private" else "public"
        match Conversations.founded(organization.id, title, user.id, access: kept, teamId: teamId) do
          Ok(channel) => return (Tab { organization: organization.id, conversation: channel.id }, true)
          Error(_) => return (Tab { ...refused, dialogProblem: "There is already a channel called ${title}." }, false)
        end
      end
    end
  end

  # Starts a group chat with the people picked, or opens the one they
  # already have; with one person picked, the private chat with them.
  gathered : User -> Tab -> [String] -> (Tab, Bool)
  foul gathered(user, tab, picked) do
    let refused = Tab { ...settled(tab), dialog: "group" }
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        let others = picked.uniq.filter { |id| id != user.id && affiliated?(organization.id, id) }
        return (Tab { ...refused, dialogProblem: "Pick at least one person." }, false) if others.empty?
        return whispered(user, settled(tab), others.first.or("")) if others.count == 1

        match Conversations.among(organization.id, others, user.id) do
          Ok(chat) => return (Tab { organization: organization.id, conversation: chat.id }, true)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
    end
  end

  # Makes the group chat the tab shows a channel, public or private. Whoever
  # was in it stays in it.
  promotedTo : User -> Tab -> String -> String -> (Tab, Bool)
  foul promotedTo(user, tab, title, access) do
    let refused = Tab { ...settled(tab), dialog: "promote" }
    let problems = Metro.Validation.checked(channelRules, {"title": title}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => do
        return (settled(tab), false) if !conversation.group?
        if !App.Services.Authority.canAdminister(user, conversation)
          return (Tab { ...refused, dialogProblem: "Only an administrator can make this a channel." }, false)
        end

        let kept = access == "public" then "public" else "private"
        match Conversations.promoted(conversation.id, title, kept) do
          Ok(channel) => return (Tab { organization: channel.organizationId, conversation: channel.id }, true)
          Error(_) => return (Tab { ...refused, dialogProblem: "There is already a channel called ${title}." }, false)
        end
      end
    end
  end

  # Lets people of the organization into the private channel the tab shows.
  admittedTo : User -> Tab -> [String] -> (Tab, Bool)
  foul admittedTo(user, tab, picked) do
    let refused = Tab { ...settled(tab), dialog: "admit" }
    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => do
        return (settled(tab), false) if !conversation.channel? || conversation.public?
        if !App.Services.Authority.canAdminister(user, conversation)
          return (Tab { ...refused, dialogProblem: "Only an administrator of this channel can add people." }, false)
        end

        let newcomers = picked.uniq.filter do |id|
          !conversation.admits?(id) && affiliated?(conversation.organizationId, id)
        end
        return (Tab { ...refused, dialogProblem: "Pick at least one person who is not in it yet." }, false) if newcomers.empty?

        match Conversations.admitted(conversation.id, newcomers) do
          Ok(count) => return (Tab { ...settled(tab), notice: count == 1 then "Added one person." else "Added ${count} people." }, true)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
    end
  end

  # The team the tab has open, if it is one of the tab's organization.
  teamHere : User -> Tab -> Team?
  foul teamHere(user, tab) do
    return None if tab.team.empty?

    match home(user, tab) do
      None => return None
      Just(organization) => match Teams.single(tab.team) do
        Ok(Just(team)) => return team.organizationId == organization.id then Just(team) else None
        _ => return None
      end
    end
  end

  # Opens a team beside the conversation, in place of a thread or a profile.
  teamed : User -> Tab -> String -> (Tab, Bool)
  foul teamed(user, tab, id) do
    let opened = Tab { ...settled(tab), thread: "", profile: "", team: id }
    match teamHere(user, opened) do
      Just(_) => return (opened, false)
      None => return (tab, false)
    end
  end

  # A new team, with whoever made it in it. Its handle is the one given, or
  # else what its name suggests.
  teamFormed : User -> Tab -> [(String, String?)] -> (Tab, Bool)
  foul teamFormed(user, tab, entries) do
    let refused = Tab { ...settled(tab), dialog: "team" }
    let name = field(entries, "name").trim
    let description = field(entries, "description").trim
    let given = field(entries, "handle").trim.lowerCase
    let handle = given.startsWith?("@") then given.drop(1) else given
    let chosen = handle.empty? then App.Models.Team.handled(name) else handle
    let problems = Metro.Validation.checked(teamRules, {"name": name, "description": description}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?
    return (Tab { ...refused, dialogProblem: "A handle has 2 to 30 lower-case letters, digits and dashes, and starts with a letter." }, false) if !App.Models.Team.handle?(chosen)

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        if !App.Services.Authority.canCreate(user, organization.id)
          return (Tab { ...refused, dialogProblem: "You may not make a team in ${organization.name}." }, false)
        end
        let team = Team {
          id: "",
          organizationId: organization.id,
          handle: chosen,
          name: name,
          description: description,
          members: [user.id]
        }
        match Teams.formed(team, user.id) do
          Ok(made) => return (Tab { ...settled(tab), thread: "", profile: "", team: made.id }, true)
          Error(_) => return (Tab { ...refused, dialogProblem: "There is already a team called @${chosen}." }, false)
        end
      end
    end
  end

  # What a team a sync keeps says when somebody tries to change it here.
  let SYNCED = "kept in sync from your organization's directory: change it there."

  # Renames the open team, and says again what it is for.
  teamRevised : User -> Tab -> [(String, String?)] -> (Tab, Bool)
  foul teamRevised(user, tab, entries) do
    let refused = Tab { ...settled(tab), dialog: "team-edit" }
    let name = field(entries, "name").trim
    let description = field(entries, "description").trim
    let problems = Metro.Validation.checked(teamRules, {"name": name, "description": description}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    match teamHere(user, tab) do
      None => return (settled(tab), false)
      Just(team) => do
        return (Tab { ...refused, dialogProblem: "@${team.handle} is ${SYNCED}" }, false) if team.managed?

        match Teams.revised(team.id, name, description) do
          Ok(_) => return (settled(tab), true)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
    end
  end

  # Puts people of the organization in the open team.
  teamJoined : User -> Tab -> [String] -> (Tab, Bool)
  foul teamJoined(user, tab, picked) do
    match teamHere(user, tab) do
      None => return (tab, false)
      Just(team) => do
        return (Tab { ...settled(tab), failure: "@${team.handle} is ${SYNCED}" }, false) if team.managed?

        let newcomers = picked.filter { |id| affiliated?(team.organizationId, id) }
        match Teams.joinedAll(team.id, newcomers) do
          Ok(count) => return (settled(tab), count > 0)
          Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
        end
      end
    end
  end

  # Takes somebody out of the open team.
  teamLeft : User -> Tab -> String -> (Tab, Bool)
  foul teamLeft(user, tab, id) do
    match teamHere(user, tab) do
      None => return (tab, false)
      Just(team) => do
        return (Tab { ...settled(tab), failure: "@${team.handle} is ${SYNCED}" }, false) if team.managed?

        match Teams.left(team.id, id) do
          Ok(count) => return (settled(tab), count > 0)
          Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
        end
      end
    end
  end

  # A file somebody has uploaded waits in the tab's message box, to go with
  # the next message: only one of theirs that has not been sent.
  shared : User -> Tab -> String -> (Tab, Bool)
  foul shared(user, tab, id) do
    match Attachments.single(id) do
      Ok(Just(file)) => do
        return (tab, false) if file.userId != user.id || file.sent? || tab.pending.contains?(id)
        return (Tab { ...tab, pending: (tab.pending + [id]).take(PENDING) }, false)
      end
      _ => return (tab, false)
    end
  end

  # How many files can go with one message.
  let PENDING = 10

  sent : Server<App.Live.Events.Bus> -> Server<Presence> -> User -> Tab -> String -> (Tab, Bool)
  foul sent(events, statuses, user, tab, body) do
    # A message needs words, unless files go with it.
    let problems = Metro.Validation.checked(messageRules, {"body": body}).messages
    let unfit = tab.pending.empty? || body.chars.count > App.Models.Message.LONGEST
    return (tab, false) if !problems.empty? && unfit

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => do
        return (tab, false) if !App.Services.Authority.canWrite(user, conversation)
        # A command for a bot is used, not said; the files waiting stay.
        if invoked(events, user, conversation, "", body)
          statuses.lifted(conversation.id, user.id)
          return (settled(tab), true)
        end
        return postedTo(events, statuses, user, tab, conversation, body)
      end
    end
  end

  # A message said in the conversation, with the files waiting in its box.
  postedTo : Server<App.Live.Events.Bus> -> Server<Presence> -> User -> Tab -> Conversation -> String -> (Tab, Bool)
  foul postedTo(events, statuses, user, tab, conversation, body) do
    match posting(events, user, conversation, body, tab.pending) do
      Ok(message) => do
        # Whatever they were said to be doing, they have done.
        statuses.lifted(conversation.id, user.id)
        return (Tab { ...settled(tab), pending: [] }, true)
      end
      Error(reason) => return (Tab { ...settled(tab), failure: "Not sent: ${reason}" }, false)
    end
  end

  # A message, with what goes with it, all or nothing: whoever starts a
  # thread follows it, the files waiting in the box go with it, and the
  # draft it was is gone.
  posting : Server<App.Live.Events.Bus> -> User -> Conversation -> String -> [String] -> Result<Message, String>
  foul posting(events, user, conversation, body, pending) do
    let posted : Result<Message, String> = Harmat.Database.transaction do
      let message : Message = Messages.said(conversation.id, user.id, body, "").try
      Readings.reached(user.id, Reading {
        conversationId: conversation.id,
        threadId: message.id,
        readAt: message.sentAt
      }).try
      Attachments.sent(user.id, pending, conversation.id, message.id).try
      Drafts.kept(user.id, Draft { conversationId: conversation.id, body: "" }).try
      Ok(message)
    end
    match posted do
      Ok(message) => happened(events, conversation, "message", message.id, "", message.sentAt, "", body)
      Error(_) => ()
    end
    return posted
  end

  # Answers a form a message asks. The answer is kept with that message —
  # it is not a message of its own — and replaces an earlier one this person
  # gave to the same form. The tab stays as it is.
  answered : Server<App.Live.Events.Bus> -> User -> Tab -> [(String, String?)] -> (Tab, Bool)
  foul answered(events, user, tab, entries) do
    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match Messages.single(field(entries, "message")) do
        Ok(Just(message)) => do
          return (tab, false) if message.conversationId != conversation.id

          match App.Helpers.RichText.answer(message.body, entries) do
            None => return (tab, false)
            Just((form, said)) => match Answers.recorded(conversation.organizationId, message, form, user.id, said) do
              Ok(given) => do
                # Only the bot whose form it was is told, and it is told only
                # where to look.
                happened(events, conversation, "answer", message.id, message.parentId, given.answeredAt, message.userId, "")
                return (tab, true)
              end
              Error(reason) => return (Tab { ...tab, failure: "Not answered: ${reason}" }, false)
            end
          end
        end
        _ => return (tab, false)
      end
    end
  end

  retitled : User -> Tab -> String -> (Tab, Bool)
  foul retitled(user, tab, topic) do
    let problems = Metro.Validation.checked(topicRules, {"topic": topic}).messages
    return (Tab { ...settled(tab), retitling?: true, failure: problems.first.or("") }, false) if !problems.empty?

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match Conversations.retitled(conversation.id, topic) do
        Ok(changed) => return (settled(tab), changed)
        Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
      end
    end
  end

  # A reaction goes on a message of the conversation the tab is showing, and
  # nowhere else: the message is looked up, and has to belong to it.
  reacted : User -> Tab -> String -> String -> (Tab, Bool)
  foul reacted(user, tab, messageId, emoji) do
    return (tab, false) if !App.Models.Emoji.reaction?(emoji)

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match Messages.single(messageId) do
        Ok(Just(message)) => do
          return (tab, false) if message.conversationId != conversation.id
          match Reactions.flipped(message, user.id, emoji) do
            Ok(_) => return (tab, true)
            Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
          end
        end
        _ => return (tab, false)
      end
    end
  end
end
