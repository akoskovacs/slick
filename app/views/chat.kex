# Slick's markup: a layout, and the live region inside it — a sidebar of
# channels and people, and the conversation that is open. The templates are
# the `.ket` files beside this module; `<%= %>` escapes what it prints.
#
# The records here are what the templates print. Their field names are
# chosen not to match any function in the program, because a template reads
# `item.name` as a call to `name(item)` when one exists (kexhq/kex#448).
module App.Views.Chat

using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Message, only: [Message]
using App.Models.Organization, only: [Organization]
using App.Models.Reaction, only: [Reaction]
using App.Models.Answer, only: [Answer]
using App.Models.Draft, only: [Draft]
using App.Helpers.RichText, only: [Given]
using App.Models.User, only: [User]
using Metro.Live.Presence, only: [Note]

# One line of the sidebar.
record Entry do
  # The event the line sends, and the field it sends it with.
  action : String
  subject : String
  key : String
  caption : String
  current? : Bool
  # "BOT" beside a bot's name; "" beside a person's.
  badged : String = ""
  # Whether they have a tab open.
  online? : Bool = false
  # The emoji of their status, and its words for whoever points at it.
  emblem : String = ""
  emblemNote : String = ""
  # Whether something is written there and not sent, and so marked ✏️.
  drafted? : Bool = false
end

# One of my bots, in the bots dialog.
record Robot do
  key : String
  caption : String
  # Whether it is in the organization the tab is in, and what that is called.
  here? : Bool
  spot : String
  # Whose it is, in words.
  belonging : String = ""
end

# One organization in the rail.
record Badge do
  key : String
  glyph : String
  caption : String
  current? : Bool
end

# One message.
record Bubble do
  key : String
  # The element's id: a message shown in the conversation and again at the
  # head of its thread is two elements.
  anchor : String
  author : String
  badged : String = ""
  emblem : String = ""
  emblemNote : String = ""
  # The author's first letter and one of eight colours, for the avatar.
  initial : String
  tint : String
  # The author's id, to open their profile with.
  writer : String = ""
  stamp : String
  # The message as markup, already escaped: `App.Helpers.RichText.html`.
  content : String
  own? : Bool
  # "3 replies", or "" when there are none or it is shown inside the thread.
  answers : String = ""
  # Whether a thread can be opened from it.
  threadable? : Bool = true
  # Whether it carries on from the message above — the same person, soon
  # after — and so is shown without their name and picture again.
  continued? : Bool = false
end

# Somebody's profile, beside the conversation.
record Card do
  key : String
  caption : String
  initial : String
  tint : String
  badged : String = ""
  emblem : String = ""
  motto : String = ""
  # "Active" or "Away".
  presence : String
  active? : Bool
  # Their email; "" for a bot, whose address is nobody's to write to.
  mail : String = ""
  # Who a bot belongs to, and the id of that person to open their profile
  # with; "" for a person, and a key of "" for an organization's bot.
  keeper : String = ""
  keeperKey : String = ""
  # What else their profile says, as they gave it; "" for what it does not.
  # `alias` is their name when they go by their nickname.
  alias : String = ""
  role : String = ""
  team : String = ""
  about : String = ""
  dial : String = ""
  zone : String = ""
  # Whether it is whoever is looking.
  own? : Bool
end

# One detail in the form that changes a profile.
record Detail do
  key : String
  caption : String
  worth : String
  longest : String
  hint : String = ""
  # Whether it is a few lines rather than one.
  long? : Bool = false
  # Whether a sync has taken it over: shown, and not to be changed here.
  locked? : Bool = false
end

# What somebody is in the middle of, under the conversation.
record Standing do
  who : String
  doing : String
  # When it stops being true, in milliseconds since 1970.
  lapses : String
end

# One emoji under a message: how many put it there, and whether I did.
record Chip do
  key : String
  glyph : String
  tally : String
  own? : Bool
end

let layout = Template.html(Kex.embed("layouts/application.html.ket"))
let frame = Template.html(Kex.embed("chat/index.html.ket"))
let entryPartial = Template.html(Kex.embed("chat/_entry.html.ket"))
let headingPartial = Template.html(Kex.embed("chat/_heading.html.ket"))
let badgePartial = Template.html(Kex.embed("chat/_badge.html.ket"))
let botPartial = Template.html(Kex.embed("chat/_bot.html.ket"))
let botsPartial = Template.html(Kex.embed("chat/_bots.html.ket"))
let dialogPartial = Template.html(Kex.embed("chat/_dialog.html.ket"))
let welcomePartial = Template.html(Kex.embed("chat/_welcome.html.ket"))
let bubblePartial = Template.html(Kex.embed("chat/_bubble.html.ket"))
let chipPartial = Template.html(Kex.embed("chat/_chip.html.ket"))
let topbarPartial = Template.html(Kex.embed("chat/_topbar.html.ket"))
let moodPartial = Template.html(Kex.embed("chat/_mood.html.ket"))
let statusPartial = Template.html(Kex.embed("chat/_status.html.ket"))
let threadPartial = Template.html(Kex.embed("chat/_thread.html.ket"))
let profilePartial = Template.html(Kex.embed("chat/_profile.html.ket"))
let detailsPartial = Template.html(Kex.embed("chat/_details.html.ket"))
let detailPartial = Template.html(Kex.embed("chat/_detail.html.ket"))
let composerPartial = Template.html(Kex.embed("chat/_composer.html.ket"))

# The document: head, who is signed in, the live region, and Metro's script.
# The live region is all of it, the bar across the top included: the name
# and status there change like everything else.
page : String -> String
let page(live) = layout(live)

# The live region for somebody who is in no organization yet.
welcome : Tab -> User -> String
let welcome(tab, user) = welcomePartial(user.shown, user.email, tab.dialogProblem, topbar(user, false))

# The live region.
#
# `organizations` are the ones this person is in; `organization` is the one
# the tab is in, and the channels and people are its.
# `thread` is the open thread — the message that started it, then the
# replies — or empty.
#
# `bots` are the ones this person may look after here — the organization's
# and their own — and only asked for while their dialog is open.
#
# `drafts` are what this person has written and not sent, anywhere.
#
# `doing` is what other people there are in the middle of right now.
#
# `online` are the ids of the people with a tab open.
index : Tab -> User -> [Organization] -> Organization -> [Conversation] -> [User] -> [String] -> [User] -> [Draft] -> Conversation? -> [Message] -> [Reaction] -> [Answer] -> [Message] -> [Note] -> String
let index(tab, user, organizations, organization, channels, people, online, bots, drafts, conversation, messages, reactions, responses, thread, doing) do
  let shown = conversation.map { |open| open.id }.or("")
  let badges = organizations.map { |each|
    badgePartial(Badge { key: each.id, glyph: each.name.take(1).upperCase, caption: each.name, current?: each.id == organization.id })
  }
  let channelLines = channels.map { |channel|
    let drafted = channel.id != shown && drafts.any? { |draft| draft.conversationId == channel.id }
    entryPartial(Entry { action: "open", subject: "id", key: channel.id, caption: "# ${channel.title}", current?: channel.id == shown, drafted?: drafted })
  }
  # A person's own bots have a list of their own; everybody else's, and the
  # organization's, are among the people, marked as bots.
  # This person as stored now: the `user` a tab was opened with does not
  # know of a status set since.
  let me = people.find { |person| person.id == user.id }.or(user)
  let alone = conversation.map { |open| open.solo? && open.admits?(user.id) }.or(false)
  let selfLine = entryPartial(Entry { action: "direct", subject: "user", key: user.id, caption: "${me.shown} (you)", current?: alone, online?: online.contains?(user.id), emblem: me.statusEmoji, emblemNote: me.statusText, drafted?: !alone && waiting(drafts, user.id) })
  let personLines = people.reject { |person| person.id == user.id || person.ownerId == user.id }.map { |person|
    let chatting = conversation.map { |open| !open.channel? && open.counterpart(user.id) == person.id }.or(false)
    entryPartial(Entry { action: "direct", subject: "user", key: person.id, caption: person.shown, current?: chatting, badged: person.bot? then "BOT" else "", online?: person.bot? || online.contains?(person.id), emblem: person.statusEmoji, emblemNote: person.statusText, drafted?: !chatting && waiting(drafts, person.id) })
  }
  let robotLines = people.filter { |person| person.ownerId == user.id }.map { |person|
    let chatting = conversation.map { |open| !open.channel? && open.counterpart(user.id) == person.id }.or(false)
    entryPartial(Entry { action: "direct", subject: "user", key: person.id, caption: person.shown, current?: chatting, badged: person.bot? then "BOT" else "", online?: person.bot? || online.contains?(person.id), emblem: person.statusEmoji, emblemNote: person.statusText, drafted?: !chatting && waiting(drafts, person.id) })
  }
  let unsent = { |threadId| drafts.find { |draft| draft.conversationId == shown && draft.threadId == threadId }.map { |draft| draft.body }.or("") }
  let beside = thread.empty? then profilePane(tab, user, organization, people, online) else threadPane(user, people, reactions, responses, thread, unsent(opened(thread)))
  let place = conversation.map { |open| located(organization, open, user, thread) }.or("")
  let caption = conversation.map { |open| "${titled(open, user, people)} · ${organization.name}" }.or(organization.name)
  frame(
    tab.failure, tab.notice, badges.join("\n"), organization.name, channelLines.join("\n"), ([selfLine] + personLines).join("\n"), robotLines.join("\n"), topbar(me, true),
    pane(tab, user, people, conversation, messages, reactions, responses, thread.empty? && tab.dialog.empty?, doing, unsent("")) + beside,
    asking(tab, organization, people, bots, me), place, caption
  )
end

private do
  # The bar across the top: who is signed in, and under their name what
  # they say about themselves and the way to change it. `placed?` is whether
  # they are in an organization, where they have a profile to open.
  topbar : User -> Bool -> String
  let topbar(me, placed?) do
    let set = !me.statusEmoji.empty? || !me.statusText.empty?
    let saying = set then "${me.statusEmoji} ${me.statusText}".trim else "No status set"
    topbarPartial(me.shown, me.statusEmoji, saying, set, placed? then me.id else "")
  end

  # The profile a tab has open, if it is of somebody in the organization.
  # A bot's says whose it is: a person's, or the organization's.
  profilePane : Tab -> User -> Organization -> [User] -> [String] -> String
  let profilePane(tab, user, organization, people, online) do
    match people.find { |person| person.id == tab.profile } do
      None => ""
      Just(person) => do
        let active = person.bot? || online.contains?(person.id)
        let owner = people.find { |each| each.id == person.ownerId }
        let keeper = person.ownerOrganizationId.empty? then owner.map { |each| each.shown }.or(person.bot? then "Someone" else "") else organization.name
        profilePartial(Card {
          key: person.id, caption: person.shown, initial: person.shown.take(1).upperCase, tint: "${BEAM.erlang.phash2(person.id, 8)}",
          badged: person.bot? then "BOT" else "", emblem: person.statusEmoji, motto: person.statusText,
          presence: active then "Active" else "Away", active?: active, mail: person.bot? then "" else person.email,
          keeper: keeper, keeperKey: owner.map { |each| each.id }.or(""), own?: person.id == user.id,
          alias: person.shown == person.name then "" else person.name, role: person.title, team: person.department,
          dial: person.phone, zone: person.timeZone, about: person.bio
        })
      end
    end
  end

  # Where a conversation is, as an address: the one the address bar shows
  # and `App.Live.Chat.arrived` reads back.
  located : Organization -> Conversation -> User -> [Message] -> String
  let located(organization, conversation, user, thread) do
    let channel = App.Paths.channelPath.filled({"organization": organization.slug, "name": conversation.title})
    let direct = App.Paths.directPath.filled({"organization": organization.slug, "person": conversation.counterpart(user.id)})
    App.Paths.threaded(conversation.channel? then channel else direct, opened(thread))
  end

  # The id of the message an open thread starts with; "" when none is open.
  opened : [Message] -> String
  let opened([]) = ""
  let opened([opening | replies]) = opening.id

  # The answers a message's forms have had, as the forms show them: whose
  # each is, by the name they go by.
  answered : Message -> User -> [User] -> [Answer] -> [Given]
  let answered(message, user, people, responses) do
    responses.filter { |each| each.messageId == message.id }.map { |each|
      let who = people.find { |person| person.id == each.userId }.map { |person| person.shown }.or("Someone")
      Given { form: each.form, who: who, mine?: each.userId == user.id, answer: each.answer }
    }
  end

  # The dialog a tab has open, if any.
  asking : Tab -> Organization -> [User] -> [User] -> User -> String
  let asking(tab, organization, people, bots, me) do
    if tab.dialog == "status"
      let presets = App.Models.Emoji.STATUSES.map { |entry| match entry do (glyph, words) => preset(glyph, words) end }
      let glyphs = [""] + App.Models.Emoji.STATUSES.map { |entry| match entry do (glyph, _) => glyph end } + App.Models.Emoji.KNOWN.map { |entry| match entry do (_, glyph) => glyph end }
      let options = glyphs.map { |glyph| choice(glyph, glyph == me.statusEmoji) }
      return moodPartial(presets.join(""), options.join(""), me.statusText, tab.dialogProblem)
    end

    if tab.dialog == "profile"
      let inputs = App.Models.User.DETAILS.map { |entry|
        match entry do
          (column, label, longest) => detailPartial(Detail {
            key: column, caption: label, worth: me.detail(column), longest: "${longest}",
            hint: column == "time_zone" then "Europe/Budapest" else "", long?: column == "bio", locked?: me.locked?(column)
          })
        end
      }
      return detailsPartial(inputs.join("\n"), me.nicknameShown?, tab.dialogProblem, !me.managed.empty?)
    end

    if tab.dialog == "bots"
      let rows = bots.map { |bot|
        let shared = !bot.ownerOrganizationId.empty?
        botPartial(Robot {
          key: bot.id, caption: bot.shown, here?: shared || people.any? { |person| person.id == bot.id }, spot: organization.name,
          belonging: shared then "belongs to ${organization.name}" else "yours"
        })
      }
      return botsPartial(organization.name, rows.join("\n"), tab.dialogProblem, tab.secret, tab.secretFor)
    end

    if tab.dialog == "channel"
      return dialogPartial(
        "Create a channel",
        "Everyone in ${organization.name} can read it and write in it. Lower-case letters, digits and dashes.",
        "create",
        "title",
        "new-channel",
        tab.dialogProblem,
        "Create"
      )
    end

    return dialogPartial("Create an organization", "Its own channels and people, apart from every other.", "charter", "name", "Acme", tab.dialogProblem, "Create") if tab.dialog == "organization"
    return dialogPartial("Add people to ${organization.name}", "The email somebody registered with. They are in as soon as you add them.", "enlist", "email", "name@example.com", tab.dialogProblem, "Add") if tab.dialog == "invite"

    ""
  end

  # A ready-made status, set with one click. Both are this program's own
  # constants, not anything typed.
  preset : String -> String -> String
  let preset(glyph, words) = "<button type=\"button\" data-event=\"status-set\" data-emoji=\"${glyph}\" data-text=\"${words}\">${glyph} ${words}</button>"

  choice : String -> Bool -> String
  let choice("", chosen?) = "<option value=\"\">No emoji</option>"
  let choice(glyph, true) = "<option value=\"${glyph}\" selected>${glyph}</option>"
  let choice(glyph, false) = "<option value=\"${glyph}\">${glyph}</option>"

  # The emoji buttons that type into one message box.
  picked : String -> String
  let picked(target) do
    App.Models.Emoji.KNOWN.map { |entry| match entry do (code, glyph) => "<button type=\"button\" class=\"quiet\" data-insert=\"${glyph}\" data-target=\"${target}\" title=\":${code}:\">${glyph}</button>" end }.join("")
  end

  tallied : Integer -> String
  let tallied(0) = ""
  let tallied(1) = "1 reply"
  let tallied(replies) = "${replies} replies"

  # The thread beside the conversation: its first message, then the replies.
  # Whether a private chat with somebody has something written and not sent.
  waiting : [Draft] -> String -> Bool
  let waiting(drafts, personId) = drafts.any? { |draft| !draft.personId.empty? && draft.personId == personId }

  threadPane : User -> [User] -> [Reaction] -> [Answer] -> [Message] -> String -> String
  let threadPane(user, people, reactions, responses, thread, unsent) do
    let opener = thread.take(1).map { |message| bubble(message, user, people, reactions, responses, true, false) }.join("")
    let followups = sequence(thread.drop(1), "", 0, user, people, reactions, responses, true)
    let summary = followups.empty? then "No replies yet" else tallied(followups.count)
    threadPartial(opener, summary, followups.join("\n"), composerPartial("reply", "reply-box", "Reply…", picked("#reply-box"), true, unsent))
  end

  # `unsent` is what is written in its message box and not sent yet.
  pane : Tab -> User -> [User] -> Conversation? -> [Message] -> [Reaction] -> [Answer] -> Bool -> [Note] -> String -> String
  let pane(tab, user, people, None, messages, reactions, responses, alone?, doing, unsent) = "<section class=\"pane\"><p class=\"empty\">That conversation is not there, or is not yours to read. Pick one on the left.</p></section>"
  let pane(tab, user, people, Just(conversation), messages, reactions, responses, alone?, doing, unsent) do
    let title = titled(conversation, user, people)
    let heading = headingPartial(title, App.Models.Emoji.shown(conversation.topic), conversation.channel?, tab.retitling?)
    let bubbles = sequence(messages, "", 0, user, people, reactions, responses, false)
    let emptied = conversation.solo? then soloIntro else (messages.empty? then "<p class=\"empty\">Nothing here yet. Say something.</p>" else "")
    "<section class=\"pane\">${heading}<div class=\"messages\" id=\"messages\" data-stick=\"bottom\">${emptied}${bubbles.join("\n")}</div><p class=\"statuses\" id=\"statuses\" aria-live=\"polite\">${statuses(doing, people)}</p>${composerPartial("send", "message-box", conversation.solo? then "Jot something down…" else "Message ${title}", picked("#message-box"), alone?, unsent)}</section>"
  end

  # What somebody's chat with themselves is for, at the start of it.
  let soloIntro = Kex.embed("chat/_solo.html")

  # "Ada is typing…", or what a bot says it is doing: "deploy-bot Deploying…".
  statuses : [Note] -> [User] -> String
  let statuses(doing, people) do
    doing.map { |note|
      let who = people.find { |person| person.id == note.member }.map { |person| person.shown }.or("Someone")
      let what = note.saying.empty? then "is typing…" else "${note.saying}…"
      statusPartial(Standing { who: who, doing: what, lapses: "${note.lapses}" })
    }.join(" ")
  end

  # What a conversation is called for this person: `# name` for a channel,
  # the other person for a private chat.
  titled : Conversation -> User -> [User] -> String
  let titled(conversation, user, people) do
    return "# ${conversation.title}" if conversation.channel?

    let other = conversation.counterpart(user.id)
    return "${people.find { |person| person.id == other }.map { |person| person.shown }.or(user.shown)} (you)" if other == user.id
    people.find { |person| person.id == other }.map { |person| person.shown }.or("Private chat")
  end

  # How long after a message the same person's next one still counts as
  # carrying on from it, in milliseconds.
  let RUN = 300000

  # Messages in order, each knowing whether it carries on from the one
  # before: consecutive messages of one person are shown as one block, under
  # one name. `lastUser` and `lastAt` are the message before.
  sequence : [Message] -> String -> Integer -> User -> [User] -> [Reaction] -> [Answer] -> Bool -> [String]
  let sequence([], lastUser, lastAt, user, people, reactions, responses, inThread?) = []
  let sequence([message | rest], lastUser, lastAt, user, people, reactions, responses, inThread?) do
    let carries = message.userId == lastUser && message.sentAt - lastAt < RUN
    [bubble(message, user, people, reactions, responses, inThread?, carries)] + sequence(rest, message.userId, message.sentAt, user, people, reactions, responses, inThread?)
  end

  # `inThread?` is whether it is shown in the thread pane, where a message
  # has its own element id and no way to open the thread it is already in.
  bubble : Message -> User -> [User] -> [Reaction] -> [Answer] -> Bool -> Bool -> String
  let bubble(message, user, people, reactions, responses, inThread?, carries) do
    let writer = people.find { |person| person.id == message.userId }
    let author = writer.map { |person| person.shown }.or("Someone")
    let badged = writer.map { |person| person.bot? }.or(false) then "BOT" else ""
    let emblem = writer.map { |person| person.statusEmoji }.or("")
    let emblemNote = writer.map { |person| person.statusText }.or("")
    let mine = reactions.filter { |reaction| reaction.messageId == message.id }
    let chips = mine.map { |reaction| reaction.emoji }.uniq.map { |glyph|
      let givers = mine.filter { |reaction| reaction.emoji == glyph }
      chipPartial(Chip { key: message.id, glyph: glyph, tally: "${givers.count}", own?: givers.any? { |reaction| reaction.userId == user.id } })
    }
    let offers = App.Models.Emoji.PALETTE.map { |glyph| chipPartial(Chip { key: message.id, glyph: glyph, tally: "", own?: false }) }
    bubblePartial(
      Bubble { key: message.id, anchor: inThread? then "thread-${message.id}" else "message-${message.id}", answers: inThread? then "" else tallied(message.replyCount), threadable?: !inThread?, continued?: carries, author: author, badged: badged, emblem: emblem, emblemNote: emblemNote, initial: author.take(1).upperCase, writer: message.userId, tint: "${BEAM.erlang.phash2(message.userId, 8)}", stamp: message.sentOn.drop(11).take(5), content: App.Helpers.RichText.shown(message.body, message.id, answered(message, user, people, responses)), own?: message.userId == user.id },
      chips.join(""), offers.join("")
    )
  end
end
