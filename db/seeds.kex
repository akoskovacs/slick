# What a database starts with, apart from its tables. Kept here and not in
# the migrations: those change the schema, and say nothing about what a new
# database should have in it.
#
#   tey seed     plant what this environment's database starts with
#
# Planting twice plants once: a seed looks for what it would make first.
#
# Only development has seeds — data to try things on: the organization Acme
# with three people (the password is below), two channels with messages, a
# thread and a reaction in them, a private chat, a group chat, the team
# @design with the private channel it owns, and bots whose tokens are the
# ones below. Test starts empty, so a spec says what it
# relies on; production starts with whoever registers.
module DB.Seeds

using Metro.Environment, only: [Environment, Development]
using App.Models.Team, only: [Team]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Memberships, as: Memberships
using DB.Repositories.Messages, as: Messages
using DB.Repositories.Organizations, as: Organizations
using DB.Repositories.Reactions, as: Reactions
using DB.Repositories.Teams, as: Teams
using DB.Repositories.Users, as: Users

# The password of every seeded person.
let PASSWORD = "correct horse"

# The API token of each seeded bot: `slick_bot_development_<its name>`.
# Known to everyone who can read this file, which is why they are only ever
# planted in development. The `claude` bot is the one script/dev.sh runs
# the slick-ai-bot as (../slick-ai-bot).
let BOT_TOKEN = "slick_bot_development_claude"
let BOTS = ["claude", "muse", "opencode"]

# Plants an environment's seeds. What was planted, in words: nothing when it
# was all there already.
planted : Environment -> Result<[String], String>
foul planted(Development) = demo()
foul planted(environment) = Ok([])

private do
  # Acme, and enough in it to try every part of the application on.
  foul demo() -> Result<[String], String> do
    let existing = Organizations.addressed("acme").try
    return Ok([]) if existing.set?

    let ada = person("Ada", "ada@example.com").try
    let bob = person("Bob", "bob@example.com").try
    let eve = person("Eve", "eve@example.com").try
    let acme = Organizations.chartered("Acme", "acme", ada.id).try
    Memberships.enlisted(acme.id, ada.id).try
    Memberships.enlisted(acme.id, bob.id).try
    Memberships.enlisted(acme.id, eve.id).try

    let general = Conversations.founded(acme.id, App.Models.Conversation.GENERAL, ada.id, botAccess: "all").try
    Conversations.retitled(general.id, "Company-wide announcements and chatter").try
    let welcome = Messages.said(general.id, ada.id, "Welcome to Acme :wave:", "").try
    Messages.said(general.id, bob.id, "Glad to be here. Is the *release* still on for Friday?", "").try
    let plan = Messages.said(general.id, ada.id, "It is. The checklist:\n- migrate\n- restart\n- tell everyone", "").try
    Messages.said(general.id, eve.id, "I can take the migration.", plan.id).try
    Messages.said(general.id, ada.id, "Yours, thank you.", plan.id).try
    Reactions.flipped(welcome, bob.id, "👍").try
    Reactions.flipped(welcome, eve.id, "🎉").try

    let random = Conversations.founded(acme.id, "random", bob.id, botAccess: "all").try
    Conversations.retitled(random.id, "Anything goes :tada:").try
    Messages.said(random.id, bob.id, "Lunch at one?", "").try
    Messages.said(random.id, eve.id, "`yes`", "").try

    let chat = Conversations.between(acme.id, ada.id, bob.id).try
    Messages.said(chat.id, ada.id, "Can you look at my pull request today?", "").try
    Messages.said(chat.id, bob.id, "After lunch.", "").try

    let trio = Conversations.among(acme.id, [bob.id, eve.id], ada.id).try
    Messages.said(trio.id, eve.id, "Shall we plan the offsite here?", "").try

    let design = Team {
      id: "",
      organizationId: acme.id,
      handle: "design",
      name: "Design",
      description: "Everything people see",
      members: [ada.id, eve.id]
    }
    let team = Teams.formed(design, ada.id).try
    let studio = Conversations.founded(acme.id, "studio", eve.id, access: "private", teamId: team.id).try
    Messages.said(studio.id, eve.id, "New mockups are up, @design", "").try

    let bots = BOTS.map { |name| bot(name, acme.id).try }
    bots.each { |made| Memberships.enlisted(acme.id, made.id).try }
    return Ok([
      "the organization Acme, at /acme",
      "${ada.email}, ${bob.email} and ${eve.email}, password \"${PASSWORD}\"",
      "#general and #random, a thread, reactions, a private chat and a group chat",
      "the team @design, with Ada and Eve, and its private channel #studio",
      "the bots ${BOTS.join(", ")}, tokens ${BOTS.map { |name| token(name) }.join(", ")}"
    ])
  end

  # A seeded bot's token.
  token : String -> String
  let token(name) = "slick_bot_development_${name}"

  # An organization's bot, known by its development token.
  foul bot(name: String, organizationId: String) -> Result<User, String> do
    let id = Metro.Id.generate(prefix: "b")
    let made = User {
      id: id,
      email: "${id}@bots.invalid",
      name: name,
      kind: "bot",
      ownerOrganizationId: organizationId
    }
    return Users.automated(made, Metro.Auth.Token.digest(token(name)))
  end

  # The person registered under an email, made if there is none.
  foul person(name: String, email: String) -> Result<User, String> do
    match Users.credentials(email).try do
      Just((found, _)) => return Ok(found)
      None => do
        let id = Metro.Id.generate(prefix: "u")
        return Users.enroll(User { id: id, email: email, name: name }, Metro.Auth.Password.hashed(PASSWORD))
      end
    end
  end
end
