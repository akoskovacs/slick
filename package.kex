package "slick" do
  version("0.1.0")
  description("Slick")
  kex(">= 0.4.0-rc.1")

  # The application is laid out from its top: the entrypoint, and beside it
  # the folders its modules are in — App.* in app/, Config.* in config/,
  # DB.* in db/.
  entrypoint("main.kex")
  sources(["app", "config", "db"])

  command("server", run: "tey run server", description: "Migrate, then serve on http://localhost:4000")
  command("migrate", run: "tey run migrate", description: "Run the migrations this database has not run")
  command("rollback", run: "tey run rollback", description: "Undo the newest migration (or the newest N)")
  command("seed", run: "tey run seed", description: "Migrate, then plant what a new database starts with")
  command("odbc", run: "sh script/setup-odbc.sh db/odbc", description: "Build Erlang's ODBC port program into db/odbc, once")

  tey("harmat", git: "https://github.com/kexhq/harmat", branch: "main")
  tey("metro", git: "https://github.com/kexhq/metro", branch: "main")
end
