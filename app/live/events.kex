# What happened, told to the bots that are watching, as it happens.
#
# A bot that wants to know what is new in Slick would otherwise have to look:
# every channel and private chat it is in, every so often, whether anything
# changed or not. Here instead is the one place what it could see happening
# is noted — a message said, a form answered, a command used — and every bot
# connected to it (`App.Controllers.Api.evented`) is told at once, each only
# what it may read:
#
#   - a message, to a bot that may read the conversation it is in
#   - an answer, to the one bot whose form was answered
#   - a command, to the one bot it was used for
#
# What is told is where, not what: a bot that wants the words fetches them
# through the API as ever, which decides again what it may read.
#
# Each telling carries a cursor, one more every time, and the bus remembers
# the last of them (KEPT below); a bot that connects says how far it has
# already seen (`?after=<cursor>`) and is told what has happened since.
# Beyond what the bus remembers, or from nowhere, it is told to start again
# (`reset`): one full look, as a bot that polls would take now and then.
module App.Live.Events

using App.Models.User, only: [User]
using App.Models.Ids, only: [UserId]
using App.Models.User, as: User
using App.Models.Message, only: [MessageId]
using App.Models.Organization, only: [OrganizationId]
using Net.HTTP.WebSocket, only: [Text]
using JSON
using App.Models.Conversation, only: [Conversation, ConversationId, BotAccess]
using App.Models.Conversation, as: Conversation

type EventKind = Message | Answer | Command

# One thing that happened. `kind` is "message", "answer" or "command".
record Event do
  # One more every time anything happens; 0 until the bus says it.
  cursor : Integer = 0
  kind : EventKind
  # The organization it happened in: its id, and its address as the API
  # takes it.
  organizationId : OrganizationId = ""
  organization : String = ""
  conversationId : ConversationId = ""
  # The conversation as the API addresses it: a channel by its title, and a
  # group chat by its id. A private chat is addressed by who it is with, so
  # instead the two of it are kept, and each bot is told its own address.
  channel : String = ""
  group : ConversationId = ""
  first : UserId = ""
  second : UserId = ""
  # The thread it happened in; "" for the conversation itself.
  thread : MessageId = ""
  # The message at the middle of it: the one said, or the one a form was
  # answered in. "" for a command, which is no message.
  message : MessageId = ""
  # When it happened, in milliseconds since 1970.
  at : Integer = 0
  # Who may be told of it: a message, whoever could read it — a whole
  # organization when `public?`, and otherwise `people`, the two of a
  # private chat or the participants of a private channel or a group chat;
  # an answer or a command, the one bot it is for.
  public? : Bool = false
  people : [UserId] = []
  bot : UserId = ""
  # The message said — kept on the server only, so the bus can tell which
  # bots it names; never sent out.
  body : String = ""
  # How much of the conversation its bots may read: "none", "mentions" or
  # "all".
  botAccess : BotAccess = Conversation.Mentions
  # The bots that have replied in this thread: a reply reaches them even
  # when it does not name them.
  replied : [UserId] = []
end

# One connected bot: who it is, the organizations it is in, and where it is
# told of what happens.
record Seat do
  id : String
  bot : UserId
  name : String = ""
  organizations : [OrganizationId] = []
  socket : Net.HTTP.WebSocket.Connection
end

record Bus do
  log : [Event] = []
  cursor : Integer = 0
  seats : {String: Seat} = {}
end

# How much of what has happened is remembered. A bot that asks for more is
# told to start again.
let KEPT = 1000

serving Bus do
  # Notes one thing that happened and tells every bot that may hear it,
  # forgetting any that have gone.
  slot happened(event: Event) -> Void do
    let numbered = Event { ...event, cursor: @cursor + 1 }
    let whole = @log + [numbered]
    let older = whole.count - KEPT
    new.cursor = numbered.cursor
    new.log = older > 0 then whole.drop(older) else whole
    new.seats = @seats.filter { |_, seat| !numbered.for?(seat.bot, seat.name, seat.organizations) || seat.socket.send(Text(numbered.told(seat))).ok? }
    return new
  end

  # Seats a connected bot, and tells it where it stands: what has happened
  # since it last looked — `after` — while the bus still remembers that far,
  # and otherwise to start again. Whether the bot is starting again.
  slot joined(id: String, bot: UserId, name: String, organizations: [OrganizationId], after: Integer, socket: Net.HTTP.WebSocket.Connection) -> Reply<Bool> do
    let seat = Seat { id: id, bot: bot, name: name, organizations: organizations, socket: socket }
    let current = @cursor
    let oldest = @log.first.map { |first| first.cursor }.or(1)
    let again = after <= 0 || after > current || after + 1 < oldest
    if again
      socket.send(Text("{\"kind\":\"reset\",\"cursor\":${current}}"))
    else
      @log.filter { |event| event.cursor > after && event.for?(seat.bot, seat.name, seat.organizations) }
        .each { |event| socket.send(Text(event.told(seat))) }
      socket.send(Text("{\"kind\":\"ready\",\"cursor\":${current}}"))
    end
    new.seats = @seats.put(id, seat)
    return { new, reply: again }
  end

  # Takes a seat away, when its bot has gone.
  slot left(id: String) -> Void do
    new.seats = @seats.delete(id)
    return new
  end
end

make Event do
  # Whether this seat may be told of the event: an answer or command by the
  # bot it is for; a message allowed by the conversation's bot access.
  let for?(bot: UserId, name: String, organizations: [OrganizationId]) -> Bool do
    return bot == @bot && organizations.contains?(@organizationId) if !@bot.empty?
    return false if !organizations.contains?(@organizationId)
    return @first == bot || @second == bot if !@first.empty?
    return false if @botAccess == Conversation.NoBots
    let admitted = @public? || @people.contains?(bot)
    return admitted if @botAccess == Conversation.AllBots
    admitted && (@body.lowerCase.contains?("@${name.lowerCase}") || @replied.contains?(bot))
  end

  # The bot API's access values are words, rather than the database's snake
  # case enum names.
  let access -> String do
    return "all" if !@first.empty? || @botAccess == Conversation.AllBots
    return "mentions" if @botAccess == Conversation.Mentions
    "none"
  end

  # Where this event happened, as the API of the bot asked takes it.
  let placedFor(bot: UserId) -> String do
    return "dm/${@first == bot then @second else @first}" if !@first.empty?
    return "channels/${@channel}" if !@channel.empty?
    "groups/${@group}"
  end

  # Show the event as the bot API expects it. The bot fetches its content
  # through the API after this notification.
  let told(seat: Seat) -> String do
    let fields : {String: Any} = {
      "cursor": @cursor,
      "kind": Harmat.Database.spelled(@kind),
      "organization": @organization,
      "place": placedFor(seat.bot),
      "thread": @thread,
      "message": @message,
      "at": @at,
      "access": access
    }
    JSON.stringify(fields)
  end
end

# Notes what happened to the events bus, for the bots that are watching.
# Nothing is told but where; each bot fetches content through the API.
publish : Server<Bus> -> Conversation -> EventKind -> MessageId -> MessageId -> Integer -> UserId -> String -> Void
foul publish(events, conversation, kind, messageId, threadId, at, bot, body) do
  match DB.Repositories.Organizations.find(conversation.organizationId) do
    Ok(Just(organization)) => do
      let replied = if kind == Message && !threadId.empty?
        DB.Repositories.Messages.botAuthors(threadId, DB.Repositories.Users.botIds().or([])).or([])
      else
        []
      end
      events.happened(Event {
        kind: kind,
        organizationId: conversation.organizationId,
        organization: organization.slug,
        conversationId: conversation.id,
        channel: conversation.channel? then conversation.title else "",
        group: conversation.group? then conversation.id else "",
        first: conversation.direct? then conversation.firstUser else "",
        second: conversation.direct? then conversation.secondUser else "",
        thread: threadId,
        message: messageId,
        at: at,
        public?: conversation.public?,
        people: conversation.public? then [] else (conversation.direct? then [conversation.firstUser, conversation.secondUser] else conversation.participants),
        bot: bot,
        body: body,
        botAccess: conversation.botAccess,
        replied: replied
      })
    end
    _ => ()
  end
end
