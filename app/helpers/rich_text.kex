# What a message says, as blocks of rich text.
#
# A message is stored as the text that was typed. Read a line at a time, it
# is a list of blocks:
#
#   # Release notes          a heading
#   - one                    a list, for as many lines as start that way
#   > as she said            a quote, likewise
#   ```                      code, up to the closing fence, shown as typed
#   ---                      a divider
#   [?] Notes                a form field to type in
#   [?] Where: here | there  a form field to choose in; lines like these,
#                            one under the other, are one form
#   anything else            a paragraph, up to the next empty line
#
# and inside a block's text: *bold*, _italic_, ~struck~, `code`, :emoji:
# names, and addresses starting http:// or https://, which become links.
#
# Nothing typed is ever markup: every piece of text is escaped on its way
# into the page, a mark only counts when it hugs a word (so `snake_case` and
# `2 * 3` stay as they are), and only those two kinds of address are linked.
#
# A form is how a message asks something back — a bot's question, mostly.
# One field that is a choice is shown as a button for each option, and one
# click answers; anything more is fields and a Send button. An answer is not
# a message: it is kept with the message that asked (App.Models.Answer),
# shown under the form it answers, and can only be given by using the form —
# `answer` reads what a form sent and refuses what the form did not offer.
#
# The API gives and takes the same blocks as JSON (`described`, `composed`).
module App.Helpers.RichText

using Metro.Html, as: Html

# One block of a message. The strings are text as typed, not yet read for
# what is bold in them.
type ContentBlock = Paragraph([String]) | Heading(String) | Bullets([String]) | Quote([String]) | Listing(String) | Divider | Form([Field])

# One thing a form asks: something to type, or one of some options.
type Field = Asked(String) | Choice(String, [String])

# An answer as a form shows it: which of the message's blocks it answers,
# whose it is, whether that is whoever is looking, and what it says.
record Given do
  form : Integer
  who : String
  mine? : Bool = false
  answer : String
end

# One run of a block's text.
type Span = Words(String) | Bold([Span]) | Italic([Span]) | Struck([Span]) | Mono(String) | Anchor(String)

let FENCE = "```"

# What starts a line that is a form's field.
let FIELD = "[?] "

# The longest thing typed into a form's field that is kept.
let LONGEST_ANSWER = 500

# The blocks of a message.
blocks : String -> [ContentBlock]
let blocks(body) = gathered(body.replace("\r", "").split("\n"))

# A message as markup for the page. Its forms cannot be answered: there is
# no message to answer them in.
html : String -> String
let html(body) = shown(body, "", [])

# Markup with every mention of somebody marked: `@` and one of `names`, as
# the page shows them — people's names, teams' handles — not followed by a
# letter or digit. The longest name wins, so "@Ada Lovelace" is not "@Ada"
# and some words. `mine` are the names that mean whoever is looking — their
# own, and their teams' — and a mention of one is marked `you`. Only text
# is read — not tags, and not what is inside `code` or `pre`.
mentioned : String -> [String] -> [String] -> String
let mentioned(markup, names, mine) do
  let longestFirst = names.reject { |name| name.empty? }.uniq.sort { |one, other| one.chars.count > other.chars.count }
  let pieces = markup.split("<")
  let first = marked(pieces.first.or(""), longestFirst, mine)
  # Each piece is a tag and the text after it; `depth` is how many `code`
  # and `pre` elements that text is inside.
  let walked = pieces.drop(1).reduce((first, 0)) do |sofar, piece|
    match sofar do
      (done, depth) => do
        let tag = piece.split(">").first.or("")
        let name = tag.split(" ").first.or("").lowerCase
        let inside = coded?(name) then depth + 1 else (closesCode?(name) then depth - 1 else depth)
        let text = piece.drop(tag.count + 1)
        let shown = inside > 0 then text else marked(text, longestFirst, mine)
        ("${done}<${tag}>${shown}", inside)
      end
    end
  end
  match walked do
    (done, _) => done
  end
end

# A stored message as markup for the page: `key` is its id, which its forms
# send back with an answer, and `given` the answers its forms have had. A
# message of nothing but emoji is wrapped for big rendering.
shown : String -> String -> [Given] -> String
let shown(body, key, given) do
  let content : [Html.Node] = blocks(body).mapIndexed do |block, index|
    [rendered(block, key, index)] + answers(block, given.filter { |each| each.form == index })
  end.reduce([]) { |all, nodes| all + nodes }
  let tree = App.Models.Emoji.emojiOnly?(body) then [
    Html.div({"class": "big-emoji"}) do
      ...content
    end
  ] else content
  return tree.map { |node| Html.render(node) }.join("")
end

# What a form sent, as an answer to one of a message's forms: which block
# the form is, and what the answer says — "Label: value", a line for each
# field answered. A click on an option sends `form`, `label` and `value`; a
# form with fields sends `form` and `f0`, `f1`, … for them. `None` when
# nothing in it answers the form: an option that was never offered, every
# field left empty, a block that is not a form.
answer : String -> [(String, String?)] -> (Integer, String)?
let answer(body, entries) do
  let asked = blocks(body)
  # A block that is not there, when no number was sent.
  let index = sent(entries, "form").to(Integer).or(asked.count)
  let label = sent(entries, "label")
  match asked.at(index) do
    Just(Form(fields)) => do
      let typed = fields.mapIndexed { |field, position| filled(field, sent(entries, "f${position}")) }
      let clicked = fields.map { |field| picked(field, label, sent(entries, "value")) }
      let lines = (label.empty? then typed else clicked).reject { |line| line.empty? }
      lines.empty? then None else Just((index, lines.join("\n")))
    end
    _ => None
  end
end

# A message's blocks as the API shows them.
described : String -> [Any]
let described(body) = blocks(body).map { |block| listed(block) }

# The text of a message made of blocks the API was sent: the same shapes
# `described` gives. A block of a kind that is not known is a section.
composed : [Any] -> String
let composed(given) = given.map { |each| written(each) }.reject { |text| text.empty? }.join("\n\n")

private do
  # --- Blocks ---------------------------------------------------------------

  gathered : [String] -> [ContentBlock]
  let gathered([]) = []
  let gathered(lines) do
    let line = lines.first.or("").trim
    let rest = lines.drop(1)
    return gathered(rest) if line.empty?
    return [Divider] + gathered(rest) if line == "---"
    return [Heading(line.drop(2).trim)] + gathered(rest) if line.startsWith?("# ")

    if line.startsWith?(FENCE)
      let opening = line.drop(3).trim
      let inside = rest.takeWhile { |each| !each.trim.startsWith?(FENCE) }
      let shown = opening.empty? then inside else [opening] + inside
      return [Listing(shown.join("\n"))] + gathered(rest.drop(inside.count + 1))
    end
    if field?(line)
      let asked = lines.takeWhile { |each| field?(each.trim) }
      return [Form(asked.map { |each| field(each.trim.drop(FIELD.count).trim) })] + gathered(lines.drop(asked.count))
    end
    if item?(line)
      let items = lines.takeWhile { |each| item?(each.trim) }
      return [Bullets(items.map { |each| each.trim.drop(2).trim })] + gathered(lines.drop(items.count))
    end
    if quoted?(line)
      let said = lines.takeWhile { |each| quoted?(each.trim) }
      return [Quote(said.map { |each| each.trim.drop(1).trim })] + gathered(lines.drop(said.count))
    end

    let plain = lines.takeWhile { |each| ordinary?(each.trim) }
    return [Paragraph(plain.map { |each| each.trim })] + gathered(lines.drop(plain.count))
  end

  item? : String -> Bool
  let item?(line) = line.startsWith?("- ") || line.startsWith?("• ")

  quoted? : String -> Bool
  let quoted?(line) = line.startsWith?("> ") || line == ">"

  field? : String -> Bool
  let field?(line) = line.startsWith?(FIELD) && !line.drop(FIELD.count).trim.empty?

  # A field as it was written after the mark: "Where: here | there" is a
  # choice between two, and anything else is something to type.
  field : String -> Field
  let field(written) do
    let label = written.split(": ").first.or(written).trim
    let options = written.drop(label.count).trim.drop(1).split("|").map { |option| option.trim }.reject { |option| option.empty? }
    return Choice(label, options) if written.contains?(": ") && options.count > 1

    Asked(written.endsWith?(":") then written.take(written.count - 1).trim else written)
  end

  # A line that carries on a paragraph: not empty, and not the start of
  # another kind of block.
  ordinary? : String -> Bool
  let ordinary?(line) do
    let marked = line == "---" || line.startsWith?("# ") || line.startsWith?(FENCE)
    !line.empty? && !marked && !item?(line) && !quoted?(line) && !field?(line)
  end

  # A block as markup. `key` is the message it is in and `index` which of
  # its blocks it is: what a form sends back to be answered.
  rendered : ContentBlock -> String -> Integer -> Html.Node
  let rendered(Paragraph(lines), key, index) = Html.p({}) do ...broken(lines) end
  let rendered(Heading(text), key, index) = Html.h3({}) do ...inline(text) end
  let rendered(Bullets(items), key, index) = Html.ul({}) do
    ...(items.map { |item| Html.li({}) do ...inline(item) end })
  end
  let rendered(Quote(lines), key, index) = Html.blockquote({}) do ...broken(lines) end
  let rendered(Listing(text), key, index) = Html.pre({}) do
    Html.code({}) do
      Html.text(text)
    end
  end
  let rendered(Divider, key, index) = Html.hr({})
  # One choice of a few options is a button for each; of more, a select
  # and Send, like a form that asks several things.
  let rendered(Form([Choice(label, options)]), key, index) do
    return fieldsOf([Choice(label, options)], key, index) if options.count > BUTTONS

    Html.div({"class": "asking-form choices"}) do
      Html.p({"class": "asked"}) do ...inline(label) end
      Html.div({"class": "options"}) do
        ...(options.map { |option| offered(key, index, label, option) })
      end
    end
  end
  let rendered(Form(fields), key, index) = fieldsOf(fields, key, index)

  # The most options a choice is shown as buttons for.
  let BUTTONS = 6

  # A form as fields to fill in, and Send.
  fieldsOf : [Field] -> String -> Integer -> Html.Node
  let fieldsOf(fields, key, index) do
    let inputs = fields.mapIndexed { |each, position| input(each, position) }
    let hidden = [
      Html.input({"type": "hidden", "name": "message", "value": key}),
      Html.input({"type": "hidden", "name": "form", "value": "${index}"})
    ]
    let send = Html.button(key.empty? then {"type": "submit", "class": "primary", "disabled": ""} else {"type": "submit", "class": "primary"}) do
      Html.text("Send")
    end
    Html.form({"class": "asking-form", "data-live": "answer", "data-live-quiet": "", "data-live-reset": "", "data-live-keep": ""}) do
      ...(hidden + inputs + [send])
    end
  end

  # Whether a tag opens or closes code, where nothing is a mention.
  coded? : String -> Bool
  let coded?(name) = name == "code" || name == "pre"

  closesCode? : String -> Bool
  let closesCode?(name) = name == "/code" || name == "/pre"

  # A run of escaped text with its mentions marked.
  marked : String -> [String] -> [String] -> String
  let marked(text, names, mine) do
    return text if !text.contains?("@")
    let parts = text.split("@")
    let rest = parts.drop(1).map { |part| mentionIn(part, names, mine) }
    parts.first.or("") + rest.join("")
  end

  # What follows one `@`: the mention of the longest name it starts with,
  # then the rest; or the `@` and the text as they were.
  mentionIn : String -> [String] -> [String] -> String
  let mentionIn(part, names, mine) do
    let escaped = names.map { |name| Template.escapeHtml(name) }
    let found = escaped.find do |name|
      part.startsWith?(name) && part.drop(name.count).chars.first.map { |char| !char.letter? && !char.digit? }.or(true)
    end
    match found do
      None => "@${part}"
      Just(name) => do
        let own = mine.any? { |each| Template.escapeHtml(each) == name }
        let whose = own then "mention you" else "mention"
        "<span class=\"${whose}\">@${name}</span>${part.drop(name.count)}"
      end
    end
  end

  # One option of a choice, as the button that answers with it.
  offered : String -> Integer -> String -> String -> Html.Node
  let offered(key, index, label, option) do
    let atts = {"type": "button", "class": "option", "data-event": "message-answer", "data-message": key, "data-form": "${index}", "data-label": label, "data-value": option}
    Html.button(key.empty? then atts.put("disabled", "") else atts) do
      ...inline(option)
    end
  end

  # The answers a form has had, under it: whose, and what. Nothing for a
  # block that is not a form, or a form nobody has answered.
  answers : ContentBlock -> [Given] -> [Html.Node]
  let answers(Form(fields), []) = []
  let answers(Form(fields), given) do
    let lines = given.map do |each|
      let said = told(fields, each.answer)
      let whose = each.mine? then "response mine" else "response"
      Html.li({"class": whose}) do
        Html.strong({}) do
          Html.text(each.who)
        end
        Html.text(" ")
        Html.span({}) do
          Html.text(said)
        end
      end
    end
    [Html.ul({"class": "responses", "aria-label": "Answers"}) do
      ...lines
    end]
  end
  let answers(block, given) = []

  # An answer as one line under its form. A form that asks one thing does
  # not have its question said again in every answer.
  told : [Field] -> String -> String
  let told(fields, answer) do
    let single = fields.count == 1 && answer.contains?(": ")
    single then answer.drop(answer.split(": ").first.or("").count + 2) else answer.replace("\n", " · ")
  end

  # One field of a form with several, under its label.
  input : Field -> Integer -> Html.Node
  let input(Asked(label), position) = Html.label({"class": "field"}) do
    Html.span({}) do ...inline(label) end
    Html.input({"name": "f${position}", "maxlength": "${LONGEST_ANSWER}", "autocomplete": "off"})
  end
  let input(Choice(label, options), position) = Html.label({"class": "field"}) do
    Html.span({}) do ...inline(label) end
    Html.select({"name": "f${position}"}) do
      ...(options.map { |option| Html.option({}) do Html.text(option) end })
    end
  end

  # A form shown where there is no message to answer it in cannot be used.
  disabled : String -> {String: String}
  let disabled(key) = key.empty? then {"disabled": ""} else {}

  # --- Answers --------------------------------------------------------------

  # One named thing a form sent; "" when it did not.
  sent : [(String, String?)] -> String -> String
  let sent(entries, name) do
    match entries.find { |key, _| key == name } do
      Just((_, Just(value))) => value.trim
      _ => ""
    end
  end

  # What clicking an option answers a field with: the field has to be the
  # choice that was clicked in, and the option one it offers.
  picked : Field -> String -> String -> String
  let picked(Choice(label, options), clicked, value) do
    label == clicked && options.contains?(value) then "${label}: ${value}" else ""
  end
  let picked(Asked(label), clicked, value) = ""

  # One field's line of an answer; "" when it was left empty, or answered
  # with something that was not offered.
  filled : Field -> String -> String
  let filled(Asked(label), value) do
    let single = value.replace("\r", "").replace("\n", " ").trim.take(LONGEST_ANSWER)
    single.empty? then "" else "${label}: ${single}"
  end
  let filled(Choice(label, options), value) = options.contains?(value) then "${label}: ${value}" else ""

  # Lines of one block, each read for its marks, one under the other.
  broken : [String] -> [Html.Node]
  let broken(lines) = lines.map { |line| inline(line) }.reduce([]) { |all, nodes| all.empty? then nodes else all + [Html.br()] + nodes }

  listed : ContentBlock -> {String: Any}
  let listed(Paragraph(lines)) = {"type": "section", "text": lines.join("\n")}
  let listed(Heading(text)) = {"type": "heading", "text": text}
  let listed(Bullets(items)) = {"type": "list", "items": items}
  let listed(Quote(lines)) = {"type": "quote", "text": lines.join("\n")}
  let listed(Listing(text)) = {"type": "code", "text": text}
  let listed(Divider) = {"type": "divider"}
  let listed(Form(fields)) do
    let described : [Any] = fields.map { |each| fieldListed(each) }
    {"type": "form", "fields": described}
  end

  fieldListed : Field -> {String: Any}
  let fieldListed(Asked(label)) = {"label": label}
  let fieldListed(Choice(label, options)) = {"label": label, "options": options}

  written : Any -> String
  let written(given) do
    let fields : {String: Any} = given
    let kind = fields.get("type").map { |found| "${found}" }.or("section")
    let text = fields.get("text").map { |found| "${found}" }.or("").replace("\r", "").trim
    let single = text.replace("\n", " ")
    return "---" if kind == "divider"
    return "# ${single}" if kind == "heading" && !single.empty?
    return [FENCE, text.replace(FENCE, "'''"), FENCE].join("\n") if kind == "code" && !text.empty?
    return text.split("\n").map { |line| "> ${line}" }.join("\n") if kind == "quote" && !text.empty?

    if kind == "list"
      let items : [Any] = fields.get("items").or([])
      return items.map { |item| bulleted("${item}") }.join("\n")
    end
    if kind == "form"
      let asked : [Any] = fields.get("fields").or([])
      return asked.map { |each| fieldWritten(each) }.reject { |line| line.empty? }.join("\n")
    end
    text
  end

  # A form's field the API was sent, as the line it is stored as. A label
  # cannot hold what would make it read as something else.
  fieldWritten : Any -> String
  let fieldWritten(given) do
    let fields : {String: Any} = given
    let label = "${fields.get("label").or("")}".replace("\n", " ").replace(": ", " ").replace("|", " ").trim
    let offered : [Any] = fields.get("options").or([])
    let options = offered.map { |option| "${option}".replace("\n", " ").replace("|", " ").trim }.reject { |option| option.empty? }
    return "" if label.empty?

    options.count > 1 then "${FIELD}${label}: ${options.join(" | ")}" else "${FIELD}${label}"
  end

  bulleted : String -> String
  let bulleted(item) do
    let single = item.replace("\n", " ").trim
    "- ${single}"
  end

  # --- Text inside a block ----------------------------------------------------

  inline : String -> [Html.Node]
  let inline(text) = linked(text.split(" "), "", true).map { |span| marked(span) }

  marked : Span -> Html.Node
  let marked(Words(text)) = Html.text(App.Models.Emoji.shown(text))
  let marked(Bold(inner)) = Html.strong({}) do ...(inner.map { |span| marked(span) }) end
  let marked(Italic(inner)) = Html.em({}) do ...(inner.map { |span| marked(span) }) end
  let marked(Struck(inner)) = Html.s({}) do ...(inner.map { |span| marked(span) }) end
  let marked(Mono(text)) = Html.code({}) do Html.text(text) end
  let marked(Anchor(address)) = Html.a({"href": address, "target": "_blank", "rel": "noopener noreferrer nofollow"}) do
    Html.text(address)
  end

  # Words one at a time: an address becomes a link, and everything between
  # two addresses is read for marks together. `pending` is the text since
  # the last address.
  linked : [String] -> String -> Bool -> [Span]
  let linked([], pending, first?) = coded(pending)
  let linked(words, pending, first?) do
    let word = words.first.or("")
    let gap = first? then "" else " "
    return linked(words.drop(1), "${pending}${gap}${word}", false) if !address?(word)

    let address = bare(word)
    coded("${pending}${gap}") + [Anchor(address)] + linked(words.drop(1), word.drop(address.count), false)
  end

  address? : String -> Bool
  let address?(word) = (word.startsWith?("http://") && word.count > 7) || (word.startsWith?("https://") && word.count > 8)

  # An address without the full stop or bracket that ends the sentence it
  # was typed in.
  bare : String -> String
  let bare(word) do
    let ending = word.last.map { |char| ".,;:!?)".contains?("${char}") }.or(false)
    ending then bare(word.take(word.count - 1)) else word
  end

  # `code` first: what is inside it is not read for anything else.
  coded : String -> [Span]
  let coded("") = []
  let coded(text) = paired(text.split("`"), "`")

  # The pieces of a text split at one mark. Odd pieces are inside a pair of
  # marks, if the pair is a real one; a mark that opens nothing is put back.
  paired : [String] -> String -> [Span]
  let paired([], mark) = []
  let paired(pieces, mark) do
    let before = pieces.first.or("")
    let inner = pieces.drop(1).first.or("")
    let following = pieces.drop(2)
    return styled(before, mark) if pieces.count == 1
    return styled("${before}${mark}${inner}", mark) if pieces.count == 2
    return paired(["${before}${mark}${inner}"] + following, mark) if !hugging?(before, inner, following.first.or(""), mark)

    styled(before, mark) + [wrapped(inner, mark)] + paired(following, mark)
  end

  # Whether marks around `inner` are a pair: something is between them, it
  # touches both, and neither is in the middle of a word.
  hugging? : String -> String -> String -> String -> Bool
  let hugging?(before, inner, following, mark) do
    return !inner.empty? if mark == "`"

    let inside = !inner.empty? && !inner.startsWith?(" ") && inner.trim == inner
    let opens = before.last.map { |char| !char.letter? && !char.digit? }.or(true)
    let closes = following.first.map { |char| !char.letter? && !char.digit? }.or(true)
    inside && opens && closes
  end

  wrapped : String -> String -> Span
  let wrapped(inner, "`") = Mono(inner)
  let wrapped(inner, "*") = Bold(styled(inner, "*"))
  let wrapped(inner, "_") = Italic(styled(inner, "_"))
  let wrapped(inner, mark) = Struck(styled(inner, mark))

  # Text outside the pairs of one mark, read for the next mark in turn.
  styled : String -> String -> [Span]
  let styled("", mark) = []
  let styled(text, "`") = paired(text.split("*"), "*")
  let styled(text, "*") = paired(text.split("_"), "_")
  let styled(text, "_") = paired(text.split("~"), "~")
  let styled(text, mark) = [Words(text)]
end
