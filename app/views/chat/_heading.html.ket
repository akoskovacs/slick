---
params: [title: String, topic: String, channel?: Bool, retitling?: Bool, filing?: Bool, filed: String, note: String, admitting?: Bool, promotable?: Bool]
---
<header class="heading">
  <div class="heading-row">
    <h1><%= title %></h1>
    <nav class="views" aria-label="Show">
      <button type="button" class="view<% if !filing? %> current<% end %>"
        data-event="messages">Messages</button>
      <button type="button" class="view<% if filing? %> current<% end %>"
        data-event="files">Files<% if !filed.empty? %> <span class="tally"><%= filed %></span><% end %></button>
    </nav>
  </div>
  <% if retitling? %>
    <form class="topic-form" data-live="topic" data-live-quiet>
      <input name="topic" value="<%= topic %>" maxlength="250" placeholder="What is this channel about?" autocomplete="off">
      <button type="submit" class="primary">Save</button>
      <button type="button" class="quiet" data-event="cancel">Cancel</button>
    </form>
  <% elif channel? %>
    <p class="topic"><% if topic.empty? %>No topic yet<% else %><%= topic %><% end %>
      <button type="button" class="quiet" data-event="retitle">Edit topic</button>
    </p>
  <% end %>
  <% if !note.empty? %>
    <p class="topic"><%= note %>
    <% if admitting? %>
      <button type="button" class="quiet" data-event="admit">Add people</button>
    <% end %>
    <% if promotable? %>
      <button type="button" class="quiet" data-event="promote">Make it a channel</button>
    <% end %>
    </p>
  <% end %>
</header>
