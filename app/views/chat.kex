# Slick's markup: a layout, and the live region inside it — a sidebar of
# channels and people, and the conversation that is open. Each part is a
# module of its own beside this one (app/views/chat/), with the `.ket`
# templates it prints; `<%= %>` escapes what it prints.
module App.Views.Chat

using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation, Channel, Group]
using App.Models.Conversation, as: Conversation
using App.Models.Message, only: [Message]
using App.Models.Organization, only: [Organization]
using App.Models.User, only: [User]
using App.Views.Chat.Page, only: [Sidebar, Pane]
using App.Views.Chat.Lists, only: [Entry, Badge, personEntry, waiting]
using App.Views.Chat.Messages, only: [Room]
using App.Views.Chat.Threads, only: [opened]
using App.Views.Chat.Names, only: [channelName, gathered, titled, counted]

# The document: head, who is signed in, the live region, and Metro's script.
# The live region is all of it, the bar across the top included: the name
# and status there change like everything else.
let page = Template.html(Kex.embed("layouts/application.html.ket"))
let frame = Template.html(Kex.embed("chat/index.html.ket"))
let entryPartial = Template.html(Kex.embed("chat/_entry.html.ket"))
let badgePartial = Template.html(Kex.embed("chat/_badge.html.ket"))
let welcomePartial = Template.html(Kex.embed("chat/_welcome.html.ket"))
let topbarPartial = Template.html(Kex.embed("chat/_topbar.html.ket"))

# The live region for somebody who is in no organization yet.
welcome : Tab -> User -> String
let welcome(tab, user) = welcomePartial(
  user.shown,
  user.email,
  tab.dialogProblem,
  topbar(user, false)
)

# The live region: the sidebar around the conversation, and the
# conversation itself with what is beside it.
index : Tab -> User -> Sidebar -> Pane -> String
let index(tab, user, sidebar, pane) do
  let shown = pane.conversation.map { |open| open.id }.or("".as(App.Models.Conversation.ConversationId))
  let badges = sidebar.organizations.map do |each|
    badgePartial(Badge {
      key: each.id.as(String),
      glyph: each.name.take(1).upperCase,
      caption: each.name,
      current?: each.id == sidebar.organization.id,
      unread: counted(sidebar.unread.organizations.get(each.id).or(0))
    })
  end
  let channelLines = sidebar.channels.map do |channel|
    let here = channel.id == shown
    entryPartial(Entry {
      action: "conversation-open",
      subject: "id",
      key: channel.id.as(String),
      caption: channelName(channel),
      current?: here,
      drafted?: !here && sidebar.drafts.any? { |draft| draft.conversationId == channel.id },
      unread: counted(sidebar.unread.channels.get(channel.id).or(0))
    })
  end
  # This person as stored now: the `user` a tab was opened with does not
  # know of a status set since.
  let me = sidebar.people.find { |person| person.id == user.id }.or(user)
  let alone = pane.conversation
    .map { |open| open.solo? && open.admits?(user.id) }
    .or(false)
  let selfLine = entryPartial(Entry {
    ...personEntry(me, pane.conversation, user, sidebar.online, sidebar.drafts, sidebar.unread),
    caption: "${me.shown} (you)",
    current?: alone,
    drafted?: !alone && waiting(sidebar.drafts, user.id)
  })
  # A person's own bots have a list of their own; everybody else's, and the
  # organization's, are among the people, marked as bots.
  let personLines = sidebar.people
    .reject { |person| person.id == user.id || person.ownerId == user.id }
    .map { |person| entryPartial(personEntry(person, pane.conversation, user, sidebar.online, sidebar.drafts, sidebar.unread)) }
  let robotLines = sidebar.people
    .filter { |person| person.ownerId == user.id }
    .map { |person| entryPartial(personEntry(person, pane.conversation, user, sidebar.online, sidebar.drafts, sidebar.unread)) }
  let groupLines = sidebar.groups.map do |group|
    let here = group.id == shown
    entryPartial(Entry {
      action: "conversation-open",
      subject: "id",
      key: group.id.as(String),
      caption: gathered(group, user, sidebar.people),
      current?: here,
      drafted?: !here && sidebar.drafts.any? { |draft| draft.conversationId == group.id },
      unread: counted(sidebar.unread.groups.get(group.id).or(0))
    })
  end
  let teamLines = sidebar.teams.map do |team|
    entryPartial(Entry {
      action: "team-open",
      subject: "id",
      key: team.id.as(String),
      caption: "@${team.handle}",
      current?: team.id == tab.team
    })
  end
  let room = Room {
    viewer: user,
    people: sidebar.people,
    teams: sidebar.teams,
    reactions: pane.reactions,
    responses: pane.responses,
    files: pane.cabinet.stored,
    commands: pane.commands,
    channel?: pane.conversation.map { |open| !open.direct? }.or(false),
    invocations: pane.invocations,
    administrator: sidebar.administrator
  }
  let unsent = do |threadId|
    sidebar.drafts
      .find { |draft| draft.conversationId == shown && draft.threadId == threadId }
      .map { |draft| draft.body }
      .or("")
  end
  let beside = if !pane.thread.empty?
    App.Views.Chat.Threads.pane(room, pane.thread, unsent(opened(pane.thread)))
  elif !tab.team.empty?
    App.Views.Chat.Teams.pane(tab, user, sidebar)
  else
    App.Views.Chat.Profiles.pane(tab, user, sidebar)
  end
  let place = pane.conversation
    .map { |open| located(sidebar.organization, open, user, pane.thread) }
    .or("")
  let named = pane.conversation
    .map { |open| "${titled(open, user, sidebar.people)} · ${sidebar.organization.name}" }
    .or(sidebar.organization.name)
  let caption = sidebar.unread.total > 0 then "(${counted(sidebar.unread.total)}) ${named}" else named
  let open = App.Views.Chat.Conversation.pane(
    tab,
    sidebar.organization,
    room,
    pane.conversation,
    pane.messages,
    pane.cabinet,
    pane.thread.empty? && tab.dialog == App.Live.Tab.NoDialog,
    pane.doing,
    unsent("")
  )
  frame(
    tab.failure,
    tab.notice,
    badges.join("\n"),
    sidebar.organization.name,
    sidebar.administrator,
    channelLines.join("\n"),
    ([selfLine] + groupLines + personLines).join("\n"),
    robotLines.join("\n"),
    teamLines.join("\n"),
    topbar(me, true),
    open + beside,
    App.Views.Chat.Dialogs.dialog(tab, sidebar, me, pane.conversation),
    place,
    caption
  )
end

private do
  # The bar across the top: who is signed in, and under their name what
  # they say about themselves and the way to change it. `placed?` is whether
  # they are in an organization, where they have a profile to open.
  topbar : User -> Bool -> String
  let topbar(me, placed?) do
    let set = !me.statusEmoji.empty? || !me.statusText.empty?
    let saying = set then "${me.statusEmoji} ${me.statusText}".trim else "No status set"
    topbarPartial(me.shown, me.statusEmoji, saying, set, placed? then me.id.as(String) else "")
  end

  # Where a conversation is, as an address: the one the address bar shows
  # and `App.Live.Addresses.tabFor` reads back.
  located : Organization -> Conversation -> User -> [Message] -> String
  let located(organization, conversation, user, thread) do
    let channel = Config.RoutePaths.channel.filled({
      "organization": organization.slug,
      "name": conversation.title
    })
    let direct = Config.RoutePaths.direct.filled({
      "organization": organization.slug,
      "person": conversation.counterpart(user.id)
    })
    let group = Config.RoutePaths.group.filled({
      "organization": organization.slug,
      "group": conversation.id
    })
    let address = match conversation.kind do
      Channel => channel
      Group => group
      _ => direct
    end
    App.Paths.threaded(address, opened(thread).as(String))
  end
end
