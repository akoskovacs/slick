# Organizations.
#
#   OrganizationRepository { db: db }.addressed("acme")
module DB.Repositories.Organizations

using Harmat.Db, only: [Db, eq]
using App.Models.Organization, only: [Organization]

record OrganizationRepository do
  db : Db
end

make OrganizationRepository do
  # Creates an organization. Fails when the address is taken: the unique
  # index on `slug` decides.
  foul chartered(name: String, slug: String, by: String) -> Result<Organization, String> do
    let organization = Organization { id: "o${BEAM.erlang.system_time(:microsecond)}-${BEAM.erlang.unique_integer([:positive])}", slug: slug, name: name }
    let row = {id: organization.id, slug: slug, name: name, created_by: by, created_at: "${DateTime.utcNow()}"}
    return @db.insert(DB.Schema.Organizations.definition).values(row).run.map { |_| organization }
  end

  # The organization at this address, or `None`.
  foul addressed(slug: String) -> Result<Organization?, String> do
    return @db.select().from(DB.Schema.Organizations.definition).where(eq(DB.Schema.Organizations.slug, slug)).first
      .map { |row| row.map { |found| decoded(found) } }
  end

  # The organization with this id, or `None`.
  foul identified(id: String) -> Result<Organization?, String> do
    return @db.select().from(DB.Schema.Organizations.definition).where(eq(DB.Schema.Organizations.id, id)).first
      .map { |row| row.map { |found| decoded(found) } }
  end
end

private do
  decoded : {String: String} -> Organization
  let decoded(row) = Organization { id: row.get("id").or(""), slug: row.get("slug").or(""), name: row.get("name").or("") }
end
