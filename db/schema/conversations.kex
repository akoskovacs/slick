# The `conversations` table: channels, private chats and group chats. See
# db/migrate/N0004_create_conversations.kex and N0021_add_groups.kex.
module DB.Schema.Conversations

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]
using App.Models.Conversation, only: [Kind, Access]

let definition = Table.define :conversations, doc: "Channels, private chats and group chats" do |t|
  t.text(:id, primaryKey: true)
  t.text(:kind, oneOf: Harmat.Column.choices(Type.of(Kind)), doc: "A channel, a chat between two people, or one between more")
  t.text(:slug, doc: "Its organization, then #name, @one:other or &all,of,them")
  t.text(:title, default: "")
  t.text(:topic, default: "")
  t.belongsTo(:first, :users, column: :first_user, default: "", doc: "In a private chat: the person whose id sorts first")
  t.belongsTo(:second, :users, column: :second_user, default: "", doc: "In a private chat: the other one")
  t.belongsTo(:creator, :users, column: :created_by, default: "")
  t.text(:created_at)
  t.belongsTo(:organization, :organizations, default: "")
  t.text(:access, default: "public", oneOf: Harmat.Column.choices(Type.of(Access)), doc: "Anyone in the organization, or only its participants and team")
  t.belongsTo(:team, :teams, default: "", doc: "The team that owns a channel")
  t.hasMany(:drafts, :drafts)
  t.hasMany(:readings, :readings)
  t.hasMany(:files, :files)
  t.hasMany(:reactions, :reactions)
  t.hasMany(:invocations, :invocations)
  t.hasMany(:answers, :answers)
  t.hasMany(:messages, :messages)
  t.hasMany(:participants, :participants)
end

let table = DB.Schema.Conversations.definition.table

let id = DB.Schema.Conversations.definition.textColumn(:id)
let kind = DB.Schema.Conversations.definition.textColumn(:kind)
let slug = DB.Schema.Conversations.definition.textColumn(:slug)
let title = DB.Schema.Conversations.definition.textColumn(:title)
let topic = DB.Schema.Conversations.definition.textColumn(:topic)
let firstUser = DB.Schema.Conversations.definition.textColumn(:first_user)
let secondUser = DB.Schema.Conversations.definition.textColumn(:second_user)
let createdBy = DB.Schema.Conversations.definition.textColumn(:created_by)
let createdAt = DB.Schema.Conversations.definition.textColumn(:created_at)
let organizationId = DB.Schema.Conversations.definition.textColumn(:organization_id)
let access = DB.Schema.Conversations.definition.textColumn(:access)
let teamId = DB.Schema.Conversations.definition.textColumn(:team_id)
