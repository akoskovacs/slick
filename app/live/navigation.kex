# What a tab shows, apart from what is stored: the dialog open over the
# conversation, which of its views is shown, and whether anybody is looking.
module App.Live.Navigation

using Metro.Live.Socket, only: [unchanged]
using App.Live.Event, only: [Event]
using App.Live.Outcome, only: [Outcome]
using App.Live.Tab, only: [
  Tab, Dialog, ConversationView, FilesView, SettingsView,
  ChannelDialog, GroupDialog, PromoteDialog, AdmitDialog, TeamDialog,
  TeamEditDialog, OrganizationDialog, InviteDialog, PeopleDialog, StatusDialog,
  ProfileDialog, BotsDialog
]
using App.Models.Message, only: [MessageId]
using App.Models.Ids, only: [UserId]
using App.Models.Team, only: [TeamId]

# The dialogs a tab opens by name (`dialog-open` with `dialog`).
on : String -> Event -> Outcome
foul on("dialog-open", event) do
  match dialogFrom(event.given("dialog")) do
    None => return unchanged(event.tab)
    Just(dialog) => do
      return unchanged(event.tab) if dialog == PeopleDialog && !event.user.canManage?(event.tab.organization)
      return unchanged(Tab { ...event.tab.closed, dialog: dialog })
    end
  end
end
# Closing whatever is open over the conversation: `cancel`, from a button,
# or from Metro's live.js on Escape or a click beside a dialog.
foul on("cancel", event) = unchanged(event.tab.closed)
foul on("view-messages", event) = unchanged(Tab { ...event.tab.closed, view: ConversationView })
foul on("view-files", event) = unchanged(Tab { ...event.tab.closed, thread: "".as(MessageId), view: FilesView })
foul on("view-settings", event) = unchanged(Tab { ...event.tab.closed, thread: "".as(MessageId), profile: "".as(UserId), team: "".as(TeamId), view: SettingsView })
# Whether somebody is looking at the tab: `attention`, from Metro's live.js.
foul on("attention", event) = unchanged(Tab { ...event.tab, attentive?: event.flag("on") })
foul on(_, event) = unchanged(event.tab)

private do
  dialogFrom : String -> Dialog?
  let dialogFrom("channel") = Just(ChannelDialog)
  let dialogFrom("group") = Just(GroupDialog)
  let dialogFrom("promote") = Just(PromoteDialog)
  let dialogFrom("admit") = Just(AdmitDialog)
  let dialogFrom("team") = Just(TeamDialog)
  let dialogFrom("team-edit") = Just(TeamEditDialog)
  let dialogFrom("organization") = Just(OrganizationDialog)
  let dialogFrom("invite") = Just(InviteDialog)
  let dialogFrom("people") = Just(PeopleDialog)
  let dialogFrom("status") = Just(StatusDialog)
  let dialogFrom("profile") = Just(ProfileDialog)
  let dialogFrom("bots") = Just(BotsDialog)
  let dialogFrom(_) = None
end
