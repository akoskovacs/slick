# Every URL the application answers. This is the one file that touches
# Rodolfo's router.
#
#   everything       Metro.Plugs.sameOrigin: no POST from another site
#   signed in only   GET /   POST /signout
#   signed out only  GET /signin   POST /signin   GET /register   POST /register
#   WS /live         the chat kept current: events in, markup out
#   GET /metro/live.js   the browser half of a live page, from Metro
#   GET /*           files from public/
#
# Who may reach what is said once, by the plug on each scope. Who is asking
# is a session token in the `slick_session` cookie.
module Config.Routes

using Rodolfo
using Net.HTTP.WebSocket, only: [Connection]
using Metro.Live.Hub, only: [Hub]
using App.Models.User, only: [User]
using Harmat.Db, only: [Db]
using DB.Store, only: [Store]

let COOKIE = "slick_session"

routes : Server<Store> -> Server<Hub> -> Rodolfo.Router
foul routes(store, hub) do
  let database = Harmat.Db.over(DB.Store.gateway(store))
  Rodolfo.router do
    plug(Metro.Plugs.sameOrigin)

    scope "" do
      plug(signedIn(database))

      get "/" do |env|
        let user : User = visitor(database, env).try
        page(App.Views.Chat.page(user.shown, App.Live.Chat.markup(database, user, App.Live.Tab.Tab {})))
      end

      post "/signout" do |env|
        App.Services.Authentication.signOut(database, token(env))
        Response.Redirect { status: 303, location: "/signin", headers: cookie(Metro.Cookies.cleared(COOKIE)) }
      end
    end

    scope "" do
      plug(signedOut(database))

      get "/signin" do
        page(App.Views.Auth.signin("", []))
      end

      post "/signin" do |env|
        let email = env.form("email").or("")
        match App.Services.Authentication.signIn(database, email, env.form("password").or("")) do
          Ok(token) => entered(env, token)
          Error(problems) => Response.HTML { status: 422, body: App.Views.Auth.signin(email, problems) }
        end
      end

      get "/register" do
        page(App.Views.Auth.register("", "", []))
      end

      post "/register" do |env|
        let name = env.form("name").or("")
        let email = env.form("email").or("")
        match App.Services.Authentication.register(database, name, email, env.form("password").or("")) do
          Ok(token) => entered(env, token)
          Error(problems) => Response.HTML { status: 422, body: App.Views.Auth.register(name, email, problems) }
        end
      end
    end

    # A `ws` route is outside the plug stack, so it asks the same two
    # questions itself and closes the socket on a wrong answer.
    ws "/live" do |env, socket|
      let user = Metro.Plugs.trusted?(env) then visitor(database, env) else None
      if user.none?
        socket.close
      else
        served(database, hub, socket, user.try)
      end
    end

    Metro.Live.Client.route()
    publicFolder("public")
  end
end

# --- Plugs ------------------------------------------------------------------

# Lets a signed-in request through; sends anyone else to sign in.
signedIn : Db -> Rodolfo.Plug
foul signedIn(database) = Plug.around do |inner, env|
  if visitor(database, env).set?
    inner(env)
  else
    redirectTo("/signin")
  end
end

# The reverse, for the sign-in and registration pages.
signedOut : Db -> Rodolfo.Plug
foul signedOut(database) = Plug.around do |inner, env|
  if visitor(database, env).set?
    redirectTo("/")
  else
    inner(env)
  end
end

private do
  # The session token a request carries, if any.
  token : Context -> String?
  let token(env) = Metro.Plugs.cookie(env, COOKIE)

  # Who is signed in on this request.
  visitor : Db -> Context -> User?
  foul visitor(database, env) = App.Services.Authentication.current(database, token(env))

  # Every tab is in one group: a message anywhere is news to every sidebar.
  # What a tab is then shown is still only what its person may read.
  foul served(database: Db, hub: Server<Hub>, socket: Connection, user: User) -> Void do
    Metro.Live.Socket.attached(
      socket, hub, "everyone", App.Live.Tab.Tab {},
      do |tab, event| App.Live.Chat.handled(database, user, tab, event) end,
      do |tab| App.Live.Chat.markup(database, user, tab) end
    )
  end

  # A page that must not be kept by a cache: it is one person's.
  page : String -> Rodolfo.Reply
  let page(body) = Response.HTML { body: body, headers: Net.HTTP.Headers.empty.add("Cache-Control", "no-store").or(Net.HTTP.Headers.empty) }

  cookie : String -> Net.HTTP.Headers
  let cookie(value) = Net.HTTP.Headers.empty.add("Set-Cookie", value).or(Net.HTTP.Headers.empty)

  # Signed in: hand the browser its session and send it home. `Secure` goes
  # on the cookie when the request arrived over HTTPS, as a proxy reports it.
  entered : Context -> String -> Rodolfo.Reply
  let entered(env, token) do
    let secure? = env.request.headers.get("X-Forwarded-Proto") == Just("https")
    let issued = Metro.Cookies.issued(COOKIE, token, App.Services.Authentication.LIFETIME, secure?)
    Response.Redirect { status: 303, location: "/", headers: cookie(issued) }
  end
end
