# Every address the application answers, and who gets as far as answering.
#
#   :application   the database, the hub and the statuses board, on every request
#   :browser       no request from another site; nothing kept by a cache
#   :members       signed in, or sent to sign in
#   :guests        signed out, or sent home
#   :bots          a bot's token, or 401
#
# Who is asking is a session token in the `slick_session` cookie for a
# person, and an `Authorization: Bearer` token for a bot. Each is looked up
# once, by a plug, and the actions are handed who it was.
module Config.Routes

using Metro.Live.Hub, only: [Hub]
using Metro.Plugs, only: [providing]
using Metro.Router, only: [pipeline, scope, get, post, live, static]
using DB.Store, only: [Store]
# Actions are named bare, and so imported by name: a reference through the
# module (`~App.Controllers.Chat.show`) does not resolve when it is called.
using App.Controllers.Accounts, only: [signInPage, signIn, signOut, registrationPage, register]
using App.Controllers.Api, only: [whoami, channelList, history, posted, reacting, statusSet]
using App.Controllers.Chat, only: [show]

routes : Server<Store> -> Server<Hub> -> Metro.Router.Router
foul routes(store, hub) do
  let database = Harmat.Db.over(DB.Store.gateway(store))
  # What people are in the middle of — typing, or what a bot says it is
  # doing. Remembered here and not in the database: it is only true for now.
  let statuses = Process.spawn(Metro.Live.Presence.Presence {})
  Metro.Router.define do
    pipeline(:application, [providing(:database, database), providing(:hub, hub), providing(:statuses, statuses)])
    pipeline(:browser, [Metro.Plugs.sameOrigin, Metro.Plugs.unstored])
    pipeline(:members, [App.Controllers.Application.signedIn()])
    pipeline(:guests, [App.Controllers.Application.signedOut()])
    pipeline(:bots, [App.Controllers.Application.bearer()])

    scope "/api", via: [:application, :bots] do
      get("/me", ~whoami)
      get("/:organization/channels", ~channelList)
      get("/:organization/channels/:name/messages", ~history)
      post("/:organization/channels/:name/messages", ~posted)
      post("/:organization/channels/:name/reactions", ~reacting)
      post("/:organization/channels/:name/status", ~statusSet)
      get("/:organization/dm/:person/messages", ~history)
      post("/:organization/dm/:person/messages", ~posted)
      post("/:organization/dm/:person/reactions", ~reacting)
      post("/:organization/dm/:person/status", ~statusSet)
    end

    scope "/", via: [:application, :browser, :guests] do
      get("/signin", ~signInPage)
      post("/signin", ~signIn)
      get("/register", ~registrationPage)
      post("/register", ~register)
    end

    scope "/", via: [:application, :browser, :members] do
      get("/", ~show)
      # A conversation has an address; the live view keeps the address bar
      # on the one it is showing, and a reload comes back here.
      get(App.Paths.channelPath.template, ~show)
      get(App.Paths.directPath.template, ~show)
      post("/signout", ~signOut)
      # The chat kept current: events in, markup out. Behind the same plugs
      # as the page, so a socket from another site, or from nobody, is refused.
      live "/live" do |request, socket| App.Controllers.Chat.joined(request, socket) end
    end

    Metro.Live.Client.route()
    static("public")
  end
end
