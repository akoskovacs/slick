# The `readings` table: how far each person has read in each conversation.
# `read_at` is a message's `sent_at`, in milliseconds since 1970;
# `thread_id` the message a followed thread starts with, or "".
module DB.Schema.Readings

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

# The schema is shared by the repositories that query this table.
  let definition = Table.define :readings do |t|
    t.text(:id, primaryKey: true)
    t.text(:user_id)
    t.text(:conversation_id)
    t.bigint(:read_at)
    t.text(:thread_id, default: "")
  end

  let id = definition.textColumn(:id)
  let userId = definition.textColumn(:user_id)
  let conversationId = definition.textColumn(:conversation_id)
  let readAt = definition.wholeColumn(:read_at)
