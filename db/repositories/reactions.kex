# Emoji on messages.
#
#   DB.Repositories.Reactions.flipped(message, user.id, "🎉")
module DB.Repositories.Reactions

using Harmat.Db, as: Db
using App.Models.Message, only: [Message]
using App.Models.Reaction, only: [Reaction]

# Every reaction in a conversation.
foul throughout(conversationId: String) -> Result<[Reaction], String> do
  return Db.select().from(DB.Schema.Reactions)
    .where(DB.Schema.Reactions.conversationId.eq(conversationId))
    .all
    .map { |rows| rows.map { |row| decoded(row) } }
end

# Puts a person's emoji on a message, or takes it off if it is there.
# Whether it is on afterwards.
foul flipped(message: Message, userId: String, emoji: String) -> Result<Bool, String> do
  let id = "${message.id}:${userId}:${emoji}"
  let existing = Db.select([:id]).from(DB.Schema.Reactions)
    .where(DB.Schema.Reactions.id.eq(id))
    .first
  match existing do
    Error(reason) => return Error(reason)
    Ok(Just(_)) => do
      return Db.delete(DB.Schema.Reactions)
        .where(DB.Schema.Reactions.id.eq(id))
        .run
        .map { |_| false }
    end
    Ok(None) => do
      let row = {
        id: id,
        conversation_id: message.conversationId,
        message_id: message.id,
        user_id: userId,
        emoji: emoji
      }
      return Db.insert(DB.Schema.Reactions)
        .values(row)
        .run
        .map { |_| true }
    end
  end
end

private do
  decoded : {String: String} -> Reaction
  let decoded(row) = Reaction {
    messageId: row.get("message_id").or(""),
    userId: row.get("user_id").or(""),
    emoji: row.get("emoji").or("")
  }
end
