# The whole of Slick as one live view: what each browser event does to a
# tab's state and to what is stored, and the markup that results.
# `Metro.Live.Socket` runs these two functions against a WebSocket
# (config/routes.kex).
#
# Every event is checked here against who sent it. A tab names an
# organization and a conversation by id, and an id is not a permission:
# `home` only ever answers with an organization its person is in, and
# `visible` only with a conversation of that organization they may read.
# Both are asked before anything is read or written, so the id of another
# organization's channel, or of somebody else's private chat, gets a tab
# nothing.
module App.Live.Chat

using Metro.Live.Presence, only: [Presence, Note]
using Metro.Live.Socket, only: [field, repeated]
using App.Live.Places, only: [home, visible, organizations, memberOrganization]
using App.Live.Tab, only: [Tab, closed]
using App.Models.Conversation, only: [Conversation]
using App.Models.Draft, only: [Draft]
using App.Models.Message, only: [Message]
using App.Models.Reading, only: [Reading]
using App.Models.Organization, only: [Organization]
using App.Models.Team, only: [Team]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Drafts, as: Drafts
using DB.Repositories.Memberships, as: Memberships
using DB.Repositories.Messages, as: Messages
using DB.Repositories.Readings, as: Readings
using DB.Repositories.Reactions, as: Reactions
using DB.Repositories.Answers, as: Answers
using DB.Repositories.Grants, as: Grants
using DB.Repositories.Teams, as: Teams
using DB.Repositories.Users, as: Users

# How many messages of a conversation a tab is shown.
let WINDOW = 200

# The live region for one person's tab, as things are stored right now.
#
# `statuses` is the board of what people are in the middle of — typing, or
# whatever a bot says it is doing: `Metro.Live.Presence`.
markup : Server<Presence> -> User -> Tab -> String
foul markup(statuses, user, tab) do
  match home(user, tab) do
    None => return App.Views.Chat.welcome(tab, user)
    Just(organization) => do
      let mine : [Organization] = organizations(user)
      let roster : [String] = Memberships.roster(organization.id).or([])
      let everyone : [User] = Users.everyone.or([])
      let people = everyone.filter { |person| roster.contains?(person.id) }
      let channels : [Conversation] = App.Live.Places.readable(user, Conversations.channels(organization.id).or([]))
      let groups : [Conversation] = Conversations.groupsOf(organization.id, user.id).or([])
      let teams : [Team] = Teams.ofOrganization(organization.id).or([])
      let now = Metro.Clock.milliseconds()
      let online : [String] = Metro.Live.Presence.standing(statuses, App.Live.Statuses.ONLINE, now)
        .map { |note| note.member.split(" ").first.or("") }
      let bots : [User] = tab.dialog == "bots" then App.Live.Bots.manageable(user, organization) else []
      let operators : {String: [String]} = bots.reduce({}) { |found, bot|
        found.put(bot.id, DB.Repositories.BotOperators.listed(bot.id).or([]))
      }
      let roles = Grants.over("organization", organization.id).or([])
        .filter { |grant| grant.subjectType == "user" }
        .reduce({}) { |found, grant| found.put(grant.subjectId, grant.role) }
      let administrator = App.Services.Authority.canManage(user, organization.id)
      let drafts : [Draft] = Drafts.pending(user.id).or([])
      let marks : [Reading] = Readings.marks(user.id).or([])
      match visible(user, tab) do
        None => do
          let unread = App.Live.Unread.counts(user, organization, mine, marks, "", "")
          return App.Views.Chat.index(
            tab,
            user,
            mine,
            organization,
            channels,
            groups,
            teams,
            people,
            online,
            bots,
            operators,
            drafts,
            unread,
            App.Views.Chat.Cabinet {},
            [],
            [],
            None,
            [],
            [],
            [],
            [],
            [],
            roles,
            administrator
          )
        end
        Just(conversation) => do
          let messages : [Message] = Messages.latest(conversation.id, WINDOW).or([])
          let thread = App.Live.Threads.messages(conversation, tab.thread)
          let (reading, readingThread) = App.Live.Unread.markRead(user, marks, conversation, messages, thread, tab.attentive?)
          let unread = App.Live.Unread.counts(user, organization, mine, marks, reading, readingThread)
          let reactions = Reactions.throughout(conversation.id).or([])
          let cabinet = App.Live.Files.cabinet(user, tab, conversation)
          let responses = Answers.collected(conversation.id).or([])
          let doing : [Note] = Metro.Live.Presence.standing(statuses, conversation.id, now)
          return App.Views.Chat.index(
            tab,
            user,
            mine,
            organization,
            channels,
            groups,
            teams,
            people,
            online,
            bots,
            operators,
            drafts,
            unread,
            cabinet,
            App.Live.Commands.available(user, conversation, people),
            DB.Repositories.Invocations.inside(conversation.id).or([]),
            Just(conversation),
            messages,
            reactions,
            responses,
            thread,
            doing.reject { |note| note.member == user.id },
            roles,
            administrator
          )
        end
      end
    end
  end
end

# Applies one event: the tab's next state, and whether something other tabs
# show was changed — in which case they are told to refresh. What changed in
# what a bot could see is noted to the events bus on the way (`bus`).
handled : Server<App.Live.Events.Bus> -> Server<Presence> -> User -> Tab -> [(String, String?)] -> (Tab, Bool)
foul handled(bus, statuses, user, tab, entries) = on(field(entries, "event"), Event {
  bus: bus,
  statuses: statuses,
  user: user,
  tab: tab,
  entries: entries
})

# One event from a tab, and whose tab it is.
record Event do
  bus : Server<App.Live.Events.Bus>
  statuses : Server<Presence>
  user : User
  tab : Tab
  # What the browser sent with it.
  entries : [(String, String?)]
end

# The dialogs a tab opens by name, with nothing else open over the
# conversation: the event that opens each, and the dialog.
let DIALOGS = {
  "channel-new": "channel",
  "group-new": "group",
  "promote": "promote",
  "admit": "admit",
  "team-new": "team",
  "team-edit": "team-edit",
  "organization-new": "organization",
  "invite": "invite",
  "status": "status",
  "profile-edit": "profile",
  "bots": "bots"
}

private do
  # What came with an event: as sent, trimmed, and every value sent for it.
  given : Event -> String -> String
  let given(event, key) = field(event.entries, key)

  typed : Event -> String -> String
  let typed(event, key) = field(event.entries, key).trim

  picked : Event -> String -> [String]
  let picked(event, key) = repeated(event.entries, key)

  # What each event does, by its name.
  on : String -> Event -> (Tab, Bool)

  # Conversations.
  foul on("conversation-open", event) = App.Live.Conversations.open(event.user, event.tab, given(event, "id"))
  foul on("direct-open", event) = App.Live.Conversations.openDirect(event.user, event.tab, given(event, "user"))
  foul on("channel-create", event) = App.Live.Conversations.createChannel(event.user, event.tab, typed(event, "title").lowerCase, given(event, "access"), given(event, "team"))
  foul on("channel-add", event) = App.Live.Conversations.addPeople(event.user, event.tab, picked(event, "person"))
  foul on("channel-configure", event) = App.Live.Conversations.configure(event.user, event.tab, given(event, "access"), given(event, "team"), given(event, "bot-access"))
  foul on("group-create", event) = App.Live.Conversations.createGroup(event.user, event.tab, picked(event, "person"))
  foul on("group-promote", event) = App.Live.Conversations.makeChannel(event.user, event.tab, typed(event, "title").lowerCase, given(event, "access"))
  foul on("topic-edit", event) = (Tab { ...closed(event.tab), retitling?: true }, false)
  foul on("topic-set", event) = App.Live.Conversations.setTopic(event.user, event.tab, typed(event, "topic"))
  foul on("settings", event) = (Tab { ...closed(event.tab), thread: "", profile: "", team: "", view: "settings" }, false)
  foul on("files", event) = (Tab { ...closed(event.tab), thread: "", view: "files" }, false)
  foul on("messages", event) = (Tab { ...closed(event.tab), view: "" }, false)

  # Messages and threads.
  foul on("send", event) = App.Live.Messages.send(event.bus, event.statuses, event.user, event.tab, typed(event, "body"))
  foul on("reply", event) = App.Live.Messages.reply(event.bus, event.statuses, event.user, event.tab, typed(event, "body"))
  foul on("draft-save", event) = App.Live.Messages.saveDraft(event.user, event.tab, given(event, "place"), given(event, "body"))
  foul on("react", event) = App.Live.Messages.react(event.user, event.tab, given(event, "message"), given(event, "emoji"))
  foul on("answer", event) = App.Live.Messages.answer(event.bus, event.user, event.tab, event.entries)
  foul on("file-attach", event) = App.Live.Messages.attach(event.user, event.tab, given(event, "file"))
  foul on("file-attach-failed", event) = App.Live.Messages.refuseUpload(event.tab, given(event, "filename"), given(event, "reason"))
  foul on("file-detach", event) = App.Live.Messages.detach(event.tab, given(event, "file"))
  foul on("thread-open", event) = App.Live.Threads.open(event.user, event.tab, given(event, "message"))
  foul on("thread-close", event) = (Tab { organization: event.tab.organization, conversation: event.tab.conversation }, false)
  foul on("typing", event) = App.Live.Statuses.markTyping(event.statuses, event.user, event.tab)

  # Teams.
  foul on("team-open", event) = App.Live.Teams.open(event.user, event.tab, given(event, "id"))
  foul on("team-close", event) = (Tab { ...closed(event.tab), team: "" }, false)
  foul on("team-create", event) = App.Live.Teams.create(event.user, event.tab, typed(event, "name"), typed(event, "description"), typed(event, "handle").lowerCase)
  foul on("team-update", event) = App.Live.Teams.update(event.user, event.tab, typed(event, "name"), typed(event, "description"))
  foul on("team-join", event) = App.Live.Teams.addMembers(event.user, event.tab, [event.user.id])
  foul on("team-add", event) = App.Live.Teams.addMembers(event.user, event.tab, picked(event, "person"))
  foul on("team-leave", event) = App.Live.Teams.removeMember(event.user, event.tab, event.user.id)
  foul on("team-remove", event) = App.Live.Teams.removeMember(event.user, event.tab, given(event, "user"))

  # Organizations, and who is in them.
  foul on("organization-switch", event) = App.Live.Organizations.switch(event.user, event.tab, given(event, "id"))
  foul on("organization-create", event) = App.Live.Organizations.create(event.user, event.tab, typed(event, "name"))
  foul on("invite-send", event) = App.Live.Organizations.invite(event.user, event.tab, typed(event, "email").lowerCase)
  foul on("role-set", event) = App.Live.Organizations.setRole(event.user, event.tab, given(event, "user"), given(event, "role"))
  foul on("member-remove", event) = App.Live.Organizations.removeMember(event.user, event.tab, given(event, "user"))

  # Profiles.
  foul on("profile-open", event) = App.Live.Profiles.open(event.user, event.tab, given(event, "user"))
  foul on("profile-close", event) = (Tab { ...closed(event.tab), profile: "" }, false)
  foul on("profile-update", event) = App.Live.Profiles.update(event.user, event.tab, event.entries)
  foul on("status-set", event) = App.Live.Profiles.setStatus(event.user, event.tab, typed(event, "emoji"), typed(event, "text"))
  foul on("status-clear", event) = App.Live.Profiles.setStatus(event.user, event.tab, "", "")

  # Bots.
  foul on("bot-create", event) = App.Live.Bots.create(event.user, event.tab, typed(event, "name"), given(event, "owner"))
  foul on("bot-rotate", event) = App.Live.Bots.rotateToken(event.user, event.tab, given(event, "id"))
  foul on("bot-add", event) = App.Live.Bots.add(event.user, event.tab, given(event, "id"))
  foul on("bot-remove", event) = App.Live.Bots.remove(event.user, event.tab, given(event, "id"))
  foul on("bot-operators-set", event) = App.Live.Bots.setOperators(event.user, event.tab, given(event, "bot"), picked(event, "operator"))
  foul on("bot-access-set", event) = App.Live.Bots.setAccess(event.user, event.tab, given(event, "access"))

  # The tab itself: what its person is looking at, and where it is.
  foul on("cancel", event) = (closed(event.tab), false)
  foul on("attention", event) = (Tab { ...event.tab, attentive?: given(event, "on") != "false" }, false)
  foul on("visit", event) = (arrived(event.user, given(event, "path")), false)

  # A dialog, by the event that opens it; any other event does nothing.
  foul on(name, event) = DIALOGS
    .get(name)
    .map { |dialog| (Tab { ...closed(event.tab), dialog: dialog }, false) }
    .or((event.tab, false))
end

# The tab for an address (App.Paths): a channel, a private chat or a group
# chat of an organization, any with `?thread=<message>`. Anything else, or a
# place this person may not be, is the tab everyone starts with. A private
# chat is started by going to it.
arrived : User -> String -> Tab
foul arrived(user, location) do
  let thread = Metro.Path.query(location, "thread").or("")
  match App.Paths.channelPath.captured(location) do
    Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
      None => return Tab {}
      Just(organization) => match Conversations.channelCalled(organization.id, parts.get("name").or("")) do
        Ok(Just(channel)) => return Tab { organization: organization.id, conversation: channel.id, thread: thread }
        _ => return Tab { organization: organization.id }
      end
    end
    None => match App.Paths.directPath.captured(location) do
      None => return grouped(user, location, thread)
      Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
        None => return Tab {}
        Just(organization) => do
          let (chat, _) = App.Live.Conversations.openDirect(user, Tab { organization: organization.id }, parts.get("person").or(""))
          return Tab { organization: organization.id, conversation: chat.conversation, thread: thread }
        end
      end
    end
  end
end

# The tab for the address of a group chat: only one this person is in.
grouped : User -> String -> String -> Tab
foul grouped(user, location, thread) do
  match App.Paths.groupPath.captured(location) do
    None => return Tab {}
    Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
      None => return Tab {}
      Just(organization) => do
        let tab = Tab { organization: organization.id, conversation: parts.get("group").or(""), thread: thread }
        match visible(user, tab) do
          Just(conversation) => return conversation.group? then tab else Tab { organization: organization.id }
          None => return Tab { organization: organization.id }
        end
      end
    end
  end
end
