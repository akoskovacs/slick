# Bots and their API tokens.
#
# A token is made here, handed back once, and stored only as its SHA-256:
# whoever reads the database cannot act as a bot.
module App.Services.Bots

using App.Models.User, only: [User]
using App.Models.Organization, only: [OrganizationId]
using DB.Repositories.Users, as: Users

# What every token starts with, so one found lying around can be recognised.
let PREFIX = "slick_bot_"

# Makes a bot: an organization's when `organizationId` names one, and
# otherwise this person's own. The bot, and its token.
built : User -> OrganizationId -> String -> Result<(User, String), String>
foul built(maker, organizationId, name) do
  let id = Metro.Id.generate(prefix: "b")
  let token = "${PREFIX}${Metro.Auth.Token.fresh()}"
  let bot = User {
    id: id, email: "${id}@bots.invalid", name: name, kind: "bot",
    ownerId: organizationId.empty? then maker.id else "", ownerOrganizationId: organizationId
  }
  return Users.automated(bot, Metro.Auth.Token.digest(token)).map { |made| (made, token) }
end

# Gives a bot a new token; the old one stops working. The bot has to be
# this person's own, or belong to `organizationId` — which the caller has
# already made sure this person is in.
renewed : User -> OrganizationId -> String -> Result<String, String>
foul renewed(asker, organizationId, botId) do
  let token = "${PREFIX}${Metro.Auth.Token.fresh()}"
  let digest = Metro.Auth.Token.digest(token)
  let own = Users.rekeyed(botId, asker.id, digest).or(false)

  return Ok(token) if own
  return Error("That is not one of your bots.") if organizationId.empty?

  let shared = Users.rekeyedFor(botId, organizationId, digest).or(false)

  return shared then Ok(token) else Error("That is not one of your bots, or of this organization's.")
end

# Deletes a bot, taking away its access with it: the bot has to be this
# person's own, or belong to `organizationId` — which the caller has
# already made sure this person is in.
removed : User -> OrganizationId -> String -> Result<Bool, String>
foul removed(asker, organizationId, botId) do
  let own = Users.removed(botId, asker.id).or(false)
  return Ok(true) if own
  return Error("That is not one of your bots.") if organizationId.empty?

  let shared = Users.removedFor(botId, organizationId).or(false)

  return shared then Ok(true) else Error("That is not one of your bots, or of this organization's.")
end

# The bot an `Authorization: Bearer …` header speaks for, if any.
bearer : String? -> User?
foul bearer(header) do
  let token = header.or("").split("Bearer ").drop(1).first.or("").trim
  return None if token.empty?

  match Users.bearing(Metro.Auth.Token.digest(token)) do
    Ok(Just(bot)) => return Just(bot)
    _ => return None
  end
end
