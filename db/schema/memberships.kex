# The `memberships` table: who is in which organization.
module DB.Schema.Memberships

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :memberships do |t|
  t.text(:id, primaryKey: true)
  t.text(:organization_id)
  t.text(:user_id)
  t.text(:joined_at)
end

let table = DB.Schema.Memberships.definition.table

let id = DB.Schema.Memberships.definition.textColumn(:id)
let organizationId = DB.Schema.Memberships.definition.textColumn(:organization_id)
let userId = DB.Schema.Memberships.definition.textColumn(:user_id)
