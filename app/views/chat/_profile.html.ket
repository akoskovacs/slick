---
params: [card: Card]
---
<aside class="profile" aria-label="Profile of <%= card.caption %>">
  <header class="heading thread-head">
    <h1>Profile</h1>
    <button type="button" class="quiet" data-event="unprofile" title="Close profile">✕</button>
  </header>
  <div class="profile-body">
    <span class="portrait tint-<%= card.tint %>" aria-hidden="true"><%= card.initial %></span>
    <h2><%= card.caption %>
    <% if !card.badged.empty? %>
      <span class="flag"><%= card.badged %></span>
    <% end %>
    </h2>
    <% if !card.name.empty? %>
      <p class="formal"><%= card.name %></p>
    <% end %>
    <% if !card.title.empty? %>
      <p class="role"><%= card.title %></p>
    <% end %>
    <p class="presence<% if card.active? %> active<% end %>"><%= card.presence %></p>
    <% if !card.emblem.empty? || !card.statusText.empty? %>
      <p class="motto"><%= card.emblem %> <%= card.statusText %></p>
    <% end %>
    <% if !card.bio.empty? %>
      <p class="bio"><%= card.bio %></p>
    <% end %>
    <div class="actions">
    <% if card.own? %>
      <button type="button" data-event="profile-edit">Edit profile</button>
      <button type="button" data-event="status">Set a status…</button>
    <% else %>
      <button type="button" class="primary"
        data-event="direct" data-user="<%= card.key %>">Message</button>
    <% end %>
    </div>
    <dl class="details">
    <% if !card.department.empty? %>
      <dt>Department</dt>
      <dd><%= card.department %></dd>
    <% end %>
    <% if !card.mail.empty? %>
      <dt>Email</dt>
      <dd><a href="mailto:<%= card.mail %>"><%= card.mail %></a></dd>
    <% end %>
    <% if !card.phone.empty? %>
      <dt>Phone</dt>
      <dd><a href="tel:<%= card.phone %>"><%= card.phone %></a></dd>
    <% end %>
    <% if !card.timeZone.empty? %>
      <dt>Time zone</dt>
      <dd><%= card.timeZone %></dd>
    <% end %>
    <% if !card.keeper.empty? %>
      <dt>Belongs to</dt>
      <% if card.keeperKey.empty? %>
        <dd><%= card.keeper %></dd>
      <% else %>
        <dd>
          <button type="button" class="link"
            data-event="profile" data-user="<%= card.keeperKey %>"><%= card.keeper %></button>
        </dd>
      <% end %>
    <% end %>
    </dl>
  </div>
</aside>
