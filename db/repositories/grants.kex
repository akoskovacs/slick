# Grants: who holds what role over what. One table for every membership —
# in an organization, a conversation or a team — and every administrative
# role, with teams as subjects that hand their members their roles.
# See docs/permissions.md.
module DB.Repositories.Grants

using Harmat.Database, as: Database
using App.Models.Grant, as: Grant
using App.Models.Grant, only: [Grant, GrantId, GrantSubjectId, GrantResourceId, GrantSubjectType, GrantResourceType, GrantRole, UserSubject, OrganizationResource, ConversationResource, TeamResource]
using App.Models.Ids, only: [UserId]
using App.Models.Team, only: [TeamId]
using App.Models.Organization, only: [OrganizationId]
using App.Models.Conversation, only: [ConversationId]

# Grants a role, in place of any earlier grant of the same subject over the
# same resource.
foul grant(grant: Grant) -> Grant or! String do
  let id = Grant.idFor(grant.subjectType, grant.subjectId, grant.resourceType, grant.resourceId)
  let stored = Grant { ...grant, id: id, grantedAt: Metro.Clock.milliseconds() }
  let subjectType = stored.subjectType
  let subjectId = stored.subjectId.as(String)
  let resourceType = stored.resourceType
  let resourceId = stored.resourceId.as(String)
  let role = stored.role
  let grantedAt = stored.grantedAt
  let row = {
    id: id,
    subject_type: subjectType,
    subject_id: subjectId,
    resource_type: resourceType,
    resource_id: resourceId,
    role: role,
    granted_at: grantedAt
  }
  let made : Grant or! String = Database.transaction do
    Database.delete(DB.Schema.Grants.definition).where(DB.Schema.Grants.id == id.as(String)).run.try
    Database.insert(DB.Schema.Grants.definition)
      .values(row)
      .run
      .try
    Ok(stored)
  end
  return made
end

# Takes a grant back.
foul revoke(grantId: GrantId) -> Integer or! String do
  return Database.delete(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.id == grantId.as(String))
    .run
end

# Every grant one subject holds.
foul heldBy(subjectType: GrantSubjectType, subjectId: GrantSubjectId) -> [Grant] or! String do
  return Database.select().from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId.as(String))
    .all(as: Grant)
end

# Every grant over each of some resources, whoever holds it, by resource.
foul overEach(resourceType: GrantResourceType, resourceIds: [GrantResourceId]) -> {GrantResourceId: [Grant]} or! String do
  return Ok({}) if resourceIds.empty?
  let found = Database.select().from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId.in(resourceIds.map { |id| id.as(String) }))
    .all(as: Grant)
    .try
  return Ok(found.reduce({}) do |grouped, grant|
    let resourceId = grant.resourceId
    grouped.put(resourceId, grouped.get(resourceId).or([]) + [grant])
  end)
end

# Every grant over one resource, whoever holds it.
foul over(resourceType: GrantResourceType, resourceId: GrantResourceId) -> [Grant] or! String do
  return Database.select().from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId.as(String))
    .all(as: Grant)
end

# The teams a user is in, by id.
foul teamsOf(userId: UserId) -> [TeamId] or! String do
  # The Kex query decoder needs the concrete String type; keep the ID alias
  # in the repository result so callers don't lose the domain type.
  let found : Result<[TeamId], String> = Database.select([:resource_id]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.subjectId == userId.as(String))
    .where(DB.Schema.Grants.resourceType == Database.spelled(TeamResource))
    .orderBy([:granted_at, :id])
    .all(as: TeamId)
  return found
end

# The organizations a user is in, by id — in any role, so a read-only
# member is still in their organization — oldest grant first.
foul organizationsOf(userId: UserId) -> [OrganizationId] or! String do
  let found : Result<[OrganizationId], String> = Database.select([:resource_id]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.subjectId == userId.as(String))
    .where(DB.Schema.Grants.resourceType == Database.spelled(OrganizationResource))
    .orderBy([:granted_at, :id])
    .all(as: OrganizationId)
  return found
end

# The users holding any grant over a resource, by id.
foul members(resourceType: GrantResourceType, resourceId: GrantResourceId) -> [UserId] or! String do
  return Database.select([:subject_id]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId.as(String))
    .orderBy([:granted_at, :id])
    .all(as: UserId)
end

# The users holding any grant over each of some resources, by resource.
foul membersOf(resourceType: GrantResourceType, resourceIds: [GrantResourceId]) -> {GrantResourceId: [UserId]} or! String do
  return Ok({}) if resourceIds.empty?
  let rows = Database.select([:resource_id, :subject_id]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId.in(resourceIds.map { |id| id.as(String) }))
    .orderBy([:granted_at, :id])
    .all
    .try
  return Ok(rows.reduce({}) do |found, row|
    let place = row.get("resource_id").or("").as(GrantResourceId)
    found.put(place, found.get(place).or([]) + [row.get("subject_id").or("").as(UserId)])
  end)
end

# Who may read each of some resources: everyone holding a grant over one —
# a team's grant handing it to every member of the team — by resource.
foul readersOf(resourceType: GrantResourceType, resourceIds: [GrantResourceId]) -> {GrantResourceId: [UserId]} or! String do
  return Ok({}) if resourceIds.empty?
  let found = Database.select().from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId.in(resourceIds.map { |id| id.as(String) }))
    .orderBy([:granted_at, :id])
    .all(as: Grant)
    .try
  let teamIds = found.flatMap { |grant| grant.teamId.map { |id| [id.as(String).as(GrantResourceId)] }.or([]) }.uniq
  let teams : {GrantResourceId: [UserId]} = membersOf(TeamResource, teamIds).or({})
  return Ok(found.reduce({}) do |grouped, grant|
    let holders = match grant.userId do
      Just(id) => [id]
      None => grant.teamId.map { |id| teams.get(id.as(String).as(GrantResourceId)).or([]) }.or([])
    end
    let resourceId = grant.resourceId
    grouped.put(resourceId, (grouped.get(resourceId).or([]) + holders).uniq)
  end)
end

# Who may read one resource.
foul readers(resourceType: GrantResourceType, resourceId: GrantResourceId) -> [UserId] or! String do
  return readersOf(resourceType, [resourceId]).map { |grouped| grouped.get(resourceId).or([]) }
end

# The conversations a user holds a grant over, by id.
foul conversationsOf(userId: UserId) -> [ConversationId] or! String do
  return Database.select([:resource_id]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.subjectId == userId.as(String))
    .where(DB.Schema.Grants.resourceType == Database.spelled(ConversationResource))
    .orderBy([:granted_at, :id])
    .all(as: ConversationId)
end

# Whether a subject holds any grant over a resource.
foul holds?(subjectType: GrantSubjectType, subjectId: GrantSubjectId, resourceType: GrantResourceType, resourceId: GrantResourceId) -> Bool do
  let found = Database.select([:id]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId.as(String))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId.as(String))
    .first
  match found do
    Ok(Just(_)) => return true
    _ => return false
  end
end

# The users holding a given role over a resource, by id.
foul roleHolders(resourceType: GrantResourceType, resourceId: GrantResourceId, role: GrantRole) -> [UserId] or! String do
  return Database.select([:subject_id]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId.as(String))
    .where(DB.Schema.Grants.role == Database.spelled(role))
    .orderBy([:granted_at, :id])
    .all(as: UserId)
end

# When a subject was granted a role over a resource, in milliseconds since
# 1970; 0 for never.
foul grantedAt(subjectType: GrantSubjectType, subjectId: GrantSubjectId, resourceType: GrantResourceType, resourceId: GrantResourceId) -> Integer do
  let found = Database.select([:granted_at]).from(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId.as(String))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId.as(String))
    .first
  match found do
    Ok(Just(row)) => return row.get("granted_at").or("0").to(Integer).or(0)
    _ => return 0
  end
end

# Takes back every grant a subject holds: everything it could do, gone.
foul revokeAll(subjectType: GrantSubjectType, subjectId: GrantSubjectId) -> Integer or! String do
  return Database.delete(DB.Schema.Grants.definition)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId.as(String))
    .run
end
