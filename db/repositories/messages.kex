# What was said.
#
#   DB.Repositories.Messages.latest(conversation.id, 200)
module DB.Repositories.Messages

using Harmat.Database, as: Database
using App.Models.Message, only: [Message]

# The newest `limit` messages of a conversation, oldest first. Replies are
# not among them: they are read with the thread they belong to.
foul latest(conversationId: String, limit: Integer) -> [Message] or! String do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.conversationId == conversationId)
    .where(DB.Schema.Messages.parentId == "")
    .orderBy(descending: [:sent_at, :id])
    .limit(limit)
    .all(as: Message)
    .map { |messages| messages.reverse }
end

# How many messages of a conversation are newer than `after`, in
# milliseconds since 1970. Replies are not counted: they are read in their
# thread.
foul newerCount(conversationId: String, after: Integer) -> Integer or! String do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.conversationId == conversationId)
    .where(DB.Schema.Messages.parentId == "")
    .where(DB.Schema.Messages.sentAt > after)
    .count
end

# The replies to any of these messages newer than `after`, oldest first.
foul repliesTo(rootIds: [String], after: Integer) -> [Message] or! String do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.parentId.in(rootIds))
    .where(DB.Schema.Messages.sentAt > after)
    .orderBy([:sent_at, :id])
    .all(as: Message)
end

# The replies to a message, oldest first.
foul replies(rootId: String) -> [Message] or! String do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.parentId == rootId)
    .orderBy([:sent_at, :id])
    .all(as: Message)
end

# The bot authors of a thread's messages — the root and its replies — by id,
# from among `botIds`.
foul botAuthors(rootId: String, botIds: [String]) -> [String] or! String do
  let root = Database.select([:user_id]).from(DB.Schema.Messages)
    .where(DB.Schema.Messages.id == rootId)
    .pluck(:user_id)
    .or([])
  let replies = Database.select([:user_id]).from(DB.Schema.Messages)
    .where(DB.Schema.Messages.parentId == rootId)
    .pluck(:user_id)
    .or([])
  return Ok((root + replies).filter { |id| botIds.contains?(id) }.uniq)
end

# Stores a message, stamped now. With a parent it is a reply, and the
# parent's count is brought up to date — counted again, not added to, so
# two replies at once cannot leave it wrong.
foul create(conversationId: String, userId: String, body: String, parent: String) -> Message or! String do
  let moment = Metro.Clock.milliseconds()
  let message = Message {
    id: "m${moment}-${Metro.Id.serial()}",
    conversationId: conversationId,
    userId: userId,
    body: body,
    sentAt: moment,
    parentId: parent
  }
  let row = {
    id: message.id,
    conversation_id: conversationId,
    user_id: userId,
    body: body,
    sent_at: moment,
    parent_id: parent
  }
  # A reply and its thread's count change together, or not at all.
  let stored : Integer or! String = Database.transaction do
    let inserted = Database.insert(DB.Schema.Messages)
      .values(row)
      .run
      .try
    if parent.empty?
      Ok(inserted)
    else
      let replies = replies(parent).try
      Database.update(DB.Schema.Messages)
        .set({reply_count: replies.count})
        .where(DB.Schema.Messages.id == parent)
        .run
    end
  end
  return stored.map { |_| message }
end

# One message, or `None`.
foul find(id: String) -> Message? or! String do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.id == id)
    .first(as: Message)
end
