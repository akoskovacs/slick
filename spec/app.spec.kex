using Metro.Live.Presence, only: [Presence]
using Metro.Environment, only: [Development, Test, Production]
using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.User, only: [User]

# Slick as it is linked for serving: the routes are built, so Rodolfo and
# Net.HTTP are part of the program, and the live view is driven the way a
# browser drives it — one event at a time. Some names only stop resolving
# once the HTTP stack is linked in (kexhq/kex#451); this is the tripwire.

foul stepped(statuses: Server<Presence>, user: User, tab: Tab, fields: [(String, String)]) -> (Tab, Bool) do
  App.Live.Chat.handled(statuses, user, tab, fields.map { |pair| match pair do (key, value) => (key, Just(value)) end })
end

describe("Slick") do
  it("has one migration history that matches db/schema, all of it reversible") do
    Assert.equal(Harmat.Table.drift(DB.Schema.tables, DB.Migrations.all), [])
    Assert.equal(Harmat.Migration.irreversible(DB.Migrations.all), [])
    Assert.equal(Harmat.Migration.head(DB.Migrations.all), Ok("create_files"))
  end

  it("turns shortcodes into emoji") do
    Assert.equal(App.Models.Emoji.shown("ship it :rocket: :tada:"), "ship it 🚀 🎉")
    Assert.equal(App.Models.Emoji.shown("10:30 :nope:"), "10:30 :nope:")
  end

  it("shows a message of nothing but emoji big") do
    Assert.truthy(App.Models.Emoji.emojiOnly?("🎉"))
    Assert.truthy(App.Models.Emoji.emojiOnly?("🎉 🚀"))
    Assert.truthy(App.Models.Emoji.emojiOnly?("👨‍👩‍👧 ❤️"))
    Assert.truthy(App.Models.Emoji.emojiOnly?(":tada::rocket:"))
    Assert.falsy(App.Models.Emoji.emojiOnly?(""))
    Assert.falsy(App.Models.Emoji.emojiOnly?("   "))
    Assert.falsy(App.Models.Emoji.emojiOnly?("🎉!"))
    Assert.falsy(App.Models.Emoji.emojiOnly?("..."))
    Assert.falsy(App.Models.Emoji.emojiOnly?("ship it :rocket:"))
    Assert.equal(App.Helpers.RichText.html("🎉 🚀"), "<div class=\"big-emoji\"><p>🎉 🚀</p></div>")
    Assert.equal(App.Helpers.RichText.html("🎉!"), "<p>🎉!</p>")
  end

  it("reads a message as blocks of rich text, and nothing typed as markup") do
    Assert.equal(App.Helpers.RichText.html("hello"), "<p>hello</p>")
    Assert.equal(App.Helpers.RichText.html("*bold* _it_ ~gone~ `co*de*`"), "<p><strong>bold</strong> <em>it</em> <s>gone</s> <code>co*de*</code></p>")
    Assert.equal(App.Helpers.RichText.html("*bold and _both_*"), "<p><strong>bold and <em>both</em></strong></p>")
    # Marks only count around a word.
    Assert.equal(App.Helpers.RichText.html("snake_case_name and 2 * 3 * 4"), "<p>snake_case_name and 2 * 3 * 4</p>")
    Assert.equal(App.Helpers.RichText.html("a lone * star"), "<p>a lone * star</p>")
    Assert.equal(App.Helpers.RichText.html("ship it :rocket:"), "<p>ship it 🚀</p>")
    # Nothing typed is markup.
    Assert.equal(App.Helpers.RichText.html("<script>alert(1)</script> *<b>*"), "<p>&lt;script&gt;alert(1)&lt;/script&gt; <strong>&lt;b&gt;</strong></p>")
    # Only http and https addresses are links; the sentence's full stop is not part of one.
    Assert.equal(App.Helpers.RichText.html("see https://kex.dev/a_b_c."), "<p>see <a href=\"https://kex.dev/a_b_c\" target=\"_blank\" rel=\"noopener noreferrer nofollow\">https://kex.dev/a_b_c</a>.</p>")
    Assert.falsy(App.Helpers.RichText.html("javascript:alert(1) data:text/html,x").contains?("<a"))
    Assert.truthy(App.Helpers.RichText.html("https://a.b/?q=\"><script>").contains?("href=\"https://a.b/?q=&quot;&gt;&lt;script&gt;\""))
    # Blocks.
    let message = "# Release 1.2\nTwo lines\nof text\n\n- one\n- *two*\n> quoted\n---\n```\nlet x = <1>\n*not bold*\n```\nafter"
    Assert.equal(
      App.Helpers.RichText.html(message),
      "<h3>Release 1.2</h3><p>Two lines<br>of text</p><ul><li>one</li><li><strong>two</strong></li></ul><blockquote>quoted</blockquote><hr><pre><code>let x = &lt;1&gt;\n*not bold*</code></pre><p>after</p>"
    )
    Assert.equal(App.Helpers.RichText.html("```\nnever closed"), "<pre><code>never closed</code></pre>")

    # A form: one choice is buttons, anything more is fields and Send.
    let poll = App.Helpers.RichText.shown("[?] Deploy to: staging | production", "m1", [])
    Assert.truthy(poll.contains?("<p class=\"asked\">Deploy to</p>"))
    Assert.truthy(poll.contains?("data-event=\"answer\" data-message=\"m1\" data-form=\"0\" data-label=\"Deploy to\" data-value=\"staging\""))
    let form = "Please say:\n[?] Where: here | there\n[?] Notes"
    let asked = App.Helpers.RichText.shown(form, "m2", [])
    Assert.truthy(asked.contains?("<p>Please say:</p><form class=\"asking-form\" data-live=\"answer\""))
    Assert.truthy(asked.contains?("name=\"message\" value=\"m2\"") && asked.contains?("name=\"form\" value=\"1\""))
    Assert.truthy(asked.contains?("<select name=\"f0\"><option>here</option><option>there</option></select>"))
    Assert.truthy(asked.contains?("<span>Notes</span><input name=\"f1\""))
    Assert.falsy(asked.contains?("class=\"responses\""))
    # Where there is no message to answer in, a form cannot be used.
    Assert.truthy(App.Helpers.RichText.html("[?] Deploy to: staging | production").contains?(" disabled>"))
    # A label and an option are text like any other.
    Assert.truthy(App.Helpers.RichText.shown("[?] <b>: \"x\" | <i>", "m", []).contains?("data-value=\"&quot;x&quot;\""))

    # The answers a form has had are shown under it, and are text too.
    let given = [
      App.Helpers.RichText.Given { form: 1, who: "Ada", mine?: true, answer: "Where: here\nNotes: <soon>" },
      App.Helpers.RichText.Given { form: 0, who: "Bob", answer: "not a form" }
    ]
    Assert.truthy(App.Helpers.RichText.shown(form, "m2", given).contains?("<li class=\"response mine\"><strong>Ada</strong> <span>Where: here · Notes: &lt;soon&gt;</span></li>"))
    Assert.falsy(App.Helpers.RichText.shown(form, "m2", given).contains?("Bob"))
    let voted = [App.Helpers.RichText.Given { form: 0, who: "Bob", answer: "Deploy to: staging" }]
    Assert.truthy(App.Helpers.RichText.shown("[?] Deploy to: staging | production", "m1", voted).contains?("<strong>Bob</strong> <span>staging</span>"))

    # An answer is what the form sent, when the form offered it.
    Assert.equal(App.Helpers.RichText.answer(form, [("form", Just("1")), ("label", Just("Where")), ("value", Just("there"))]), Just((1, "Where: there")))
    Assert.equal(App.Helpers.RichText.answer(form, [("form", Just("1")), ("label", Just("Where")), ("value", Just("elsewhere"))]), None)
    Assert.equal(App.Helpers.RichText.answer(form, [("form", Just("1")), ("label", Just("Notes")), ("value", Just("there"))]), None)
    Assert.equal(App.Helpers.RichText.answer(form, [("form", Just("1")), ("f0", Just("here")), ("f1", Just(" soon\nplease "))]), Just((1, "Where: here\nNotes: soon please")))
    Assert.equal(App.Helpers.RichText.answer(form, [("form", Just("1")), ("f0", Just("nowhere")), ("f1", Just(""))]), None)
    Assert.equal(App.Helpers.RichText.answer(form, [("form", Just("0")), ("f0", Just("here"))]), None)
    Assert.equal(App.Helpers.RichText.answer(form, [("label", Just("Where")), ("value", Just("there"))]), None)

    # The API tells a form as a block, and takes one back as the same text.
    let told = App.Helpers.RichText.described(form)
    Assert.equal(JSON.stringify(told.drop(1)), "[{\"fields\":[{\"label\":\"Where\",\"options\":[\"here\",\"there\"]},{\"label\":\"Notes\"}],\"type\":\"form\"}]")
    Assert.equal(App.Helpers.RichText.composed(told), "Please say:\n\n[?] Where: here | there\n[?] Notes")
    # The API's form of the same blocks, and back.
    let listed = App.Helpers.RichText.described(message)
    Assert.equal(listed.count, 7)
    Assert.equal(JSON.stringify(listed.take(1)), "[{\"text\":\"Release 1.2\",\"type\":\"heading\"}]")
    Assert.equal(App.Helpers.RichText.html(App.Helpers.RichText.composed(listed)), App.Helpers.RichText.html(message))
  end

  it("answers over HTTP: pages for people, JSON for bots, and neither for the wrong one") do
    let file = "db/spec_routes_${Metro.Clock.milliseconds()}.sqlite3"
    let store = DB.Store.started(Config.Database.sqlite(file)).try
    DB.Store.migrate(store).try
    with Harmat.Connection = DB.Store.StoreConnection { store: store } do
      let site = Config.Routes.routes(Process.spawn(Metro.Live.Hub.Hub {}))
      let here = [("Host", "slick.test"), ("Origin", "http://slick.test")]

      # Nobody signed in: sent to sign in, and the page there is not kept.
      let anonymous = site.call(Metro.WebRequest.asked("GET", "/"))
      Assert.equal(anonymous.code, 303)
      Assert.equal(anonymous.outgoing.get("Location"), Just("/signin"))
      let signin = site.call(Metro.WebRequest.asked("GET", "/signin"))
      Assert.equal(signin.code, 200)
      Assert.equal(signin.outgoing.get("Cache-Control"), Just("no-store"))
      Assert.truthy(signin.payload.to(String).or("").contains?("/app.css?v="))

      # Registering: not from another site, not with a short password.
      let form = "name=Ada&email=ada%40example.com&password=correct+horse"
      Assert.equal(site.call(Metro.WebRequest.asked("POST", "/register", [("Host", "slick.test"), ("Origin", "http://evil.example")], form)).code, 403)
      Assert.equal(site.call(Metro.WebRequest.asked("POST", "/register", here, "name=Ada&email=ada%40example.com&password=short")).code, 422)
      let registered = site.call(Metro.WebRequest.asked("POST", "/register", here, form))
      Assert.equal(registered.code, 303)
      let cookie = registered.outgoing.get("Set-Cookie").or("").split(";").first.or("")
      Assert.truthy(cookie.startsWith?("slick_session="))

      # Signed in: the chat page, at any of its addresses; the sign-in page sends home.
      let home = site.call(Metro.WebRequest.asked("GET", "/", [("Cookie", cookie)], ""))
      Assert.equal(home.code, 200)
      Assert.truthy(home.payload.to(String).or("").contains?("Welcome, Ada"))
      Assert.truthy(home.payload.to(String).or("").contains?("/metro/live.js?v="))
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/acme/channels/general", [("Cookie", cookie)], "")).code, 200)
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/signin", [("Cookie", cookie)], "")).outgoing.get("Location"), Just("/"))

      # The API wants a bot's token, and a person's cookie is not one.
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/api/me")).code, 401)
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/api/me", [("Cookie", cookie)], "")).code, 401)
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/api/me", [("Authorization", "Bearer slick_bot_nope")], "")).code, 401)

      # Signing out ends it.
      let out = site.call(Metro.WebRequest.asked("POST", "/signout", here + [("Cookie", cookie)], ""))
      Assert.equal(out.outgoing.get("Location"), Just("/signin"))
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/", [("Cookie", cookie)], "")).code, 303)

      # Files of public/, and nothing else.
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/app.css")).code, 200)
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/../package.kex")).code, 404)
    end
    FS.File.delete(file)
  end

  it("seeds development with somewhere to sign in, once, and nothing elsewhere") do
    let file = "db/spec_seeds_${Metro.Clock.milliseconds()}.sqlite3"
    let store = DB.Store.started(Config.Database.sqlite(file)).try
    DB.Store.migrate(store).try
    with Harmat.Connection = DB.Store.StoreConnection { store: store } do
      Assert.equal(DB.Seeds.planted(Test), Ok([]))
      Assert.equal(DB.Seeds.planted(Production), Ok([]))
      Assert.equal(DB.Seeds.planted(Development).map { |lines| lines.count }, Ok(4))
      Assert.equal(DB.Seeds.planted(Development), Ok([]))

      let token = App.Services.Authentication.signIn("ada@example.com", DB.Seeds.PASSWORD).try
      let ada : User = App.Services.Authentication.current(Just(token)).try
      let statuses = Process.spawn(Metro.Live.Presence.Presence {})
      Assert.truthy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("Welcome to Acme 👋"))
      let claude : User = App.Services.Bots.bearer(Just("Bearer ${DB.Seeds.BOT_TOKEN}")).try
      Assert.equal(claude.name, "claude")

      # The bot reads a channel through the API, and a thread when it asks
      # for one — but only a thread of the conversation it names.
      let site = Config.Routes.routes(Process.spawn(Metro.Live.Hub.Hub {}))
      let asBot = [("Authorization", "Bearer ${DB.Seeds.BOT_TOKEN}")]
      let general = site.call(Metro.WebRequest.asked("GET", "/api/acme/channels/general/messages", asBot, ""))
      Assert.equal(general.code, 200)
      let said = general.payload.to(String).or("")
      Assert.truthy(said.contains?("The checklist") && !said.contains?("I can take the migration."))
      # A message's fields come in alphabetical order: its id after its body.
      let rootId = said.split("The checklist").last.or("").split("\"id\":\"").second.or("").split("\"").first.or("")
      let thread = site.call(Metro.WebRequest.asked("GET", "/api/acme/channels/general/messages?thread=${rootId}", asBot, ""))
      Assert.truthy(thread.payload.to(String).or("").contains?("I can take the migration."))
      let elsewhere = site.call(Metro.WebRequest.asked("GET", "/api/acme/channels/random/messages?thread=${rootId}", asBot, ""))
      Assert.equal(elsewhere.payload.to(String).or(""), "[]")

      # It is told the answers to the forms in its own messages — and those
      # only: where each was asked, who answered, and what.
      let asBotJson = asBot + [("Content-Type", "application/json")]
      let none = site.call(Metro.WebRequest.asked("GET", "/api/acme/answers", asBot, ""))
      Assert.equal(none.payload.to(String).or(""), "[]")
      let question = site.call(Metro.WebRequest.asked("POST", "/api/acme/channels/general/messages", asBotJson, "{\"body\":\"[?] Ship it: yes | no\"}"))
      Assert.equal(question.code, 201)
      let questionId = question.payload.to(String).or("").split("\"id\":\"").second.or("").split("\"").first.or("")
      let inGeneral = App.Live.Chat.arrived(ada, "/acme/channels/general")
      stepped(statuses, ada, inGeneral, [("event", "answer"), ("message", questionId), ("form", "0"), ("label", "Ship it"), ("value", "yes")])
      stepped(statuses, ada, inGeneral, [("event", "send"), ("body", "[?] Ship it: yes | no")])
      let answers = site.call(Metro.WebRequest.asked("GET", "/api/acme/answers", asBot, "")).payload.to(String).or("")
      Assert.truthy(answers.contains?("\"answer\":\"Ship it: yes\"") && answers.contains?("\"channel\":\"general\""))
      Assert.truthy(answers.contains?("\"user\":\"${ada.id}\"") && answers.contains?("\"message\":\"${questionId}\""))
      Assert.equal(answers.split("\"answer\":").count, 2)
      let later = site.call(Metro.WebRequest.asked("GET", "/api/acme/answers?after=99999999999999", asBot, ""))
      Assert.equal(later.payload.to(String).or(""), "[]")

      # It is told which private chats it has, once somebody has opened one.
      let before = site.call(Metro.WebRequest.asked("GET", "/api/acme/dm", asBot, ""))
      Assert.equal(before.payload.to(String).or(""), "[]")
      stepped(statuses, ada, Tab {}, [("event", "direct"), ("user", claude.id)])
      let chats = site.call(Metro.WebRequest.asked("GET", "/api/acme/dm", asBot, "")).payload.to(String).or("")
      Assert.truthy(chats.contains?("\"person\":\"${ada.id}\"") && chats.contains?("\"name\":\"Ada\""))
    end
    FS.File.delete(file)
  end

  it("lets people register, chat in channels and in private, react and set topics") do
    let file = "db/spec_${Metro.Clock.milliseconds()}.sqlite3"
    let store = DB.Store.started(Config.Database.sqlite(file)).try
    DB.Store.migrate(store).try
    with Harmat.Connection = DB.Store.StoreConnection { store: store } do
      let site = Config.Routes.routes(Process.spawn(Metro.Live.Hub.Hub {}))
      Assert.truthy(site.table.count > 0)
      let statuses = Process.spawn(Metro.Live.Presence.Presence {})

      # Registration needs a name; sign-in works afterwards.
      Assert.truthy(App.Services.Authentication.register("", "ada@example.com", "correct horse battery").error?)
      Assert.truthy(App.Services.Authentication.register("Ada", "ada@example.com", "7 chars").error?)
      Assert.truthy(App.Services.Authentication.register("Zed", "zed@example.com", "8 chars!").ok?)
      let adaToken = App.Services.Authentication.register("Ada", "ada@example.com", "correct horse battery").try
      let bobToken = App.Services.Authentication.register("Bob", "bob@example.com", "another long phrase").try
      let eveToken = App.Services.Authentication.register("Eve", "eve@example.com", "a third long phrase").try
      let ada : User = App.Services.Authentication.current(Just(adaToken)).try
      let bob : User = App.Services.Authentication.current(Just(bobToken)).try
      let eve : User = App.Services.Authentication.current(Just(eveToken)).try
      Assert.equal(ada.shown, "Ada")
      Assert.truthy(App.Services.Authentication.signIn("ada@example.com", "correct horse battery").ok?)

      # Somebody in no organization is asked to make one; nothing else shows.
      let lonely = App.Live.Chat.markup(statuses, ada, Tab {})
      Assert.truthy(lonely.contains?("You are not in an organization yet"))
      Assert.falsy(lonely.contains?("class=\"sidebar\""))
      let (unnamed, _) = stepped(statuses, ada, Tab {}, [("event", "charter"), ("name", "!")])
      Assert.truthy(!unnamed.dialogProblem.empty?)
      let (reserved, _) = stepped(statuses, ada, Tab {}, [("event", "charter"), ("name", "Sign In")])
      Assert.truthy(reserved.dialogProblem.contains?("cannot be used"))
      let (inAcme, acmeMade) = stepped(statuses, ada, Tab {}, [("event", "charter"), ("name", "Acme Corp")])
      Assert.truthy(acmeMade)
      Assert.truthy(!inAcme.organization.empty?)
      let (again, _) = stepped(statuses, bob, Tab {}, [("event", "charter"), ("name", "acme corp")])
      Assert.truthy(again.dialogProblem.contains?("already"))

      # People are added by the email they registered with.
      Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("You are not in an organization yet"))
      let (unknown, _) = stepped(statuses, ada, Tab {}, [("event", "enlist"), ("email", "nobody@example.com")])
      Assert.truthy(unknown.dialogProblem.contains?("Nobody has registered"))
      let (added, bobAdded) = stepped(statuses, ada, Tab {}, [("event", "enlist"), ("email", "Bob@Example.com")])
      Assert.truthy(bobAdded)
      Assert.truthy(added.notice.contains?("Bob is now in Acme Corp"))
      stepped(statuses, bob, Tab {}, [("event", "enlist"), ("email", "eve@example.com")])
      let (twice, _) = stepped(statuses, ada, Tab {}, [("event", "enlist"), ("email", "eve@example.com")])
      Assert.truthy(twice.dialogProblem.contains?("already in"))

      # Mallory is registered, in an organization of her own, and not in Acme.
      let malToken = App.Services.Authentication.register("Mallory", "mal@example.com", "a fourth long phrase").try
      let mal : User = App.Services.Authentication.current(Just(malToken)).try
      let (inOther, _) = stepped(statuses, mal, Tab {}, [("event", "charter"), ("name", "Other")])

      # Everyone starts in their organization's #general.
      let first = App.Live.Chat.markup(statuses, ada, Tab {})
      Assert.truthy(first.contains?("# general"))
      Assert.truthy(first.contains?("Company-wide announcements"))
      Assert.truthy(first.contains?("Bob"))

      # A message, with an emoji, seen by somebody else.
      let (afterSend, sendChanged) = stepped(statuses, ada, Tab {}, [("event", "send"), ("body", "hello <b>world</b> :wave:")])
      Assert.truthy(sendChanged)
      let bobSees = App.Live.Chat.markup(statuses, bob, Tab {})
      Assert.truthy(bobSees.contains?("hello &lt;b&gt;world&lt;/b&gt; 👋"))
      Assert.truthy(bobSees.contains?("<strong>Ada</strong>"))
      let (_, emptyChanged) = stepped(statuses, ada, Tab {}, [("event", "send"), ("body", "   ")])
      Assert.falsy(emptyChanged)

      # Consecutive messages of one person are one block: the name is there once.
      stepped(statuses, ada, Tab {}, [("event", "send"), ("body", "and one more thing")])
      let block = App.Live.Chat.markup(statuses, bob, Tab {})
      Assert.equal(block.split("<strong>Ada</strong>").count, 2)
      Assert.truthy(block.contains?("class=\"message continued\""))
      stepped(statuses, bob, Tab {}, [("event", "send"), ("body", "bob cuts in")])
      stepped(statuses, ada, Tab {}, [("event", "send"), ("body", "ada again")])
      Assert.equal(App.Live.Chat.markup(statuses, eve, Tab {}).split("<strong>Ada</strong>").count, 3)

      # Typing is shown to the others there, not to the one typing, and is
      # over once the message is sent. A bot can say what it is doing instead.
      let (_, typingHeard) = stepped(statuses, ada, Tab {}, [("event", "typing")])
      Assert.truthy(typingHeard)
      Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("<strong>Ada</strong> is typing…"))
      Assert.falsy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("is typing…"))
      stepped(statuses, ada, Tab {}, [("event", "send"), ("body", "typed and sent")])
      Assert.falsy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("is typing…"))
      Assert.truthy(App.Live.Chat.noting(statuses, eve, Tab {}, "Deploying <now>", 30000))
      Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("<strong>Eve</strong> Deploying &lt;now&gt;…"))
      App.Live.Chat.noting(statuses, eve, Tab {}, "", 0)
      Assert.falsy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("Deploying"))
      # A note that has lapsed is not shown.
      statuses.noted("general", "nobody", "old news", 1)
      Assert.equal(Metro.Live.Presence.standing(statuses, "general", 2), [])

      # Being here: somebody with a tab open is shown as online, until the
      # last of their tabs closes.
      Assert.falsy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("entry online\" data-event=\"direct\""))
      App.Live.Chat.arriving(statuses, ada, "one")
      App.Live.Chat.arriving(statuses, ada, "two")
      Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("entry online\" data-event=\"direct\" data-user=\"${ada.id}\""))
      App.Live.Chat.leaving(statuses, ada, "one")
      Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("entry online\" data-event=\"direct\" data-user=\"${ada.id}\""))
      App.Live.Chat.leaving(statuses, ada, "two")
      Assert.falsy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("entry online\" data-event=\"direct\" data-user=\"${ada.id}\""))

      # A status: an emoji Slick offers and a few words, beside the name.
      let (_, statusSet) = stepped(statuses, ada, Tab {}, [("event", "status-set"), ("emoji", "🌴"), ("text", "On vacation <till Monday>")])
      Assert.truthy(statusSet)
      let withStatus = App.Live.Chat.markup(statuses, bob, Tab {})
      Assert.truthy(withStatus.contains?("<span class=\"emblem\" title=\"On vacation &lt;till Monday&gt;\">🌴</span>"))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("<p class=\"menu-status\">🌴 On vacation &lt;till Monday&gt;</p>"))
      let (badStatus, badSet) = stepped(statuses, ada, Tab {}, [("event", "status-set"), ("emoji", "<img>"), ("text", "x")])
      Assert.falsy(badSet)
      Assert.truthy(!badStatus.dialogProblem.empty?)
      stepped(statuses, ada, Tab {}, [("event", "status-clear")])
      Assert.falsy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("🌴"))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("<p class=\"menu-status\">No status set</p>"))

      # A channel: created, refused when malformed or taken, visible to all.
      let (refused, _) = stepped(statuses, ada, Tab {}, [("event", "create"), ("title", "Bad Name!")])
      Assert.equal(refused.dialog, "channel")
      Assert.truthy(!refused.dialogProblem.empty?)
      let (asking, _) = stepped(statuses, ada, Tab {}, [("event", "found")])
      Assert.truthy(App.Live.Chat.markup(statuses, ada, asking).contains?("aria-label=\"Create a channel\""))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, refused).contains?("role=\"alert\""))
      let (inRandom, created) = stepped(statuses, ada, Tab {}, [("event", "create"), ("title", "random")])
      Assert.truthy(created)
      Assert.truthy(inRandom.conversation != "general")
      let (taken, _) = stepped(statuses, bob, Tab {}, [("event", "create"), ("title", "random")])
      Assert.truthy(taken.dialogProblem.contains?("already"))
      Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("# random"))

      # A form in a message is answered by using it. The answer is kept with
      # the message and shown under its form: it is not a message, and
      # typing what an answer says is not an answer.
      stepped(statuses, bob, inRandom, [("event", "send"), ("body", "[?] Lunch: pizza | soup")])
      let asking = App.Live.Chat.markup(statuses, ada, inRandom)
      Assert.truthy(asking.contains?("data-label=\"Lunch\" data-value=\"soup\""))
      let lunchId = asking.split("data-form=\"0\" data-label=\"Lunch\"").first.or("").split("data-message=\"").last.or("").split("\"").first.or("")
      let lunch = [("event", "answer"), ("message", lunchId), ("form", "0"), ("label", "Lunch")]
      let (afterAnswer, answerGiven) = stepped(statuses, ada, inRandom, lunch + [("value", "soup")])
      Assert.truthy(answerGiven)
      Assert.equal(afterAnswer.conversation, inRandom.conversation)
      let answered = App.Live.Chat.markup(statuses, bob, inRandom)
      Assert.truthy(answered.contains?("<li class=\"response\"><strong>Ada</strong> <span>soup</span></li>"))
      Assert.falsy(answered.contains?("<p>Lunch: soup</p>"))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, inRandom).contains?("<li class=\"response mine\"><strong>Ada</strong> <span>soup</span></li>"))
      # Answering again replaces the answer; she has one.
      stepped(statuses, ada, inRandom, lunch + [("value", "pizza")])
      let changed = App.Live.Chat.markup(statuses, bob, inRandom)
      Assert.truthy(changed.contains?("<strong>Ada</strong> <span>pizza</span>") && !changed.contains?("<span>soup</span>"))
      let (_, wrongAnswer) = stepped(statuses, ada, inRandom, lunch + [("value", "cake")])
      Assert.falsy(wrongAnswer)
      # Not from another conversation, where the message is not.
      let (_, answeredElsewhere) = stepped(statuses, ada, Tab {}, lunch + [("value", "soup")])
      Assert.falsy(answeredElsewhere)
      # Saying it is only saying it.
      stepped(statuses, eve, inRandom, [("event", "send"), ("body", "Lunch: soup")])
      Assert.falsy(App.Live.Chat.markup(statuses, bob, inRandom).contains?("<strong>Eve</strong> <span>soup</span>"))

      # A topic, on a channel.
      let (_, topicChanged) = stepped(statuses, bob, inRandom, [("event", "topic"), ("topic", "Anything goes :tada:")])
      Assert.truthy(topicChanged)
      Assert.truthy(App.Live.Chat.markup(statuses, ada, inRandom).contains?("Anything goes 🎉"))

      # A private chat between Ada and Bob: the same one from either side.
      let (adaPrivate, _) = stepped(statuses, ada, Tab {}, [("event", "direct"), ("user", bob.id)])
      let (bobPrivate, _) = stepped(statuses, bob, Tab {}, [("event", "direct"), ("user", ada.id)])
      Assert.equal(adaPrivate.conversation, bobPrivate.conversation)
      Assert.truthy(adaPrivate.conversation != "general")
      stepped(statuses, ada, adaPrivate, [("event", "send"), ("body", "between us")])
      Assert.truthy(App.Live.Chat.markup(statuses, bob, bobPrivate).contains?("between us"))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, adaPrivate).contains?("only the two of you"))

      # Eve cannot read it, open it, write into it or change it, id in hand.
      let eveTries = Tab { conversation: adaPrivate.conversation }
      Assert.falsy(App.Live.Chat.markup(statuses, eve, eveTries).contains?("between us"))
      let (eveOpened, _) = stepped(statuses, eve, Tab {}, [("event", "open"), ("id", adaPrivate.conversation)])
      Assert.equal(eveOpened.conversation, "")
      let (_, eveSent) = stepped(statuses, eve, eveTries, [("event", "send"), ("body", "let me in")])
      Assert.falsy(eveSent)
      Assert.falsy(App.Live.Chat.markup(statuses, ada, adaPrivate).contains?("let me in"))
      let (_, eveTopic) = stepped(statuses, eve, eveTries, [("event", "topic"), ("topic", "mine now")])
      Assert.falsy(eveTopic)
      Assert.equal(App.Live.Chat.visible(eve, eveTries), None)

      # A private chat has no topic to set, even for its own people.
      let (_, privateTopic) = stepped(statuses, ada, adaPrivate, [("event", "topic"), ("topic", "x")])
      Assert.falsy(privateTopic)

      # Reactions: on, counted, off again; not from outside the conversation.
      let general = App.Live.Chat.markup(statuses, bob, Tab {})
      let messageId = general.split("id=\"message-").drop(1).first.or("").split("\"").first.or("")
      Assert.truthy(!messageId.empty?)
      let (_, reacted) = stepped(statuses, bob, Tab {}, [("event", "react"), ("message", messageId), ("emoji", "🎉")])
      Assert.truthy(reacted)
      stepped(statuses, ada, Tab {}, [("event", "react"), ("message", messageId), ("emoji", "🎉")])
      Assert.truthy(App.Live.Chat.markup(statuses, eve, Tab {}).contains?("🎉 <span>2</span>"))
      stepped(statuses, bob, Tab {}, [("event", "react"), ("message", messageId), ("emoji", "🎉")])
      Assert.truthy(App.Live.Chat.markup(statuses, eve, Tab {}).contains?("🎉 <span>1</span>"))
      let (_, wrongEmoji) = stepped(statuses, bob, Tab {}, [("event", "react"), ("message", messageId), ("emoji", "<script>")])
      Assert.falsy(wrongEmoji)
      let (_, wrongPlace) = stepped(statuses, bob, inRandom, [("event", "react"), ("message", messageId), ("emoji", "🎉")])
      Assert.falsy(wrongPlace)

      # Threads: replies stay out of the conversation, which counts them.
      let (bobThread, _) = stepped(statuses, bob, Tab {}, [("event", "thread"), ("message", messageId)])
      Assert.equal(bobThread.thread, messageId)
      Assert.truthy(App.Live.Chat.markup(statuses, bob, bobThread).contains?("No replies yet"))
      let (_, replySent) = stepped(statuses, bob, bobThread, [("event", "reply"), ("body", "a reply in the thread")])
      Assert.truthy(replySent)
      stepped(statuses, ada, bobThread, [("event", "reply"), ("body", "and another")])
      let outside = App.Live.Chat.markup(statuses, eve, Tab {})
      Assert.falsy(outside.contains?("a reply in the thread"))
      Assert.truthy(outside.contains?("2 replies"))
      let inside = App.Live.Chat.markup(statuses, eve, bobThread)
      Assert.truthy(inside.contains?("a reply in the thread"))
      Assert.truthy(inside.contains?("and another"))
      Assert.truthy(inside.contains?("id=\"thread-${messageId}\""))
      Assert.truthy(inside.contains?("data-live-path=\"/acmecorp/channels/general?thread=${messageId}\""))
      # A reply with no thread open goes nowhere; a thread from another
      # conversation does not open here.
      let (_, stray) = stepped(statuses, bob, Tab {}, [("event", "reply"), ("body", "lost")])
      Assert.falsy(stray)
      let (elsewhere, _) = stepped(statuses, bob, inRandom, [("event", "thread"), ("message", messageId)])
      Assert.equal(elsewhere.thread, "")
      # Sending in the conversation leaves the thread open beside it.
      let (stillOpen, _) = stepped(statuses, bob, bobThread, [("event", "send"), ("body", "back in the channel")])
      Assert.equal(stillOpen.thread, messageId)

      # Addresses: an organization, then a channel by name, a private chat by
      # person, a thread.
      Assert.equal(App.Live.Chat.arrived(eve, "/acmecorp/channels/random").conversation, inRandom.conversation)
      Assert.equal(App.Live.Chat.arrived(eve, "/acmecorp/channels/general?thread=${messageId}").thread, messageId)
      Assert.equal(App.Live.Chat.arrived(ada, "/acmecorp/dm/${bob.id}").conversation, adaPrivate.conversation)
      Assert.equal(App.Live.Chat.arrived(eve, "/acmecorp/channels/nowhere").conversation, "")
      Assert.equal(App.Live.Chat.arrived(eve, "/acmecorp/dm/nobody").conversation, "")
      Assert.equal(App.Live.Chat.arrived(eve, "/nowhere/channels/general").organization, "")
      Assert.truthy(App.Live.Chat.markup(statuses, ada, adaPrivate).contains?("data-live-path=\"/acmecorp/dm/${bob.id}\""))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, inRandom).contains?("# random · Acme Corp\">"))
      # Eve going to her own chat with Bob gets hers, not Ada's.
      Assert.truthy(App.Live.Chat.arrived(eve, "/acmecorp/dm/${bob.id}").conversation != adaPrivate.conversation)

      # Organizations are apart. Mallory, not in Acme, gets none of it: not by
      # address, not by naming the organization or a channel's id, not by
      # writing to somebody in it.
      let malSees = App.Live.Chat.markup(statuses, mal, Tab {})
      Assert.truthy(malSees.contains?("<strong>Other</strong>"))
      Assert.falsy(malSees.contains?("Acme"))
      Assert.falsy(malSees.contains?("# random"))
      Assert.falsy(malSees.contains?("Ada"))
      Assert.falsy(malSees.contains?("hello"))
      Assert.equal(App.Live.Chat.arrived(mal, "/acmecorp/channels/random"), Tab {})
      let (malSwitched, _) = stepped(statuses, mal, Tab {}, [("event", "organization"), ("id", inAcme.organization)])
      Assert.equal(malSwitched.organization, "")
      let malForged = Tab { organization: inAcme.organization, conversation: inRandom.conversation }
      Assert.equal(App.Live.Chat.visible(mal, malForged), None)
      Assert.falsy(App.Live.Chat.markup(statuses, mal, malForged).contains?("Anything goes"))
      let (_, malSent) = stepped(statuses, mal, malForged, [("event", "send"), ("body", "mallory was here")])
      Assert.falsy(malSent)
      let (malOpened, _) = stepped(statuses, mal, Tab {}, [("event", "open"), ("id", inRandom.conversation)])
      Assert.equal(malOpened.conversation, "")
      let (malDirect, _) = stepped(statuses, mal, Tab {}, [("event", "direct"), ("user", ada.id)])
      Assert.equal(malDirect.conversation, "")
      let (_, malReacted) = stepped(statuses, mal, malForged, [("event", "react"), ("message", messageId), ("emoji", "🎉")])
      Assert.falsy(malReacted)
      Assert.falsy(App.Live.Chat.markup(statuses, ada, inRandom).contains?("mallory was here"))

      # Somebody in two organizations switches between them; the same channel
      # name is a different channel in each.
      stepped(statuses, mal, Tab {}, [("event", "enlist"), ("email", "ada@example.com")])
      let adaBoth = App.Live.Chat.markup(statuses, ada, Tab {})
      Assert.truthy(adaBoth.contains?("title=\"Acme Corp\""))
      Assert.truthy(adaBoth.contains?("title=\"Other\""))
      let (adaInOther, _) = stepped(statuses, ada, Tab {}, [("event", "organization"), ("id", inOther.organization)])
      Assert.equal(adaInOther.organization, inOther.organization)
      let otherSide = App.Live.Chat.markup(statuses, ada, adaInOther)
      Assert.truthy(otherSide.contains?("data-live-path=\"/other/channels/general\""))
      Assert.truthy(otherSide.contains?("Mallory"))
      Assert.falsy(otherSide.contains?("hello"))
      Assert.falsy(otherSide.contains?("Bob"))
      let (otherRandom, otherMade) = stepped(statuses, ada, adaInOther, [("event", "create"), ("title", "random")])
      Assert.truthy(otherMade)
      Assert.truthy(otherRandom.conversation != inRandom.conversation)

      # Bots: a person's own, members like anyone, known by a token that is
      # stored only as a digest.
      let (botTab, botMade) = stepped(statuses, bob, Tab {}, [("event", "bot-create"), ("name", "deploy-bot"), ("owner", "me")])
      Assert.truthy(botMade)
      Assert.truthy(botTab.secret.contains?("slick_bot_"))
      let botsDialog = App.Live.Chat.markup(statuses, bob, botTab)
      Assert.truthy(botsDialog.contains?(botTab.secret))
      Assert.truthy(botsDialog.contains?("deploy-bot"))
      Assert.falsy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?(botTab.secret))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("class=\"flag\">BOT"))
      let deployBot : User = App.Services.Bots.bearer(Just("Bearer ${botTab.secret}")).try
      # A person's own bots are listed under Bots, for them; for everyone else
      # the bot is among the people.
      let bobsSidebar = App.Live.Chat.markup(statuses, bob, Tab {}).split("<h2>Bots</h2>")
      Assert.falsy(bobsSidebar.first.or("").contains?(">deploy-bot"))
      Assert.truthy(bobsSidebar.drop(1).first.or("").contains?(">deploy-bot"))
      let adasSidebar = App.Live.Chat.markup(statuses, ada, Tab {}).split("<h2>Bots</h2>")
      Assert.truthy(adasSidebar.first.or("").contains?(">deploy-bot"))
      Assert.falsy(adasSidebar.drop(1).first.or("").contains?(">deploy-bot"))
      Assert.truthy(deployBot.bot?)
      Assert.equal(deployBot.ownerId, bob.id)
      Assert.equal(App.Services.Bots.bearer(Just("Bearer slick_bot_wrong")), None)
      Assert.equal(App.Services.Bots.bearer(None), None)
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ")), None)
      # It cannot sign in the way a person does.
      Assert.truthy(App.Services.Authentication.signIn(deployBot.email, "").error?)
      Assert.truthy(App.Services.Authentication.signIn(deployBot.email, botTab.secret).error?)
      # It writes where its organization lets a member write, and nowhere else.
      let (_, botSent) = stepped(statuses, deployBot, Tab {}, [("event", "send"), ("body", "deployed :rocket:")])
      Assert.truthy(botSent)
      Assert.truthy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("deployed 🚀"))
      Assert.equal(App.Live.Chat.arrived(deployBot, "/other/channels/general"), Tab {})
      Assert.equal(App.Live.Chat.visible(deployBot, adaPrivate), None)

      # Somebody can write to themselves, to try things out; nobody else
      # can read it, and it is explained to them.
      let (adaAlone, _) = stepped(statuses, ada, Tab {}, [("event", "direct"), ("user", ada.id)])
      Assert.truthy(!adaAlone.conversation.empty?)
      let (_, aloneSent) = stepped(statuses, ada, adaAlone, [("event", "send"), ("body", "a note to self")])
      Assert.truthy(aloneSent)
      let ownSpace = App.Live.Chat.markup(statuses, ada, adaAlone)
      Assert.truthy(ownSpace.contains?("This is your space"))
      Assert.truthy(ownSpace.contains?("a note to self"))
      Assert.truthy(ownSpace.contains?("Ada (you)"))
      Assert.truthy(ownSpace.contains?("data-live-path=\"/acmecorp/dm/${ada.id}\""))
      Assert.equal(App.Live.Chat.arrived(ada, "/acmecorp/dm/${ada.id}").conversation, adaAlone.conversation)
      Assert.equal(App.Live.Chat.visible(bob, adaAlone), None)
      Assert.falsy(App.Live.Chat.markup(statuses, bob, adaAlone).contains?("a note to self"))
      Assert.falsy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("This is your space"))

      # Unread: what came since somebody last looked is counted beside the
      # place, in the title, and in the rail for another organization; looking
      # reads it.
      App.Live.Chat.markup(statuses, eve, Tab {})
      Assert.falsy(App.Live.Chat.markup(statuses, eve, inRandom).contains?("# general\n      <span class=\"count\""))
      stepped(statuses, bob, Tab {}, [("event", "send"), ("body", "one for later")])
      stepped(statuses, bob, Tab {}, [("event", "send"), ("body", "and another")])
      let eveAway = App.Live.Chat.markup(statuses, eve, inRandom)
      Assert.truthy(eveAway.contains?("# general\n      <span class=\"count\" aria-label=\"2 unread\">2</span>"))
      Assert.truthy(eveAway.contains?("data-live-title=\"(2) # random"))
      Assert.truthy(eveAway.contains?("class=\"entry unread\""))
      App.Live.Chat.markup(statuses, eve, Tab {})
      Assert.falsy(App.Live.Chat.markup(statuses, eve, inRandom).contains?("# general\n      <span class=\"count\""))
      # Replies are read in their thread, and do not count.
      stepped(statuses, bob, bobThread, [("event", "reply"), ("body", "a quiet reply")])
      Assert.falsy(App.Live.Chat.markup(statuses, eve, inRandom).contains?("# general\n      <span class=\"count\""))
      # A conversation open in a tab nobody is looking at is not read: what
      # arrives counts, in the title, until they look again.
      let eveAway = Tab { attentive?: false }
      let (eveBack, _) = stepped(statuses, eve, eveAway, [("event", "attention"), ("on", "true")])
      Assert.truthy(eveBack.attentive?)
      stepped(statuses, bob, Tab {}, [("event", "send"), ("body", "while eve is away")])
      Assert.truthy(App.Live.Chat.markup(statuses, eve, eveAway).contains?("data-live-title=\"(1) # general"))
      Assert.truthy(App.Live.Chat.markup(statuses, eve, eveAway).contains?("data-live-title=\"(1) # general"))
      App.Live.Chat.markup(statuses, eve, eveBack)
      Assert.falsy(App.Live.Chat.markup(statuses, eve, eveAway).contains?("data-live-title=\"(1)"))
      # Replying in a thread follows it: other people's replies there count
      # on its channel until the thread is read.
      stepped(statuses, eve, bobThread, [("event", "reply"), ("body", "count me in")])
      stepped(statuses, bob, bobThread, [("event", "reply"), ("body", "eve, look")])
      Assert.truthy(App.Live.Chat.markup(statuses, eve, inRandom).contains?("# general\n      <span class=\"count\" aria-label=\"1 unread\">1</span>"))
      # Reading the channel is not reading the thread.
      Assert.truthy(App.Live.Chat.markup(statuses, eve, Tab {}).contains?("data-live-title=\"(1) # general"))
      App.Live.Chat.markup(statuses, eve, bobThread)
      Assert.falsy(App.Live.Chat.markup(statuses, eve, inRandom).contains?("# general\n      <span class=\"count\""))
      # A private chat is counted by the person it is with.
      let (bobToEve, _) = stepped(statuses, bob, Tab {}, [("event", "direct"), ("user", eve.id)])
      stepped(statuses, bob, bobToEve, [("event", "send"), ("body", "psst, eve")])
      Assert.truthy(App.Live.Chat.markup(statuses, eve, inRandom).contains?("data-user=\"${bob.id}\">Bob\n      <span class=\"count\""))

      # Drafts: what is written and not sent is kept, for its writer alone,
      # until it is sent; a conversation with one is marked in the sidebar.
      stepped(statuses, ada, Tab {}, [("event", "draft"), ("place", "send"), ("body", "half a <tho")])
      Assert.truthy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("autofocus>half a &lt;tho</textarea>"))
      Assert.falsy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("half a"))
      Assert.truthy(App.Live.Chat.markup(statuses, ada, inRandom).contains?("# general\n      <span class=\"drafted\""))
      Assert.falsy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("class=\"drafted\""))
      stepped(statuses, ada, Tab {}, [("event", "draft"), ("place", "send"), ("body", "half a thought")])
      Assert.equal(DB.Repositories.Drafts.pending(ada.id).or([]).count, 1)
      # A thread's box keeps its own.
      let adaThread = Tab { ...bobThread }
      stepped(statuses, ada, adaThread, [("event", "draft"), ("place", "reply"), ("body", "a reply, later")])
      let bothBoxes = App.Live.Chat.markup(statuses, ada, adaThread)
      Assert.truthy(bothBoxes.contains?(">a reply, later</textarea>"))
      Assert.truthy(bothBoxes.contains?(">half a thought</textarea>"))
      stepped(statuses, ada, adaThread, [("event", "reply"), ("body", "a reply, now")])
      Assert.falsy(App.Live.Chat.markup(statuses, ada, adaThread).contains?("a reply, later"))
      # A private chat is marked by the person it is with.
      stepped(statuses, ada, adaPrivate, [("event", "draft"), ("place", "send"), ("body", "psst")])
      Assert.truthy(App.Live.Chat.markup(statuses, ada, Tab {}).contains?("data-user=\"${bob.id}\">Bob\n      <span class=\"drafted\""))
      stepped(statuses, ada, adaPrivate, [("event", "draft"), ("place", "send"), ("body", "  ")])
      # Sending takes it away; nobody keeps a draft where they cannot write.
      stepped(statuses, ada, Tab {}, [("event", "send"), ("body", "half a thought, finished")])
      Assert.equal(DB.Repositories.Drafts.pending(ada.id).or([]), [])
      stepped(statuses, mal, malForged, [("event", "draft"), ("place", "send"), ("body", "sneaky")])
      Assert.equal(DB.Repositories.Drafts.pending(mal.id).or([]), [])

      # Files: uploaded, waiting in the message box, sent with a message,
      # then listed in the files view and served only to who may read them.
      let files = "storage_spec_${Metro.Clock.milliseconds()}"
      with Metro.Storage.Service = Metro.Storage.Disk { root: files } do
        let upload = Metro.Wire.made("POST", "/uploads", [("Content-Type", "text/plain"), ("X-Filename", "notes.txt")], "first line\nsecond <line>")
        let uploaded = App.Controllers.Files.uploaded(Metro.WebRequest.WebRequest { incoming: upload, assigns: {user: ada} })
        Assert.equal(uploaded.code, 200)
        let fileId = uploaded.payload.to(String).or("").split("\"file\":\"").second.or("").split("\"").first.or("")
        Assert.truthy(fileId.startsWith?("f"))
        # Nobody shares a file that is not theirs.
        let (bobTakes, _) = stepped(statuses, bob, Tab {}, [("event", "share"), ("file", fileId)])
        Assert.equal(bobTakes.pending, [])
        let (adaShares, _) = stepped(statuses, ada, Tab {}, [("event", "share"), ("file", fileId)])
        Assert.equal(adaShares.pending, [fileId])
        Assert.truthy(App.Live.Chat.markup(statuses, ada, adaShares).contains?("<strong>notes.txt</strong>"))
        # Before it is sent, only its uploader can fetch it.
        let asking = { |who| App.Controllers.Files.fetched(Metro.WebRequest.WebRequest { incoming: Metro.Wire.made("GET", "/files/${fileId}", [], ""), captures: {"id": fileId}, assigns: {user: who} }) }
        Assert.equal(asking(bob).code, 404)
        Assert.equal(asking(ada).code, 200)
        # A file goes without words.
        let (afterFile, fileSent) = stepped(statuses, ada, adaShares, [("event", "send"), ("body", "")])
        Assert.truthy(fileSent)
        Assert.equal(afterFile.pending, [])
        Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab {}).contains?("href=\"/files/${fileId}\""))
        Assert.equal(asking(bob).code, 200)
        Assert.equal(asking(mal).code, 404)
        Assert.equal(asking(bob).outgoing.get("X-Content-Type-Options"), Just("nosniff"))
        # The files view lists it, with the start of what it says.
        let filesView = App.Live.Chat.markup(statuses, bob, Tab { view: "files" })
        Assert.truthy(filesView.contains?("<pre>first line\nsecond &lt;line&gt;</pre>"))
        Assert.truthy(filesView.contains?("Files <span class=\"tally\">1</span>"))
        # A file once sent cannot be sent again.
        let (again, _) = stepped(statuses, ada, Tab {}, [("event", "share"), ("file", fileId)])
        Assert.equal(again.pending, [])
      end
      FS.Directory.deleteAll(files)

      # Profiles: a name or a picture on a message opens its author's beside
      # the conversation; a bot's says whose it is.
      let (bobProfile, _) = stepped(statuses, ada, Tab {}, [("event", "profile"), ("user", bob.id)])
      Assert.equal(bobProfile.profile, bob.id)
      let bobCard = App.Live.Chat.markup(statuses, ada, bobProfile)
      Assert.truthy(bobCard.contains?("aria-label=\"Profile of Bob\""))
      Assert.truthy(bobCard.contains?("mailto:bob@example.com"))
      Assert.truthy(bobCard.contains?("data-event=\"direct\" data-user=\"${bob.id}\""))
      Assert.truthy(bobCard.contains?("data-event=\"profile\" data-user=\"${deployBot.id}\""))
      let (botProfile, _) = stepped(statuses, ada, Tab {}, [("event", "profile"), ("user", deployBot.id)])
      let botCard = App.Live.Chat.markup(statuses, ada, botProfile)
      Assert.truthy(botCard.contains?("Belongs to"))
      Assert.truthy(botCard.contains?("data-event=\"profile\" data-user=\"${bob.id}\">Bob</button>"))
      Assert.falsy(botCard.contains?("mailto:"))
      # It stays open over other events, and a thread takes its place.
      let (stillProfiled, _) = stepped(statuses, ada, bobProfile, [("event", "cancel")])
      Assert.equal(stillProfiled.profile, bob.id)
      let (threadInstead, _) = stepped(statuses, ada, bobProfile, [("event", "thread"), ("message", messageId)])
      Assert.equal(threadInstead.profile, "")
      Assert.equal(threadInstead.thread, messageId)
      let (closed, _) = stepped(statuses, ada, bobProfile, [("event", "unprofile")])
      Assert.equal(closed.profile, "")
      # Somebody fills in their own profile; a name cannot be emptied.
      let profileForm = [("event", "profile-set"), ("name", "Bob"), ("title", "Engineer"), ("department", "Platform"), ("phone", "+36 1 234"), ("time_zone", "Europe/Budapest"), ("bio", "Builds <things>"), ("nickname", "Bobby")]
      let (_, bobDescribed) = stepped(statuses, bob, Tab {}, profileForm)
      Assert.truthy(bobDescribed)
      let bobFilled = App.Live.Chat.markup(statuses, ada, bobProfile)
      Assert.truthy(bobFilled.contains?("Engineer"))
      Assert.truthy(bobFilled.contains?("Europe/Budapest"))
      Assert.truthy(bobFilled.contains?("Builds &lt;things&gt;"))
      Assert.falsy(bobFilled.contains?("Bobby"))
      let (unnamedBob, _) = stepped(statuses, bob, Tab {}, [("event", "profile-set"), ("name", "  ")])
      Assert.truthy(unnamedBob.dialogProblem.contains?("Name cannot be empty"))
      # Going by a nickname shows it everywhere, with the name on the profile.
      let (_, nicknamed) = stepped(statuses, bob, Tab {}, profileForm + [("show_nickname", "yes")])
      Assert.truthy(nicknamed)
      let byNickname = App.Live.Chat.markup(statuses, ada, bobProfile)
      Assert.truthy(byNickname.contains?("aria-label=\"Profile of Bobby\""))
      Assert.truthy(byNickname.contains?("<p class=\"formal\">Bob</p>"))
      # What a sync has taken over stays as it is, and the form shows it locked.
      DB.Repositories.Users.managing(bob.id, ["name", "title"])
      stepped(statuses, bob, Tab {}, [("event", "profile-set"), ("name", "Hacked"), ("title", "CEO"), ("department", "Sales")])
      let synced = App.Live.Chat.markup(statuses, ada, bobProfile)
      Assert.truthy(synced.contains?("Engineer"))
      Assert.truthy(synced.contains?("Sales"))
      Assert.falsy(synced.contains?("Hacked"))
      Assert.falsy(synced.contains?("CEO"))
      let lockedForm = App.Live.Chat.markup(statuses, bob, Tab { dialog: "profile" })
      Assert.truthy(lockedForm.contains?("name=\"title\" value=\"Engineer\" maxlength=\"80\" placeholder=\"\" autocomplete=\"off\" readonly"))
      Assert.falsy(lockedForm.contains?("name=\"department\" value=\"Sales\" maxlength=\"80\" placeholder=\"\" autocomplete=\"off\" readonly"))
      DB.Repositories.Users.managing(bob.id, [])
      stepped(statuses, bob, Tab {}, [("event", "profile-set"), ("name", "Bob")])
      # Nobody outside the organization is shown, whatever the tab names.
      let (malProfile, _) = stepped(statuses, mal, Tab {}, [("event", "profile"), ("user", eve.id)])
      Assert.equal(malProfile.profile, "")
      Assert.falsy(App.Live.Chat.markup(statuses, mal, Tab { profile: eve.id }).contains?("Profile of Eve"))
      # Only its owner gives it a new token, and the old one stops working.
      let (adaTries, _) = stepped(statuses, ada, Tab {}, [("event", "bot-rekey"), ("id", deployBot.id)])
      Assert.equal(adaTries.secret, "")
      Assert.truthy(App.Services.Bots.bearer(Just("Bearer ${botTab.secret}")).set?)
      let (renewed, _) = stepped(statuses, bob, Tab {}, [("event", "bot-rekey"), ("id", deployBot.id)])
      Assert.truthy(renewed.secret != botTab.secret)
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ${botTab.secret}")), None)
      Assert.truthy(App.Services.Bots.bearer(Just("Bearer ${renewed.secret}")).set?)
      # Nor can somebody else bring it into their organization.
      let (malBrings, malBrought) = stepped(statuses, mal, Tab {}, [("event", "bot-enlist"), ("id", deployBot.id)])
      Assert.falsy(malBrought)

      # A bot belongs to a person or to an organization. An organization's is
      # looked after by anyone in it — and by nobody outside it.
      let (sharedTab, _) = stepped(statuses, bob, Tab {}, [("event", "bot-create"), ("name", "acme-bot"), ("owner", "organization")])
      let acmeBot : User = App.Services.Bots.bearer(Just("Bearer ${sharedTab.secret}")).try
      Assert.equal(acmeBot.ownerId, "")
      Assert.equal(acmeBot.ownerOrganizationId, inAcme.organization)
      Assert.equal(deployBot.ownerOrganizationId, "")
      let evesDialog = App.Live.Chat.markup(statuses, eve, Tab { dialog: "bots" })
      Assert.truthy(evesDialog.contains?("acme-bot"))
      Assert.truthy(evesDialog.contains?("belongs to Acme Corp"))
      Assert.falsy(evesDialog.contains?("<span class=\"hint\">yours</span>"))
      Assert.truthy(App.Live.Chat.markup(statuses, bob, Tab { dialog: "bots" }).contains?("<span class=\"hint\">yours</span>"))
      let (eveRenews, _) = stepped(statuses, eve, Tab {}, [("event", "bot-rekey"), ("id", acmeBot.id)])
      Assert.truthy(eveRenews.secret.contains?("slick_bot_"))
      Assert.equal(App.Services.Bots.bearer(Just("Bearer ${sharedTab.secret}")), None)
      let (malRenews, _) = stepped(statuses, mal, Tab {}, [("event", "bot-rekey"), ("id", acmeBot.id)])
      Assert.equal(malRenews.secret, "")
      Assert.truthy(App.Services.Bots.bearer(Just("Bearer ${eveRenews.secret}")).set?)
      # Ada is in both organizations, but in Other she cannot touch Acme's bot
      # or bring it over.
      let (adaElsewhere, _) = stepped(statuses, ada, adaInOther, [("event", "bot-rekey"), ("id", acmeBot.id)])
      Assert.equal(adaElsewhere.secret, "")
      let (_, adaBrought) = stepped(statuses, ada, adaInOther, [("event", "bot-enlist"), ("id", acmeBot.id)])
      Assert.falsy(adaBrought)
      Assert.falsy(App.Live.Chat.markup(statuses, mal, Tab {}).contains?("acme-bot"))

      App.Services.Authentication.signOut(Just(adaToken))
      Assert.equal(App.Services.Authentication.current(Just(adaToken)), None)
    end
    FS.File.delete(file)
  end
end
