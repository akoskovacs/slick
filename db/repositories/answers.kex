# Answers to the forms in messages.
#
#   message.answer(organization.id, 1, user.id, "Deploy to: staging")
module DB.Repositories.Answers

using Harmat.Database, as: Database

# An answer, and not a response: a record called `Response` is taken for
# the HTTP library's own once the whole application is linked, and reading
# a field of one then fails.
using App.Models.Message, only: [MessageId]
using App.Models.Conversation, only: [ConversationId]
using App.Models.Organization, only: [OrganizationId]
using App.Models.Ids, only: [UserId]
using App.Models.Answer, only: [Answer]

# Every answer in a conversation.
foul inConversation(conversationId: ConversationId) -> [Answer] or! String do
  return Database.select().from(DB.Schema.Answers.definition)
    .where(DB.Schema.Answers.conversationId == conversationId)
    .orderBy([:answered_at, :id])
    .all(as: Answer)
end

# Every answer, in an organization, to the forms somebody asked — a bot
# reading what its own messages were answered with. Oldest first.
foul askedBy(organizationId: OrganizationId, askerId: UserId) -> [Answer] or! String do
  return Database.select().from(DB.Schema.Answers.definition)
    .where(DB.Schema.Answers.organizationId == organizationId)
    .where(DB.Schema.Answers.askerId == askerId)
    .orderBy([:answered_at, :id])
    .all(as: Answer)
end

# Records a person's answer to one form of a message. An earlier answer of
# theirs to that form is replaced: a person has one.
foul save(organizationId: OrganizationId, messageId: MessageId, conversationId: ConversationId, askerId: UserId, form: Integer, userId: UserId, answer: String) -> Integer or! String do
  let id = "${messageId}:${form}:${userId}"
  let answeredAt = Metro.Clock.milliseconds()
  let row = {
    id: id,
    message_id: messageId,
    conversation_id: conversationId,
    organization_id: organizationId,
    asker_id: askerId,
    user_id: userId,
    form: form,
    answer: answer,
    answered_at: answeredAt
  }
  # The earlier answer and this one are swapped in one transaction.
  let swapped : Integer or! String = Database.transaction do
    Database.delete(DB.Schema.Answers.definition)
      .where(DB.Schema.Answers.id == id)
      .run
      .try
    Database.insert(DB.Schema.Answers.definition)
      .values(row)
      .run
  end
  return swapped.map { |_| answeredAt }
end
