# The `invocations` table: slash commands somebody used. See
# db/migrate/N0019_create_invocations.kex.
module DB.Schema.Invocations

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :invocations, doc: "Slash commands somebody used, for the bot they were meant for" do |t|
  t.text(:id, primaryKey: true)
  t.belongsTo(:organization, :organizations)
  t.belongsTo(:conversation, :conversations)
  t.belongsTo(:thread, :messages, default: "", doc: "The message the thread it was used in starts with; empty for none")
  t.belongsTo(:bot, :users)
  t.belongsTo(:user, :users)
  t.text(:command)
  t.text(:arguments, default: "")
  t.bigint(:invoked_at)
  t.text(:invoked_on)
end

let table = DB.Schema.Invocations.definition.table

let id = DB.Schema.Invocations.definition.textColumn(:id)
let organizationId = DB.Schema.Invocations.definition.textColumn(:organization_id)
let conversationId = DB.Schema.Invocations.definition.textColumn(:conversation_id)
let botId = DB.Schema.Invocations.definition.textColumn(:bot_id)
let invokedAt = DB.Schema.Invocations.definition.wholeColumn(:invoked_at)
