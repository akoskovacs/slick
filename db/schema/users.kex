# The `users` table. `password_hash` is a `Metro.Auth.Password` line, never a
# password; `name` is what a person is called in a conversation.
module DB.Schema.Users

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :users do |t|
  [
    t.text(:id, primaryKey: true),
    t.text(:email),
    t.text(:password_hash),
    t.text(:created_at),
    t.text(:name, default: ""),
    t.text(:kind, default: "person", oneOf: ["person", "bot"]),
    t.text(:owner_id, default: ""),
    t.text(:api_token_digest, default: ""),
    t.text(:owner_organization_id, default: ""),
    t.text(:status_emoji, default: ""),
    t.text(:status_text, default: "")
  ]
end

let table = DB.Schema.Users.definition.table

let id = DB.Schema.Users.definition.textColumn(:id)
let email = DB.Schema.Users.definition.textColumn(:email)
let passwordHash = DB.Schema.Users.definition.textColumn(:password_hash)
let createdAt = DB.Schema.Users.definition.textColumn(:created_at)
let name = DB.Schema.Users.definition.textColumn(:name)
let kind = DB.Schema.Users.definition.textColumn(:kind)
let ownerId = DB.Schema.Users.definition.textColumn(:owner_id)
let apiTokenDigest = DB.Schema.Users.definition.textColumn(:api_token_digest)
let ownerOrganizationId = DB.Schema.Users.definition.textColumn(:owner_organization_id)
