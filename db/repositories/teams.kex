# Teams, and who is in them.
#
#   DB.Repositories.Teams.inOrganization(organization.id)
#
# A team a sync has (`managed?`) keeps its name and members as the sync
# says: the conditions here leave it alone, whoever asks. A team's members
# are the users holding a member grant over it (DB.Repositories.Grants).
module DB.Repositories.Teams

using Harmat.Database, as: Database
using App.Models.Team, only: [Team]
using App.Models.Grant, only: [Grant]
using DB.Repositories.Grants, as: Grants

# Creates a team, with its first members. Fails when the organization has a
# team of that handle: the unique index decides.
foul create(team: Team, by: String) -> Team or! String do
  let made = Team { ...team, id: Metro.Id.generate(prefix: "t") }
  let row = {
    id: made.id,
    organization_id: made.organizationId,
    handle: made.handle,
    name: made.name,
    description: made.description,
    created_by: by,
    created_at: Metro.Clock.milliseconds()
  }
  let stored : Team or! String = Database.transaction do
    Database.insert(DB.Schema.Teams)
      .values(row)
      .run
      .try
    addMembers(made.id, made.members).try
    Ok(made)
  end
  return stored
end

# Every team of an organization, by handle, each with its members.
foul inOrganization(organizationId: String) -> [Team] or! String do
  let rows = Database.select().from(DB.Schema.Teams)
    .where(DB.Schema.Teams.organizationId == organizationId)
    .orderBy([:handle])
    .all(as: Team)
    .try
  return membered(rows)
end

# One team, with its members, or `None`.
foul find(id: String) -> Team? or! String do
  let row = Database.select().from(DB.Schema.Teams)
    .where(DB.Schema.Teams.id == id)
    .first(as: Team)
    .try
  match row do
    None => return Ok(None)
    Just(found) => do
      let teams : [Team] = membered([found]).try
      return Ok(teams.first)
    end
  end
end

# Renames a team and says again what it is for; whether there was such a
# team that is not a sync's.
foul update(id: String, name: String, description: String) -> Bool or! String do
  return Database.update(DB.Schema.Teams)
    .set({name: name, description: description}, columns: [:name, :description])
    .where(DB.Schema.Teams.externalId == "")
    .where(DB.Schema.Teams.id == id)
    .run
    .map { |changed| changed > 0 }
end

# Puts people in a team, leaving out whoever is in it already: each is
# granted membership of the team.
foul addMembers(teamId: String, userIds: [String]) -> Integer or! String do
  let present : [String] = members(teamId).try
  let newcomers = userIds.uniq.reject { |userId| present.contains?(userId) }
  # A `.try` inside a block given to `map` would leave only that block:
  # what failed is collected instead.
  let failures = newcomers.flatMap do |userId|
    let stored = Grants.grant(Grant { subjectType: "user", subjectId: userId, resourceType: "team", resourceId: teamId, role: "member" })
    match stored do
      Ok(_) => []
      Error(reason) => [reason]
    end
  end
  return failures.empty? then Ok(newcomers.count) else Error(failures.first.or(""))
end

# Takes a person out of a team, and their grant with them.
foul removeMember(teamId: String, userId: String) -> Integer or! String do
  return Grants.revoke(Grants.key("user", userId, "team", teamId))
end

# Hands a team to a sync, as the group of this id — or, with "", takes it
# back: from then on it is changed here again.
foul markManaged(id: String, externalId: String) -> Integer or! String do
  return Database.update(DB.Schema.Teams)
    .set({external_id: externalId}, columns: [:external_id])
    .where(DB.Schema.Teams.id == id)
    .run
end

# The ids of the people in a team.
foul members(teamId: String) -> [String] or! String do
  return Grants.members("team", teamId)
end

# The ids of the people in any of some teams, by team.
foul rosters(teamIds: [String]) -> {String: [String]} or! String do
  return Grants.membersOf("team", teamIds)
end

private do
  # Teams with their members filled in, and whether a sync has each.
  foul membered(teams: [Team]) -> [Team] or! String do
    let byTeam : {String: [String]} = rosters(teams.map { |team| team.id }).try
    return Ok(teams.map do |team|
      Team {
        ...team,
        members: byTeam.get(team.id).or([]),
        managed?: !team.externalId.empty?
      }
    end)
  end
end
