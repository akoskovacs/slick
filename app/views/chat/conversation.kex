# The conversation a tab shows: its heading, its messages or files or
# settings, who is in the middle of something there, and the box to write
# in.
module App.Views.Chat.Conversation

using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Message, only: [Message]
using App.Models.Organization, only: [Organization]
using App.Models.Team, only: [Team]
using App.Models.User, only: [User]
using Metro.Live.Presence, only: [Note]
using App.Views.Chat.Page, only: [Cabinet]
using App.Views.Chat.Names, only: [shownAs, titled]
using App.Views.Chat.Files, only: [enclosed, filed, Enclosure]
using App.Views.Chat.Messages, only: [Room, woven]
using App.Views.Chat.Composer, only: [mentionable, offered, picked]

# What somebody is in the middle of, under the conversation.
record Standing do
  who : String
  doing : String
  # When it stops being true, in milliseconds since 1970.
  lapses : String
end

let composerPartial = Template.html(Kex.embed("_composer.html.ket"))
let groupSettingsPartial = Template.html(Kex.embed("_group_settings.html.ket"))
let settingsPartial = Template.html(Kex.embed("_settings.html.ket"))
let teamOptionPartial = Template.html(Kex.embed("_team_option.html.ket"))
let headingPartial = Template.html(Kex.embed("_heading.html.ket"))
let statusPartial = Template.html(Kex.embed("_status.html.ket"))
let queuedPartial = Template.html(Kex.embed("_queued.html.ket"))

# The conversation, or with `tab.view` "files", what was sent into it.
# Either way files can be dropped anywhere on it, pasted into it or
# chosen with 📎, and wait in the message box to be sent. `unsent` is
# what is written in its message box and not sent yet.
let pane(
  tab: Tab,
  organization: Organization,
  room: Room,
  conversation: Conversation?,
  messages: [Message],
  cabinet: Cabinet,
  alone?: Bool,
  doing: [Note],
  unsent: String
) -> String do
  match conversation do
    None => return [
      "<section class=\"pane\"><p class=\"empty\">",
      "That conversation is not there, or is not yours to read. Pick one on the left.",
      "</p></section>"
    ].join("")
    Just(open) => do
      let title = titled(open, room.viewer, room.people)
      let filing = tab.view == "files"
      let setting = tab.view == "settings" && (open.channel? || open.group?) && room.administrator
      let heading = headingPartial(
        title,
        App.Models.Emoji.shown(open.topic),
        open.channel?,
        tab.retitling?,
        filing,
        cabinet.stored.empty? then "" else "${cabinet.stored.count}",
        noted(open),
        open.channel? && !open.public?,
        open.group?,
        open.botAccess,
        room.administrator && (open.channel? || open.group?),
        setting
      )
      let queued = cabinet.queued
        .map { |file| queuedPartial(enclosed(file, room.people, "")) }
        .join("")
      let composer = composerPartial(
        "message-send",
        "message-box",
        open.solo? then "Jot something down…" else "Message ${title}",
        picked("#message-box"),
        alone?,
        unsent,
        queued,
        true,
        mentionable(room),
        offered(room)
      )
      let shown = if filing
        filed(cabinet, room.people)
      elif setting
        open.channel? then settingsPane(open, organization, room) else groupSettingsPartial(open.botAccess)
      else
        let uses = room.invocations.filter { |used| used.threadId.empty? }
        let bubbles = woven(room, messages, uses, "", 0, false)
        let emptied = if open.solo?
          soloIntro
        else
          messages.empty? then "<p class=\"empty\">Nothing here yet. Say something.</p>" else ""
        end
        [
          "<div class=\"messages\" id=\"messages\" data-stick=\"bottom\">",
          emptied,
          bubbles.join("\n"),
          "</div>",
          "<p class=\"statuses\" id=\"statuses\" aria-live=\"polite\">",
          statuses(doing, room.people),
          "</p>"
        ].join("")
      end
      return [
        "<section class=\"pane\" data-live-drop=\"file-attach\">",
        heading,
        shown,
        setting then "" else composer,
        "</section>"
      ].join("")
    end
  end
end

private do
  # What a conversation's heading says about who can read it, under its
  # topic. Team ownership is shown in channel settings.
  noted : Conversation -> String
  let noted(conversation) do
    let count = conversation.participants.count
    match conversation.kind do
      "direct" => "Private: only the two of you can read this."
      "group" => "Private: only the ${count} of you can read this."
      _ => do
        let people = count == 1 then "1 person" else "${count} people"
        conversation.public? then "" else "🔒 Private: only its ${people} can read this."
      end
    end
  end

  # A channel's settings, as a full pane: who may read it, the team that owns
  # it, and how much its bots may read.
  settingsPane : Conversation -> Organization -> Room -> String
  let settingsPane(conversation, organization, room) do
    let owners = room.teams
      .filter { |team| team.includes?(room.viewer.id) || team.id == conversation.teamId }
      .map { |team| teamOptionPartial(team.id, team.handle, team.id == conversation.teamId) }
    settingsPartial(organization.name, conversation.public?, conversation.botAccess, owners.join(""))
  end

  # What somebody's chat with themselves is for, at the start of it.
  let soloIntro = Kex.embed("_solo.html")

  # "Ada is typing…", or what a bot says it is doing: "deploy-bot Deploying…".
  statuses : [Note] -> [User] -> String
  let statuses(doing, people) do
    doing
      .map do |note|
        statusPartial(Standing {
          who: shownAs(people, note.member, "Someone"),
          doing: note.saying.empty? then "is typing…" else "${note.saying}…",
          lapses: "${note.lapses}"
        })
      end
      .join(" ")
  end
end
