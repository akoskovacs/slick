---
params: [failure: String, notice: String, rail: String, organization: String, administrator?: Bool, channels: String, people: String, robots: String, teams: String, bar: String, pane: String, dialog: String, place: String, caption: String]
---
<%== bar %>
<% if !failure.empty? %>
  <p class="failure" role="alert"><%= failure %></p>
<% end %>
<% if !notice.empty? %>
  <p class="notice" role="status"><%= notice %></p>
<% end %>
<div class="workspace" data-live-path="<%= place %>" data-live-title="<%= caption %>">
  <nav class="rail" aria-label="Organizations">
    <%== rail %>
    <button type="button" class="badge add" data-event="dialog-open" data-dialog="organization" title="Create an organization">+</button>
  </nav>
  <nav class="sidebar">
    <div class="organization">
      <strong><%= organization %></strong>
      <% if administrator? %>
        <button type="button" class="quiet" data-event="dialog-open" data-dialog="people">Manage people</button>
      <% end %>
    </div>
    <div class="sidebar-head">
      <h2>Channels</h2>
      <button type="button" class="quiet" data-event="dialog-open" data-dialog="channel" title="New channel">+</button>
    </div>
    <ul class="entries"><%== channels %></ul>
    <div class="sidebar-head">
      <h2>Direct messages</h2>
      <button type="button" class="quiet" data-event="dialog-open" data-dialog="group" title="New group chat">+</button>
    </div>
    <ul class="entries people"><%== people %></ul>
    <div class="sidebar-head">
      <h2>Teams</h2>
      <button type="button" class="quiet" data-event="dialog-open" data-dialog="team" title="New team">+</button>
    </div>
    <ul class="entries"><%== teams %></ul>
    <div class="sidebar-head">
      <h2>Bots</h2>
      <button type="button" class="quiet" data-event="dialog-open" data-dialog="bots" title="Add a bot, or give one a new API token">⚙</button>
    </div>
    <ul class="entries people"><%== robots %></ul>
  </nav>
  <%== pane %>
</div>
<%== dialog %>
