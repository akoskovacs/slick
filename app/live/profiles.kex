# Profiles from a tab: opening somebody's beside the conversation, and
# changing one's own — details, and a status.
module App.Live.Profiles

using Metro.Live.Socket, only: [field, unchanged, changed]
using Metro.Validation, only: [rules, validates, sized]
using App.Live.Outcome, only: [Outcome, refused]
using App.Live.Places, only: [home, member?]
using App.Live.Event, only: [Event, given, typed]
using App.Live.Tab, only: [Tab, closed]
using App.Models.User, only: [User, UserDetail, UserId, Name]
using App.Models.User, as: User
using DB.Repositories.Users, as: Users

let statusRules = rules do
  validates("text", "A status", [sized(0, 80)])
end

# Opens somebody's profile beside the conversation, in place of a thread or
# a team: only of somebody in the tab's organization.
open : User -> Tab -> UserId -> Outcome
foul open(user, tab, id) do
  match home(user, tab) do
    None => return unchanged(tab)
    Just(organization) => do
      return unchanged(tab) if !member?(organization.id, id)
      return unchanged(Tab { ...closed(tab), thread: "", profile: id, team: "" })
    end
  end
end

# Changes somebody's own details. One a sync has taken over keeps what is
# stored, whatever was sent for it: the form shows it, but only to read.
update : User -> Tab -> [(String, String?)] -> Outcome
foul update(user, tab, entries) do
  match Users.find(user.id) do
    Ok(Just(stored)) => do
      let given = User.DETAILS.map do |column, _, _|
        let kept = stored.locked?(column)
        let key = Harmat.Database.spelled(column)
        (column, kept then stored.detail(column) else field(entries, key).trim)
      end
      let problems = User.DETAILS.flatMap do |column, label, longest|
        faults(column, label, longest, chosen(given, column))
      end
      return refused(tab, App.Live.Tab.ProfileDialog, problems.first.or("")) if !problems.empty?

      let described = User {
        ...stored,
        name: chosen(given, User.Name),
        title: chosen(given, User.Title),
        department: chosen(given, User.Department),
        phone: chosen(given, User.Phone),
        timeZone: chosen(given, User.TimeZone),
        bio: chosen(given, User.Bio),
        nickname: chosen(given, User.Nickname),
        nicknameShown?: field(entries, "show_nickname") == "yes"
      }
      match Users.update(described) do
        Ok(_) => return changed(closed(tab))
        Error(reason) => return refused(tab, App.Live.Tab.ProfileDialog, reason)
      end
    end
    _ => return unchanged(tab)
  end
end

# What somebody says about themselves: an emoji Slick offers, and a few
# words. Both empty takes it back.
setStatus : User -> Tab -> String -> String -> Outcome
foul setStatus(user, tab, emoji, saying) do
  let problems = Metro.Validation.checked(statusRules, {"text": saying}).messages
  return refused(tab, App.Live.Tab.StatusDialog, problems.first.or("")) if !problems.empty?
  return refused(tab, App.Live.Tab.StatusDialog, "Pick one of the emoji offered.") if !App.Models.Emoji.status?(emoji)

  match Users.setStatus(user.id, emoji, saying) do
    Ok(_) => return changed(closed(tab))
    Error(reason) => return refused(tab, App.Live.Tab.StatusDialog, reason)
  end
end

# What this part answers, of the events config/live.kex routes to it, by
# their whole names; any other does nothing.
on : String -> Event -> Outcome
foul on("profile-open", event) = open(event.user, event.tab, given(event, "user"))
foul on("profile-close", event) = unchanged(Tab { ...closed(event.tab), profile: "" })
foul on("profile-update", event) = update(event.user, event.tab, event.entries)
foul on("status-set", event) = setStatus(event.user, event.tab, typed(event, "emoji"), typed(event, "text"))
foul on("status-clear", event) = setStatus(event.user, event.tab, "", "")
foul on(_, event) = unchanged(event.tab)

private do
  # What was given for one detail.
  chosen : [(UserDetail, String)] -> UserDetail -> String
  let chosen(pairs, column) = pairs
    .flatMap { |key, value| key == column then [value] else [] }
    .first
    .or("")

  # What is wrong with what was given for one detail: a display name is
  # needed, and none may be longer than it may.
  faults : UserDetail -> String -> Integer -> String -> [String]
  let faults(Name, label, longest, "") = ["${label} cannot be empty."]
  let faults(column, label, longest, text) do
    return [] if text.chars.count <= longest
    ["${label} cannot be longer than ${longest} characters."]
  end
end
