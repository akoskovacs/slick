using App.Live.Tab, only: [Tab]
using App.Models.Grant, only: [Grant]
using App.Models.Grant, as: Grant
using App.Models.User, only: [User]
using Spec.Support, only: [World, stepped, shown, fresh, populated]
using App.Models.Organization, only: [OrganizationId]
using App.Models.Conversation, only: [ConversationId]

# Profiles from a tab. Each example starts from a world of its own
# (Spec.Support).

# Bob's details, as his form sends them.
let BOBS = [
  ("event", "profile-update"),
  ("name", "Bob"),
  ("title", "Engineer"),
  ("department", "Platform"),
  ("phone", "+36 1 234"),
  ("time_zone", "Europe/Budapest"),
  ("bio", "Builds <things>"),
  ("nickname", "Bobby")
]

# Bob's profile, open in a tab of Ada's.
foul bobsProfile(world: World) -> Tab do
  let (opened, _) = stepped(world, world.ada, Tab {}, [("event", "profile-open"), ("user", world.bob.id.as(String))])
  opened
end

describe("App.Live.Profiles, opening one") do
  it("opens the server administrator's own profile outside the organization roster") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let token = App.Services.Authentication.register("Server Admin", "admin@example.com", "a long enough phrase").try
      let admin : User = App.Services.Authentication.current(Just(token)).try
      DB.Repositories.Grants.grant(Grant.userOnServer(admin.id, Grant.Admin)).try

      let (profile, _) = stepped(world, admin, Tab { organization: world.acme.organization }, [
        ("event", "profile-open"), ("user", admin.id.as(String))
      ])
      Assert.equal(profile.profile, admin.id)
      let card = shown(world, admin, profile)
      Assert.truthy(card.contains?("aria-label=\"Profile of Server Admin\""))
      Assert.truthy(card.contains?("Server administrator"))
      Assert.truthy(card.contains?("Edit profile"))

      let (_, changed) = stepped(world, admin, profile, [
        ("event", "profile-update"), ("name", "Admin Updated")
      ])
      Assert.truthy(changed)
      Assert.equal(
        DB.Repositories.Users.find(admin.id).map { |found| found.map { |user| user.name } },
        Ok(Just("Admin Updated"))
      )
    end
  end

  it("opens somebody's profile beside the conversation") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let profile = bobsProfile(world)
      Assert.equal(profile.profile, world.bob.id)
      let card = shown(world, world.ada, profile)
      Assert.truthy(card.contains?("aria-label=\"Profile of Bob\""))
      Assert.truthy(card.contains?("mailto:bob@example.com"))
      Assert.truthy(card.contains?("data-event=\"direct-open\" data-user=\"${world.bob.id}\""))
      Assert.truthy(card.contains?("Manage member"))
    end
  end

  it("says whose a bot is, on its profile") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (made, _) = stepped(world, world.bob, Tab {}, [("event", "bot-create"), ("name", "deploy-bot"), ("owner", "me")])
      let bot : User = App.Services.Bots.bearer(Just("Bearer ${made.secret}")).or(world.bob)
      let (botProfile, _) = stepped(world, world.ada, Tab {}, [("event", "profile-open"), ("user", bot.id.as(String))])
      let card = shown(world, world.ada, botProfile)
      Assert.truthy(card.contains?("Belongs to"))
      Assert.truthy(card.contains?("data-event=\"profile-open\" data-user=\"${world.bob.id}\">Bob</button>"))
      Assert.falsy(card.contains?("mailto:"))
    end
  end

  it("stays open over other events, until a thread takes its place or it is closed") do
    with Harmat.Connection = fresh() do
      let world = populated()
      stepped(world, world.ada, Tab {}, [("event", "message-send"), ("body", "a thread")])
      let general = world.ada.visible("", "").map { |chat| chat.id }.or("")
      let said : [App.Models.Message.Message] = DB.Repositories.Messages.latest(general, 1).or([])
      let id = said.first.map { |message| message.id }.or("")
      let profile = bobsProfile(world)
      let (cancelled, _) = stepped(world, world.ada, profile, [("event", "cancel")])
      Assert.equal(cancelled.profile, world.bob.id)
      let (thread, _) = stepped(world, world.ada, profile, [("event", "thread-open"), ("message", id.as(String))])
      Assert.equal(thread.profile, "")
      Assert.equal(thread.thread, id)
      let (closed, _) = stepped(world, world.ada, profile, [("event", "profile-close")])
      Assert.equal(closed.profile, "")
    end
  end

  it("shows nobody outside the organization, whatever the tab names") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (malTries, _) = stepped(world, world.mal, Tab {}, [("event", "profile-open"), ("user", world.eve.id.as(String))])
      Assert.equal(malTries.profile, "")
      Assert.falsy(shown(world, world.mal, Tab { profile: world.eve.id }).contains?("Profile of Eve"))
    end
  end
end

describe("App.Live.Profiles, one's own details") do
  it("fills in somebody's own profile, a nickname only when asked") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, changed) = stepped(world, world.bob, Tab {}, BOBS)
      Assert.truthy(changed)
      let card = shown(world, world.ada, bobsProfile(world))
      Assert.truthy(card.contains?("Engineer"))
      Assert.truthy(card.contains?("Europe/Budapest"))
      Assert.truthy(card.contains?("Builds &lt;things&gt;"))
      Assert.falsy(card.contains?("Bobby"))
    end
  end

  it("cannot empty a name") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (unnamed, changed) = stepped(world, world.bob, Tab {}, [("event", "profile-update"), ("name", "  ")])
      Assert.falsy(changed)
      Assert.truthy(unnamed.dialogProblem.contains?("Name cannot be empty"))
    end
  end

  it("shows a nickname everywhere when somebody goes by it, the name on the profile") do
    with Harmat.Connection = fresh() do
      let world = populated()
      stepped(world, world.bob, Tab {}, BOBS + [("show_nickname", "yes")])
      let card = shown(world, world.ada, bobsProfile(world))
      Assert.truthy(card.contains?("aria-label=\"Profile of Bobby\""))
      Assert.truthy(card.contains?("<p class=\"formal\">Bob</p>"))
    end
  end

  it("keeps what a sync has taken over, and shows it locked") do
    with Harmat.Connection = fresh() do
      let world = populated()
      stepped(world, world.bob, Tab {}, BOBS)
      DB.Repositories.Users.markManaged(world.bob.id, [User.Name, User.Title])
      stepped(world, world.bob, Tab {}, [
        ("event", "profile-update"),
        ("name", "Hacked"),
        ("title", "CEO"),
        ("department", "Sales")
      ])
      let card = shown(world, world.ada, bobsProfile(world))
      Assert.truthy(card.contains?("Engineer"))
      Assert.truthy(card.contains?("Sales"))
      Assert.falsy(card.contains?("Hacked"))
      Assert.falsy(card.contains?("CEO"))
      let form = shown(world, world.bob, Tab { dialog: App.Live.Tab.ProfileDialog })
      let inputOf = do |column|
        form
          .split("name=\"${column}\"")
          .second
          .or("")
          .split(">")
          .first
          .or("")
      end
      Assert.truthy(inputOf("title").contains?("value=\"Engineer\""))
      Assert.truthy(inputOf("title").contains?("readonly"))
      Assert.truthy(inputOf("department").contains?("value=\"Sales\""))
      Assert.falsy(inputOf("department").contains?("readonly"))
    end
  end
end

describe("App.Live.Profiles, a status") do
  it("shows an emoji Slick offers and a few words beside the name") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (_, changed) = stepped(world, world.ada, Tab {}, [("event", "status-set"), ("emoji", "🌴"), ("text", "On vacation <till Monday>")])
      Assert.truthy(changed)
      Assert.truthy(shown(world, world.bob, Tab {}).contains?("<span class=\"emblem\" title=\"On vacation &lt;till Monday&gt;\">🌴</span>"))
      Assert.truthy(shown(world, world.ada, Tab {}).contains?("<p class=\"menu-status\">🌴 On vacation &lt;till Monday&gt;</p>"))
    end
  end

  it("takes no emoji Slick does not offer, and takes a status back") do
    with Harmat.Connection = fresh() do
      let world = populated()
      let (odd, oddChanged) = stepped(world, world.ada, Tab {}, [("event", "status-set"), ("emoji", "<img>"), ("text", "x")])
      Assert.falsy(oddChanged)
      Assert.truthy(!odd.dialogProblem.empty?)
      stepped(world, world.ada, Tab {}, [("event", "status-set"), ("emoji", "🌴"), ("text", "away")])
      stepped(world, world.ada, Tab {}, [("event", "status-clear")])
      Assert.falsy(shown(world, world.bob, Tab {}).contains?("🌴"))
      Assert.truthy(shown(world, world.ada, Tab {}).contains?("<p class=\"menu-status\">No status set</p>"))
    end
  end
end
