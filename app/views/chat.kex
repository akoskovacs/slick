# Slick's markup: a layout, and the live region inside it — a sidebar of
# channels and people, and the conversation that is open. The templates are
# the `.ket` files beside this module; `<%= %>` escapes what it prints.
#
# The records here are what the templates print. Their field names are
# chosen not to match any function in the program, because a template reads
# `item.name` as a call to `name(item)` when one exists (kexhq/kex#448).
module App.Views.Chat

using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Message, only: [Message]
using App.Models.Organization, only: [Organization]
using App.Models.Reaction, only: [Reaction]
using App.Models.User, only: [User]

# One line of the sidebar.
record Entry do
  # The event the line sends, and the field it sends it with.
  action : String
  subject : String
  key : String
  caption : String
  current? : Bool
  # "BOT" beside a bot's name; "" beside a person's.
  badged : String = ""
end

# One of my bots, in the bots dialog.
record Robot do
  key : String
  caption : String
  # Whether it is in the organization the tab is in, and what that is called.
  here? : Bool
  spot : String
end

# One organization in the rail.
record Badge do
  key : String
  glyph : String
  caption : String
  current? : Bool
end

# One message.
record Bubble do
  key : String
  # The element's id: a message shown in the conversation and again at the
  # head of its thread is two elements.
  anchor : String
  author : String
  badged : String = ""
  # The author's first letter and one of eight colours, for the avatar.
  initial : String
  tint : String
  stamp : String
  content : String
  own? : Bool
  # "3 replies", or "" when there are none or it is shown inside the thread.
  answers : String = ""
  # Whether a thread can be opened from it.
  threadable? : Bool = true
end

# One emoji under a message: how many put it there, and whether I did.
record Chip do
  key : String
  glyph : String
  tally : String
  own? : Bool
end

let layout = Template.html(Kex.embed("layouts/application.html.ket"))
let frame = Template.html(Kex.embed("chat/index.html.ket"))
let entryPartial = Template.html(Kex.embed("chat/_entry.html.ket"))
let foundingPartial = Template.html(Kex.embed("chat/_founding.html.ket"))
let headingPartial = Template.html(Kex.embed("chat/_heading.html.ket"))
let badgePartial = Template.html(Kex.embed("chat/_badge.html.ket"))
let botPartial = Template.html(Kex.embed("chat/_bot.html.ket"))
let botsPartial = Template.html(Kex.embed("chat/_bots.html.ket"))
let dialogPartial = Template.html(Kex.embed("chat/_dialog.html.ket"))
let welcomePartial = Template.html(Kex.embed("chat/_welcome.html.ket"))
let bubblePartial = Template.html(Kex.embed("chat/_bubble.html.ket"))
let chipPartial = Template.html(Kex.embed("chat/_chip.html.ket"))
let threadPartial = Template.html(Kex.embed("chat/_thread.html.ket"))
let composerPartial = Template.html(Kex.embed("chat/_composer.html.ket"))

# The document: head, who is signed in, the live region, and Metro's script.
page : String -> String -> String
let page(who, live) = layout(who, live)

# The live region for somebody who is in no organization yet.
welcome : Tab -> User -> String
let welcome(tab, user) = welcomePartial(user.shown, user.email, tab.dialogProblem)

# The live region.
#
# `organizations` are the ones this person is in; `organization` is the one
# the tab is in, and the channels and people are its.
# `thread` is the open thread — the message that started it, then the
# replies — or empty.
#
# `bots` are this person's own, and only asked for while their dialog is open.
index : Tab -> User -> [Organization] -> Organization -> [Conversation] -> [User] -> [User] -> Conversation? -> [Message] -> [Reaction] -> [Message] -> String
let index(tab, user, organizations, organization, channels, people, bots, conversation, messages, reactions, thread) do
  let shown = conversation.map { |open| open.id }.or("")
  let badges = organizations.map { |each|
    badgePartial(Badge { key: each.id, glyph: each.name.take(1).upperCase, caption: each.name, current?: each.id == organization.id })
  }
  let channelLines = channels.map { |channel|
    entryPartial(Entry { action: "open", subject: "id", key: channel.id, caption: "# ${channel.title}", current?: channel.id == shown })
  }
  let personLines = people.reject { |person| person.id == user.id }.map { |person|
    let chatting = conversation.map { |open| !open.channel? && open.counterpart(user.id) == person.id }.or(false)
    entryPartial(Entry { action: "direct", subject: "user", key: person.id, caption: person.shown, current?: chatting, badged: person.bot? then "BOT" else "" })
  }
  let founding = tab.founding? then foundingPartial(tab.channelProblem) else ""
  let beside = thread.empty? then "" else threadPane(user, people, reactions, thread)
  let place = conversation.map { |open| located(organization, open, user, thread) }.or("")
  let caption = conversation.map { |open| "${titled(open, user, people)} · ${organization.name}" }.or(organization.name)
  frame(
    tab.failure, tab.notice, badges.join("\n"), organization.name, channelLines.join("\n"), founding, personLines.join("\n"),
    pane(tab, user, people, conversation, messages, reactions, thread.empty? && tab.dialog.empty?) + beside,
    asking(tab, organization, people, bots), place, caption
  )
end

private do
  # Where a conversation is, as an address: the one the address bar shows
  # and `App.Live.Chat.arrived` reads back.
  located : Organization -> Conversation -> User -> [Message] -> String
  let located(organization, conversation, user, thread) do
    let base = conversation.channel? then "/${organization.slug}/channels/${conversation.title}" else "/${organization.slug}/dm/${conversation.counterpart(user.id)}"
    thread.first.map { |opening| "${base}?thread=${opening.id}" }.or(base)
  end

  # The dialog a tab has open, if any.
  asking : Tab -> Organization -> [User] -> [User] -> String
  let asking(tab, organization, people, bots) do
    if tab.dialog == "bots"
      let rows = bots.map { |bot|
        botPartial(Robot { key: bot.id, caption: bot.shown, here?: people.any? { |person| person.id == bot.id }, spot: organization.name })
      }
      return botsPartial(organization.name, rows.join("\n"), tab.dialogProblem, tab.secret, tab.secretFor)
    end

    return dialogPartial("Create an organization", "Its own channels and people, apart from every other.", "charter", "name", "Acme", tab.dialogProblem, "Create") if tab.dialog == "organization"
    return dialogPartial("Add people to ${organization.name}", "The email somebody registered with. They are in as soon as you add them.", "enlist", "email", "name@example.com", tab.dialogProblem, "Add") if tab.dialog == "invite"

    ""
  end

  # The emoji buttons that type into one message box.
  picked : String -> String
  let picked(target) do
    App.Models.Emoji.KNOWN.map { |entry| match entry do (code, glyph) => "<button type=\"button\" class=\"quiet\" data-insert=\"${glyph}\" data-target=\"${target}\" title=\":${code}:\">${glyph}</button>" end }.join("")
  end

  tallied : Integer -> String
  let tallied(0) = ""
  let tallied(1) = "1 reply"
  let tallied(replies) = "${replies} replies"

  # The thread beside the conversation: its first message, then the replies.
  threadPane : User -> [User] -> [Reaction] -> [Message] -> String
  let threadPane(user, people, reactions, thread) do
    let opener = thread.take(1).map { |message| bubble(message, user, people, reactions, true) }.join("")
    let followups = thread.drop(1).map { |message| bubble(message, user, people, reactions, true) }
    let summary = followups.empty? then "No replies yet" else tallied(followups.count)
    threadPartial(opener, summary, followups.join("\n"), composerPartial("reply", "reply-box", "Reply…", picked("#reply-box"), true))
  end

  pane : Tab -> User -> [User] -> Conversation? -> [Message] -> [Reaction] -> Bool -> String
  let pane(tab, user, people, None, messages, reactions, alone?) = "<section class=\"pane\"><p class=\"empty\">That conversation is not there, or is not yours to read. Pick one on the left.</p></section>"
  let pane(tab, user, people, Just(conversation), messages, reactions, alone?) do
    let title = titled(conversation, user, people)
    let heading = headingPartial(title, App.Models.Emoji.shown(conversation.topic), conversation.channel?, tab.retitling?)
    let bubbles = messages.map { |message| bubble(message, user, people, reactions, false) }
    let emptied = messages.empty? then "<p class=\"empty\">Nothing here yet. Say something.</p>" else ""
    "<section class=\"pane\">${heading}<div class=\"messages\" id=\"messages\" data-stick=\"bottom\">${emptied}${bubbles.join("\n")}</div>${composerPartial("send", "message-box", "Message ${title}", picked("#message-box"), alone?)}</section>"
  end

  # What a conversation is called for this person: `# name` for a channel,
  # the other person for a private chat.
  titled : Conversation -> User -> [User] -> String
  let titled(conversation, user, people) do
    return "# ${conversation.title}" if conversation.channel?

    let other = conversation.counterpart(user.id)
    people.find { |person| person.id == other }.map { |person| person.shown }.or("Private chat")
  end

  # `inThread?` is whether it is shown in the thread pane, where a message
  # has its own element id and no way to open the thread it is already in.
  bubble : Message -> User -> [User] -> [Reaction] -> Bool -> String
  let bubble(message, user, people, reactions, inThread?) do
    let writer = people.find { |person| person.id == message.userId }
    let author = writer.map { |person| person.shown }.or("Someone")
    let badged = writer.map { |person| person.bot? }.or(false) then "BOT" else ""
    let mine = reactions.filter { |reaction| reaction.messageId == message.id }
    let chips = mine.map { |reaction| reaction.emoji }.uniq.map { |glyph|
      let givers = mine.filter { |reaction| reaction.emoji == glyph }
      chipPartial(Chip { key: message.id, glyph: glyph, tally: "${givers.count}", own?: givers.any? { |reaction| reaction.userId == user.id } })
    }
    let offers = App.Models.Emoji.PALETTE.map { |glyph| chipPartial(Chip { key: message.id, glyph: glyph, tally: "", own?: false }) }
    bubblePartial(
      Bubble { key: message.id, anchor: inThread? then "thread-${message.id}" else "message-${message.id}", answers: inThread? then "" else tallied(message.replyCount), threadable?: !inThread?, author: author, badged: badged, initial: author.take(1).upperCase, tint: "${BEAM.erlang.phash2(message.userId, 8)}", stamp: message.sentOn.drop(11).take(5), content: App.Models.Emoji.shown(message.body), own?: message.userId == user.id },
      chips.join(""), offers.join("")
    )
  end
end
