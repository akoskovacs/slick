# A name, an email and a password — typed twice — as the registration form
# sends them, and the rules they must satisfy.
module App.Forms.Credentials

using Metro.Validation, only: [Rule, rules, validates, confirmed, present, sized, emailAddress]

let SHORTEST_PASSWORD = 8
let LONGEST_PASSWORD = 200
let LONGEST_NAME = 40

# Length is the only rule on a password: no required symbols, no forbidden
# ones, and a long passphrase is welcome.
let registration = rules do
  validates("name", "Name", [present, sized(1, LONGEST_NAME)])
  validates("email", "Email", [present, emailAddress])
  validates("password", "Password", [present, sized(SHORTEST_PASSWORD, LONGEST_PASSWORD)])
  confirmed("password", "password_confirmation", "The two passwords do not match.")
end

# An email the way it is stored and compared: trimmed, lower case.
normalized : String -> String
let normalized(email) = email.trim.lowerCase

# Everything wrong with a registration, as sentences; empty when it is fine.
# `confirmation` is the password typed again, as the form sends it; `None`
# for an account made by the program, where there is nothing to compare.
problems : String -> String -> String -> String? -> [String]
let problems(name, email, password, confirmation) do
  let values = {
    "name": name,
    "email": normalized(email),
    "password": password
  }
  let typed = confirmation
    .map { |again| values.put("password_confirmation", again) }
    .or(values)
  Metro.Validation.checked(registration, typed).messages
end
