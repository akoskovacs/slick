# The people who can sign in.
#
#   DB.Repositories.Users.credentials(email)
module DB.Repositories.Users

using Harmat.Database, as: Database
using App.Models.User, only: [User]
using DB.Repositories.Grants, as: Grants

# Stores a new user. Fails when the email is taken: the table's unique
# index decides, so two registrations racing for one address cannot both win.
foul enroll(user: User, passwordHash: String) -> Result<User, String> do
  let row = {
    id: user.id,
    email: user.email,
    name: user.name,
    password_hash: passwordHash,
    created_at: "${DateTime.utcNow()}"
  }
  return Database.insert(DB.Schema.Users)
    .values(row)
    .run
    .map { |_| user }
end

# The user registered under an email, with their stored password line.
foul credentials(email: String) -> Result<(User, String)?, String> do
  return Database.select().from(DB.Schema.Users)
    .where(DB.Schema.Users.email == email)
    .first
    .flatMap do |row|
      match row do
        None => Ok(None)
        Just(found) => Database.decoded(found, User, USER_COLUMNS)
          .map { |user| Just((user, found.get("password_hash").or(""))) }
      end
    end
end

# Stores a bot. It has no password: `tokenDigest` is how it is known.
foul automated(bot: User, tokenDigest: String) -> Result<User, String> do
  let row = {
    id: bot.id,
    email: bot.email,
    name: bot.name,
    password_hash: "",
    created_at: "${DateTime.utcNow()}",
    kind: "bot",
    owner_id: bot.ownerId,
    owner_organization_id: bot.ownerOrganizationId,
    api_token_digest: tokenDigest
  }
  return Database.insert(DB.Schema.Users)
    .values(row)
    .run
    .map { |_| bot }
end

# A person's bots, by name.
foul operated(owner: String) -> Result<[User], String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .where(DB.Schema.Users.ownerId == owner)
    .orderBy([:name, :id])
    .all(as: User, renamed: USER_COLUMNS)
end

# An organization's bots, by name.
foul maintained(organizationId: String) -> Result<[User], String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .where(DB.Schema.Users.ownerOrganizationId == organizationId)
    .orderBy([:name, :id])
    .all(as: User, renamed: USER_COLUMNS)
end

# Replaces the token of an organization's bot; whether it was that
# organization's to change.
foul rekeyedFor(botId: String, organizationId: String, tokenDigest: String) -> Result<Bool, String> do
  return Database.within(DB.Schema.Users.ownerOrganizationId == organizationId)
    .update(DB.Schema.Users)
    .set({api_token_digest: tokenDigest})
    .where(DB.Schema.Users.id == botId)
    .run
    .map { |changed| changed > 0 }
end

# The bot an API token's digest belongs to, or `None`.
foul bearing(tokenDigest: String) -> Result<User?, String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .where(DB.Schema.Users.apiTokenDigest == tokenDigest)
    .where(DB.Schema.Users.kind == "bot")
    .first(as: User, renamed: USER_COLUMNS)
end

# Replaces a bot's token; whether it was this owner's bot to change.
foul rekeyed(botId: String, owner: String, tokenDigest: String) -> Result<Bool, String> do
  return Database.within(DB.Schema.Users.ownerId == owner)
    .update(DB.Schema.Users)
    .set({api_token_digest: tokenDigest})
    .where(DB.Schema.Users.id == botId)
    .run
    .map { |changed| changed > 0 }
end

# Deletes a bot — this owner's own — and everything of it: what it could do,
# what it was in, and the places it had been. Whether it was there to delete.
foul removed(botId: String, owner: String) -> Result<Bool, String> do
  return removing(botId, owner, "")
end

# The same, for an organization's bot.
foul removedFor(botId: String, organizationId: String) -> Result<Bool, String> do
  return removing(botId, "", organizationId)
end

# Sets what somebody says about themselves; "" and "" takes it back.
foul restyled(id: String, emoji: String, saying: String) -> Result<Integer, String> do
  return Database.update(DB.Schema.Users)
    .set({status_emoji: emoji, status_text: saying})
    .where(DB.Schema.Users.id == id)
    .run
end

# Sets the details a profile shows, each as it is on `user`. Whatever a sync
# has taken over is for the caller to have kept: `App.Live.Chat` does.
foul described(user: User) -> Result<Integer, String> do
  let row = {
    name: user.name,
    title: user.title,
    department: user.department,
    phone: user.phone,
    time_zone: user.timeZone,
    bio: user.bio,
    nickname: user.nickname,
    show_nickname: user.nicknameShown? then "yes" else ""
  }
  return Database.update(DB.Schema.Users)
    .set(row)
    .where(DB.Schema.Users.id == user.id)
    .run
end

# Hands details over to a sync, by column, or back with `[]`: what it has
# taken over cannot be changed from a profile.
foul managing(id: String, columns: [String]) -> Result<Integer, String> do
  return Database.update(DB.Schema.Users)
    .set({managed: columns.join(",")})
    .where(DB.Schema.Users.id == id)
    .run
end

foul member(id: String) -> Result<User?, String> do
  return Database.select().from(DB.Schema.Users)
    .where(DB.Schema.Users.id == id)
    .first(as: User, renamed: USER_COLUMNS)
end

# Everyone, by name: who can be written to, and whose name goes on a message.
foul everyone -> Result<[User], String> do
  return Database.select(SHOWN).from(DB.Schema.Users)
    .orderBy([:name, :email])
    .all(as: User, renamed: USER_COLUMNS)
end

# Every bot's id.
foul botIds -> Result<[String], String> do
  return Database.select().from(DB.Schema.Users)
    .where(DB.Schema.Users.kind == "bot")
    .pluck(:id)
end

private do
  # Deletes a bot, when it is the caller's to delete: `owner` is its owner's
  # id, or `organizationId` the organization it belongs to — never both. The
  # bot goes first, so nothing of it is taken from a bot that was not this
  # caller's; the rest is all or nothing, in the one transaction. What it
  # said stays, as what anybody who is gone has said does ("Someone").
  foul removing(botId: String, owner: String, organizationId: String) -> Result<Bool, String> do
    let done : Result<Bool, String> = Harmat.Database.transaction do
      let gone : Integer = (if owner.empty?
        Database.delete(DB.Schema.Users)
          .where(DB.Schema.Users.id == botId)
          .where(DB.Schema.Users.kind == "bot")
          .where(DB.Schema.Users.ownerOrganizationId == organizationId)
      else
        Database.delete(DB.Schema.Users)
          .where(DB.Schema.Users.id == botId)
          .where(DB.Schema.Users.kind == "bot")
          .where(DB.Schema.Users.ownerId == owner)
      end).run.try
      if gone > 0
        Database.delete(DB.Schema.Commands).where(DB.Schema.Commands.botId == botId).run.try
        Database.delete(DB.Schema.Invocations).where(DB.Schema.Invocations.botId == botId).run.try
        # Everything it was granted — its memberships, its roles — goes too.
        Grants.revokedAll("user", botId).try
        Database.delete(DB.Schema.Drafts).where(DB.Schema.Drafts.userId == botId).run.try
        Database.delete(DB.Schema.Readings).where(DB.Schema.Readings.userId == botId).run.try
        Database.delete(DB.Schema.Sessions).where(DB.Schema.Sessions.userId == botId).run.try
      end
      Ok(gone > 0)
    end
    return done
  end

  # This field predates the model's name; the other columns follow snake case.
  let USER_COLUMNS = {"nicknameShown?": "show_nickname"}

  # What is read of a user when nobody is signing in: everything but the
  # password line and the token digest.
  let SHOWN = [
    :id,
    :email,
    :name,
    :kind,
    :owner_id,
    :owner_organization_id,
    :status_emoji,
    :status_text,
    :title,
    :department,
    :phone,
    :time_zone,
    :bio,
    :nickname,
    :show_nickname,
    :managed
  ]
end
