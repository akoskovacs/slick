# Organizations.
#
#   DB.Repositories.Organizations.findBySlug("acme")
module DB.Repositories.Organizations

using Harmat.Database, as: Database
using App.Models.Organization, only: [Organization, OrganizationId]
using App.Models.Ids, only: [UserId]

# Creates an organization. Fails when the address is taken: the unique
# index on `slug` decides.
foul create(name: String, slug: String, by: UserId) -> Organization or! String do
  let organization = Organization {
    id: Metro.Id.generate(prefix: "o"),
    slug: slug,
    name: name
  }
  let row = {
    id: organization.id,
    slug: slug,
    name: name,
    created_by: by,
    created_at: Metro.Clock.milliseconds()
  }
  return Database.insert(DB.Schema.Organizations)
    .values(row)
    .run
    .map { |_| organization }
end

# The organization at this address, or `None`.
foul findBySlug(slug: String) -> Organization? or! String do
  return Database.select().from(DB.Schema.Organizations)
    .where(DB.Schema.Organizations.slug == slug)
    .first(as: Organization)
end

# The organization with this id, or `None`.
foul find(id: OrganizationId) -> Organization? or! String do
  return Database.select().from(DB.Schema.Organizations)
    .where(DB.Schema.Organizations.id == id)
    .first(as: Organization)
end

foul all() -> [Organization] or! String do
  return Database.select().from(DB.Schema.Organizations)
    .orderBy([:name, :id])
    .all(as: Organization)
end
