# Organizations.
#
#   DB.Repositories.Organizations.addressed("acme")
module DB.Repositories.Organizations

using Harmat.Database, as: Database
using App.Models.Organization, only: [Organization]

# Creates an organization. Fails when the address is taken: the unique
# index on `slug` decides.
foul chartered(name: String, slug: String, by: String) -> Result<Organization, String> do
  let organization = Organization {
    id: Metro.Id.generate(prefix: "o"),
    slug: slug,
    name: name
  }
  let row = {
    id: organization.id,
    slug: slug,
    name: name,
    created_by: by,
    created_at: "${DateTime.utcNow()}"
  }
  return Database.insert(DB.Schema.Organizations)
    .values(row)
    .run
    .map { |_| organization }
end

# The organization at this address, or `None`.
foul addressed(slug: String) -> Result<Organization?, String> do
  return Database.findBy(DB.Schema.Organizations, {slug: slug}, into: Organization { id: "" })
end

# The organization with this id, or `None`.
foul identified(id: String) -> Result<Organization?, String> do
  return Database.find(DB.Schema.Organizations, id, into: Organization { id: "" })
end
