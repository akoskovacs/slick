# Who may do what. One place: every check in Slick is a call here, over the
# grants table — a user's role comes from their own grants and from the
# grants of every team they are in (a team owning a channel hands its
# members that channel). See docs/permissions.md for the matrix.
#
# A bot is a user; whether it may read a conversation is decided here, and
# a channel's bot read-scope (none | mentions | all) is layered on top, at
# the API and the events stream, not here.
module App.Services.Authority

using App.Models.User, only: [User, UserId]
using App.Models.User, as: User
using App.Models.Conversation, only: [Conversation, ConversationId]
using App.Models.Organization, only: [OrganizationId]
using App.Models.Team, only: [TeamId]
using App.Models.Message, only: [MessageId]
using App.Models.Grant, only: [Grant, GrantResourceType, GrantRole, UserSubject, TeamSubject, OrganizationResource, ConversationResource, Admin, Member, ReadOnly]
using App.Models.Grant, as: Grant
using DB.Repositories.Grants, as: Grants

# The strongest role a user — by id — holds over a resource, directly or
# through a team they are in; `None` for none.
foul role(userId: UserId, resourceType: GrantResourceType, resourceId: String) -> GrantRole? do
  let teams : [TeamId] = Grants.teamsOf(userId).or([])
  return roleAmong(userId, teams, Grants.over(resourceType, resourceId).or([]))
end

# The conversations of these the user may read, as `canRead` decides for
# each — with the grants that takes read once for all of them.
foul readable(user: User, conversations: [Conversation]) -> [Conversation] do
  return conversations if user.serverAdmin?
  let teams : [TeamId] = Grants.teamsOf(user.id).or([])
  let organizationIds : [OrganizationId] = conversations
    .filter { |conversation| !conversation.direct? && conversation.public? }
    .map { |conversation| conversation.organizationId }
    .uniq
  let privateIds : [ConversationId] = conversations
    .filter { |conversation| !conversation.direct? && !conversation.public? }
    .map { |conversation| conversation.id }
  let overOrganizations : {OrganizationId: [Grant]} = Grants.overEach(Grant.OrganizationResource, organizationIds).or({})
  let overConversations : {ConversationId: [Grant]} = Grants.overEach(Grant.ConversationResource, privateIds).or({})
  return conversations.filter do |conversation|
    let over = conversation.public?
      then overOrganizations.get(conversation.organizationId).or([])
      else overConversations.get(conversation.id).or([])
    conversation.direct?
      then conversation.firstUser == user.id || conversation.secondUser == user.id
      else roleAmong(user.id, teams, over).set?
  end
end

# The administrators of an organization, by id.
foul admins(organizationId: OrganizationId) -> [UserId] do
  return Grants.roleHolders(OrganizationResource, organizationId, Admin).or([])
end

# Whether a bot may read a conversation's thread — `root` "" for its newest
# messages — given what the conversation lets its bots read. A person is
# never gated here, and a private chat is the bot's own.
foul botMayRead(bot: User, conversation: Conversation, root: MessageId) -> Bool do
  return true if !bot.bot?
  return true if conversation.direct?
  return false if conversation.botsForbidden?
  return true if conversation.botsAll?
  return false if root.empty?

  match DB.Repositories.Messages.find(root) do
    Ok(Just(message)) => do
      return true if User.mentioned?(bot.name, message.body)
      return DB.Repositories.Messages.botAuthors(root, [bot.id]).or([]).count > 0
    end
    _ => return false
  end
end

# Whether the user may make a channel or a team in an organization.
foul canCreate(user: User, organizationId: OrganizationId) -> Bool do
  return true if user.serverAdmin?
  let at = role(user.id, OrganizationResource, organizationId)
  return at == Just(Member) || at == Just(Admin)
end

# Whether the user administers an organization: invites, bots, teams,
# channels.
foul canManage(user: User, organizationId: OrganizationId) -> Bool do
  return true if user.serverAdmin?
  return role(user.id, OrganizationResource, organizationId) == Just(Admin)
end

# Whether the user may read a conversation.
foul canRead(user: User, conversation: Conversation) -> Bool do
  return true if user.serverAdmin?
  if conversation.direct?
    return conversation.firstUser == user.id || conversation.secondUser == user.id
  end
  if conversation.public?
    return role(user.id, OrganizationResource, conversation.organizationId).set?
  end
  return role(user.id, ConversationResource, conversation.id).set?
end

# Whether the user may say something in a conversation.
foul canWrite(user: User, conversation: Conversation) -> Bool do
  return true if user.serverAdmin?
  if conversation.direct?
    return conversation.firstUser == user.id || conversation.secondUser == user.id
  end
  if conversation.public?
    let inOrg = role(user.id, OrganizationResource, conversation.organizationId)
    return inOrg == Just(Member) || inOrg == Just(Admin)
  end
  let inConversation = role(user.id, ConversationResource, conversation.id)
  return inConversation == Just(Member) || inConversation == Just(Admin)
end

# Whether the user may manage a conversation — its topic, its members, its
# bot access.
foul canAdminister(user: User, conversation: Conversation) -> Bool do
  return true if user.serverAdmin?
  if role(user.id, OrganizationResource, conversation.organizationId) == Just(Admin)
    return true
  end
  return role(user.id, ConversationResource, conversation.id) == Just(Admin)
end

private do
  # The strongest role a user holds among some grants: their own, or one of
  # their teams'.
  roleAmong : UserId -> [TeamId] -> [Grant] -> GrantRole?
  let roleAmong(userId, teams, grants) do
    let roles = grants.flatMap do |grant|
      let held = grant.subjectType == UserSubject && grant.subjectId == userId
      let viaTeam = grant.subjectType == TeamSubject && teams.contains?(grant.subjectId)
      held || viaTeam then [grant.role] else []
    end
    strongest(roles)
  end

  # The strongest of some roles: admin, else member, else read-only.
  strongest : [GrantRole] -> GrantRole?
  let strongest(roles) do
    return Just(Admin) if roles.contains?(Admin)
    return Just(Member) if roles.contains?(Member)
    return Just(ReadOnly) if roles.contains?(ReadOnly)
    return None
  end
end
