# The whole of Slick as one live view: what each browser event does to a
# tab's state and to what is stored, and the markup that results.
# `Metro.Live.Socket` runs these two functions against a WebSocket
# (config/routes.kex).
#
# Every event is checked here against who sent it. A tab names an
# organization and a conversation by id, and an id is not a permission:
# `home` only ever answers with an organization its person is in, and
# `visible` only with a conversation of that organization they may read.
# Both are asked before anything is read or written, so the id of another
# organization's channel, or of somebody else's private chat, gets a tab
# nothing.
module App.Live.Chat

using Metro.Live.Presence, only: [Presence, Note]
using Metro.Live.Socket, only: [field]
using Metro.Validation, only: [rules, validates, present, sized, passing]
using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Message, only: [Message]
using App.Models.Organization, only: [Organization]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Memberships, as: Memberships
using DB.Repositories.Messages, as: Messages
using DB.Repositories.Organizations, as: Organizations
using DB.Repositories.Reactions, as: Reactions
using DB.Repositories.Users, as: Users

# How many messages of a conversation a tab is shown.
let WINDOW = 200

# What the first channel of an organization is about, until somebody says.
let GENERAL_TOPIC = "Company-wide announcements and chatter"

let channelRules = rules do
  validates("title", "A channel name", [
    present, sized(2, 30),
    passing("may only have lower-case letters, digits and dashes.") { |text| text.chars.all? { |char| char.lower? || char.digit? || "${char}" == "-" } }
  ])
end

let messageRules = rules do
  validates("body", "A message", [present, sized(1, App.Models.Message.LONGEST)])
end

let topicRules = rules do
  validates("topic", "A topic", [sized(0, 250)])
end

let organizationRules = rules do
  validates("name", "A name", [present, sized(2, 40)])
end

# The live region for one person's tab, as things are stored right now.
#
# `statuses` is the board of what people are in the middle of — typing, or
# whatever a bot says it is doing: `Metro.Live.Presence`.
markup : Server<Presence> -> User -> Tab -> String
foul markup(statuses, user, tab) do
  match home(user, tab) do
    None => return App.Views.Chat.welcome(tab, user)
    Just(organization) => do
      let mine : [Organization] = organizations(user)
      let roster : [String] = Memberships.roster(organization.id).or([])
      let everyone : [User] = Users.everyone.or([])
      let people = everyone.filter { |person| roster.contains?(person.id) }
      let channels : [Conversation] = Conversations.channels(organization.id).or([])
      let now = BEAM.erlang.system_time(:millisecond)
      let online : [String] = Metro.Live.Presence.standing(statuses, ONLINE, now).map { |note| note.member.split(" ").first.or("") }
      let bots : [User] = tab.dialog == "bots" then manageable(user, organization) else []
      match visible(user, tab) do
        None => return App.Views.Chat.index(tab, user, mine, organization, channels, people, online, bots, None, [], [], [], [])
        Just(conversation) => do
          let messages : [Message] = Messages.latest(conversation.id, WINDOW).or([])
          let reactions = Reactions.throughout(conversation.id).or([])
          let doing : [Note] = Metro.Live.Presence.standing(statuses, conversation.id, now)
          return App.Views.Chat.index(tab, user, mine, organization, channels, people, online, bots, Just(conversation), messages, reactions, unfolded(conversation, tab.thread), doing.reject { |note| note.member == user.id })
        end
      end
    end
  end
end

# Applies one event: the tab's next state, and whether something other tabs
# show was changed — in which case they are told to refresh.
handled : Server<Presence> -> User -> Tab -> [(String, String?)] -> (Tab, Bool)
foul handled(statuses, user, tab, entries) do
  match field(entries, "event") do
    "open" => opened(user, tab, field(entries, "id"))
    "direct" => whispered(user, tab, field(entries, "user"))
    "found" => (Tab { ...settled(tab), dialog: "channel" }, false)
    "create" => established(user, tab, field(entries, "title").trim.lowerCase)
    "send" => sent(statuses, user, tab, field(entries, "body").trim)
    "typing" => typing(statuses, user, tab)
    "retitle" => (Tab { ...settled(tab), retitling?: true }, false)
    "topic" => retitled(user, tab, field(entries, "topic").trim)
    "react" => reacted(user, tab, field(entries, "message"), field(entries, "emoji"))
    "cancel" => (settled(tab), false)
    "thread" => threaded(user, tab, field(entries, "message"))
    "unthread" => (Tab { organization: tab.organization, conversation: tab.conversation }, false)
    "reply" => replied(statuses, user, tab, field(entries, "body").trim)
    "visit" => (arrived(user, field(entries, "path")), false)
    "organization" => switched(user, tab, field(entries, "id"))
    "organize" => (Tab { ...settled(tab), dialog: "organization" }, false)
    "charter" => organized(user, tab, field(entries, "name").trim)
    "invite" => (Tab { ...settled(tab), dialog: "invite" }, false)
    "enlist" => invited(user, tab, field(entries, "email").trim.lowerCase)
    "status" => (Tab { ...settled(tab), dialog: "status" }, false)
    "status-set" => restyled(user, tab, field(entries, "emoji").trim, field(entries, "text").trim)
    "status-clear" => restyled(user, tab, "", "")
    "bots" => (Tab { ...settled(tab), dialog: "bots" }, false)
    "bot-create" => botMade(user, tab, field(entries, "name").trim, field(entries, "owner"))
    "bot-rekey" => botRenewed(user, tab, field(entries, "id"))
    "bot-enlist" => botBrought(user, tab, field(entries, "id"))
    _ => (tab, false)
  end
end

# The topic, on the statuses board, of who has a tab open. A member there is
# "<user id> <something of the tab's own>", so that closing one of two tabs
# does not make somebody look gone.
let ONLINE = "online"

# Somebody's tab has opened, or closed.
arriving : Server<Presence> -> User -> String -> Void
foul arriving(statuses, user, seat) do
  statuses.noted(ONLINE, "${user.id} ${seat}", "", BEAM.erlang.system_time(:millisecond) + 86400000)
end

leaving : Server<Presence> -> User -> String -> Void
foul leaving(statuses, user, seat) do
  statuses.lifted(ONLINE, "${user.id} ${seat}")
end

# How long "is typing" stands after a keystroke is heard of, in milliseconds.
# The browser says so again every three seconds while it goes on.
let TYPING_FOR = 6000

# Says what somebody is doing in the conversation their tab is showing, for
# `milliseconds`; "" takes it back. Whether there was a conversation to say
# it in.
noting : Server<Presence> -> User -> Tab -> String -> Integer -> Bool
foul noting(statuses, user, tab, text, milliseconds) do
  match visible(user, tab) do
    None => return false
    Just(conversation) => do
      if milliseconds <= 0
        statuses.lifted(conversation.id, user.id)
      else
        statuses.noted(conversation.id, user.id, text, BEAM.erlang.system_time(:millisecond) + milliseconds)
      end
      return true
    end
  end
end

# The tab for an address (App.Paths): a channel or a private chat of an
# organization, either with `?thread=<message>`. Anything else, or a place
# this person may not be, is the tab everyone starts with. A private chat is
# started by going to it.
arrived : User -> String -> Tab
foul arrived(user, location) do
  let thread = Metro.Path.query(location, "thread").or("")
  match App.Paths.channelPath.captured(location) do
    Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
      None => return Tab {}
      Just(organization) => match Conversations.channelCalled(organization.id, parts.get("name").or("")) do
        Ok(Just(channel)) => return Tab { organization: organization.id, conversation: channel.id, thread: thread }
        _ => return Tab { organization: organization.id }
      end
    end
    None => match App.Paths.directPath.captured(location) do
      None => return Tab {}
      Just(parts) => match memberOrganization(user, parts.get("organization").or("")) do
        None => return Tab {}
        Just(organization) => do
          let (chat, _) = whispered(user, Tab { organization: organization.id }, parts.get("person").or(""))
          return Tab { organization: organization.id, conversation: chat.conversation, thread: thread }
        end
      end
    end
  end
end

# The organization at an address, if this person is in it.
memberOrganization : User -> String -> Organization?
foul memberOrganization(user, slug) do
  match Organizations.addressed(slug) do
    Ok(Just(organization)) => return Memberships.affiliated?(organization.id, user.id) then Just(organization) else None
    _ => return None
  end
end

# The organization a tab is in: the one it names, if its person is in it,
# and otherwise the first one they are in. `None` is somebody in none.
home : User -> Tab -> Organization?
foul home(user, tab) do
  let mine : [String] = Memberships.affiliations(user.id).or([])
  let chosen = mine.contains?(tab.organization) then tab.organization else mine.first.or("")
  return None if chosen.empty?

  match Organizations.identified(chosen) do
    Ok(Just(organization)) => return Just(organization)
    _ => return None
  end
end

# The conversation a tab is showing, if its person may read it: it has to be
# in the tab's organization, and theirs to read there.
visible : User -> Tab -> Conversation?
foul visible(user, tab) do
  match home(user, tab) do
    None => return None
    Just(organization) => do
      let found = tab.conversation.empty? then Conversations.channelCalled(organization.id, App.Models.Conversation.GENERAL) else Conversations.lookup(tab.conversation)
      match found do
        Ok(Just(conversation)) => do
          return None if conversation.organizationId != organization.id || !conversation.admits?(user.id)
          return Just(conversation)
        end
        _ => return None
      end
    end
  end
end

# The organizations a person is in, oldest membership first.
organizations : User -> [Organization]
foul organizations(user) do
  let mine : [String] = Memberships.affiliations(user.id).or([])
  return mine.flatMap { |id|
    match Organizations.identified(id) do
      Ok(Just(organization)) => [organization]
      _ => []
    end
  }
end

private do
  # A tab with nothing open over the conversation: no form, no dialog, no
  # message left from the last thing tried.
  settled : Tab -> Tab
  let settled(tab) = Tab { organization: tab.organization, conversation: tab.conversation, thread: tab.thread }

  switched : User -> Tab -> String -> (Tab, Bool)
  foul switched(user, tab, id) do
    return (tab, false) if !Memberships.affiliated?(id, user.id)
    return (Tab { organization: id }, false)
  end

  # Creates an organization with its first member and its #general.
  organized : User -> Tab -> String -> (Tab, Bool)
  foul organized(user, tab, name) do
    let refused = Tab { ...settled(tab), dialog: "organization" }
    let problems = Metro.Validation.checked(organizationRules, {"name": name}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    let slug = App.Models.Organization.slugged(name)
    return (Tab { ...refused, dialogProblem: "A name needs at least two letters or digits." }, false) if slug.chars.count < 2
    return (Tab { ...refused, dialogProblem: "${name} cannot be used as a name. Try another." }, false) if App.Models.Organization.RESERVED.contains?(slug)

    match Organizations.chartered(name, slug, user.id) do
      Error(_) => return (Tab { ...refused, dialogProblem: "There is already an organization called ${name}." }, false)
      Ok(organization) => do
        Memberships.enlisted(organization.id, user.id)
        let general : Result<Conversation, String> = Conversations.founded(organization.id, App.Models.Conversation.GENERAL, user.id)
        if general.ok?
          let channel : Conversation = general.try
          Conversations.retitled(channel.id, GENERAL_TOPIC)
        end
        return (Tab { organization: organization.id }, true)
      end
    end
  end

  # Puts somebody who has registered into the tab's organization.
  invited : User -> Tab -> String -> (Tab, Bool)
  foul invited(user, tab, email) do
    let refused = Tab { ...settled(tab), dialog: "invite" }
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => match Users.credentials(email) do
        Ok(Just((person, _))) => match Memberships.enlisted(organization.id, person.id) do
          Ok(_) => return (Tab { ...settled(tab), notice: "${person.shown} is now in ${organization.name}." }, true)
          Error(_) => return (Tab { ...refused, dialogProblem: "${person.shown} is already in ${organization.name}." }, false)
        end
        _ => return (Tab { ...refused, dialogProblem: "Nobody has registered with ${email}. They need an account first." }, false)
      end
    end
  end

  let botRules = rules do
    validates("name", "A bot's name", [present, sized(2, 40)])
  end

  # Makes a bot of this person's, in the tab's organization. Its token is
  # kept in the tab, to be shown until the dialog is closed, and nowhere else.
  # The bots a person may look after from a tab: their own, and those of
  # the organization the tab is in.
  manageable : User -> Organization -> [User]
  foul manageable(user, organization) do
    let own : [User] = Users.operated(user.id).or([])
    let shared : [User] = Users.maintained(organization.id).or([])
    return shared + own
  end

  # `owner` is "me" for a bot of this person's own; anything else makes it
  # the organization's.
  botMade : User -> Tab -> String -> String -> (Tab, Bool)
  foul botMade(user, tab, name, owner) do
    let refused = Tab { ...settled(tab), dialog: "bots" }
    let problems = Metro.Validation.checked(botRules, {"name": name}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => match App.Services.Bots.built(user, owner == "me" then "" else organization.id, name) do
        Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        Ok((bot, token)) => do
          Memberships.enlisted(organization.id, bot.id)
          return (Tab { ...refused, secret: token, secretFor: bot.name }, true)
        end
      end
    end
  end

  botRenewed : User -> Tab -> String -> (Tab, Bool)
  foul botRenewed(user, tab, id) do
    let refused = Tab { ...settled(tab), dialog: "bots" }
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        let named = manageable(user, organization).find { |bot| bot.id == id }.map { |bot| bot.name }.or("the bot")
        match App.Services.Bots.renewed(user, organization.id, id) do
          Ok(token) => return (Tab { ...refused, secret: token, secretFor: named }, false)
          Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
        end
      end
    end
  end

  # Puts one of this person's bots into the tab's organization.
  botBrought : User -> Tab -> String -> (Tab, Bool)
  foul botBrought(user, tab, id) do
    let refused = Tab { ...settled(tab), dialog: "bots" }
    let owned : [User] = Users.operated(user.id).or([])
    return (Tab { ...refused, dialogProblem: "That is not one of your bots." }, false) if !owned.any? { |bot| bot.id == id }

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        Memberships.enlisted(organization.id, id)
        return (refused, true)
      end
    end
  end

  let statusRules = rules do
    validates("text", "A status", [sized(0, 80)])
  end

  # What somebody says about themselves: an emoji Slick offers, and a few
  # words. Both empty takes it back.
  restyled : User -> Tab -> String -> String -> (Tab, Bool)
  foul restyled(user, tab, emoji, saying) do
    let refused = Tab { ...settled(tab), dialog: "status" }
    let problems = Metro.Validation.checked(statusRules, {"text": saying}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?
    return (Tab { ...refused, dialogProblem: "Pick one of the emoji offered." }, false) if !App.Models.Emoji.status?(emoji)

    match Users.restyled(user.id, emoji, saying) do
      Ok(_) => return (settled(tab), true)
      Error(reason) => return (Tab { ...refused, dialogProblem: reason }, false)
    end
  end

  # Somebody is typing: said for a few seconds, to everyone else there.
  typing : Server<Presence> -> User -> Tab -> (Tab, Bool)
  foul typing(statuses, user, tab) = (tab, noting(statuses, user, tab, "", TYPING_FOR))

  # The message that starts the thread this message is in — itself, when it
  # is not a reply — if it belongs to this conversation.
  rooted : Conversation -> String -> Message?
  foul rooted(conversation, id) do
    return None if id.empty?

    match Messages.single(id) do
      Ok(Just(message)) => do
        return None if message.conversationId != conversation.id
        return Just(message) if message.parentId.empty?
        return rooted(conversation, message.parentId)
      end
      _ => return None
    end
  end

  # An open thread: the message that started it, then its replies. Empty
  # when no thread is open, or the one asked for is not in this conversation.
  unfolded : Conversation -> String -> [Message]
  foul unfolded(conversation, id) do
    match rooted(conversation, id) do
      None => return []
      Just(first) => do
        let replies : [Message] = Messages.answering(first.id).or([])
        return [first] + replies
      end
    end
  end

  threaded : User -> Tab -> String -> (Tab, Bool)
  foul threaded(user, tab, id) do
    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match rooted(conversation, id) do
        Just(first) => return (Tab { ...settled(tab), thread: first.id }, false)
        None => return (tab, false)
      end
    end
  end

  # A reply goes into the thread the tab has open, and nowhere else.
  replied : Server<Presence> -> User -> Tab -> String -> (Tab, Bool)
  foul replied(statuses, user, tab, body) do
    let problems = Metro.Validation.checked(messageRules, {"body": body}).messages
    return (tab, false) if !problems.empty?

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match rooted(conversation, tab.thread) do
        None => return (tab, false)
        Just(first) => match Messages.said(conversation.id, user.id, body, first.id) do
          Ok(_) => do
            statuses.lifted(conversation.id, user.id)
            return (Tab { ...settled(tab), thread: first.id }, true)
          end
          Error(reason) => return (Tab { ...settled(tab), failure: "Not sent: ${reason}" }, false)
        end
      end
    end
  end

  opened : User -> Tab -> String -> (Tab, Bool)
  foul opened(user, tab, id) do
    return (tab, false) if id.empty?

    match visible(user, Tab { organization: tab.organization, conversation: id }) do
      Just(conversation) => return (Tab { organization: conversation.organizationId, conversation: conversation.id }, false)
      None => return (tab, false)
    end
  end

  # Opens the private chat with another person of the organization, starting
  # it if need be.
  whispered : User -> Tab -> String -> (Tab, Bool)
  foul whispered(user, tab, other) do
    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => do
        return (tab, false) if other == user.id || !Memberships.affiliated?(organization.id, other)

        match Conversations.between(organization.id, user.id, other) do
          Ok(conversation) => return (Tab { organization: organization.id, conversation: conversation.id }, false)
          Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
        end
      end
    end
  end

  # Not called `founded`: a function here with the name and the number of
  # arguments of a repository method makes the call to that method lose an
  # argument when compiled, and fail as `undef` when run (kexhq/kex#451).
  established : User -> Tab -> String -> (Tab, Bool)
  foul established(user, tab, title) do
    let refused = Tab { ...settled(tab), dialog: "channel" }
    let problems = Metro.Validation.checked(channelRules, {"title": title}).messages
    return (Tab { ...refused, dialogProblem: problems.first.or("") }, false) if !problems.empty?

    match home(user, tab) do
      None => return (tab, false)
      Just(organization) => match Conversations.founded(organization.id, title, user.id) do
        Ok(channel) => return (Tab { organization: organization.id, conversation: channel.id }, true)
        Error(_) => return (Tab { ...refused, dialogProblem: "There is already a channel called ${title}." }, false)
      end
    end
  end

  sent : Server<Presence> -> User -> Tab -> String -> (Tab, Bool)
  foul sent(statuses, user, tab, body) do
    let problems = Metro.Validation.checked(messageRules, {"body": body}).messages
    return (tab, false) if !problems.empty?

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match Messages.said(conversation.id, user.id, body, "") do
        Ok(_) => do
          # Whatever they were said to be doing, they have done.
          statuses.lifted(conversation.id, user.id)
          return (settled(tab), true)
        end
        Error(reason) => return (Tab { ...settled(tab), failure: "Not sent: ${reason}" }, false)
      end
    end
  end

  retitled : User -> Tab -> String -> (Tab, Bool)
  foul retitled(user, tab, topic) do
    let problems = Metro.Validation.checked(topicRules, {"topic": topic}).messages
    return (Tab { ...settled(tab), retitling?: true, failure: problems.first.or("") }, false) if !problems.empty?

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match Conversations.retitled(conversation.id, topic) do
        Ok(changed) => return (settled(tab), changed)
        Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
      end
    end
  end

  # A reaction goes on a message of the conversation the tab is showing, and
  # nowhere else: the message is looked up, and has to belong to it.
  reacted : User -> Tab -> String -> String -> (Tab, Bool)
  foul reacted(user, tab, messageId, emoji) do
    return (tab, false) if !App.Models.Emoji.reaction?(emoji)

    match visible(user, tab) do
      None => return (tab, false)
      Just(conversation) => match Messages.single(messageId) do
        Ok(Just(message)) => do
          return (tab, false) if message.conversationId != conversation.id
          match Reactions.flipped(message, user.id, emoji) do
            Ok(_) => return (tab, true)
            Error(reason) => return (Tab { ...settled(tab), failure: reason }, false)
          end
        end
        _ => return (tab, false)
      end
    end
  end
end
