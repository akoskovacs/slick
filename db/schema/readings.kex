# The `readings` table. See db/migrate/N0015_create_readings.kex and
# N0016_add_reading_threads.kex.
module DB.Schema.Readings

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :readings, doc: "How far each person has read in each conversation, and in each thread they follow" do |t|
  t.text(:id, primaryKey: true)
  t.belongsTo(:user, :users)
  t.belongsTo(:conversation, :conversations)
  t.bigint(:read_at, doc: "A message's sent_at, in milliseconds since 1970")
  t.belongsTo(:thread, :messages, default: "", doc: "The message a followed thread starts with; empty for the conversation itself")
end

let table = DB.Schema.Readings.definition.table

let id = DB.Schema.Readings.definition.textColumn(:id)
let userId = DB.Schema.Readings.definition.textColumn(:user_id)
let conversationId = DB.Schema.Readings.definition.textColumn(:conversation_id)
let readAt = DB.Schema.Readings.definition.wholeColumn(:read_at)
