# The `conversations` table: channels, private chats and group chats. See
# db/migrate/N0004_create_conversations.kex and N0021_add_groups.kex.
module DB.Schema.Conversations

using App.Models.Conversation, only: [Conversation]
using App.Models.Conversation, as: Conversation
using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

# Known while compiling: a query over this table is written then.
compiled do
  let definition = Table.define :conversations do |t|
    t.text(:id, primaryKey: true)
    t.text(:kind, oneOf: Harmat.Column.choices(Type.of(Conversation.Channel)))
    t.text(:slug)
    t.text(:title, default: "")
    t.text(:topic, default: "")
    t.text(:first_user, default: "")
    t.text(:second_user, default: "")
    t.text(:created_by, default: "")
    t.bigint(:created_at)
    t.text(:organization_id, default: "")
    t.text(:access, default: "public", oneOf: Harmat.Column.choices(Type.of(Conversation.Public)))
    t.text(:team_id, default: "")
    t.text(:bot_access, default: "mentions", oneOf: Harmat.Column.choices(Type.of(Conversation.NoBots)))
  end

  let id = definition.textColumn(:id)
  let kind = definition.textColumn(:kind)
  let slug = definition.textColumn(:slug)
  let title = definition.textColumn(:title)
  let topic = definition.textColumn(:topic)
  let firstUser = definition.textColumn(:first_user)
  let secondUser = definition.textColumn(:second_user)
  let createdAt = definition.wholeColumn(:created_at)
  let organizationId = definition.textColumn(:organization_id)
  let access = definition.textColumn(:access)
  let teamId = definition.textColumn(:team_id)
  let botAccess = definition.textColumn(:bot_access)
end
