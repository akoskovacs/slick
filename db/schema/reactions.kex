# The `reactions` table.
module DB.Schema.Reactions

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

# Known while compiling: a query over this table is written then.
let definition = Table.define :reactions do |t|
  t.text(:id, primaryKey: true)
  t.text(:conversation_id)
  t.text(:message_id)
  t.text(:user_id)
  t.text(:emoji)
end

let id = definition.textColumn(:id)
let conversationId = definition.textColumn(:conversation_id)
let messageId = definition.textColumn(:message_id)
let userId = definition.textColumn(:user_id)
let emoji = definition.textColumn(:emoji)
