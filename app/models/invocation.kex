# A slash command somebody used — `/mode`, to opencode — where they used
# it. It is not a message: it is shown as what happened, and told to the
# bot it was for, which answers as it likes.
module App.Models.Invocation

using App.Models.Conversation, only: [ConversationId]
using App.Models.Message, only: [MessageId]
using App.Models.Organization, only: [OrganizationId]
using App.Models.Ids, only: [UserId]

distinct type InvocationId = String
make InvocationId do
  let empty? -> Bool = this.as(String).empty?
end
record Invocation do
  id : InvocationId
  organizationId : OrganizationId
  conversationId : ConversationId
  # The message the thread starts with; "" in the conversation itself.
  threadId : MessageId = "".as(MessageId)
  botId : UserId
  userId : UserId
  # Without the slash: "mode".
  command : String
  # What was written after it: "auto", or "".
  arguments : String = ""
  # Milliseconds since 1970.
  invokedAt : Integer = 0
end
