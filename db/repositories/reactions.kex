# Emoji on messages.
#
#   DB.Repositories.Reactions.toggle(message, user.id, "🎉")
module DB.Repositories.Reactions

using Harmat.Database, as: Database
using App.Models.Message, only: [Message]
using App.Models.Reaction, only: [Reaction]
using App.Models.Conversation, only: [ConversationId]
using App.Models.User, only: [UserId]

# Every reaction in a conversation.
foul inConversation(conversationId: ConversationId) -> [Reaction] or! String do
  return Database.select().from(DB.Schema.Reactions)
    .where(DB.Schema.Reactions.conversationId == conversationId)
    .all(as: Reaction)
end

# Puts a person's emoji on a message, or takes it off if it is there.
# Whether it is on afterwards.
foul toggle(message: Message, userId: UserId, emoji: String) -> Bool or! String do
  let id = "${message.id}:${userId}:${emoji}"
  let existing = Database.select([:id]).from(DB.Schema.Reactions)
    .where(DB.Schema.Reactions.id == id)
    .first
  match existing do
    Error(reason) => return Error(reason)
    Ok(Just(_)) => do
      return Database.delete(DB.Schema.Reactions)
        .where(DB.Schema.Reactions.id == id)
        .run
        .map { |_| false }
    end
    Ok(None) => do
      let row = {
        id: id,
        conversation_id: message.conversationId,
        message_id: message.id,
        user_id: userId,
        emoji: emoji
      }
      return Database.insert(DB.Schema.Reactions)
        .values(row)
        .run
        .map { |_| true }
    end
  end
end
