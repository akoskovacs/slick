---
params: [bubble: Bubble, chips: String, offers: String]
---
<article class="message<% if bubble.own? %> own<% end %><% if bubble.continued? %> continued<% end %>" id="<%= bubble.anchor %>">
<% if bubble.continued? %>
  <time class="gutter"><%= bubble.stamp %></time>
<% else %>
  <span class="avatar tint-<%= bubble.tint %>" aria-hidden="true"><%= bubble.initial %></span>
<% end %>
  <div class="said">
<% if !bubble.continued? %>
    <p class="byline"><strong><%= bubble.author %></strong><% if !bubble.badged.empty? %> <span class="flag"><%= bubble.badged %></span><% end %> <time><%= bubble.stamp %></time></p>
<% end %>
    <div class="body"><%== bubble.content %></div>
    <div class="reactions"><%== chips %></div>
<% if !bubble.answers.empty? %>
    <button type="button" class="answers" data-event="thread" data-message="<%= bubble.key %>"><%= bubble.answers %></button>
<% end %>
  </div>
  <div class="offers"><%== offers %><% if bubble.threadable? %><button type="button" class="chip" data-event="thread" data-message="<%= bubble.key %>" title="Reply in thread">💬</button><% end %></div>
</article>
