---
params: [title: String, topic: String, channel?: Bool, retitling?: Bool, filing?: Bool, filed: String, note: String, admitting?: Bool, promotable?: Bool, botAccess: String, canAdminister: Bool, setting?: Bool]
---
<header class="heading">
  <div class="heading-row">
    <h1><%= title %></h1>
  </div>
  <% if retitling? %>
    <form class="topic-form" data-live="topic-set" data-live-quiet>
      <input name="topic" value="<%= topic %>" maxlength="250" placeholder="What is this channel about?" autocomplete="off">
      <button type="submit" class="primary">Save</button>
      <button type="button" class="quiet" data-event="cancel">Cancel</button>
    </form>
  <% elif channel? %>
    <p class="topic"><% if topic.empty? %>No topic yet<% else %><%= topic %><% end %>
      <button type="button" class="quiet" data-event="topic-edit">Edit topic</button>
    </p>
  <% end %>
  <% if !note.empty? %>
    <p class="topic"><%= note %>
    <% if admitting? %>
      <button type="button" class="quiet" data-event="dialog-open" data-dialog="admit">Add people</button>
    <% end %>
    <% if promotable? %>
      <button type="button" class="quiet" data-event="dialog-open" data-dialog="promote">Make it a channel</button>
    <% end %>
    </p>
  <% end %>
    <nav class="views" aria-label="Show">
      <button type="button" class="view<% if !filing? && !setting? %> current<% end %>"
        aria-pressed="<%= !filing? && !setting? %>" data-event="view-messages">Messages</button>
      <button type="button" class="view<% if filing? %> current<% end %>"
        aria-pressed="<%= filing? %>" data-event="view-files">Files<% if !filed.empty? %> <span class="tally"><%= filed %></span><% end %></button>
      <% if canAdminister %>
        <button type="button" class="view<% if setting? %> current<% end %>" aria-pressed="<%= setting? %>" data-event="view-settings" title="Conversation settings">Settings</button>
      <% end %>
    </nav>
</header>
