# The `grants` table: one role a subject holds over a resource. See
# db/migrate/N0022_create_grants.kex and docs/permissions.md.
module DB.Schema.Grants

using App.Models.Grant, only: [Grant]
using App.Models.Grant, as: Grant
using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

# Known while compiling: a query over this table is written then.
compiled do
  let definition = Table.define :grants do |t|
    t.text(:id, primaryKey: true)
    t.text(:subject_type, oneOf: Harmat.Column.choices(Type.of(Grant.UserSubject)))
    t.text(:subject_id)
    t.text(:resource_type, oneOf: Harmat.Column.choices(Type.of(Grant.ServerResource)))
    t.text(:resource_id, default: "")
    t.text(:role, oneOf: Harmat.Column.choices(Type.of(Grant.Admin)))
    t.bigint(:granted_at, default: 0)
  end

  let id = definition.textColumn(:id)
  let subjectType = definition.textColumn(:subject_type)
  let subjectId = definition.textColumn(:subject_id)
  let resourceType = definition.textColumn(:resource_type)
  let resourceId = definition.textColumn(:resource_id)
  let role = definition.textColumn(:role)
end
