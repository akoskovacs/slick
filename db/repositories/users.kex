# The people who can sign in.
#
#   UserRepository { db: db }.credentials(email)
module DB.Repositories.Users

using Harmat.Db, only: [Db, eq]
using App.Models.User, only: [User]

record UserRepository do
  db : Db
end

make UserRepository do
  # Stores a new user. Fails when the email is taken: the table's unique
  # index decides, so two registrations racing for one address cannot both win.
  foul enroll(user: User, passwordHash: String) -> Result<User, String> do
    let row = {id: user.id, email: user.email, name: user.name, password_hash: passwordHash, created_at: "${DateTime.utcNow()}"}
    return @db.insert(DB.Schema.Users.definition).values(row).run.map { |_| user }
  end

  # The user registered under an email, with their stored password line.
  foul credentials(email: String) -> Result<(User, String)?, String> do
    return @db.select().from(DB.Schema.Users.definition).where(eq(DB.Schema.Users.email, email)).first
      .map { |row| row.map { |found| (decoded(found), found.get("password_hash").or("")) } }
  end

  foul member(id: String) -> Result<User?, String> do
    return @db.select().from(DB.Schema.Users.definition).where(eq(DB.Schema.Users.id, id)).first
      .map { |row| row.map { |found| decoded(found) } }
  end

  # Everyone, by name: who can be written to, and whose name goes on a message.
  foul everyone -> Result<[User], String> do
    return @db.select([:id, :email, :name]).from(DB.Schema.Users.definition).orderBy([:name, :email]).all
      .map { |rows| rows.map { |row| decoded(row) } }
  end
end

private do
  decoded : {String: String} -> User
  let decoded(row) = User { id: row.get("id").or(""), email: row.get("email").or(""), name: row.get("name").or("") }
end
