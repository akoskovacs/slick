# A file somebody uploaded: its bytes are in `Metro.Storage` under its id.
# It is theirs alone until it is sent with a message into a conversation.
module App.Models.Attachment

using Units.Data
using App.Models.Conversation, only: [ConversationId]
using App.Models.Message, only: [MessageId]
using App.Models.Ids, only: [UserId]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Memberships, as: Memberships

distinct type AttachmentId = String
make AttachmentId do
  let empty? -> Bool = this.as(String).empty?
end
record Attachment do
  id : AttachmentId
  userId : UserId
  conversationId : ConversationId = ""
  messageId : MessageId = ""
  filename : String
  contentType : String
  byteSize : Integer
  checksum : String = ""
  # Milliseconds since 1970.
  uploadedAt : Integer = 0
end

make Attachment do
  # Whether it has been sent yet.
  let sent? -> Bool = !@messageId.empty?

  # Whether it is a picture a page can show.
  let picture? -> Bool = Metro.Storage.picture?(@contentType)

  # Whether it is text worth showing the start of.
  let textual? -> Bool = @contentType.startsWith?("text/") || @contentType == "application/json"

  # Where it is fetched from: the name at the end is for whoever saves it.
  let address -> String = "/files/${@id}"

  # Its size in words, to a tenth: "512 B", "4.3 KB", "1.5 MB" — decimal
  # units, as a file manager shows them.
  let sized -> String = @byteSize.byte
    .scaled
    .to(String, Number.format`#.#`)
    .or("${@byteSize} B")

  # The blob `Metro.Storage.served` answers with.
  let blob -> Metro.Storage.Blob = Metro.Storage.Blob {
    key: @id.as(String),
    filename: @filename,
    contentType: @contentType,
    byteSize: @byteSize,
    checksum: @checksum
  }

  # A file is private to its uploader until it has been sent; afterwards
  # only members who can read its conversation may fetch it.
  foul availableTo?(userId: UserId) -> Bool do
    return @userId == userId if !@sent?

    match Conversations.find(@conversationId) do
      Ok(Just(conversation)) =>
        Memberships.member?(conversation.organizationId, userId) && conversation.admits?(userId)
      _ => false
    end
  end
end
