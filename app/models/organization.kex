# A group of people with their own channels and private chats. Nothing in
# one organization can be seen from another.
module App.Models.Organization

using App.Models.Ids, only: [UserId]
using App.Models.Grant, only: [GrantRole]
using App.Models.Grant, as: Grant
using DB.Repositories.Grants, as: Grants

type OrganizationId = String
let GENERAL_TOPIC = "Company-wide announcements and chatter"
record Organization do
  id : OrganizationId
  # The name as it appears in addresses: /acme/channels/general.
  slug : String = ""
  name : String = ""
end

make Organization do
  # Whether this person belongs to the organization.
  foul member?(userId: UserId) -> Bool do
    return true if Grants.organizationsOf(userId).or([]).contains?(@id)

    let teams = Grants.teamsOf(userId).or([])
    return Grants.over(Grant.ServerResource, "").or([]).any? do |grant|
      grant.role == Grant.Admin && (
        (grant.subjectType == Grant.UserSubject && grant.subjectId == userId) ||
        (grant.subjectType == Grant.TeamSubject && teams.contains?(grant.subjectId))
      )
    end
  end

  # The address form of a name: its letters and digits, lower case.
  slugged : String -> String
  let slugged(name) do
    let slug = name.trim.lowerCase.chars.filter { |char| char.lower? || char.digit? }
    return slug.map { |char| "${char}" }.join("")
  end

  # The administrators of this organization, by id.
  foul admins -> [UserId] = Grants.roleHolders(Grant.OrganizationResource, @id, Grant.Admin).or([])

  # The role a person holds here, directly or through one of their teams.
  foul roleOf(userId: UserId) -> GrantRole? do
    let teams = Grants.teamsOf(userId).or([])
    Grant.roleFor(userId, teams, Grants.over(Grant.OrganizationResource, @id).or([]))
  end
end
