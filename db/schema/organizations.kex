# The `organizations` table. See db/migrate/N0008_create_organizations.kex.
module DB.Schema.Organizations

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

# The schema is shared by the repositories that query this table.
  let definition = Table.define :organizations do |t|
    t.text(:id, primaryKey: true)
    t.text(:slug)
    t.text(:name)
    t.text(:created_by, default: "")
    t.bigint(:created_at)
  end

  let id = definition.textColumn(:id)
  let slug = definition.textColumn(:slug)
