---
params: [heading: String, content: Block<String>]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= heading %> · Slick</title>
    <link rel="stylesheet" href="/app.css">
  </head>
  <body>
    <main class="auth">
      <span class="brand">Slick</span>
      <h1><%= heading %></h1>
      <%== content() %>
    </main>
  </body>
</html>
