# The `answers` table: answers to the forms in messages. See
# db/migrate/N0012_create_answers.kex.
module DB.Schema.Answers

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

# Known while compiling: a query over this table is written then.
let definition = Table.define :answers do |t|
  t.text(:id, primaryKey: true)
  t.text(:message_id)
  t.text(:conversation_id)
  t.text(:organization_id)
  t.text(:asker_id)
  t.text(:user_id)
  t.int(:form)
  t.text(:answer)
  t.bigint(:answered_at)
end

let id = definition.textColumn(:id)
let messageId = definition.textColumn(:message_id)
let conversationId = definition.textColumn(:conversation_id)
let organizationId = definition.textColumn(:organization_id)
let askerId = definition.textColumn(:asker_id)
let userId = definition.textColumn(:user_id)
