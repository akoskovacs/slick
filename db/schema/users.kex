# The `users` table. `password_hash` is a `Metro.Auth.Password` line, never a
# password; `name` is what a person is called in a conversation.
module DB.Schema.Users

using Harmat.Column, only: [Column, Characters, Wide, Flag]
using Harmat.Table, only: [Definition]
using App.Models.User, as: User

# The schema is shared by the repositories that query this table.
  let definition = Definition {
    label: "users",
    columns: [
      Column { label: "id", storage: Characters, key?: true },
      Column { label: "email", storage: Characters },
      Column { label: "password_hash", storage: Characters },
      Column { label: "created_at", storage: Wide },
      Column { label: "name", storage: Characters, fallback: Just("''") },
      Column { label: "kind", storage: Characters, fallback: Just(Harmat.Column.quoted(Harmat.Column.choices(Type.of(User.Person)).first.or(""))), allowed: Harmat.Column.choices(Type.of(User.Person)) },
      Column { label: "owner_id", storage: Characters, fallback: Just("''") },
      Column { label: "api_token_digest", storage: Characters, fallback: Just("''") },
      Column { label: "owner_organization_id", storage: Characters, fallback: Just("''") },
      Column { label: "status_emoji", storage: Characters, fallback: Just("''") },
      Column { label: "status_text", storage: Characters, fallback: Just("''") },
      Column { label: "title", storage: Characters, fallback: Just("''") },
      Column { label: "department", storage: Characters, fallback: Just("''") },
      Column { label: "bio", storage: Characters, fallback: Just("''") },
      Column { label: "nickname", storage: Characters, fallback: Just("''") },
      Column { label: "phone", storage: Characters, fallback: Just("''") },
      Column { label: "time_zone", storage: Characters, fallback: Just("''") },
      Column { label: "managed", storage: Characters, fallback: Just("''") },
      Column { label: "nickname_shown", storage: Flag, fallback: Just("FALSE") }
    ]
  }

  let id = definition.textColumn(:id)
  let email = definition.textColumn(:email)
  let passwordHash = definition.textColumn(:password_hash)
  let createdAt = definition.wholeColumn(:created_at)
  let name = definition.textColumn(:name)
  let kind = definition.textColumn(:kind)
  let ownerId = definition.textColumn(:owner_id)
  let apiTokenDigest = definition.textColumn(:api_token_digest)
  let ownerOrganizationId = definition.textColumn(:owner_organization_id)
