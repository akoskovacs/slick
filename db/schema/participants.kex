# The `participants` table: who is in a private channel or a group chat.
# See db/migrate/N0021_add_groups.kex.
module DB.Schema.Participants

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :participants do |t|
  t.text(:id, primaryKey: true)
  t.text(:conversation_id)
  t.text(:user_id)
  t.text(:joined_at)
end

let table = DB.Schema.Participants.definition.table

let id = DB.Schema.Participants.definition.textColumn(:id)
let conversationId = DB.Schema.Participants.definition.textColumn(:conversation_id)
let userId = DB.Schema.Participants.definition.textColumn(:user_id)
