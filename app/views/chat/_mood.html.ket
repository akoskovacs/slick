---
params: [presets: String, options: String, saying: String, problem: String]
---
<div class="backdrop">
  <section class="editor" id="editor" role="dialog" aria-modal="true" aria-label="Set a status">
    <h2>Set a status</h2>
    <p class="hint">An emoji and a few words beside your name, until you clear them.</p>
    <div class="presets"><%== presets %></div>
    <form class="asking" data-live="status-set" data-live-quiet>
      <div class="mood">
        <select name="emoji" aria-label="Emoji"><%== options %></select>
        <input name="text" value="<%= saying %>" placeholder="What are you up to?" maxlength="80" autocomplete="off">
      </div>
      <% if !problem.empty? %>
        <p class="problem" role="alert"><%= problem %></p>
      <% end %>
      <div class="actions">
        <button type="submit" class="primary">Save</button>
        <button type="button" class="quiet" data-event="status-clear">Clear status</button>
        <button type="button" class="quiet" data-event="cancel">Cancel</button>
      </div>
    </form>
  </section>
</div>
