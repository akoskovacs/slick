# One event from a tab, and whose tab it is: what every part of the live
# view is handed to answer (config/live.kex routes it).
module App.Live.Event

using Metro.Live.Presence, only: [Presence]
using Metro.Live.Socket, only: [field, repeated]
using App.Live.Tab, only: [Tab]
using App.Models.User, only: [User]

record Event do
  # Its whole name: "bot-create".
  name : String
  bus : Server<App.Live.Events.Bus>
  statuses : Server<Presence>
  user : User
  tab : Tab
  # What the browser sent with it.
  entries : [(String, String?)]
end

# Which part of Slick answers an event, by the first word of its name:
# config/live.kex. The root path segments are supplied by Metro.Router.
record Routes do
  handlers : [(String, String -> Event -> (Tab, Bool))]
  rootSegments : [String]
end

make Event do
  # What came with an event, as it was sent.
  let given(key: String) -> String = field(@entries, key)

  # A yes-or-no field of an event: anything the browser sends but "false"
  # is yes.
  let flag(key: String) -> Bool = given(key) != "false"

  # What came with an event, trimmed: what somebody typed.
  let typed(key: String) -> String = Metro.Live.Socket.typed(@entries, key)

  # Every value sent for a field of an event: the boxes ticked in a list.
  let picked(key: String) -> [String] = repeated(@entries, key)
end
