---
params: [heading: String, lead: String, verb: String, asked: String, hint: String, problem: String, label: String]
---
<div class="backdrop">
  <section class="editor" id="editor" role="dialog" aria-modal="true" aria-label="<%= heading %>">
    <h2><%= heading %></h2>
    <p class="hint"><%= lead %></p>
    <form class="asking" data-live="<%= verb %>" data-live-quiet>
      <input name="<%= asked %>" placeholder="<%= hint %>" maxlength="200" autocomplete="off">
      <% if !problem.empty? %>
        <p class="problem" role="alert"><%= problem %></p>
      <% end %>
      <div class="actions">
        <button type="submit" class="primary"><%= label %></button>
        <button type="button" class="quiet" data-event="cancel">Cancel</button>
      </div>
    </form>
  </section>
</div>
