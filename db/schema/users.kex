# The `users` table. `password_hash` is a `Metro.Auth.Password` line, never a
# password; `name` is what a person is called in a conversation.
module DB.Schema.Users

using App.Models.User, only: [User]
using App.Models.User, as: User
using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

# Known while compiling: a query over this table is written then.
let definition = Table.define :users do |t|
  t.text(:id, primaryKey: true)
  t.text(:email)
  t.text(:password_hash)
  t.bigint(:created_at)
  t.text(:name, default: "")
  t.text(:kind, default: "person", oneOf: Harmat.Column.choices(Type.of(User.Person)))
  t.text(:owner_id, default: "")
  t.text(:api_token_digest, default: "")
  t.text(:owner_organization_id, default: "")
  t.text(:status_emoji, default: "")
  t.text(:status_text, default: "")
  t.text(:title, default: "")
  t.text(:department, default: "")
  t.text(:bio, default: "")
  t.text(:nickname, default: "")
  t.text(:phone, default: "")
  t.text(:time_zone, default: "")
  t.text(:managed, default: "")
  t.boolean(:nickname_shown, default: false)
end

let id = definition.textColumn(:id)
let email = definition.textColumn(:email)
let passwordHash = definition.textColumn(:password_hash)
let createdAt = definition.wholeColumn(:created_at)
let name = definition.textColumn(:name)
let kind = definition.textColumn(:kind)
let ownerId = definition.textColumn(:owner_id)
let apiTokenDigest = definition.textColumn(:api_token_digest)
let ownerOrganizationId = definition.textColumn(:owner_organization_id)
