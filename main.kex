# Slick
#
#   tey server      http://localhost:4000 — migrates first, then serves
#   tey db:migrate  run the migrations this database has not run
#   tey db:rollback undo the newest migration; `tey db:rollback 3` undoes three
#   tey db:seed     migrate, then plant what a new database starts with
#   tey console     the application in Kex's REPL (bin/console)
#
# METRO_ENV says where this is running, and PORT and HOST move the listener
# (`Metro.Environment`); the environment and DATABASE_DSN choose the database
# (config/database.kex).

# Project modules are named in full here rather than brought in with `using`:
# with `src` linked to this directory, a `using` in the entrypoint finds each
# module twice and warns about it.

foul failed(reason: String) -> Void do
  IO.printError("slick: ${reason}")
  System.exit(1)
end

# Runs pending migrations and says which; whether it worked.
foul upToDate(store: Server<DB.Store.StoreState>) -> Bool do
  match DB.Store.migrate(store) do
    Ok(names) => do
      names.each { |name| IO.printLine("migrated ${name}") }
      return true
    end
    Error(reason) => do
      failed(reason)
      return false
    end
  end
end

foul undone(store: Server<DB.Store.StoreState>, count: Integer) -> Void do
  match DB.Store.rollback(store, count) do
    Ok([]) => IO.printLine("Nothing to roll back.")
    Ok(names) => names.each { |name| IO.printLine("rolled back ${name}") }
    Error(reason) => failed(reason)
  end
end

foul served(store: Server<DB.Store.StoreState>) -> Void do
  let port = Metro.Environment.port()
  let bindHost = Metro.Environment.host()
  let environment = Metro.Environment.current().map { |running| running.label }.or("")
  IO.printLine("Slick (${environment}) is on http://${bindHost == "0.0.0.0" then "localhost" else bindHost}:${port}")
  # Everything that serves is made in here, the routes included: this is
  # where the store becomes the database every query reaches.
  with Harmat.Connection = DB.Store.StoreConnection { store: store } do
    # Each request and live event, logged as configured (config/logging.kex).
    with Metro.Logger = Config.Logging.requests() do
      let hub = Process.spawn(Metro.Live.Hub.Hub {})
      let events = Process.spawn(App.Live.Events.Bus {})
      let statuses = Process.spawn(Metro.Live.Presence.Presence {})
      let probe = Config.Routes.routes(hub, events, statuses, [])
      let site = Config.Routes.routes(hub, events, statuses, probe.rootSegments)
      site.start(bindHost, port).try
    end
  end
end

# Plants this environment's seeds (db/seeds.kex) and says what they were.
foul seeded(store: Server<DB.Store.StoreState>) -> Void do
  with Harmat.Connection = DB.Store.StoreConnection { store: store } do
    match Metro.Environment.current() do
      Error(reason) => failed(reason)
      Ok(environment) => match DB.Seeds.planted(environment) do
        Ok([]) => IO.printLine("Nothing to seed.")
        Ok(lines) => lines.each { |line| IO.printLine("seeded ${line}") }
        Error(reason) => failed(reason)
      end
    end
  end
end

foul commanded(store: Server<DB.Store.StoreState>, args: [String]) -> Void do
  match args.first.or("server") do
    "server" => upToDate(store) then served(store) else ()
    "migrate" => upToDate(store) then IO.printLine("The database is up to date.") else ()
    "rollback" => undone(store, args.second.flatMap { |text| text.to(Integer) }.or(1))
    "seed" => upToDate(store) then seeded(store) else ()
    other => failed("unknown command ${other}; expected server, migrate, rollback or seed")
  end
end

# Queries are logged as configured (config/logging.kex) everywhere: the
# store is started inside, so what it runs in a transaction is logged too.
main(args) do
  with Harmat.Logger = Config.Logging.queries() do
    match (Metro.Environment.current(), Config.Database.dsn) do
      (Error(reason), _) => failed(reason)
      (_, Error(reason)) => failed(reason)
      (_, Ok(dsn)) => match DB.Store.started(dsn) do
        Error(reason) => failed(reason)
        Ok(store) => commanded(store, args)
      end
    end
  end
end
