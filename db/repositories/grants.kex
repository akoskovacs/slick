# Grants: who holds what role over what. One table for every membership —
# in an organization, a conversation or a team — and every administrative
# role, with teams as subjects that hand their members their roles.
# See docs/permissions.md.
module DB.Repositories.Grants

using Harmat.Database, as: Database
using App.Models.Grant, only: [Grant, GrantSubjectType, GrantResourceType, GrantRole, UserSubject, TeamSubject, OrganizationResource, ConversationResource, TeamResource]

# The id of a grant is its subject and its resource, so a second grant of
# the same subject over the same resource takes the place of the first.
key : GrantSubjectType -> String -> GrantResourceType -> String -> String
let key(subjectType, subjectId, resourceType, resourceId) = "${Database.spelled(subjectType)}:${subjectId}:${Database.spelled(resourceType)}:${resourceId}"

# Grants a role, in place of any earlier grant of the same subject over the
# same resource.
foul grant(grant: Grant) -> Grant or! String do
  let id = key(grant.subjectType, grant.subjectId, grant.resourceType, grant.resourceId)
  let stored = Grant { ...grant, id: id, grantedAt: Metro.Clock.milliseconds() }
  let subjectType = stored.subjectType
  let subjectId = stored.subjectId
  let resourceType = stored.resourceType
  let resourceId = stored.resourceId
  let role = stored.role
  let grantedAt = stored.grantedAt
  let row = {
    id: id,
    subject_type: subjectType,
    subject_id: subjectId,
    resource_type: resourceType,
    resource_id: resourceId,
    role: role,
    granted_at: grantedAt
  }
  let made : Grant or! String = Database.transaction do
    Database.delete(DB.Schema.Grants).where(DB.Schema.Grants.id == id).run.try
    Database.insert(DB.Schema.Grants)
      .values(row)
      .run
      .try
    Ok(stored)
  end
  return made
end

# Takes a grant back.
foul revoke(grantId: String) -> Integer or! String do
  return Database.delete(DB.Schema.Grants)
    .where(DB.Schema.Grants.id == grantId)
    .run
end

# Every grant one subject holds.
foul heldBy(subjectType: GrantSubjectType, subjectId: String) -> [Grant] or! String do
  return Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId)
    .all(as: Grant)
end

# Every grant over each of some resources, whoever holds it, by resource.
foul overEach(resourceType: GrantResourceType, resourceIds: [String]) -> {String: [Grant]} or! String do
  return Ok({}) if resourceIds.empty?
  let found = Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId.in(resourceIds))
    .all(as: Grant)
    .try
  return Ok(found.reduce({}) do |grouped, grant|
    grouped.put(grant.resourceId, grouped.get(grant.resourceId).or([]) + [grant])
  end)
end

# Every grant over one resource, whoever holds it.
foul over(resourceType: GrantResourceType, resourceId: String) -> [Grant] or! String do
  return Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId)
    .all(as: Grant)
end

# The teams a user is in, by id.
foul teamsOf(userId: String) -> [String] or! String do
  return Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.subjectId == userId)
    .where(DB.Schema.Grants.resourceType == Database.spelled(TeamResource))
    .orderBy([:granted_at, :id])
    .pluck(:resource_id)
end

# The organizations a user is in, by id — in any role, so a read-only
# member is still in their organization — oldest grant first.
foul organizationsOf(userId: String) -> [String] or! String do
  return Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.subjectId == userId)
    .where(DB.Schema.Grants.resourceType == Database.spelled(OrganizationResource))
    .orderBy([:granted_at, :id])
    .pluck(:resource_id)
end

# The users holding any grant over a resource, by id.
foul members(resourceType: GrantResourceType, resourceId: String) -> [String] or! String do
  return Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId)
    .orderBy([:granted_at, :id])
    .pluck(:subject_id)
end

# The users holding any grant over each of some resources, by resource.
foul membersOf(resourceType: GrantResourceType, resourceIds: [String]) -> {String: [String]} or! String do
  return Ok({}) if resourceIds.empty?
  let rows = Database.select([:resource_id, :subject_id]).from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId.in(resourceIds))
    .orderBy([:granted_at, :id])
    .all
    .try
  return Ok(rows.reduce({}) do |found, row|
    let place = row.get("resource_id").or("")
    found.put(place, found.get(place).or([]) + [row.get("subject_id").or("")])
  end)
end

# Who may read each of some resources: everyone holding a grant over one —
# a team's grant handing it to every member of the team — by resource.
foul readersOf(resourceType: GrantResourceType, resourceIds: [String]) -> {String: [String]} or! String do
  return Ok({}) if resourceIds.empty?
  let found = Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId.in(resourceIds))
    .orderBy([:granted_at, :id])
    .all(as: Grant)
    .try
  let teamIds = found.filter { |grant| grant.subjectType == TeamSubject }.map { |grant| grant.subjectId }.uniq
  let teams : {String: [String]} = membersOf(TeamResource, teamIds).or({})
  return Ok(found.reduce({}) do |grouped, grant|
    let holders = grant.subjectType == UserSubject then [grant.subjectId] else teams.get(grant.subjectId).or([])
    grouped.put(grant.resourceId, (grouped.get(grant.resourceId).or([]) + holders).uniq)
  end)
end

# Who may read one resource.
foul readers(resourceType: GrantResourceType, resourceId: String) -> [String] or! String do
  return readersOf(resourceType, [resourceId]).map { |grouped| grouped.get(resourceId).or([]) }
end

# The conversations a user holds a grant over, by id.
foul conversationsOf(userId: String) -> [String] or! String do
  return Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.subjectId == userId)
    .where(DB.Schema.Grants.resourceType == Database.spelled(ConversationResource))
    .orderBy([:granted_at, :id])
    .pluck(:resource_id)
end

# Whether a subject holds any grant over a resource.
foul holds?(subjectType: GrantSubjectType, subjectId: String, resourceType: GrantResourceType, resourceId: String) -> Bool do
  let found = Database.select([:id]).from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId)
    .first
  match found do
    Ok(Just(_)) => return true
    _ => return false
  end
end

# The users holding a given role over a resource, by id.
foul roleHolders(resourceType: GrantResourceType, resourceId: String, role: GrantRole) -> [String] or! String do
  return Database.select().from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(UserSubject))
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId)
    .where(DB.Schema.Grants.role == Database.spelled(role))
    .orderBy([:granted_at, :id])
    .pluck(:subject_id)
end

# When a subject was granted a role over a resource, in milliseconds since
# 1970; 0 for never.
foul grantedAt(subjectType: GrantSubjectType, subjectId: String, resourceType: GrantResourceType, resourceId: String) -> Integer do
  let found = Database.select([:granted_at]).from(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId)
    .where(DB.Schema.Grants.resourceType == Database.spelled(resourceType))
    .where(DB.Schema.Grants.resourceId == resourceId)
    .first
  match found do
    Ok(Just(row)) => return row.get("granted_at").or("0").to(Integer).or(0)
    _ => return 0
  end
end

# Takes back every grant a subject holds: everything it could do, gone.
foul revokeAll(subjectType: GrantSubjectType, subjectId: String) -> Integer or! String do
  return Database.delete(DB.Schema.Grants)
    .where(DB.Schema.Grants.subjectType == Database.spelled(subjectType))
    .where(DB.Schema.Grants.subjectId == subjectId)
    .run
end
