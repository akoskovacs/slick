# The slash commands bots answer to.
#
#   DB.Repositories.Commands.declare(bot.id, commands)
module DB.Repositories.Commands

using Harmat.Database, as: Database
using App.Models.Command, only: [Command]
using App.Models.Ids, only: [UserId]

# Replaces a bot's commands with these, all at once.
foul declare(botId: UserId, commands: [Command]) -> Integer or! String do
  let replaced : Integer or! String = Database.transaction do
    Database.delete(DB.Schema.Commands.definition)
      .where(DB.Schema.Commands.botId == botId)
      .run
      .try
    let rows = commands.map do |command|
      {
        id: "${botId}:${command.name}",
        bot_id: botId,
        name: command.name,
        description: command.description
      }
    end
    Database.insertAll(DB.Schema.Commands.definition, rows)
  end
  return replaced
end

# The commands of some bots, by name.
foul forBots(botIds: [UserId]) -> [Command] or! String do
  return Database.select().from(DB.Schema.Commands.definition)
    .where(DB.Schema.Commands.botId.in(botIds))
    .orderBy([:name, :bot_id])
    .all(as: Command)
end
