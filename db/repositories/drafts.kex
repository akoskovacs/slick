# Unsent messages, kept as they are typed.
#
#   DB.Repositories.Drafts.save(user.id, Draft { conversationId: chat.id, body: "half a tho" })
module DB.Repositories.Drafts

using Harmat.Database, as: Database
using App.Models.Draft, only: [Draft]
using App.Models.Ids, only: [UserId]

# Everything a person has started writing and not sent.
foul pending(userId: UserId) -> [Draft] or! String do
  return Database.select().from(DB.Schema.Drafts)
    .where(DB.Schema.Drafts.userId == userId)
    .all(as: Draft)
end

# Keeps what a person has written in one message box, in place of what was
# kept before; nothing written takes it away.
# The old one and the new one are swapped in one transaction, so a draft is
# never lost between them.
foul save(userId: UserId, draft: Draft) -> Integer or! String do
  let id = "${userId}:${draft.conversationId}:${draft.threadId}"
  let row = {
    id: id,
    user_id: userId,
    conversation_id: draft.conversationId,
    thread_id: draft.threadId,
    person_id: draft.personId,
    body: draft.body,
    saved_at: Metro.Clock.milliseconds()
  }
  let swapped : Integer or! String = Database.transaction do
    let cleared = Database.delete(DB.Schema.Drafts)
      .where(DB.Schema.Drafts.id == id)
      .run
      .try
    if draft.body.trim.empty?
      Ok(cleared)
    else
      Database.insert(DB.Schema.Drafts)
        .values(row)
        .run
    end
  end
  return swapped
end
