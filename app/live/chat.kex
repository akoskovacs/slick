# The live view as `Metro.Live.Socket` runs it against a tab's WebSocket
# (App.Controllers.Chat.joined): the markup for a tab's state, and one
# event applied to it, by the part of Slick config/live.kex routes it to.
#
# Every event is checked against who sent it. A tab names an organization
# and a conversation by id, and an id is not a permission: `home` only ever
# answers with an organization its person is in, and `visible` only with a
# conversation of that organization they may read (App.Live.Places). Every
# part asks them before anything is read or written, so the id of another
# organization's channel, or of somebody else's private chat, gets a tab
# nothing.
module App.Live.Chat

using Metro.Live.Presence, only: [Presence, Note]
using App.Live.Places, only: [home, visible, organizations]
using App.Live.Event, only: [Event, Routes]
using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Reading, only: [Reading]
using App.Models.Organization, only: [Organization]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Drafts, as: Drafts
using DB.Repositories.Memberships, as: Memberships
using DB.Repositories.Messages, as: Messages
using DB.Repositories.Readings, as: Readings
using DB.Repositories.Reactions, as: Reactions
using DB.Repositories.Answers, as: Answers
using DB.Repositories.Grants, as: Grants
using DB.Repositories.Teams, as: Teams
using DB.Repositories.Users, as: Users

# How many messages of a conversation a tab is shown.
let WINDOW = 200

# The live region for one person's tab, as things are stored right now.
#
# `statuses` is the board of what people are in the middle of — typing, or
# whatever a bot says it is doing: `Metro.Live.Presence`.
markup : Server<Presence> -> User -> Tab -> String
foul markup(statuses, user, tab) do
  match home(user, tab) do
    None => return App.Views.Chat.welcome(tab, user)
    Just(organization) => do
      let marks : [Reading] = Readings.marks(user.id).or([])
      let sidebar = sidebarOf(statuses, user, tab, organization)
      let pane = visible(user, tab)
        .map { |conversation| paneOf(statuses, user, tab, sidebar.people, conversation) }
        .or(App.Views.Chat.Page.Pane {})
      # Looking at a conversation reads it, before what is unread is counted.
      let (reading, readingThread) = pane.conversation
        .map { |conversation| App.Live.Unread.markRead(user, marks, conversation, pane.messages, pane.thread, tab.attentive?) }
        .or(("", ""))
      let unread = App.Live.Unread.counts(user, organization, sidebar.organizations, marks, reading, readingThread)
      return App.Views.Chat.index(tab, user, App.Views.Chat.Page.Sidebar { ...sidebar, unread: unread }, pane)
    end
  end
end

private do
  # What the organization a tab is in shows around the conversation, but
  # what is unread: that is counted once the conversation is read.
  sidebarOf : Server<Presence> -> User -> Tab -> Organization -> App.Views.Chat.Page.Sidebar
  foul sidebarOf(statuses, user, tab, organization) do
    let roster : [String] = Memberships.roster(organization.id).or([])
    let everyone : [User] = Users.everyone.or([])
    let bots : [User] = tab.dialog == "bots" then App.Live.Bots.manageable(user, organization) else []
    let roles = Grants.over("organization", organization.id)
      .or([])
      .filter { |grant| grant.subjectType == "user" }
      .reduce({}) { |found, grant| found.put(grant.subjectId, grant.role) }
    return App.Views.Chat.Page.Sidebar {
      organizations: organizations(user),
      organization: organization,
      channels: App.Live.Places.readable(user, Conversations.channels(organization.id).or([])),
      groups: Conversations.groups(organization.id, user.id).or([]),
      teams: Teams.inOrganization(organization.id).or([]),
      people: everyone.filter { |person| roster.contains?(person.id) },
      online: Metro.Live.Presence.online(statuses),
      bots: bots,
      operators: bots.reduce({}) { |found, bot| found.put(bot.id, DB.Repositories.BotOperators.forBot(bot.id).or([])) },
      drafts: Drafts.pending(user.id).or([]),
      roles: roles,
      administrator: App.Services.Authority.canManage(user, organization.id)
    }
  end

  # The conversation a tab shows, with what is beside it.
  paneOf : Server<Presence> -> User -> Tab -> [User] -> Conversation -> App.Views.Chat.Page.Pane
  foul paneOf(statuses, user, tab, people, conversation) do
    let doing : [Note] = Metro.Live.Presence.standing(statuses, conversation.id, Metro.Clock.milliseconds())
    return App.Views.Chat.Page.Pane {
      conversation: Just(conversation),
      messages: Messages.latest(conversation.id, WINDOW).or([]),
      reactions: Reactions.inConversation(conversation.id).or([]),
      responses: Answers.inConversation(conversation.id).or([]),
      thread: App.Live.Threads.messages(conversation, tab.thread),
      cabinet: App.Live.Files.cabinet(user, tab, conversation),
      commands: App.Live.Commands.available(user, conversation, people),
      invocations: DB.Repositories.Invocations.inConversation(conversation.id).or([]),
      doing: doing.reject { |note| note.member == user.id }
    }
  end
end

# Applies one event: the tab's next state, and whether something other tabs
# show was changed — in which case they are told to refresh. What changed in
# what a bot could see is noted to the events bus on the way (`bus`). Which
# part of Slick answers it is `routes`' to say (config/live.kex).
handled : Routes -> Server<App.Live.Events.Bus> -> Server<Presence> -> User -> Tab -> [(String, String?)] -> (Tab, Bool)
foul handled(routes, bus, statuses, user, tab, entries) do
  let name = Metro.Live.Socket.named(entries)
  let event = Event {
    name: name,
    bus: bus,
    statuses: statuses,
    user: user,
    tab: tab,
    entries: entries
  }
  return Metro.Live.Router.answering(routes.handlers, name)
    .map { |answer| answer(name, event) }
    .or((tab, false))
end
