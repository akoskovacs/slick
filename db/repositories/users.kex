# The people who can sign in.
#
#   DB.Repositories.Users.credentials(email)
module DB.Repositories.Users

using App.Models.Grant, only: [Grant, GrantSubjectId]
using App.Models.Grant, as: Grant
using Harmat.Database, as: Database
using App.Models.User, only: [User, UserDetail]
using App.Models.Ids, only: [UserId]
using App.Models.User, as: User
using App.Models.Organization, only: [OrganizationId]
using DB.Repositories.Grants, as: Grants

# Stores a new user. Fails when the email is taken: the table's unique
# index decides, so two registrations racing for one address cannot both win.
foul enroll(user: User, passwordHash: String) -> User or! String do
  let row = {
    id: user.id,
    email: user.email,
    name: user.name,
    password_hash: passwordHash,
    created_at: Metro.Clock.milliseconds()
  }
  return Database.insert(DB.Schema.Users.definition)
    .values(row)
    .run
    .map { |_| user }
end

# The user registered under an email, with their stored password line.
foul credentials(email: String) -> (User, String)? or! String do
  return Database.select().from(DB.Schema.Users.definition)
    .where(DB.Schema.Users.email == email)
    .first
    .flatMap do |row|
      match row do
        None => Ok(None)
        Just(found) => Database.decoded(found, User, {})
          .map { |user| Just((user, found.get("password_hash").or(""))) }
      end
    end
end

# Stores a bot. It has no password: `tokenDigest` is how it is known.
foul createBot(bot: User, tokenDigest: String) -> User or! String do
  let row = {
    id: bot.id,
    email: bot.email,
    name: bot.name,
    password_hash: "",
    created_at: Metro.Clock.milliseconds(),
    kind: User.Bot,
    owner_id: bot.ownerId,
    owner_organization_id: bot.ownerOrganizationId,
    api_token_digest: tokenDigest
  }
  return Database.insert(DB.Schema.Users.definition)
    .values(row)
    .run
    .map { |_| bot }
end

# A person's bots, by name.
foul botsOf(owner: UserId) -> [User] or! String do
  return Database.select(SHOWN).from(DB.Schema.Users.definition)
    .where(DB.Schema.Users.ownerId == owner)
    .orderBy([:name, :id])
    .all(as: User)
end

# An organization's bots, by name.
foul botsOfOrganization(organizationId: OrganizationId) -> [User] or! String do
  return Database.select(SHOWN).from(DB.Schema.Users.definition)
    .where(DB.Schema.Users.ownerOrganizationId == organizationId)
    .orderBy([:name, :id])
    .all(as: User)
end

# Replaces the token of an organization's bot; whether it was that
# organization's to change.
foul rekeyOrganizationBot(botId: UserId, organizationId: OrganizationId, tokenDigest: String) -> Bool or! String do
  return Database.update(DB.Schema.Users.definition)
    .set({api_token_digest: tokenDigest})
    .where(DB.Schema.Users.ownerOrganizationId == organizationId)
    .where(DB.Schema.Users.id == botId)
    .run
    .map { |changed| changed > 0 }
end

# The bot an API token's digest belongs to, or `None`.
foul findByToken(tokenDigest: String) -> User? or! String do
  return Database.select(SHOWN).from(DB.Schema.Users.definition)
    .where(DB.Schema.Users.apiTokenDigest == tokenDigest)
    .where(DB.Schema.Users.kind == Database.spelled(User.Bot))
    .first(as: User)
end

# Replaces a bot's token; whether it was this owner's bot to change.
foul rekeyBot(botId: UserId, owner: UserId, tokenDigest: String) -> Bool or! String do
  return Database.update(DB.Schema.Users.definition)
    .set({api_token_digest: tokenDigest})
    .where(DB.Schema.Users.ownerId == owner)
    .where(DB.Schema.Users.id == botId)
    .run
    .map { |changed| changed > 0 }
end

# Deletes a bot — this owner's own — and everything of it: what it could do,
# what it was in, and the places it had been. Whether it was there to delete.
foul removeBot(botId: UserId, owner: UserId) -> Bool or! String do
  return removing(botId, owner, "")
end

# The same, for an organization's bot.
foul removeOrganizationBot(botId: UserId, organizationId: OrganizationId) -> Bool or! String do
  return removing(botId, "", organizationId)
end

# Sets what somebody says about themselves; "" and "" takes it back.
foul setStatus(id: UserId, emoji: String, saying: String) -> Integer or! String do
  return Database.update(DB.Schema.Users.definition)
    .set({status_emoji: emoji, status_text: saying})
    .where(DB.Schema.Users.id == id)
    .run
end

# Sets the details a profile shows, each as it is on `user`. Whatever a sync
# has taken over is for the caller to have kept: `App.Live.Chat` does.
foul update(user: User) -> Integer or! String do
  let id = user.id
  let row = {
    name: user.name,
    title: user.title,
    department: user.department,
    phone: user.phone,
    time_zone: user.timeZone,
    bio: user.bio,
    nickname: user.nickname,
    nickname_shown: user.nicknameShown?
  }
  return Database.update(DB.Schema.Users.definition)
    .set(row)
    .where(DB.Schema.Users.id == id)
    .run
end

# Hands details over to a sync, by column, or back with `[]`: what it has
# taken over cannot be changed from a profile.
foul markManaged(id: UserId, columns: [UserDetail]) -> Integer or! String do
  let managed = columns.map { |column| Database.spelled(column) }.join(",")
  return Database.update(DB.Schema.Users.definition)
    .set({managed: managed})
    .where(DB.Schema.Users.id == id)
    .run
end

foul find(id: UserId) -> User? or! String do
  return Database.select().from(DB.Schema.Users.definition)
    .where(DB.Schema.Users.id == id)
    .first(as: User)
end

# Everyone, by name: who can be written to, and whose name goes on a message.
foul everyone -> [User] or! String do
  return Database.select(SHOWN).from(DB.Schema.Users.definition)
    .orderBy([:name, :email])
    .all(as: User)
end

# Every bot's id.
foul botIds -> [UserId] or! String do
  return Database.select([:id]).from(DB.Schema.Users.definition)
    .where(DB.Schema.Users.kind == Database.spelled(User.Bot))
    .all(as: UserId)
end

private do
  # Deletes a bot, when it is the caller's to delete: `owner` is its owner's
  # id, or `organizationId` the organization it belongs to — never both. The
  # bot goes first, so nothing of it is taken from a bot that was not this
  # caller's; the rest is all or nothing, in the one transaction. What it
  # said stays, as what anybody who is gone has said does ("Someone").
  foul removing(botId: UserId, owner: UserId, organizationId: OrganizationId) -> Bool or! String do
    let done : Bool or! String = Harmat.Database.transaction do
      let gone : Integer = (if owner.empty?
        Database.delete(DB.Schema.Users.definition)
          .where(DB.Schema.Users.id == botId)
          .where(DB.Schema.Users.kind == Database.spelled(User.Bot))
          .where(DB.Schema.Users.ownerOrganizationId == organizationId)
      else
        Database.delete(DB.Schema.Users.definition)
          .where(DB.Schema.Users.id == botId)
          .where(DB.Schema.Users.kind == Database.spelled(User.Bot))
          .where(DB.Schema.Users.ownerId == owner)
      end).run.try
      if gone > 0
        Database.delete(DB.Schema.Commands.definition).where(DB.Schema.Commands.botId == botId).run.try
        Database.delete(DB.Schema.Invocations.definition).where(DB.Schema.Invocations.botId == botId).run.try
        # Everything it was granted — its memberships, its roles — goes too.
        Grants.revokeAll(Grant.UserSubject, botId.as(GrantSubjectId)).try
        Database.delete(DB.Schema.Drafts.definition).where(DB.Schema.Drafts.userId == botId).run.try
        Database.delete(DB.Schema.Readings.definition).where(DB.Schema.Readings.userId == botId).run.try
        Database.delete(DB.Schema.Sessions.definition).where(DB.Schema.Sessions.userId == botId).run.try
      end
      Ok(gone > 0)
    end
    return done
  end
end

# What is read of a user when nobody is signing in: everything but the
# password line and the token digest. Known while compiling, so the queries
# that read it are written then.
let SHOWN = [
  :id,
  :email,
  :name,
  :kind,
  :owner_id,
  :owner_organization_id,
  :status_emoji,
  :status_text,
  :title,
  :department,
  :phone,
  :time_zone,
  :bio,
  :nickname,
  :nickname_shown,
  :managed
]
