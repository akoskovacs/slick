# Organizations, and what each starts with.
module App.Services.Organizations

using App.Models.Conversation, only: [Conversation]
using App.Models.Conversation, as: Conversation
using App.Models.Grant, only: [Grant]
using App.Models.Grant, as: Grant
using App.Models.Organization, only: [Organization]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Grants, as: Grants
using DB.Repositories.Memberships, as: Memberships

# What the first channel of an organization is about, until somebody says.
let GENERAL_TOPIC = "Company-wide announcements and chatter"

# Makes an organization, all or nothing: its founder as its first member
# and administrator, and its #general.
create : User -> String -> String -> Organization or! String
foul create(founder, name, slug) do
  let made : Organization or! String = Harmat.Database.transaction do
    let organization : Organization = DB.Repositories.Organizations
      .create(name, slug, founder.id)
      .try
    Memberships.add(organization.id, founder.id).try
    Grants.grant(Grant {
      subjectType: Grant.UserSubject,
      subjectId: founder.id,
      resourceType: Grant.OrganizationResource,
      resourceId: organization.id,
      role: Grant.Admin
    }).try
    let general : Conversation = Conversations
      .create(organization.id, Conversation.GENERAL, founder.id)
      .try
    Conversations.setTopic(general.id, GENERAL_TOPIC).try
    Ok(organization)
  end
  return made
end
