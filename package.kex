package "slick" do
  version("0.1.0")
  description("Slick")
  kex(">= 0.4.0-rc.3")

  # The application is laid out from its top: the entrypoint, and beside it
  # the folders its modules are in — App.* in app/, Config.* in config/,
  # DB.* in db/.
  entrypoint("main.kex")
  sources(["app", "config", "db"])

  command("server", run: "tey run server", description: "Migrate, then serve on http://localhost:4000")
  command("dev", run: "sh script/dev.sh", description: "Serve, with the slick-ai-bot beside it")
  command("db:migrate", run: "tey run migrate", description: "Run the migrations this database has not run")
  command("db:rollback", run: "tey run rollback", description: "Undo the newest migration (or the newest N)")
  command("db:seed", run: "tey run seed", description: "Migrate, then plant what a new database starts with")
  command("db:create", run: "sh script/database.sh create", description: "Create the SQLite database for this environment")
  command("db:drop", run: "sh script/database.sh drop", description: "Drop the SQLite database for this environment")
  command("console", run: "sh bin/console", description: "The application in Kex's REPL, on this database")
  command("odbc", run: "sh script/setup-odbc.sh db/odbc", description: "Build Erlang's ODBC port program into db/odbc, once")

  tey("harmat", git: "https://github.com/kexhq/harmat", ref: "48bb7da35403116fc863dd5d47ac7aff742794a8")
  tey("metro", git: "https://github.com/kexhq/metro", ref: "f13769ce427f3532dbfbe922fb289ff9b476ba21")

  group :browser do
    tey("shakespeare", git: "https://github.com/kexhq/shakespeare", ref: "ddb58d9c0c51f7112526535d280d12d0e24c3ac0")
  end
end
