# Every table this application declares: what `Harmat.Table.drift` holds the
# migrations against. One file each in db/schema.
module DB.Schema

using Harmat.Table, only: [Definition]

# Each table under the name of its own module, so that a query reads
# `.from(DB.Schema.Users.definition)` and a condition
# `DB.Schema.Users.email == email`: the module has typed columns, and its
# `definition` is the table value.
let BotOperators = DB.Schema.BotOperators.definition
let Users = DB.Schema.Users.definition
let Sessions = DB.Schema.Sessions.definition
let Conversations = DB.Schema.Conversations.definition
let Messages = DB.Schema.Messages.definition
let Reactions = DB.Schema.Reactions.definition
let Organizations = DB.Schema.Organizations.definition
let Answers = DB.Schema.Answers.definition
let Drafts = DB.Schema.Drafts.definition
let Readings = DB.Schema.Readings.definition
let Files = DB.Schema.Files.definition
let Commands = DB.Schema.Commands.definition
let Invocations = DB.Schema.Invocations.definition
let Teams = DB.Schema.Teams.definition
let Grants = DB.Schema.Grants.definition

tables : [Definition]
let tables = [
  DB.Schema.BotOperators,
  DB.Schema.Users,
  DB.Schema.Sessions,
  DB.Schema.Conversations,
  DB.Schema.Messages,
  DB.Schema.Reactions,
  DB.Schema.Organizations,
  DB.Schema.Answers,
  DB.Schema.Drafts,
  DB.Schema.Readings,
  DB.Schema.Files,
  DB.Schema.Commands,
  DB.Schema.Invocations,
  DB.Schema.Teams,
  DB.Schema.Grants
]
