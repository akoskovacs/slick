# Teams from a tab: opening one beside the conversation, making one,
# changing it, and who is in it. A team a sync keeps is the sync's to
# change, not anyone's here.
module App.Live.Teams

using Metro.Validation, only: [rules, validates, present, sized]
using Metro.Live.Socket, only: [unchanged, changed]
using App.Live.Outcome, only: [Outcome, refused, failed]
using App.Live.Event, only: [Event]
using App.Live.Tab, only: [Tab]
using App.Models.Team, only: [Team, TeamId]
using App.Models.Team, as: Team
using App.Models.User, only: [User]
using App.Models.Ids, only: [UserId]
using App.Models.Message, only: [MessageId]
using DB.Repositories.Memberships, as: Memberships

let teamRules = rules do
  validates("name", "A team's name", [present, sized(2, 40)])
  validates("description", "What a team is for", [sized(0, Team.LONGEST_DESCRIPTION)])
end

# What a team a sync keeps says when somebody tries to change it here.
let SYNCED = "kept in sync from your organization's directory: change it there."

# Opens a team beside the conversation, in place of a thread or a profile.
open : User -> Tab -> TeamId -> Outcome
foul open(user, tab, id) do
  let opened = beside(tab, id)
  return unchanged(current(user, opened).set? then opened else tab)
end

# A new team, with whoever made it in it. Its handle is the one given, or
# else what its name suggests.
create : User -> Tab -> String -> String -> String -> Outcome
foul create(user, tab, name, description, given) do
  let typed = given.startsWith?("@") then given.drop(1) else given
  let handle = typed.empty? then Team.handled(name) else typed
  let problems = Metro.Validation.checked(teamRules, {"name": name, "description": description}).messages
  return refused(tab, App.Live.Tab.TeamDialog, problems.first.or("")) if !problems.empty?
  if !Team.handle?(handle)
    return refused(tab, App.Live.Tab.TeamDialog, "A handle has 2 to 30 lower-case letters, digits and dashes, and starts with a letter.")
  end

  match user.home(tab.organization) do
    None => return unchanged(tab)
    Just(organization) => do
      if !user.canCreate?(organization.id)
        return refused(tab, App.Live.Tab.TeamDialog, "You may not make a team in ${organization.name}.")
      end
      let team = Team {
        id: "".as(TeamId),
        organizationId: organization.id,
        handle: handle,
        name: name,
        description: description,
        members: [user.id]
      }

      match team.create(user.id) do
        Ok(made) => return changed(beside(tab, made.id))
        Error(_) => return refused(tab, App.Live.Tab.TeamDialog, "There is already a team called @${handle}.")
      end
    end
  end
end

# Renames the open team, and says again what it is for.
update : User -> Tab -> String -> String -> Outcome
foul update(user, tab, name, description) do
  let problems = Metro.Validation.checked(teamRules, {"name": name, "description": description}).messages
  return refused(tab, App.Live.Tab.TeamEditDialog, problems.first.or("")) if !problems.empty?

  match current(user, tab) do
    None => return unchanged(tab.closed)
    Just(team) => do
      return refused(tab, App.Live.Tab.TeamEditDialog, "@${team.handle} is ${SYNCED}") if team.managed?

      match team.update(name, description) do
        Ok(_) => return changed(tab.closed)
        Error(reason) => return refused(tab, App.Live.Tab.TeamEditDialog, reason)
      end
    end
  end
end

# Puts people of the organization in the open team.
addMembers : User -> Tab -> [UserId] -> Outcome
foul addMembers(user, tab, picked) do
  match current(user, tab) do
    None => return unchanged(tab)
    Just(team) => do
      return failed(tab, "@${team.handle} is ${SYNCED}") if team.managed?

      let newcomers = picked.filter { |id| Memberships.member?(team.organizationId, id) }
      match team.addMembers(newcomers) do
        Ok(count) => return (tab.closed, count > 0)
        Error(reason) => return failed(tab, reason)
      end
    end
  end
end

# Takes somebody out of the open team.
removeMember : User -> Tab -> UserId -> Outcome
foul removeMember(user, tab, id) do
  match current(user, tab) do
    None => return unchanged(tab)
    Just(team) => do
      return failed(tab, "@${team.handle} is ${SYNCED}") if team.managed?

      match team.removeMember(id) do
        Ok(count) => return (tab.closed, count > 0)
        Error(reason) => return failed(tab, reason)
      end
    end
  end
end

# What this part answers, of the events config/live.kex routes to it, by
# their whole names; any other does nothing.
on : String -> Event -> Outcome
foul on("team-open", event) = open(event.user, event.tab, event.given("id").as(TeamId))
foul on("team-close", event) = unchanged(Tab { ...event.tab.closed, team: "".as(TeamId) })
foul on("team-create", event) = create(event.user, event.tab, event.typed("name"), event.typed("description"), event.typed("handle").lowerCase)
foul on("team-update", event) = update(event.user, event.tab, event.typed("name"), event.typed("description"))
foul on("team-join", event) = addMembers(event.user, event.tab, [event.user.id])
foul on("team-add", event) = addMembers(event.user, event.tab, event.picked("person").map { |id| id.as(UserId) })
foul on("team-leave", event) = removeMember(event.user, event.tab, event.user.id)
foul on("team-remove", event) = removeMember(event.user, event.tab, event.given("user").as(UserId))
foul on(_, event) = unchanged(event.tab)

private do
  # The team the tab has open, if it is one of the tab's organization.
  current : User -> Tab -> Team?
  foul current(user, tab) do
    return None if tab.team.empty?

    match user.home(tab.organization) do
      None => return None
      Just(organization) => match DB.Repositories.Teams.find(tab.team) do
        Ok(Just(team)) => return team.organizationId == organization.id then Just(team) else None
        _ => return None
      end
    end
  end

  # The tab with a team open beside the conversation, and nothing over it.
  beside : Tab -> TeamId -> Tab
  let beside(tab, id) = Tab {
    ...tab.closed,
    thread: "".as(MessageId),
    profile: "".as(UserId),
    team: id
  }
end
