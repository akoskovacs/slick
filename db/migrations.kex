# Every migration of this application, in order.
#
#   db/migrate/N0001_create_users.kex
#   db/migrate/N0002_create_sessions.kex
#   db/migrate/N0003_add_user_names.kex
#   db/migrate/N0004_create_conversations.kex
#   db/migrate/N0005_create_messages.kex
#   db/migrate/N0006_create_reactions.kex
#   db/migrate/N0007_add_message_threads.kex
#   db/migrate/N0008_create_organizations.kex
#   db/migrate/N0009_add_bots.kex
#   db/migrate/N0010_add_bot_organizations.kex
#   db/migrate/N0011_add_user_statuses.kex
#   db/migrate/N0012_create_answers.kex
#   db/migrate/N0013_add_user_details.kex
#   db/migrate/N0014_create_drafts.kex
#   db/migrate/N0015_create_readings.kex
#   db/migrate/N0016_add_reading_threads.kex
#   db/migrate/N0017_create_files.kex
#   db/migrate/N0018_create_commands.kex
#   db/migrate/N0019_create_invocations.kex
#   db/migrate/N0020_create_teams.kex
#   db/migrate/N0021_add_groups.kex
#   db/migrate/N0022_create_grants.kex
#   db/migrate/N0023_retire_membership_tables.kex
#   db/migrate/N0024_add_bot_access.kex           ← head
#
# `N0001` is "number 1": the number keeps the folder in order, and the next
# migration takes the next one. What decides the order a database runs them
# in is what each one `follows`, so two branches that both add an `N0003_…`
# do no harm: the server refuses to start and names the two heads, and one
# more migration joins them:
#
#   let change = Migration.merge(:merge_a_and_b, [:a, :b])
#
# Adding one: write db/migrate/NNNNN_<name>.kex, declaring
# `module DB.Migrate.NNNNN<Name>` and
# `let change = Migration.define :<name>, follows: :<the current head> do … end`,
# add it to the end of the list below, and declare what it creates in
# db/schema. The server refuses to start when db/schema and the migrations
# disagree.
# Keep each migration's `oneOf` values literal. Current schema derives them
# from model enums; adding a constructor needs a new migration that widens
# the column constraint, without changing a migration already written.
#
#   tey db:migrate       # run what this database has not run
#   tey db:rollback      # undo the newest; `tey db:rollback 3` undoes three
module DB.Migrations

using Harmat.Migration, as: Migration

all : [Migration]
let all = [
  DB.Migrate.N0001CreateUsers.change,
  DB.Migrate.N0002CreateSessions.change,
  DB.Migrate.N0003AddUserNames.change,
  DB.Migrate.N0004CreateConversations.change,
  DB.Migrate.N0005CreateMessages.change,
  DB.Migrate.N0006CreateReactions.change,
  DB.Migrate.N0007AddMessageThreads.change,
  DB.Migrate.N0008CreateOrganizations.change,
  DB.Migrate.N0009AddBots.change,
  DB.Migrate.N0010AddBotOrganizations.change,
  DB.Migrate.N0011AddUserStatuses.change,
  DB.Migrate.N0012CreateAnswers.change,
  DB.Migrate.N0013AddUserDetails.change,
  DB.Migrate.N0014CreateDrafts.change,
  DB.Migrate.N0015CreateReadings.change,
  DB.Migrate.N0016AddReadingThreads.change,
  DB.Migrate.N0017CreateFiles.change,
  DB.Migrate.N0018CreateCommands.change,
  DB.Migrate.N0019CreateInvocations.change,
  DB.Migrate.N0020CreateTeams.change,
  DB.Migrate.N0021AddGroups.change,
  DB.Migrate.N0022CreateGrants.change,
  DB.Migrate.N0023RetireMembershipTables.change,
  DB.Migrate.N0024AddBotAccess.change,
  DB.Migrate.N0025CreateBotOperators.change,
  DB.Migrate.N0026CountMoments.change
]
