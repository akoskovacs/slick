---
params: [card: Card]
---
<aside class="profile" aria-label="Profile of <%= card.caption %>">
  <header class="heading thread-head">
    <h1>Profile</h1>
    <button type="button" class="quiet" data-event="profile-close" title="Close profile">✕</button>
  </header>
  <div class="profile-body">
    <span class="portrait tint-<%= card.tint %>" aria-hidden="true"><%= card.initial %></span>
    <h2><%= card.caption %>
    <% if !card.badged.empty? %>
      <span class="flag"><%= card.badged %></span>
    <% end %>
    </h2>
    <% if !card.name.empty? %>
      <p class="formal"><%= card.name %></p>
    <% end %>
    <% if !card.title.empty? %>
      <p class="role"><%= card.title %></p>
    <% end %>
    <% if !card.roleShown.empty? %>
      <p class="membership"><%= card.roleShown %></p>
    <% end %>
    <p class="presence<% if card.active? %> active<% end %>"><%= card.presence %></p>
    <% if !card.emblem.empty? || !card.statusText.empty? %>
      <p class="motto"><%= card.emblem %> <%= card.statusText %></p>
    <% end %>
    <% if !card.bio.empty? %>
      <p class="bio"><%= card.bio %></p>
    <% end %>
    <div class="actions">
    <% if card.own? %>
      <button type="button" data-event="dialog-open" data-dialog="profile">Edit profile</button>
      <button type="button" data-event="dialog-open" data-dialog="status">Set a status…</button>
    <% else %>
      <button type="button" class="primary"
        data-event="direct-open" data-user="<%= card.key %>">Message</button>
    <% end %>
    </div>
    <% if card.manageable? %>
      <details class="member-management">
        <summary>Manage member</summary>
      <form class="role-picker" data-live="role-set" data-live-quiet data-live-hook="Instant">
        <input type="hidden" name="user" value="<%= card.key %>">
        <label for="member-role">Workspace role</label>
        <select id="member-role" name="role" aria-label="Role">
          <option value="member"<% if card.member? %> selected<% end %>>Member</option>
          <option value="admin"<% if card.admin? %> selected<% end %>>Administrator</option>
          <option value="read_only"<% if card.readOnly? %> selected<% end %>>Read-only</option>
        </select>
        <button type="submit" class="visually-hidden">Save role</button>
      </form>
      <button type="button" class="quiet remove-person" data-event="member-remove" data-user="<%= card.key %>">Remove from organization</button>
      </details>
    <% end %>
    <dl class="details">
    <% if !card.department.empty? %>
      <dt>Department</dt>
      <dd><%= card.department %></dd>
    <% end %>
    <% if !card.mail.empty? %>
      <dt>Email</dt>
      <dd><a href="mailto:<%= card.mail %>"><%= card.mail %></a></dd>
    <% end %>
    <% if !card.phone.empty? %>
      <dt>Phone</dt>
      <dd><a href="tel:<%= card.phone %>"><%= card.phone %></a></dd>
    <% end %>
    <% if !card.timeZone.empty? %>
      <dt>Time zone</dt>
      <dd><%= card.timeZone %></dd>
    <% end %>
    <% if !card.keeper.empty? %>
      <dt>Belongs to</dt>
      <% if card.keeperKey.empty? %>
        <dd><%= card.keeper %></dd>
      <% else %>
        <dd>
          <button type="button" class="link"
            data-event="profile-open" data-user="<%= card.keeperKey %>"><%= card.keeper %></button>
        </dd>
      <% end %>
    <% end %>
    </dl>
  </div>
</aside>
