# The chat page, and the socket that keeps it current.
module App.Controllers.Chat

using Metro.WebRequest, only: [WebRequest]
using Metro.Environment, only: [Development]
using Net.HTTP.WebSocket, only: [Connection, Text, CloseMessage]
using App.Controllers.Application, only: [hubFor, statusesFor, eventsFor, userFor, page]

# The page, opened at the conversation its address names. The live view
# takes over from there (`joined`) and keeps the address bar in step.
show : WebRequest -> WebRequest
foul show(request) do
  let user = userFor(request)
  let tab = App.Live.Chat.arrived(user, request.target)
  let live = App.Live.Chat.markup(statusesFor(request), user, tab)
  return page(request, 200, App.Views.Chat.page { live })
end

# A tab's socket: events in, markup out, until it closes.
#
# Every tab is in one group: a message anywhere is news to every sidebar.
# What a tab is then shown is still only what its person may read. The
# socket is opened with `?at=<the page's address>`, and the live view starts
# where the page was rendered.
#
# Having a tab open is being here: said on the way in, taken back on the way
# out, and the others' pages are told both times.
joined : WebRequest -> Net.HTTP.WebSocket.Connection -> Void
foul joined(request, socket) do
  let hub = hubFor(request)
  let statuses = statusesFor(request)
  let events = eventsFor(request)
  let user = userFor(request)
  let seat = "${Metro.Id.serial()}"
  App.Live.Statuses.arrive(statuses, user, seat)
  hub.changed(seat, "everyone")
  Metro.Live.Socket.attached(
    socket, hub, "everyone", App.Live.Chat.arrived(user, request.query("at").or("/")),
    { |tab, event| App.Live.Chat.handled(events, statuses, user, tab, event) },
    { |tab| App.Live.Chat.markup(statuses, user, tab) }
  )
  App.Live.Statuses.leave(statuses, user, seat)
  hub.changed(seat, "everyone")
rescue |error|
  # Something the page cannot run around. It is said on the way out — in
  # development, what it was — and the socket is held open so the browser
  # keeps showing it until the page is reloaded. A live view that dies
  # without a word leaves whoever is looking at a page that is just broken.
  IO.printError("slick: ${error}")
  socket.send(Text("error\n${App.Controllers.Chat.shown(error)}"))
  loop do
    match socket.receiveMessage do
      Ok(CloseMessage(_, _)) => break
      Ok(_) => Void
      Error(_) => break
    end
  end
end

# What a live view says when it fails: the reason, in development, and a
# shrug elsewhere — the server's log always has it.
shown : Any -> String
foul shown(error) do
  match Metro.Environment.current() do
    Ok(Development) => "${error}"
    _ => "Something went wrong. The server log says what."
  end
end
