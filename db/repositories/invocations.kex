# Slash commands somebody used.
#
#   DB.Repositories.Invocations.inside(conversation.id)
module DB.Repositories.Invocations

using Harmat.Database, as: Database
using App.Models.Invocation, only: [Invocation]

# Keeps one, as it is.
foul recorded(invocation: Invocation) -> Result<Integer, String> do
  return Database.insert(DB.Schema.Invocations)
    .record(invocation)
    .run
end

# Every one used in a conversation, its threads included, oldest first.
foul inside(conversationId: String) -> Result<[Invocation], String> do
  return Database.select().from(DB.Schema.Invocations)
    .where(DB.Schema.Invocations.conversationId == conversationId)
    .orderBy([:invoked_at, :id])
    .all(as: Invocation)
end

# Those meant for a bot in an organization after `after`, oldest first:
# what the bot is told.
foul meantFor(organizationId: String, botId: String, after: Integer) -> Result<[Invocation], String> do
  return Database.select().from(DB.Schema.Invocations)
    .where(DB.Schema.Invocations.organizationId == organizationId)
    .where(DB.Schema.Invocations.botId == botId)
    .where(DB.Schema.Invocations.invokedAt > after)
    .orderBy([:invoked_at, :id])
    .all(as: Invocation)
end
