---
params: [entry: Entry]
---
<li><button type="button" class="entry<% if entry.current? %> current<% end %>" data-event="<%= entry.action %>" data-<%= entry.subject %>="<%= entry.key %>"><%= entry.caption %><% if !entry.badged.empty? %> <span class="flag"><%= entry.badged %></span><% end %></button></li>
