# Channels, private chats and group chats.
#
#   DB.Repositories.Conversations.channels
#
# Who may read a conversation is the model's to say (`Conversation.admits?`)
# and the live view's to ask; this only finds and stores them — and fills
# in who takes part in each private channel and group chat it finds, which
# `admits?` asks.
module DB.Repositories.Conversations

using Harmat.Database, as: Database
using App.Models.Conversation, only: [Conversation, ConversationAccess, BotAccess, Channel, Group, Public, Private, Mentions]
using App.Models.Conversation, as: Conversation
using App.Models.Grant, only: [Grant]
using App.Models.Grant, as: Grant
using DB.Repositories.Grants, as: Grants

# Every channel of an organization, by name: the private ones too, which
# not everyone may read.
foul channels(organizationId: String) -> [Conversation] or! String do
  let rows = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.kind == Database.spelled(Channel))
    .where(DB.Schema.Conversations.organizationId == organizationId)
    .orderBy([:title])
    .all(as: Conversation)
    .try
  return peopled(rows)
end

# One conversation, or `None`.
foul find(id: String) -> Conversation? or! String do
  let row = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.id == id)
    .first(as: Conversation)
    .try
  return single(row)
end

# An organization's channel of this name, or `None`.
foul findChannel(organizationId: String, title: String) -> Conversation? or! String do
  let slug = "${organizationId}#${title}"
  let row = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.slug == slug)
    .first(as: Conversation)
    .try
  return single(row)
end

# Creates a channel: public, or private to whoever made it — and, when a
# team owns it, to the team's members. Fails when the organization has one
# of that name: the unique index on `slug`, which starts with the
# organization, decides.
foul create(
  organizationId: String,
  title: String,
  by: String,
  access: ConversationAccess = Public,
  teamId: String = "",
  botAccess: BotAccess = Mentions
) -> Conversation or! String do
  let channel = Conversation {
    id: Metro.Id.generate(prefix: "c"),
    kind: Channel,
    slug: "${organizationId}#${title}",
    title: title,
    organizationId: organizationId,
    access: access,
    teamId: teamId,
    botAccess: botAccess
  }
  let row = {
    id: channel.id,
    kind: channel.kind,
    slug: channel.slug,
    title: title,
    organization_id: organizationId,
    access: access,
    team_id: teamId,
    bot_access: botAccess,
    created_by: by,
    created_at: Metro.Clock.milliseconds()
  }
  let made : Conversation or! String = Database.transaction do
    Database.insert(DB.Schema.Conversations)
      .values(row)
      .run
      .try
    let first = access == Private then [by] else []
    admit(channel.id, first).try
    # The team that owns the channel administers it, and so do its members.
    if teamId != ""
      Grants.grant(Grant { subjectType: Grant.TeamSubject, subjectId: teamId, resourceType: Grant.ConversationResource, resourceId: channel.id, role: Grant.Admin }).try
    end
    Ok(Conversation { ...channel, participants: first })
  end
  return made
end

# The group chat between some people of an organization — whoever starts
# it among them — created the first time it is asked for. The same people
# have one group chat, as two people have one private chat.
foul findOrCreateGroup(organizationId: String, people: [String], by: String) -> Conversation or! String do
  let everyone = (people + [by]).uniq.sort
  let slug = "${organizationId}${Conversation.gathering(everyone)}"
  let existing = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.slug == slug)
    .first(as: Conversation)
    .try
  match existing do
    Just(row) => return peopled([row]).map { |found| found.first.or(row) }
    None => do
      let chat = Conversation {
        id: Metro.Id.generate(prefix: "g"),
        kind: Group,
        slug: slug,
        organizationId: organizationId,
        access: Private,
        participants: everyone
      }
      let row = {
        id: chat.id,
        kind: chat.kind,
        slug: slug,
        organization_id: organizationId,
        access: Private,
        created_by: by,
        created_at: Metro.Clock.milliseconds()
      }
      let made : Conversation or! String = Database.transaction do
        Database.insert(DB.Schema.Conversations)
          .values(row)
          .run
          .try
        admit(chat.id, everyone).try
        Ok(chat)
      end
      return made
    end
  end
end

# The group chats a person is in, in an organization.
foul groups(organizationId: String, userId: String) -> [Conversation] or! String do
  let ids : [String] = taking(userId).try
  return Ok([]) if ids.empty?

  let rows = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.kind == Database.spelled(Group))
    .where(DB.Schema.Conversations.organizationId == organizationId)
    .where(DB.Schema.Conversations.id.in(ids))
    .orderBy([:created_at, :id])
    .all(as: Conversation)
    .try
  return peopled(rows)
end

# Makes a group chat a channel of this name, public or private; whoever
# was in it is in the channel. Fails when the organization has a channel
# of that name, or there is no such group chat.
foul promote(id: String, title: String, access: ConversationAccess) -> Conversation or! String do
  let found : Conversation? = find(id).try
  match found do
    Just(chat) => do
      return Error("only a group chat becomes a channel") if !chat.group?

      let slug = "${chat.organizationId}#${title}"
      Database.update(DB.Schema.Conversations)
        .set({kind: Channel, slug: slug, title: title, access: access}, columns: [:kind, :slug, :title, :access])
        .where(DB.Schema.Conversations.kind == Database.spelled(Group))
        .where(DB.Schema.Conversations.id == id)
        .run
        .try
      return Ok(Conversation {
        ...chat,
        kind: Channel,
        slug: slug,
        title: title,
        access: access
      })
    end
    None => return Error("there is no such group chat")
  end
end

# Lets people into a private channel or a group chat, leaving out whoever
# is in it already. Each is granted membership of the conversation.
foul admit(conversationId: String, userIds: [String]) -> Integer or! String do
  let present : [String] = (participantsOf([conversationId]).try).get(conversationId).or([])
  let newcomers = userIds.uniq.reject { |userId| present.contains?(userId) }
  let failures = newcomers.flatMap do |userId|
    let stored = Grants.grant(Grant { subjectType: Grant.UserSubject, subjectId: userId, resourceType: Grant.ConversationResource, resourceId: conversationId, role: Grant.Member })
    match stored do
      Ok(_) => []
      Error(reason) => [reason]
    end
  end
  return failures.empty? then Ok(newcomers.count) else Error(failures.first.or(""))
end

# The private chat between two people in an organization, created the
# first time it is asked for.
foul findOrCreateDirect(organizationId: String, one: String, other: String) -> Conversation or! String do
  let slug = "${organizationId}${Conversation.pairing(one, other)}"
  let existing = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.slug == slug)
    .first(as: Conversation)
  match existing do
    Error(reason) => return Error(reason)
    Ok(Just(row)) => return Ok(row)
    Ok(None) => do
      let first = one <= other then one else other
      let second = one <= other then other else one
      let chat = Conversation {
        id: Metro.Id.generate(prefix: "d"),
        kind: Conversation.PrivateChat,
        slug: slug,
        firstUser: first,
        secondUser: second,
        organizationId: organizationId
      }
      let row = {
        id: chat.id,
        kind: Conversation.PrivateChat,
        slug: slug,
        organization_id: organizationId,
        first_user: first,
        second_user: second,
        created_by: one,
        created_at: Metro.Clock.milliseconds()
      }
      return Database.insert(DB.Schema.Conversations)
        .values(row)
        .run
        .map { |_| chat }
    end
  end
end

# The private chats a person has in an organization, whichever of the two
# they are in it.
foul directs(organizationId: String, userId: String) -> [Conversation] or! String do
  let asFirst = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.kind == Database.spelled(Conversation.PrivateChat))
    .where(DB.Schema.Conversations.organizationId == organizationId)
    .where(DB.Schema.Conversations.firstUser == userId)
    .all(as: Conversation)
    .try
  let asSecond = Database.select().from(DB.Schema.Conversations)
    .where(DB.Schema.Conversations.kind == Database.spelled(Conversation.PrivateChat))
    .where(DB.Schema.Conversations.organizationId == organizationId)
    .where(DB.Schema.Conversations.secondUser == userId)
    .all(as: Conversation)
    .try
  return Ok(asFirst + asSecond)
end

# Sets a channel's topic; whether there was such a channel. A private chat
# has no topic, and the condition on `kind` keeps it that way.
foul setTopic(id: String, topic: String) -> Bool or! String do
  return Database.update(DB.Schema.Conversations)
    .set({topic: topic}, columns: [:topic])
    .where(DB.Schema.Conversations.kind == Database.spelled(Channel))
    .where(DB.Schema.Conversations.id == id)
    .run
    .map { |changed| changed > 0 }
end

# How much of a conversation its bots may read: "no_bots", "mentions" or "all_bots".
foul setBotAccess(id: String, access: BotAccess) -> Bool or! String do
  return Database.update(DB.Schema.Conversations)
    .set({bot_access: access}, columns: [:bot_access])
    .where(DB.Schema.Conversations.id == id)
    .run
    .map { |changed| changed > 0 }
end

# A channel's settings at once: who may read it, the team that owns it, and
# how much its bots may read. Only a channel; a private chat or a group chat
# has its own ways.
foul configure(id: String, access: ConversationAccess, teamId: String, botAccess: BotAccess) -> Bool or! String do
  let found : Conversation? = find(id).try
  match found do
    None => return Error("that conversation is not there")
    Just(conversation) => do
      return Error("only a channel is configured this way") if !conversation.channel?
      return Database.transaction do
        Database.update(DB.Schema.Conversations)
          .set({access: access, team_id: teamId, bot_access: botAccess}, columns: [:access, :team_id, :bot_access])
          .where(DB.Schema.Conversations.id == id)
          .run
          .try
        # The team that owns the channel administers it, and only that team.
        if conversation.teamId != teamId
          if !conversation.teamId.empty?
            Grants.revoke(Grants.key(Grant.TeamSubject, conversation.teamId, Grant.ConversationResource, id)).try
          end
          if !teamId.empty?
            Grants.grant(Grant { subjectType: Grant.TeamSubject, subjectId: teamId, resourceType: Grant.ConversationResource, resourceId: id, role: Grant.Admin }).try
          end
        end
        Ok(true)
      end
    end
  end
end

private do
  # A conversation found, or none, with who takes part in it.
  foul single(row: Conversation?) -> Conversation? or! String do
    match row do
      None => return Ok(None)
      Just(found) => do
        let filled : [Conversation] = peopled([found]).try
        return Ok(filled.first)
      end
    end
  end

  # Conversations with who takes part filled in where it matters — in
  # private channels and group chats: everyone who may read one, which is
  # whoever holds a grant over it, a team's grant handing it to every
  # member of that team.
  foul peopled(conversations: [Conversation]) -> [Conversation] or! String do
    let closed = conversations.filter { |conversation| conversation.access == Private }
    return Ok(conversations) if closed.empty?

    let byConversation : {String: [String]} = participantsOf(closed.map { |each| each.id }).try
    return Ok(conversations.map do |conversation|
      Conversation { ...conversation, participants: byConversation.get(conversation.id).or([]) }
    end)
  end

  # Who takes part in some conversations, by conversation.
  foul participantsOf(ids: [String]) -> {String: [String]} or! String do
    return Grants.readersOf(Grant.ConversationResource, ids)
  end

  # The conversations a person takes part in, by id.
  foul taking(userId: String) -> [String] or! String do
    return Grants.conversationsOf(userId)
  end
end
