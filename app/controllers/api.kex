# The API bots use. Every request carries `Authorization: Bearer <token>`;
# the `bearer` plug (App.Controllers.Application) has found the bot before
# any of these run.
#
#   GET  /api/me
#   PUT  /api/commands                                 {"commands": [{"name": "model", "description": "…"}]}
#   GET  /api/events?after=<cursor>                    a WebSocket: what the
#                                                      bot may see happening,
#                                                      told as it happens
#   GET  /api/:organization/channels
#   GET  /api/:organization/channels/:name/messages?limit=50&after=<sentAt>
#   GET  /api/:organization/channels/:name/messages?thread=<message id>
#   POST /api/:organization/channels/:name/messages    {"body": "…", "thread": "<message id>"}
#                                                      or {"blocks": […]} in place of "body"
#   POST /api/:organization/channels/:name/reactions   {"message": "<id>", "emoji": "🎉"}
#   POST /api/:organization/channels/:name/status      {"text": "Deploying", "seconds": 30}
#   GET  /api/:organization/dm                         the private chats it has
#   GET  /api/:organization/groups                     the group chats it is in
#   GET  /api/:organization/answers?after=<answeredAt>
#                                                      the answers to the forms in
#                                                      its own messages
#   GET  /api/:organization/invocations?after=<invokedAt>
#                                                      the slash commands people
#                                                      used for it
#   GET  /api/:organization/dm/:person/messages
#   POST /api/:organization/dm/:person/messages
#   GET  /api/:organization/groups/:group/messages     (and reactions, status,
#   POST /api/:organization/groups/:group/messages      as for a channel)
#
# A channel is public, or private to the people in it — and to the members
# of the team that owns it. A bot is told of, and may use, the channels it
# may read, as a person would be: a private one only once it is in it.
#
# A message is rich text (app/helpers/rich_text.kex). It can be sent as the
# text a person would type — "*done* in `4s`" — or as blocks:
#
#   {"blocks": [
#     {"type": "heading", "text": "Deploy finished"},
#     {"type": "section", "text": "*api* is on `v1.4`"},
#     {"type": "list", "items": ["migrated", "restarted"]},
#     {"type": "quote", "text": "…"}, {"type": "code", "text": "…"}, {"type": "divider"}
#   ]}
#
# and every message read back carries both: "body" and "blocks".
#
# A form in a message is answered by using it, and an answer is not a
# message: it is kept with the message that asked. `answers` gives a bot
# the answers to the forms it asked itself — who answered, in which
# conversation, and what — and nothing can make one appear there but
# somebody using the bot's own form.
#
# A status is what the bot is in the middle of — "Thinking", "Deploying" —
# shown under the conversation the way "is typing" is for a person. It
# stands for `seconds` (30 unless said, 300 at most), or until the bot says
# something there, or until it sends an empty "text".
#
# A bot is a member like any other, and what it does goes through the same
# two functions a browser tab's events do (`App.Live.Addresses.tabFor` and
# `handled`), so it can read and write exactly what a person in its place
# could, and tabs that are open see what it writes at once.
module App.Controllers.Api

using Metro.WebRequest, only: [WebRequest]
using Net.HTTP.WebSocket, only: [Connection, Text, CloseMessage]
using App.Controllers.Application, only: [hubFor, statusesFor, eventsFor, liveFor, userFor]
using App.Live.Tab, only: [Tab]
using App.Models.Command, only: [Command]
using App.Models.Command, as: Command
using App.Models.Conversation, only: [Conversation]
using App.Models.Answer, only: [Answer]
using App.Models.Invocation, only: [Invocation]
using App.Models.Message, only: [Message, MessageId]
using App.Models.Message, as: Message
using App.Models.Organization, only: [Organization, OrganizationId]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, as: Conversations
using DB.Repositories.Messages, as: Messages
using DB.Repositories.Answers, as: Answers
using DB.Repositories.Users, as: Users

# The most messages one request is given.
let MOST = 200

# The longest a status stands without being said again, the longest it may
# be asked to, and the longest it may be.
let STATUS_SECONDS = 30
let STATUS_MOST = 300
let STATUS_LONGEST = 80

whoami : WebRequest -> WebRequest
foul whoami(request) do
  let bot = userFor(request)
  let mine : [Organization] = App.Live.Places.organizations(bot)
  let listed : [Any] = mine.map { |each| {"slug": each.slug, "name": each.name} }
  let answer : {String: Any} = {"id": bot.id, "name": bot.name, "bot": true, "organizations": listed, "operators": DB.Repositories.BotOperators.forBot(bot.id).or([])}
  return request.json(answer)
end

# The slash commands the bot answers to, all of them, replacing those it
# declared before: the composer offers them as somebody types `/`. A name
# is lower-case letters, digits and dashes (`model`, not `/model`).
commandsDeclared : WebRequest -> WebRequest
foul commandsDeclared(request) do
  let bot = userFor(request)
  let listed : [Any] = request.list("commands")
  let commands = listed.flatMap do |each|
    let fields : {String: Any} = each
    let name = "${fields.get("name").or("")}".trim.lowerCase
    let named = name.startsWith?("/") then name.drop(1) else name
    let description = "${fields.get("description").or("")}".trim.replace("\n", " ")
    if Command.named?(named)
      [Command { botId: bot.id, name: named, description: description.take(Command.LONGEST_DESCRIPTION) }]
    else
      []
    end
  end
  if commands.count != listed.count || commands.count > Command.MOST
    return failed(
      request,
      422,
      "Commands are at most ${Command.MOST}, each a name of lower-case letters, digits and dashes."
    )
  end

  match DB.Repositories.Commands.declare(bot.id, commands) do
    Error(reason) => return failed(request, 500, reason)
    Ok(_) => do
      hubFor(request).changed("api", "everyone")
      let names : [Any] = commands.map { |command| command.name }
      let answer : {String: Any} = {"ok": true, "commands": names}
      return request.json(answer)
    end
  end
end

channelList : WebRequest -> WebRequest
foul channelList(request) do
  let organization = organizationFor(request).try
  let bot = userFor(request)
  let found : [Conversation] = Conversations.channels(organization).or([])
  let listed : [Any] = App.Services.Authority.readable(bot, found)
    .map do |channel|
      let entry : {String: Any} = {
        "id": channel.id,
        "name": channel.title,
        "topic": channel.topic,
        "private": !channel.public?
      }
      entry
    end
  return request.json(listed)
rescue |error|
  return error
end

# The group chats the bot is in, in an organization: who each is with.
groupList : WebRequest -> WebRequest
foul groupList(request) do
  let organization = organizationFor(request).try
  let bot = userFor(request)
  let people : [User] = Users.everyone.or([])
  let found : [Conversation] = Conversations.groups(organization, bot.id).or([])
  let listed : [Any] = found.map do |chat|
    let others = chat.participants.reject { |id| id == bot.id }
    let names : [Any] = others.map do |id|
      people.find { |each| each.id == id }.map { |each| each.shown }.or("Someone")
    end
    let ids : [Any] = others
    let entry : {String: Any} = {"id": chat.id, "people": ids, "names": names}
    entry
  end
  return request.json(listed)
rescue |error|
  return error
end

# The private chats the bot has in an organization: who each is with. A
# chat is there once somebody has opened one with the bot; asking does not
# make any.
chatList : WebRequest -> WebRequest
foul chatList(request) do
  let organization = organizationFor(request).try
  let bot = userFor(request)
  let people : [User] = Users.everyone.or([])
  let found : [Conversation] = Conversations.directs(organization, bot.id).or([])
  let listed : [Any] = found.map do |chat|
    let other = chat.firstUser == bot.id then chat.secondUser else chat.firstUser
    let person = people.find { |each| each.id == other }
    {
      "id": chat.id,
      "person": other,
      "name": person.map { |each| each.shown }.or("Someone"),
      "bot": person.map { |each| each.bot? }.or(false)
    }
  end
  return request.json(listed)
rescue |error|
  return error
end

# The answers to the forms in the bot's own messages, oldest first: each
# says which message, where that is — a channel or the private chat with a
# person, and the thread if it is in one — who answered, and what. `after`
# leaves out the ones a bot has already had.
answerList : WebRequest -> WebRequest
foul answerList(request) do
  let organization = organizationFor(request).try
  let bot = userFor(request)
  let since = request.query("after").or("0").to(Integer).or(0)
  let people : [User] = Users.everyone.or([])
  let found = Answers.askedBy(organization, bot.id).or([]).filter { |each| each.answeredAt > since }
  let listed : [Any] = found.flatMap { |each| placedAnswer(bot, people, each) }
  return request.json(listed)
rescue |error|
  return error
end

# The slash commands people used for this bot since `after`, oldest first:
# which, with what after it, by whom, and where — the channel or the
# person of a private chat, and the thread, "" for none. Not messages: the
# bot answers as it likes, where it was used.
invocationList : WebRequest -> WebRequest
foul invocationList(request) do
  let organization = organizationFor(request).try
  let bot = userFor(request)
  let since = request.query("after").or("0").to(Integer).or(0)
  let people : [User] = Users.everyone.or([])
  let found = DB.Repositories.Invocations.forBot(organization, bot.id, since).or([])
  let listed : [Any] = found.flatMap do |each|
    match Conversations.find(each.conversationId) do
      Ok(Just(conversation)) => [toldInvocation(bot, people, each, conversation)]
      _ => []
    end
  end
  return request.json(listed)
rescue |error|
  return error
end

# The newest messages of a conversation — a channel, or the private chat
# with a person — oldest first. Replies are not among them: `thread` asks
# for one thread instead, the message it hangs from and then its replies.
history : WebRequest -> WebRequest
foul history(request) do
  let thread = request.query("thread").or("").trim
  let (tab, conversation) = placed(request, thread).try
  if !App.Services.Authority.botMayRead(userFor(request), conversation, tab.thread)
    return request.json([])
  end
  return request.json(unfolded(conversation, tab.thread)) if !thread.empty?

  let asked = request.query("limit").or("50").to(Integer).or(50)
  let limit = asked < 1 || asked > MOST then MOST else asked
  let since = request.query("after").or("0").to(Integer).or(0)
  let people : [User] = Users.everyone.or([])
  let found : [Message] = Messages.latest(conversation.id, limit).or([])
  let listed : [Any] = found.filter { |message| message.sentAt > since }.map { |message| described(message, people) }
  return request.json(listed)
rescue |error|
  return error
end

# Says something, in the conversation or — with `thread` — in a thread.
posted : WebRequest -> WebRequest
foul posted(request) do
  let thread = request.field("thread").or("").trim
  let typed = request.field("body").or("").trim
  let body = typed.empty? then App.Helpers.RichText.composed(request.list("blocks")) else typed
  let (tab, conversation) = placed(request, thread).try

  let bot = userFor(request)
  if bot.bot? && conversation.botsForbidden?
    return failed(request, 403, "Bots may not write in this conversation.")
  end
  let event = thread.empty? then "message-send" else "message-reply"
  let (_, changed) = App.Live.Chat.handled(liveFor(request), eventsFor(request), statusesFor(request), userFor(request), tab, [("event", Just(event)), ("body", Just(body))])
  return failed(request, 422, "Not sent: a message needs a body of at most ${Message.LONGEST} characters, and a thread has to be a message of this conversation.") if !changed

  hubFor(request).changed("api", "everyone")
  let people : [User] = Users.everyone.or([])
  let inChannel : [Message] = Messages.latest(conversation.id, 1).or([])
  let inThread : [Message] = Messages.replies(tab.thread).or([])
  let newest = thread.empty? then inChannel else inThread.reverse.take(1)
  let answer : {String: Any} = newest.first.map { |message| described(message, people) }.or({})
  return request.json(201, answer)
rescue |error|
  return error
end

# Puts an emoji on a message, or takes the bot's own one off again.
reacting : WebRequest -> WebRequest
foul reacting(request) do
  let (tab, _) = placed(request, "").try
  let fields = [("event", Just("message-react")), ("message", request.field("message")), ("emoji", request.field("emoji"))]
  let (_, changed) = App.Live.Chat.handled(liveFor(request), eventsFor(request), statusesFor(request), userFor(request), tab, fields)
  return failed(request, 422, "Not done: the message has to be one of this conversation, and the emoji one of the reactions Slick offers.") if !changed

  hubFor(request).changed("api", "everyone")
  return request.json({"ok": true})
rescue |error|
  return error
end

# Says what the bot is doing in a conversation, or takes it back.
statusSet : WebRequest -> WebRequest
foul statusSet(request) do
  let (tab, _) = placed(request, "").try
  let text = request.field("text").or("").trim.replace("\n", " ").take(STATUS_LONGEST)
  let asked = request.field("seconds").or("").to(Integer).or(STATUS_SECONDS)
  let seconds = asked < 1 || asked > STATUS_SECONDS then STATUS_SECONDS else asked
  App.Live.Statuses.say(statusesFor(request), userFor(request), tab, text, text.empty? then 0 else seconds * 1000)
  hubFor(request).changed("api", "everyone")
  let answer : {String: Any} = {"ok": true, "text": text, "seconds": text.empty? then 0 else seconds}
  return request.json(answer)
rescue |error|
  return error
end

# A bot's socket: what it may see happening, told as it happens
# (App.Live.Events), until it goes away.
#
# The bot says how far it has already seen — `?after=<cursor>`, the newest
# cursor it was told — and is answered with what has happened since and then
# everything as it happens, one JSON telling a message:
#
#   {"kind":"reset","cursor":41}                          start again: one
#                                                         full look, then
#                                                         carry on from 41
#   {"kind":"message","cursor":42,"organization":"acme",
#    "place":"channels/general","thread":"","message":"m7",
#    "at":1729…,"access":"all"}                           a message said;
#                                                         access is how much
#                                                         of the place the
#                                                         bot may read
#   {"kind":"answer",…,"place":"dm/u1791","thread":"m7",
#    "message":"m9",…}                                    a form answered
#   {"kind":"command",…}                                  a command used
#   {"kind":"ready","cursor":44}                          the catch-up ends
#
# A message, a form answered or a command used is fetched through the API as
# ever (`history`, `answers`, `invocations`), each telling only where. The
# token is the bot's own — in the Authorization header, or `?token=` for a
# client that cannot send one (the `botsocket` pipeline).
evented : WebRequest -> Net.HTTP.WebSocket.Connection -> Void
foul evented(request, socket) do
  let bot = userFor(request)
  let mine : [Organization] = App.Live.Places.organizations(bot)
  let ids : [OrganizationId] = mine.map { |each| each.id }
  let after = request.query("after").or("0").to(Integer).or(0)
  let seat = "${Metro.Id.serial()}"
  eventsFor(request).joined(seat, bot.id, bot.name, ids, after, socket)
  loop do
    match socket.receiveMessage do
      Ok(CloseMessage(_, _)) => break
      Ok(Text(_)) => Void
      Ok(_) => Void
      Error(_) => break
    end
  end
  eventsFor(request).left(seat)
end

private do
  # A response as the API tells it, with where its message is. Nothing for
  # one whose message or conversation is gone.
  foul placedAnswer(bot: User, people: [User], given: Answer) -> [Any] do
    match Messages.find(given.messageId) do
      Ok(Just(message)) => match Conversations.find(given.conversationId) do
        Ok(Just(conversation)) => return [toldAnswer(bot, people, given, message, conversation)]
        _ => return []
      end
      _ => return []
    end
  end

  toldAnswer : User -> [User] -> Answer -> Message -> Conversation -> {String: Any}
  let toldAnswer(bot, people, given, message, conversation) do
    let author = people.find { |person| person.id == given.userId }.map { |person| person.shown }.or("Someone")
    {
      "message": message.id,
      "thread": message.parentId,
      "channel": conversation.channel? then conversation.title else "",
      "person": conversation.direct? then conversation.counterpart(bot.id) else "",
      "group": conversation.group? then conversation.id else "",
      "user": given.userId,
      "author": author,
      "form": given.form,
      "answer": given.answer,
      "answeredAt": given.answeredAt
    }
  end

  toldInvocation : User -> [User] -> Invocation -> Conversation -> {String: Any}
  let toldInvocation(bot, people, used, conversation) = {
    "id": used.id,
    "command": used.command,
    "arguments": used.arguments,
    "channel": conversation.channel? then conversation.title else "",
    "person": conversation.direct? then conversation.counterpart(bot.id) else "",
    "group": conversation.group? then conversation.id else "",
    "thread": used.threadId,
    "user": used.userId,
    "author": people.find { |person| person.id == used.userId }.map { |person| person.shown }.or("Someone"),
    "invokedAt": used.invokedAt
  }

  # A thread as the API tells it: the message it hangs from, then the
  # replies, oldest first. Nothing, when the message is not one of this
  # conversation's.
foul unfolded(conversation: Conversation, rootId: MessageId) -> [Any] do
    match Messages.find(rootId) do
      Ok(Just(root)) => do
        let none : [Any] = []
        return none if root.conversationId != conversation.id

        let people : [User] = Users.everyone.or([])
        let replies : [Message] = Messages.replies(root.id).or([])
        let listed : [Any] = ([root] + replies).map { |message| described(message, people) }
        return listed
      end
      _ => return []
    end
  end

  failed : WebRequest -> Integer -> String -> WebRequest
  let failed(request, status, reason) = request.json(status, {"error": reason})

  # The organization a request's address names, as the bot is in it — or the
  # 404 that says it is not.
  organizationFor : WebRequest -> String or! WebRequest
  foul organizationFor(request) do
    let slug = request.param("organization").or("")
    let tab = App.Live.Addresses.tabFor(userFor(request), Config.RoutePaths.channel.filled({"organization": slug, "name": "general"}))
    return Error(failed(request, 404, "There is no such organization, or this bot is not in it.")) if tab.organization.empty?
    return Ok(tab.organization)
  end

  # The conversation the address names, and a tab showing it — if the bot
  # may read it. A route with `:person` is the private chat with them; one
  # with `:group` a group chat; one with `:name` a channel.
  placed : WebRequest -> String -> (Tab, Conversation) or! WebRequest
  foul placed(request, thread) do
    let bot = userFor(request)
    let slug = request.param("organization").or("")
    let channel = Config.RoutePaths.channel.filled({"organization": slug, "name": request.param("name").or("")})
    let direct = Config.RoutePaths.direct.filled({"organization": slug, "person": request.param("person").or("")})
    let group = Config.RoutePaths.group.filled({"organization": slug, "group": request.param("group").or("")})
    let address = if request.param("person").set?
      direct
    elif request.param("group").set?
      group
    else
      channel
    end
    let tab = App.Live.Addresses.tabFor(bot, App.Paths.threaded(address, thread))
    return Error(failed(request, 404, "There is no such conversation, or this bot is not in it.")) if tab.conversation.empty?

    match App.Live.Places.visible(bot, tab) do
      Just(conversation) => return Ok((tab, conversation))
      None => return Error(failed(request, 404, "There is no such conversation, or this bot is not in it."))
    end
  end

  described : Message -> [User] -> {String: Any}
  let described(message, people) do
    let author = people.find { |person| person.id == message.userId }
    {
      "id": message.id, "user": message.userId, "author": author.map { |person| person.shown }.or("Someone"),
      "bot": author.map { |person| person.bot? }.or(false), "body": message.body, "blocks": App.Helpers.RichText.described(message.body), "sentAt": message.sentAt,
      "sentOn": "${DateTime.fromEpochSeconds(message.sentAt / 1000)}", "thread": message.parentId, "replies": message.replyCount
    }
  end
end
