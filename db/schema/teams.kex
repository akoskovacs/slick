# The `teams` table: named sets of people, by organization. See
# db/migrate/N0020_create_teams.kex.
module DB.Schema.Teams

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :teams do |t|
  t.text(:id, primaryKey: true)
  t.text(:organization_id)
  t.text(:handle)
  t.text(:name)
  t.text(:description, default: "")
  t.text(:external_id, default: "")
  t.text(:managed, default: "")
  t.text(:created_by, default: "")
  t.text(:created_at)
end

let id = DB.Schema.Teams.definition.textColumn(:id)
let organizationId = DB.Schema.Teams.definition.textColumn(:organization_id)
let handle = DB.Schema.Teams.definition.textColumn(:handle)
let externalId = DB.Schema.Teams.definition.textColumn(:external_id)
let managed = DB.Schema.Teams.definition.textColumn(:managed)
