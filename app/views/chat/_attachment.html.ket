---
params: [file: Enclosure]
---
<% if file.picture? %>
  <a class="attachment picture" href="<%= file.link %>" target="_blank" rel="noopener">
    <img src="<%= file.link %>" alt="<%= file.caption %>" loading="lazy">
  </a>
<% else %>
  <a class="attachment" href="<%= file.link %>" target="_blank" rel="noopener">
    <span class="kind" aria-hidden="true">📄</span>
    <span class="about"><strong><%= file.caption %></strong><span><%= file.weight %></span></span>
  </a>
<% end %>
