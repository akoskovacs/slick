# Who is signed in where. It only ever sees token digests.
#
#   DB.Repositories.Sessions.holder(digest)
module DB.Repositories.Sessions

using Harmat.Database, as: Database

foul admit(tokenDigest: String, userId: String, expiresAt: Integer) -> Result<Integer, String> do
  let row = {
    token_digest: tokenDigest,
    user_id: userId,
    expires_at: expiresAt,
    created_at: Metro.Clock.milliseconds()
  }
  return Database.insert(DB.Schema.Sessions)
    .values(row)
    .run
end

# Whose session a digest is, and when it expires (seconds since 1970).
foul holder(tokenDigest: String) -> Result<(String, Integer)?, String> do
  return Database.select().from(DB.Schema.Sessions)
    .where(DB.Schema.Sessions.tokenDigest == tokenDigest)
    .first(as: Session)
    .map { |session| session.map { |held| (held.userId, held.expiresAt) } }
end

foul revoke(tokenDigest: String) -> Result<Bool, String> do
  return Database.delete(DB.Schema.Sessions)
    .where(DB.Schema.Sessions.tokenDigest == tokenDigest)
    .run
    .map { |count| count > 0 }
end

private do
  # Only the fields authentication needs; token digests stay in the query.
  record Session do
    userId : String
    expiresAt : Integer
  end
end
