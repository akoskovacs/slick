---
params: [entry: Entry]
---
<li>
  <button type="button" class="entry<% if entry.current? %> current<% end %><% if entry.online? %> online<% end %><% if !entry.unread.empty? %> unread<% end %>" data-event="<%= entry.action %>" data-<%= entry.subject %>="<%= entry.key %>"><%= entry.caption %>
    <% if !entry.emblem.empty? %>
      <span class="emblem" title="<%= entry.emblemNote %>"><%= entry.emblem %></span>
    <% end %>
    <% if entry.drafted? %>
      <span class="drafted" title="Written and not sent">✏️</span>
    <% end %>
    <% if !entry.badged.empty? %>
      <span class="flag"><%= entry.badged %></span>
    <% end %>
    <% if !entry.unread.empty? %>
      <span class="count" aria-label="<%= entry.unread %> unread"><%= entry.unread %></span>
    <% end %>
  </button>
</li>
