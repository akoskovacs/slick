# How far people have read, in conversations and in the threads they
# follow.
#
#   DB.Repositories.Readings.reached(user.id, Reading {
#     conversationId: chat.id,
#     readAt: message.sentAt
#   })
module DB.Repositories.Readings

using Harmat.Database, as: Database
using App.Models.Reading, only: [Reading]

# Everywhere a person has read: each conversation, and each thread they
# follow.
foul marks(userId: String) -> Result<[Reading], String> do
  return Database.select([:conversation_id, :thread_id, :read_at]).from(DB.Schema.Readings)
    .where(DB.Schema.Readings.userId.eq(userId))
    .all
    .map { |rows| rows.map { |row| decoded(row) } }
end

# Notes how far a person has read a conversation, or a thread of it: the
# old mark and the new one swapped in one transaction.
foul reached(userId: String, reading: Reading) -> Result<Integer, String> do
  let place = "${userId}:${reading.conversationId}"
  let id = reading.threadId.empty? then place else "${place}:${reading.threadId}"
  let row = {
    id: id,
    user_id: userId,
    conversation_id: reading.conversationId,
    thread_id: reading.threadId,
    read_at: reading.readAt
  }
  let swapped : Result<Integer, String> = Database.transaction do
    Database.delete(DB.Schema.Readings)
      .where(DB.Schema.Readings.id.eq(id))
      .run
      .try
    Database.insert(DB.Schema.Readings)
      .values(row)
      .run
  end
  return swapped
end

private do
  decoded : {String: String} -> Reading
  let decoded(row) = Reading {
    conversationId: row.get("conversation_id").or(""),
    threadId: row.get("thread_id").or(""),
    readAt: row.get("read_at").or("0").to(Integer).or(0)
  }
end
