# Every table this application declares: what `Harmat.Table.drift` holds the
# migrations against. One file each in db/schema.
module DB.Schema

using Harmat.Table, only: [Definition]

# Each table under the name of its own module, so that a query reads
# `.from(DB.Schema.Users.definition)` and a condition
# `DB.Schema.Users.email == email`: the module has typed columns, and its
# `definition` is the table value.
tables : [Definition]
let tables = [
  DB.Schema.BotOperators.definition,
  DB.Schema.Users.definition,
  DB.Schema.Sessions.definition,
  DB.Schema.Conversations.definition,
  DB.Schema.Messages.definition,
  DB.Schema.Reactions.definition,
  DB.Schema.Organizations.definition,
  DB.Schema.Answers.definition,
  DB.Schema.Drafts.definition,
  DB.Schema.Readings.definition,
  DB.Schema.Files.definition,
  DB.Schema.Commands.definition,
  DB.Schema.Invocations.definition,
  DB.Schema.Teams.definition,
  DB.Schema.Grants.definition
]
