# A thread, open beside the conversation: the message that started it, its
# replies, and a box to reply in.
module App.Views.Chat.Threads

using App.Models.Message, only: [Message]
using App.Views.Chat.Names, only: [tallied]
using App.Views.Chat.Messages, only: [Room, bubble, woven]
using App.Views.Chat.Composer, only: [mentionable, offered, picked]

let composerPartial = Template.html(Kex.embed("_composer.html.ket"))
let threadPartial = Template.html(Kex.embed("_thread.html.ket"))

# The id of the message an open thread starts with; "" when none is open.
opened : [Message] -> String
let opened([]) = ""
let opened([opening | replies]) = opening.id

# The thread beside the conversation: its first message, then the replies.
pane : Room -> [Message] -> String -> String
let pane(room, thread, unsent) do
  let opener = thread.take(1).map { |message| bubble(room, message, true, false) }.join("")
  let uses = room.invocations.filter { |used| used.threadId == opened(thread) }
  let followups = woven(room, thread.drop(1), uses, "", 0, true)
  let summary = followups.empty? then "No replies yet" else tallied(followups.count)
  let composer = composerPartial(
    "message-reply",
    "reply-box",
    "Reply…",
    picked("#reply-box"),
    true,
    unsent,
    "",
    false,
    mentionable(room),
    offered(room)
  )
  threadPartial(opened(thread), opener, summary, followups.join("\n"), composer)
end
