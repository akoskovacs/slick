# What one browser tab is in the middle of. Nothing here is stored: it lives
# as long as the tab's WebSocket does.
module App.Live.Tab

record Tab do
  # The organization the tab is in, by id; "" is the first one its person
  # belongs to.
  organization : String = ""
  # The conversation the tab is showing, by id; "" is the organization's
  # #general.
  conversation : String = ""
  # The message whose thread is open beside it, by id; "" when none is.
  thread : String = ""
  # The person or bot whose profile is open beside it, by id; "" when none
  # is. A profile, a team and a thread take the same place, so each closes
  # the others.
  profile : String = ""
  # The team open beside it, by id; "" when none is.
  team : String = ""
  # Whether the topic is being edited.
  retitling? : Bool = false
  # The dialog that is open — "channel", "group", "promote", "admit",
  # "team", "team-edit", "organization", "invite", "status", "profile" or
  # "bots" — and what was wrong with its last try.
  dialog : String = ""
  dialogProblem : String = ""
  notice : String = ""
  # A bot's new token and whose it is: shown while the dialog stays open,
  # and gone with it.
  secret : String = ""
  secretFor : String = ""
  failure : String = ""
  # Files uploaded into the conversation and waiting, in the message box,
  # to be sent with the next message: their ids.
  pending : [String] = []
  # What the conversation's pane shows: "" for its messages, "files" for
  # what has been sent into it.
  view : String = ""
  # Whether the person is looking at it: the page shown and its window in
  # front. What arrives while they are not has not been read.
  attentive? : Bool = true
end

# The tab with nothing open over the conversation: no form, no dialog, no
# message left from the last thing tried. Everything else it keeps.
closed : Tab -> Tab
let closed(tab) = Tab {
  ...tab,
  retitling?: false,
  dialog: "",
  dialogProblem: "",
  notice: "",
  secret: "",
  secretFor: "",
  failure: ""
}
