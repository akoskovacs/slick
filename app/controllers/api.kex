# The API bots use. Every request carries `Authorization: Bearer <token>`.
#
#   GET  /api/me
#   GET  /api/:organization/channels
#   GET  /api/:organization/channels/:name/messages?limit=50&after=<sentAt>
#   POST /api/:organization/channels/:name/messages    {"body": "…", "thread": "<message id>"}
#   POST /api/:organization/channels/:name/reactions   {"message": "<id>", "emoji": "🎉"}
#   GET  /api/:organization/dm/:person/messages
#   POST /api/:organization/dm/:person/messages
#
# A bot is a member like any other, and what it does goes through the same
# two functions a browser tab's events do (`App.Live.Chat.arrived` and
# `handled`), so it can read and write exactly what a person in its place
# could, and tabs that are open see what it writes at once.
module App.Controllers.Api

using Harmat.Db, only: [Db]
using Rodolfo
using Metro.Live.Hub, only: [Hub]
using App.Live.Tab, only: [Tab]
using App.Models.Conversation, only: [Conversation]
using App.Models.Message, only: [Message]
using App.Models.Organization, only: [Organization]
using App.Models.User, only: [User]
using DB.Repositories.Conversations, only: [ConversationRepository]
using DB.Repositories.Messages, only: [MessageRepository]
using DB.Repositories.Users, only: [UserRepository]

# The most messages one request is given.
let MOST = 200

whoami : Db -> Context -> Rodolfo.Reply
foul whoami(database, env) do
  match App.Services.Bots.bearer(database, env.request.headers.get("Authorization")) do
    None => return refused()
    Just(bot) => do
      let mine : [Organization] = App.Live.Chat.organizations(database, bot)
      let listed : [Any] = mine.map { |each| {"slug": each.slug, "name": each.name} }
      let answer : {String: Any} = {"id": bot.id, "name": bot.name, "bot": true, "organizations": listed}
      return Response.JSON { body: JSON.stringify(answer) }
    end
  end
end

channelList : Db -> Context -> Rodolfo.Reply
foul channelList(database, env) do
  match App.Services.Bots.bearer(database, env.request.headers.get("Authorization")) do
    None => return refused()
    Just(bot) => do
      let slug = env.param("organization").or("")
      let tab = App.Live.Chat.arrived(database, bot, "/${slug}/channels/general")
      return failed(404, "There is no such organization, or this bot is not in it.") if tab.organization.empty?

      let found : [Conversation] = ConversationRepository { db: database }.channels(tab.organization).or([])
      let listed : [Any] = found.map { |channel| {"id": channel.id, "name": channel.title, "topic": channel.topic} }
      return Response.JSON { body: JSON.stringify(listed) }
    end
  end
end

# The newest messages of a conversation, oldest first. `kind` is "channels"
# or "dm": which of the two addresses the route was.
history : Db -> Context -> String -> Rodolfo.Reply
foul history(database, env, kind) do
  match placed(database, env, kind, "") do
    Error(reply) => return reply
    Ok((bot, tab, conversation)) => do
      let asked = env.query("limit").or("50").to(Integer).or(50)
      let limit = asked < 1 || asked > MOST then MOST else asked
      let since = env.query("after").or("0").to(Integer).or(0)
      let people : [User] = UserRepository { db: database }.everyone.or([])
      let found : [Message] = MessageRepository { db: database }.latest(conversation.id, limit).or([])
      let listed : [Any] = found.filter { |message| message.sentAt > since }.map { |message| described(message, people) }
      return Response.JSON { body: JSON.stringify(listed) }
    end
  end
end

# Says something, in the conversation or — with `thread` — in a thread.
posted : Db -> Server<Hub> -> Context -> String -> Rodolfo.Reply
foul posted(database, hub, env, kind) do
  let thread = given(env, "thread")
  let body = given(env, "body")
  match placed(database, env, kind, thread) do
    Error(reply) => return reply
    Ok((bot, tab, conversation)) => do
      let event = thread.empty? then "send" else "reply"
      let (_, changed) = App.Live.Chat.handled(database, bot, tab, [("event", Just(event)), ("body", Just(body))])
      return failed(422, "Not sent: a message needs a body of at most ${App.Models.Message.LONGEST} characters, and a thread has to be a message of this conversation.") if !changed

      hub.changed("api", "everyone")
      let people : [User] = UserRepository { db: database }.everyone.or([])
      let inChannel : [Message] = MessageRepository { db: database }.latest(conversation.id, 1).or([])
      let inThread : [Message] = MessageRepository { db: database }.answering(tab.thread).or([])
      let newest = thread.empty? then inChannel else inThread.reverse.take(1)
      let answer : {String: Any} = newest.first.map { |message| described(message, people) }.or({})
      return Response.JSON { status: 201, body: JSON.stringify(answer) }
    end
  end
end

# Puts an emoji on a message, or takes the bot's own one off again.
reacting : Db -> Server<Hub> -> Context -> String -> Rodolfo.Reply
foul reacting(database, hub, env, kind) do
  match placed(database, env, kind, "") do
    Error(reply) => return reply
    Ok((bot, tab, conversation)) => do
      let (_, changed) = App.Live.Chat.handled(database, bot, tab, [("event", Just("react")), ("message", Just(given(env, "message"))), ("emoji", Just(given(env, "emoji")))])
      return failed(422, "Not done: the message has to be one of this conversation, and the emoji one of the reactions Slick offers.") if !changed

      hub.changed("api", "everyone")
      return Response.JSON { body: JSON.stringify({"ok": true}) }
    end
  end
end

private do
  failed : Integer -> String -> Rodolfo.Reply
  let failed(status, reason) = Response.JSON { status: status, body: JSON.stringify({"error": reason}) }

  refused : Rodolfo.Reply
  let refused() = failed(401, "Send a bot's token as: Authorization: Bearer <token>")

  # The bot asking, and the conversation the address names — if there is
  # such a bot, and it may read that conversation.
  placed : Db -> Context -> String -> String -> Result<(User, Tab, Conversation), Rodolfo.Reply>
  foul placed(database, env, kind, thread) do
    match App.Services.Bots.bearer(database, env.request.headers.get("Authorization")) do
      None => return Error(refused())
      Just(bot) => do
        let slug = env.param("organization").or("")
        let subject = env.param("name").or("")
        let suffix = thread.empty? then "" else "?thread=${thread}"
        let tab = App.Live.Chat.arrived(database, bot, "/${slug}/${kind}/${subject}${suffix}")
        return Error(failed(404, "There is no such conversation, or this bot is not in it.")) if tab.conversation.empty?

        match App.Live.Chat.visible(database, bot, tab) do
          Just(conversation) => return Ok((bot, tab, conversation))
          None => return Error(failed(404, "There is no such conversation, or this bot is not in it."))
        end
      end
    end
  end

  # One field of what was sent: of a JSON object, or of a form.
  given : Context -> String -> String
  let given(env, name) do
    let text = env.request.body.to(String).or("").trim
    return env.form(name).or("").trim if text.take(1) != "{"

    match JSON.parse(text) do
      Ok(value) => do
        let fields : {String: Any} = value
        match fields.get(name) do
          Just(found) => return "${found}".trim
          None => return ""
        end
      end
      Error(_) => return ""
    end
  end

  described : Message -> [User] -> {String: Any}
  let described(message, people) do
    let author = people.find { |person| person.id == message.userId }
    {
      "id": message.id, "user": message.userId, "author": author.map { |person| person.shown }.or("Someone"),
      "bot": author.map { |person| person.bot? }.or(false), "body": message.body, "sentAt": message.sentAt,
      "sentOn": message.sentOn, "thread": message.parentId, "replies": message.replyCount
    }
  end
end
