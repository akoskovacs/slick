# What an event did to a tab: the tab's next state, and whether it changed
# something other tabs show — in which case they are told to refresh.
# `Metro.Live.Socket.unchanged` and `changed` answer the plain cases; these
# are the ones that leave the tab saying what went wrong.
module App.Live.Outcome

using App.Live.Tab, only: [Tab, closed]

type Outcome = (Tab, Bool)

# A dialog left open, saying what was wrong with its last try.
refused : Tab -> String -> String -> Outcome
let refused(tab, dialog, problem) = (Tab {
  ...closed(tab),
  dialog: dialog,
  dialogProblem: problem
}, false)

# The conversation's pane, saying what went wrong.
failed : Tab -> String -> Outcome
let failed(tab, reason) = (Tab { ...closed(tab), failure: reason }, false)
