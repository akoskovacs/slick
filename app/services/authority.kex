# Grant lookups that start with an id, rather than a User or Organization
# record. Checks that act on a User live in `make User`.
module App.Services.Authority

using App.Models.Ids, only: [UserId]
using App.Models.Team, only: [TeamId]
using App.Models.Grant, only: [Grant, GrantResourceType, GrantRole, UserSubject, TeamSubject, Admin, Member, ReadOnly]
using App.Models.Grant, as: Grant
using DB.Repositories.Grants, as: Grants

# The strongest role a user — by id — holds over a resource, directly or
# through a team they are in; `None` for none.
foul role(userId: UserId, resourceType: GrantResourceType, resourceId: String) -> GrantRole? do
  let teams : [TeamId] = Grants.teamsOf(userId).or([])
  return roleAmong(userId, teams, Grants.over(resourceType, resourceId).or([]))
end

private do
  # The strongest role a user holds among some grants: their own, or one of
  # their teams'.
  roleAmong : UserId -> [TeamId] -> [Grant] -> GrantRole?
  let roleAmong(userId, teams, grants) do
    let roles = grants.flatMap do |grant|
      let held = grant.subjectType == UserSubject && grant.subjectId == userId
      let viaTeam = grant.subjectType == TeamSubject && teams.contains?(grant.subjectId)
      held || viaTeam then [grant.role] else []
    end
    strongest(roles)
  end

  # The strongest of some roles: admin, else member, else read-only.
  strongest : [GrantRole] -> GrantRole?
  let strongest(roles) do
    return Just(Admin) if roles.contains?(Admin)
    return Just(Member) if roles.contains?(Member)
    return Just(ReadOnly) if roles.contains?(ReadOnly)
    return None
  end
end
