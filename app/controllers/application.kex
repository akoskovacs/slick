# What every controller shares: who is asking, what the application runs on,
# and the plugs that decide who gets as far as an action.
#
# The hub and the statuses board are put on every request by the router's
# first pipeline (config/routes.kex); these read them back, with their
# types. The database is not among them: queries reach it on their own,
# through `Harmat.Connection`.
module App.Controllers.Application

using Metro.WebRequest, only: [WebRequest, Plug, plug]
using Metro.Live.Hub, only: [Hub]
using Metro.Live.Presence, only: [Presence]
using App.Live.Events, only: [Bus]
using App.Models.User, only: [User]

# The cookie a session's token travels in.
let COOKIE = "slick_session"

hubFor : WebRequest -> Server<Hub>
foul hubFor(request) do
  let found : Server<Hub> = request.assigned(:hub).try
  return found
end

statusesFor : WebRequest -> Server<Presence>
foul statusesFor(request) do
  let found : Server<Presence> = request.assigned(:statuses).try
  return found
end

# The bus of what happens, put on every request by the router's first
# pipeline.
eventsFor : WebRequest -> Server<Bus>
foul eventsFor(request) do
  let found : Server<Bus> = request.assigned(:events).try
  return found
end

# The person signed in, behind `signedIn`; the bot asking, behind `bearer`.
userFor : WebRequest -> User
foul userFor(request) do
  let found : User = request.assigned(:user).try
  return found
end

# A page of the application: its stylesheet and scripts — its own and
# Metro's — addressed by what is in them, so a changed file is always
# fetched again.
page : WebRequest -> Integer -> String -> WebRequest
foul page(request, status, markup) = request.html(status, Metro.Assets.marked(markup, "public", ["/app.css", "/app.js"]))

# Who a request's session cookie says is asking.
visitor : WebRequest -> User?
foul visitor(request) = App.Services.Authentication.current(request.cookie(COOKIE))

# Lets a signed-in request through, noting who it is; sends anyone else to
# sign in.
foul signedIn() -> Plug = plug do |request|
  match visitor(request) do
    Just(user) => request.assign(:user, user)
    None => request.redirect("/signin")
  end
end

# The reverse, for the sign-in and registration pages.
foul signedOut() -> Plug = plug do |request|
  visitor(request).set? then request.redirect("/") else request
end

# Lets a bot through by its token, noting which bot. No cookie is read on
# this side of the application, so there is no request another site could
# forge and no origin to check.
foul bearer() -> Plug = plug do |request|
  match App.Services.Bots.bearer(request.header("Authorization")) do
    Just(bot) => request.assign(:user, bot)
    None => request.json(401, {"error": "Send a bot's token as: Authorization: Bearer <token>"})
  end
end

# The same, for a WebSocket: a client that cannot send a header — Kex's
# among them — sends the token in the address instead, as ?token=<token>.
foul socketBearer() -> Plug = plug do |request|
  let fromHeader = App.Services.Bots.bearer(request.header("Authorization"))
  let fromAddress = App.Services.Bots.bearer(Just("Bearer ${request.query("token").or("").trim}"))
  let found = match fromHeader do
    Just(bot) => Just(bot)
    None => fromAddress
  end
  match found do
    Just(bot) => request.assign(:user, bot)
    None => request.json(401, {"error": "Send a bot's token as: Authorization: Bearer <token>, or /api/events?token=<token>"})
  end
end
