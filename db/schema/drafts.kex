# The `drafts` table. See db/migrate/N0014_create_drafts.kex.
module DB.Schema.Drafts

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :drafts, doc: "What somebody has written and not sent, in each message box" do |t|
  t.text(:id, primaryKey: true)
  t.belongsTo(:user, :users)
  t.belongsTo(:conversation, :conversations)
  t.belongsTo(:thread, :messages, doc: "The message a thread starts with; empty for the conversation's own box")
  t.belongsTo(:person, :users, doc: "Who a private chat is with; empty elsewhere")
  t.text(:body)
  t.bigint(:saved_at)
end

let table = DB.Schema.Drafts.definition.table

let id = DB.Schema.Drafts.definition.textColumn(:id)
let userId = DB.Schema.Drafts.definition.textColumn(:user_id)
let conversationId = DB.Schema.Drafts.definition.textColumn(:conversation_id)
