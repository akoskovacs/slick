# The `messages` table.
module DB.Schema.Messages

using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]

let definition = Table.define :messages, doc: "What was said, and replies in threads" do |t|
  t.text(:id, primaryKey: true)
  t.belongsTo(:conversation, :conversations)
  t.belongsTo(:user, :users)
  t.text(:body)
  t.bigint(:sent_at, doc: "Milliseconds since 1970")
  t.text(:sent_on)
  t.belongsTo(:parent, :messages, default: "", doc: "The message a reply answers; empty for one that is not a reply")
  t.int(:reply_count, default: 0)
  t.hasMany(:drafts, :drafts)
  t.hasMany(:readings, :readings)
  t.hasMany(:files, :files)
  t.hasMany(:reactions, :reactions)
  t.hasMany(:invocations, :invocations)
  t.hasMany(:answers, :answers)
  t.hasMany(:replies, :messages)
end

let table = DB.Schema.Messages.definition.table

let id = DB.Schema.Messages.definition.textColumn(:id)
let conversationId = DB.Schema.Messages.definition.textColumn(:conversation_id)
let userId = DB.Schema.Messages.definition.textColumn(:user_id)
let body = DB.Schema.Messages.definition.textColumn(:body)
let sentAt = DB.Schema.Messages.definition.wholeColumn(:sent_at)
let sentOn = DB.Schema.Messages.definition.textColumn(:sent_on)
let parentId = DB.Schema.Messages.definition.textColumn(:parent_id)
