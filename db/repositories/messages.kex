# What was said.
#
#   DB.Repositories.Messages.latest(conversation.id, 200)
module DB.Repositories.Messages

using Harmat.Database, as: Database
using App.Models.Message, only: [Message]

# The newest `limit` messages of a conversation, oldest first. Replies are
# not among them: they are read with the thread they belong to.
foul latest(conversationId: String, limit: Integer) -> Result<[Message], String> do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.conversationId.eq(conversationId))
    .where(DB.Schema.Messages.parentId.eq(""))
    .orderBy(descending: [:sent_at, :id])
    .limit(limit)
    .all
    .map { |rows| rows.map { |row| decoded(row) }.reverse }
end

# The replies to a message, oldest first.
foul answering(rootId: String) -> Result<[Message], String> do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.parentId.eq(rootId))
    .orderBy([:sent_at, :id])
    .all
    .map { |rows| rows.map { |row| decoded(row) } }
end

# Stores a message, stamped now. With a parent it is a reply, and the
# parent's count is brought up to date — counted again, not added to, so
# two replies at once cannot leave it wrong.
foul said(conversationId: String, userId: String, body: String, parent: String) -> Result<Message, String> do
  let moment = Metro.Clock.milliseconds()
  let message = Message {
    id: "m${moment}-${Metro.Id.serial()}",
    conversationId: conversationId,
    userId: userId,
    body: body,
    sentAt: moment,
    sentOn: "${DateTime.now()}",
    parentId: parent
  }
  let row = {
    id: message.id,
    conversation_id: conversationId,
    user_id: userId,
    body: body,
    sent_at: moment,
    sent_on: message.sentOn,
    parent_id: parent
  }
  let stored = Database.insert(DB.Schema.Messages)
    .values(row)
    .run
  return stored.map { |_| message } if stored.error? || parent.empty?

  let replies = answering(parent).try
  return Database.update(DB.Schema.Messages)
    .set({reply_count: replies.count})
    .where(DB.Schema.Messages.id.eq(parent))
    .run
    .map { |_| message }
end

# One message, or `None`.
foul single(id: String) -> Result<Message?, String> do
  return Database.select().from(DB.Schema.Messages)
    .where(DB.Schema.Messages.id.eq(id))
    .first
    .map { |row| row.map { |found| decoded(found) } }
end

private do
  decoded : {String: String} -> Message
  let decoded(row) = Message {
    id: row.get("id").or(""),
    conversationId: row.get("conversation_id").or(""),
    userId: row.get("user_id").or(""),
    body: row.get("body").or(""),
    sentAt: row.get("sent_at").or("").trim.to(Integer).or(0),
    sentOn: row.get("sent_on").or(""),
    parentId: row.get("parent_id").or(""),
    replyCount: row.get("reply_count").or("").trim.to(Integer).or(0)
  }
end
